                      },
                      "tableId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      },
                      "row": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "column": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "headerPath": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "expectedCellValue": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "tableId",
                      "row",
                      "column",
                      "headerPath"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "media_timecode"
                      },
                      "startMs": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "endMs": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "speaker": {
                        "type": "string",
                        "minLength": 1
                      },
                      "channel": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "startMs",
                      "endMs"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "repository"
                      },
                      "commit": {
                        "type": "string",
                        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "rangeKind": {
                        "type": "string",
                        "enum": [
                          "lines",
                          "bytes"
                        ]
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "commit",
                      "path",
                      "rangeKind",
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "dataset"
                      },
                      "datasetVersionId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      },
                      "rowKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "column": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "datasetVersionId",
                      "rowKey"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "api_record"
                      },
                      "pageKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "recordKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fieldPointer": {
                        "type": "string",
                        "pattern": "^(?:\\/(?:[^~/]|~[01])*)*$"
                      }
                    },
                    "required": [
                      "kind",
                      "recordKey"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "selectedContentDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "fragmentId": {
                "type": "string",
                "pattern": "^fragment:[a-f0-9]{64}$"
              }
            },
            "required": [
              "captureId",
              "representationArtifactId",
              "representationDigest",
              "selector",
              "selectedContentDigest",
              "fragmentId"
            ],
            "additionalProperties": false
          },
          "computation": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "verification-cross-field-total.v1"
