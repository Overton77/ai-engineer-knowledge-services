{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "verification-extraction-field-evidence.v1"
    },
    "valid": {
      "type": "boolean"
    },
    "candidateValid": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "status",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "acceptedLeaves": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "rawValue": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "derivation": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "direct"
                  },
                  "comparison": {
                    "type": "string",
                    "enum": [
                      "exact",
                      "normalized_text",
                      "decimal",
                      "percentage",
                      "currency",
                      "unit",
                      "date",
                      "datetime",
                      "enum",
                      "identifier",
                      "checksum"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "comparison"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "normalized"
                  },
                  "comparison": {
                    "type": "string",
                    "enum": [
                      "exact",
                      "normalized_text",
                      "decimal",
                      "percentage",
                      "currency",
                      "unit",
                      "date",
                      "datetime",
                      "enum",
                      "identifier",
                      "checksum"
                    ]
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "trim_ascii",
                      "ascii_whitespace_collapsed",
                      "decimal_exact",
                      "percentage_exact",
                      "currency_code_amount",
                      "unit_token",
                      "date_calendar",
                      "datetime_instant",
                      "enum_membership",
                      "identifier_format",
                      "checksum"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "comparison",
                  "operation"
                ],
                "additionalProperties": false
              }
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "captureId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "representationArtifactId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "representationDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "text_quote"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "prefix": {
                        "type": "string",
                        "minLength": 1
                      },
                      "suffix": {
                        "type": "string",
                        "minLength": 1
                      },
                      "normalization": {
                        "type": "string",
                        "enum": [
                          "none",
                          "lf",
                          "lf_whitespace_collapsed",
                          "casefold_whitespace_filler_removed"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "quote",
                      "normalization"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "character_position"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "offsetBasis": {
                        "type": "string",
                        "enum": [
                          "utf8_bytes",
                          "utf16_code_units",
                          "unicode_code_points"
                        ]
                      },
                      "normalization": {
                        "type": "string",
                        "enum": [
                          "none",
                          "lf",
                          "lf_whitespace_collapsed",
                          "casefold_whitespace_filler_removed"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "end",
                      "offsetBasis",
                      "normalization"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "multi_fragment_text"
                      },
                      "fragments": {
                        "minItems": 2,
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "text_quote"
                                },
                                "quote": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "prefix": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "suffix": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "normalization": {
                                  "type": "string",
                                  "enum": [
                                    "none",
                                    "lf",
                                    "lf_whitespace_collapsed",
                                    "casefold_whitespace_filler_removed"
                                  ]
                                }
                              },
                              "required": [
                                "kind",
                                "quote",
                                "normalization"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "character_position"
                                },
                                "start": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "end": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "offsetBasis": {
                                  "type": "string",
                                  "enum": [
                                    "utf8_bytes",
                                    "utf16_code_units",
                                    "unicode_code_points"
                                  ]
                                },
                                "normalization": {
                                  "type": "string",
                                  "enum": [
                                    "none",
                                    "lf",
                                    "lf_whitespace_collapsed",
                                    "casefold_whitespace_filler_removed"
                                  ]
                                }
                              },
                              "required": [
                                "kind",
                                "start",
                                "end",
                                "offsetBasis",
                                "normalization"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        }
