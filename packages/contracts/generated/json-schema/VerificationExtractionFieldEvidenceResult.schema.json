              "operandPaths": {
                "minItems": 1,
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "tolerance": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "schemaVersion",
              "operation",
              "operandPaths",
              "tolerance"
            ],
            "additionalProperties": false
          },
          "lineage": {
