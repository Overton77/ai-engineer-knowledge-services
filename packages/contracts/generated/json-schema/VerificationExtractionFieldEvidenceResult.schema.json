                      "joiner": {
                        "type": "string",
                        "const": " … "
                      }
                    },
                    "required": [
                      "kind",
                      "fragments",
                      "joiner"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "json_pointer"
                      },
                      "pointer": {
                        "type": "string",
                        "pattern": "^(?:\\/(?:[^~/]|~[01])*)*$"
                      }
                    },
                    "required": [
                      "kind",
                      "pointer"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "html"
                      },
                      "css": {
                        "type": "string",
                        "minLength": 1
                      },
                      "xpath": {
                        "type": "string",
                        "minLength": 1
                      },
                      "domPath": {
                        "type": "string",
                        "minLength": 1
                      },
                      "canonicalTextFallback": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "text_quote"
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1
                          },
                          "prefix": {
                            "type": "string",
                            "minLength": 1
                          },
                          "suffix": {
                            "type": "string",
                            "minLength": 1
                          },
                          "normalization": {
                            "type": "string",
                            "enum": [
                              "none",
                              "lf",
                              "lf_whitespace_collapsed",
                              "casefold_whitespace_filler_removed"
                            ]
                          }
                        },
                        "required": [
                          "kind",
                          "quote",
                          "normalization"
                        ],
                        "additionalProperties": false
                      },
                      "textRange": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "end": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "pdf_text"
                      },
                      "page": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "end": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "offsetBasis": {
                        "type": "string",
                        "enum": [
                          "utf8_bytes",
                          "utf16_code_units",
                          "unicode_code_points"
                        ]
                      },
                      "textLayerDigest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "kind",
                      "page",
                      "start",
                      "end",
                      "offsetBasis",
                      "textLayerDigest"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
