                "additionalProperties": false
              },
              "parserVersion": {
                "type": "string",
                "const": "verification-native-parser.v1"
              },
              "imageDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "parserOptionsDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "parserTransformationSignature": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
