            "required": [
              "schemaVersion",
              "sourceArtifact",
              "nativeOutputArtifact",
              "transformationArtifact",
              "projectionArtifact",
              "parserVersion",
              "imageDigest",
              "parserOptionsDigest",
              "parserTransformationSignature"
