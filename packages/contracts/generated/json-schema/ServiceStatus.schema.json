{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "const": "knowledge-services"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "degraded"
      ]
    },
    "contractVersion": {
      "type": "string",
      "const": "v1"
    },
    "runtime": {
      "type": "string",
      "const": "node"
    }
  },
  "required": [
    "service",
    "status",
    "contractVersion",
    "runtime"
  ],
  "additionalProperties": false
}
