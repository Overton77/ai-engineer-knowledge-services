{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verificationContractVersion": {
      "type": "string",
      "const": "verification.v1"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "publication": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifactId",
            "digest"
          ],
          "additionalProperties": false
        },
        "signatureStatus": {
          "type": "string",
          "const": "verified"
        },
        "purpose": {
          "type": "string",
          "const": "artifact_custody_only"
        }
      },
      "required": [
        "artifact",
        "signatureStatus",
        "purpose"
      ],
      "additionalProperties": false
    },
    "output": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "unverified_candidate"
            },
            "schemaValidation": {
              "type": "string",
              "const": "shape_only"
            },
            "candidateArtifact": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "digest"
              ],
              "additionalProperties": false
            },
            "provenanceArtifact": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "digest"
              ],
              "additionalProperties": false
            },
            "precontextArtifact": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "artifactId",
                    "digest"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "executionArtifact": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "digest"
              ],
              "additionalProperties": false
            },
            "manifestDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "providerCallDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "status",
            "schemaValidation",
            "candidateArtifact",
            "provenanceArtifact",
            "precontextArtifact",
            "executionArtifact",
            "manifestDigest",
            "providerCallDigest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "failed"
            },
            "code": {
              "type": "string",
              "enum": [
                "PROVIDER_HTTP_FAILURE",
                "PROVIDER_RESPONSE_TOO_LARGE",
                "PROVIDER_RESPONSE_INVALID",
                "PROVIDER_RESPONSE_SCHEMA_INVALID"
              ]
            },
            "category": {
              "type": "string",
              "enum": [
                "provider_http",
                "producer_contract"
              ]
            },
            "automaticRetry": {
              "type": "boolean",
              "const": false
            },
            "candidateArtifact": {
              "type": "null"
            },
            "executionArtifact": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "digest"
              ],
              "additionalProperties": false
            },
            "manifestDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "providerCallDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "status",
            "code",
            "category",
            "automaticRetry",
            "candidateArtifact",
            "executionArtifact",
            "manifestDigest",
            "providerCallDigest"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "verificationContractVersion",
    "tenantId",
    "operationId",
    "requestDigest",
    "publication",
    "output"
  ],
  "additionalProperties": false
}
