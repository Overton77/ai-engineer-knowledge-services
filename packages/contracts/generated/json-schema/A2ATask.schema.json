{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "document_preparation",
        "vector_store_ingestion",
        "retrieval",
        "evidence_packet_construction"
      ]
    },
    "contractVersion": {
      "type": "string",
      "const": "v1"
    },
    "context": {
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "workItemId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "missionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "causationId": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "human"
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "service"
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "serviceIdentity": {
                  "type": "string",
                  "enum": [
                    "knowledge_api",
                    "knowledge_worker",
                    "acquisition_executor",
                    "conversion_executor",
                    "inspection_agent",
                    "content_curator_agent",
                    "embedding_executor",
                    "retrieval_executor",
                    "evaluation_executor",
                    "human_reviewer",
                    "mission_control_client",
                    "retention_worker",
                    "control_plane"
                  ]
                }
              },
              "required": [
                "kind",
                "id",
                "serviceIdentity"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "model"
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "serviceIdentity": {
                  "type": "string",
                  "enum": [
                    "inspection_agent",
                    "content_curator_agent"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "providerRunId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "id",
                "serviceIdentity",
                "model",
                "providerRunId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "capabilityVersion": {
          "type": "string",
          "minLength": 1
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 255
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "contractVersion": {
          "type": "string",
          "const": "v1"
        },
        "externalExecution": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "string",
              "enum": [
                "eve",
                "vercel_workflow",
                "mission_control",
                "other"
              ]
            },
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "rootRunId": {
              "type": "string",
              "minLength": 1
            },
            "sessionId": {
              "type": "string",
              "minLength": 1
            },
            "turnId": {
              "type": "string",
              "minLength": 1
            },
            "toolCallId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "runtime",
            "runId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tenantId",
        "operationId",
        "attemptId",
        "correlationId",
        "actor",
        "capabilityVersion",
        "idempotencyKey",
        "reason",
        "contractVersion"
      ],
      "additionalProperties": false
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "capabilityVersions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedOutputContract": {
      "type": "string",
      "minLength": 1
    },
    "inputArtifactIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "operationInput": {
      "$ref": "#/$defs/__schema0"
    },
    "callback": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "authenticationReference": {
          "type": "string",
          "minLength": 1
        },
        "signingKeyReference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "authenticationReference",
        "signingKeyReference"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "taskId",
    "kind",
    "contractVersion",
    "context",
    "purpose",
    "capabilityVersions",
    "expectedOutputContract",
    "inputArtifactIds",
    "operationInput",
    "callback"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
