{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verificationContractVersion": {
      "type": "string",
      "const": "verification.v1"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "comparisonId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "baselineRunId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "candidateRunId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "profile": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "enum": [
            "paired_default",
            "regression_gate"
          ]
        },
        "artifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifactId",
            "digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "profileId",
        "artifact"
      ],
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifactId",
            "digest"
          ],
          "additionalProperties": false
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "signatureStatus": {
          "type": "string",
          "const": "verified"
        }
      },
      "required": [
        "artifact",
        "payloadDigest",
        "signatureStatus"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifactId",
            "digest"
          ],
          "additionalProperties": false
        },
        "resultDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifact",
        "resultDigest"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "engineeringGateOutcome": {
      "type": "string",
      "enum": [
        "not_requested",
        "pass",
        "fail"
      ]
    },
    "qualityClaims": {
      "type": "object",
      "properties": {
        "humanGoldValidated": {
          "type": "boolean",
          "const": false
        },
        "sourceAuthorityAssessed": {
          "type": "boolean",
          "const": false
        },
        "calibrated": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "humanGoldValidated",
        "sourceAuthorityAssessed",
        "calibrated"
      ],
      "additionalProperties": false
    },
    "statisticalScope": {
      "type": "string",
      "const": "paired_engineering_observations_without_assessed_cluster_independence"
    },
    "pairs": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pairId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "caseCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "clusterCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "clusterUnit": {
            "type": "string",
            "enum": [
              "source_family",
              "report_cluster"
            ]
          },
          "metrics": {
            "minItems": 9,
            "maxItems": 9,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string",
                  "enum": [
                    "schema_validity",
                    "locator_resolution_validity",
                    "locator_expectation_agreement",
                    "field_mechanics",
                    "support_agreement",
                    "authority_agreement",
                    "world_correctness_agreement",
                    "policy_agreement",
                    "engineering_expectation_agreement"
                  ]
                },
                "denominator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "baseline": {
                  "type": "object",
                  "properties": {
                    "successes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "denominator": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "estimate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "lower": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "upper": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "successes",
                    "denominator",
                    "estimate",
                    "lower",
                    "upper"
                  ],
                  "additionalProperties": false
                },
                "candidate": {
                  "type": "object",
                  "properties": {
                    "successes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "denominator": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "estimate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "lower": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "upper": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "successes",
                    "denominator",
                    "estimate",
                    "lower",
                    "upper"
                  ],
                  "additionalProperties": false
                },
                "delta": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "regressionObservation": {
                  "type": "string",
                  "enum": [
                    "observed_regression",
                    "observed_improvement",
                    "no_observed_change"
                  ]
                },
                "clusterBootstrap": {
                  "type": "object",
                  "properties": {
                    "estimate": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "lower": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": -1,
                          "maximum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "upper": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": -1,
                          "maximum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "clusters": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "cases": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "resamples": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "seed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "limitation": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "estimate",
                    "lower",
                    "upper",
                    "clusters",
                    "cases",
                    "resamples",
                    "seed",
                    "limitation"
                  ],
                  "additionalProperties": false
                },
                "mcnemarPValue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "clusterSignFlipPValue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "metric",
                "denominator",
                "baseline",
                "candidate",
                "delta",
                "regressionObservation",
                "clusterBootstrap",
                "mcnemarPValue",
                "clusterSignFlipPValue"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "pairId",
          "caseCount",
          "clusterCount",
          "clusterUnit",
          "metrics"
        ],
        "additionalProperties": false
      }
    },
    "globalInference": {
      "type": "object",
      "properties": {
        "correction": {
          "type": "string",
          "const": "holm"
        },
        "tests": {
          "minItems": 18,
          "maxItems": 288,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "pValue": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "adjustedPValue": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "id",
              "pValue",
              "adjustedPValue"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "correction",
        "tests"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "verificationContractVersion",
    "tenantId",
    "comparisonId",
    "operationId",
    "baselineRunId",
    "candidateRunId",
    "profile",
    "publication",
    "result",
    "startedAt",
    "completedAt",
    "engineeringGateOutcome",
    "qualityClaims",
    "statisticalScope",
    "pairs",
    "globalInference"
  ],
  "additionalProperties": false
}
