{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "schemaVersion": {
      "type": "string",
      "const": "v1"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "proposalType": {
      "type": "string",
      "enum": [
        "source_vetting",
        "document_identity",
        "representation_acceptance",
        "domain_mapping",
        "chunking",
        "projection",
        "promotion",
        "evaluation_query",
        "repair"
      ]
    },
    "proposalStage": {
      "type": "string",
      "enum": [
        "source_acceptance",
        "representation_acceptance",
        "vector_space_promotion"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "inputArtifactDigests": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "inputRepresentationDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "proposedAction": {
      "type": "string",
      "minLength": 1
    },
    "selectedDomains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "engineering_claims",
          "tool_capabilities",
          "implementation_examples",
          "paper_case_study_knowledge",
          "entity_profiles",
          "model_capabilities",
          "benchmark_intelligence"
        ]
      }
    },
    "targetContract": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "supportingLocators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "representationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "nodeId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sectionPath": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "startOffset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endOffset": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "startTimeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endTimeMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "domPath": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "quoteDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "representationId"
        ],
        "additionalProperties": false
      }
    },
    "canonicalReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "schemaVersion": {
            "type": "string",
            "minLength": 1
          },
          "recordId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "kind",
          "schemaVersion",
          "recordId",
          "tenantId"
        ],
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alternativesConsidered": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requestedReviewClass": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "human"
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "service"
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "serviceIdentity": {
              "type": "string",
              "enum": [
                "knowledge_api",
                "knowledge_worker",
                "acquisition_executor",
                "conversion_executor",
                "inspection_agent",
                "content_curator_agent",
                "embedding_executor",
                "retrieval_executor",
                "evaluation_executor",
                "human_reviewer",
                "mission_control_client",
                "retention_worker",
                "control_plane"
              ]
            }
          },
          "required": [
            "kind",
            "id",
            "serviceIdentity"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "model"
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "serviceIdentity": {
              "type": "string",
              "enum": [
                "inspection_agent",
                "content_curator_agent"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "providerRunId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "id",
            "serviceIdentity",
            "model",
            "providerRunId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "promptDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "capabilityProfileVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "tenantId",
    "digest",
    "schemaVersion",
    "createdAt",
    "proposalType",
    "proposalStage",
    "correlationId",
    "inputArtifactDigests",
    "inputRepresentationDigests",
    "proposedAction",
    "selectedDomains",
    "targetContract",
    "rationale",
    "supportingLocators",
    "canonicalReferences",
    "uncertainty",
    "unresolvedQuestions",
    "alternativesConsidered",
    "requestedReviewClass",
    "author",
    "promptDigest",
    "capabilityProfileVersion"
  ],
  "additionalProperties": false
}
