{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providerAttemptId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "budgetId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "providerId": {
      "type": "string",
      "enum": [
        "gateway-structured-extraction.v1",
        "interfaze-extraction.v1"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "configurationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "attemptOrdinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "reservationCostMicros": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 20000000
    },
    "state": {
      "type": "string",
      "enum": [
        "dispatched",
        "uncertain",
        "settled"
      ]
    },
    "actualCostMicros": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000000
        },
        {
          "type": "null"
        }
      ]
    },
    "pricingBasis": {
      "type": "string",
      "enum": [
        "synthetic_transport",
        "provider_reported_response"
      ]
    },
    "costEvidenceArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "downloadHandle": {
          "type": "string",
          "minLength": 1
        },
        "objectKey": {
          "type": "string",
          "minLength": 1
        },
        "contentEncoding": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "producerActivityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1
        },
        "encryptionClass": {
          "type": "string",
          "minLength": 1
        },
        "retentionClass": {
          "type": "string",
          "minLength": 1
        },
        "dataClassification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "parentArtifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "transformationSignature": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "attestationArtifactId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "artifactId",
        "tenantId",
        "digest",
        "mediaType",
        "byteLength",
        "objectKey",
        "createdAt",
        "producerActivityId",
        "producerVersion",
        "encryptionClass",
        "retentionClass",
        "dataClassification",
        "parentArtifactIds"
      ],
      "additionalProperties": false
    },
    "supplierBillingVerified": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "providerAttemptId",
    "budgetId",
    "providerId",
    "model",
    "configurationDigest",
    "attemptOrdinal",
    "reservationCostMicros",
    "state",
    "actualCostMicros",
    "pricingBasis",
    "costEvidenceArtifact",
    "supplierBillingVerified"
  ],
  "additionalProperties": false
}
