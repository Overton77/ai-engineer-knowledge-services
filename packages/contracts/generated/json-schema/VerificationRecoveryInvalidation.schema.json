{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "verification-recovery-invalidation.v1"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "complete": {
      "type": "boolean",
      "const": true
    },
    "evaluations": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observation": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "string",
                "const": "verification-component-drift-observation.v1"
              },
              "tenantId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "baseline": {
                "type": "object",
                "properties": {
                  "runId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "auditBundleArtifact": {
                    "type": "object",
                    "properties": {
                      "artifactId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "artifactId",
                      "digest"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "runId",
                  "auditBundleArtifact"
                ],
                "additionalProperties": false
              },
              "candidate": {
                "type": "object",
                "properties": {
                  "runId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "auditBundleArtifact": {
                    "type": "object",
                    "properties": {
                      "artifactId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "artifactId",
                      "digest"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "runId",
                  "auditBundleArtifact"
                ],
                "additionalProperties": false
              },
              "baselineComponents": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "parser": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "grader": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "policy": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "provider",
                  "model",
                  "parser",
                  "grader",
                  "policy"
                ],
                "additionalProperties": false
              },
              "candidateComponents": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "parser": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "grader": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "policy": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "provider",
                  "model",
                  "parser",
                  "grader",
                  "policy"
                ],
                "additionalProperties": false
              },
              "changedDimensions": {
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "provider",
                    "model",
                    "parser",
                    "grader",
                    "policy"
                  ]
                }
              },
              "payloadDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "schemaVersion",
              "tenantId",
              "baseline",
              "candidate",
              "baselineComponents",
              "candidateComponents",
              "changedDimensions",
              "payloadDigest"
            ],
            "additionalProperties": false
          },
          "graph": {
            "type": "object",
            "properties": {
              "tenantId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "caseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "planDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "baselineAuditDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "rootIds": {
                "minItems": 1,
                "maxItems": 512,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "nodes": {
                "minItems": 1,
                "maxItems": 2048,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "dependencyIds": {
                      "maxItems": 512,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "admissionAuditDigest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "revoked": {
                      "type": "boolean"
                    },
                    "revalidatedStages": {
                      "maxItems": 7,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "capture",
                          "parser",
                          "selector",
                          "mechanical",
                          "semantic",
                          "policy",
                          "report"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "dependencyIds",
                    "admissionAuditDigest",
                    "revoked",
                    "revalidatedStages"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "tenantId",
              "caseId",
              "planDigest",
              "baselineAuditDigest",
              "rootIds",
              "nodes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "observation",
          "graph"
        ],
        "additionalProperties": false
      }
    },
    "invalidatedOutputIds": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "revalidatedOutputIds": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "blockedOutputIds": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "caseId",
    "planDigest",
    "complete",
    "evaluations",
    "invalidatedOutputIds",
    "revalidatedOutputIds",
    "blockedOutputIds",
    "payloadDigest"
  ],
  "additionalProperties": false
}
