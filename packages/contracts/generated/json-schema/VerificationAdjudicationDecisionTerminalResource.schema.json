{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verificationContractVersion": {
      "type": "string",
      "const": "verification.v1"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "output": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "verification-adjudication-decision-result.v1"
        },
        "subjectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "packetArtifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifactId",
            "digest"
          ],
          "additionalProperties": false
        },
        "decisionArtifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifactId",
            "digest"
          ],
          "additionalProperties": false
        },
        "decision": {
          "type": "string",
          "enum": [
            "affirm",
            "reject",
            "defer"
          ]
        },
        "reviewerProvenance": {
          "type": "string",
          "enum": [
            "human_origin",
            "synthetic_engineering"
          ]
        },
        "quorum": {
          "type": "object",
          "properties": {
            "required": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "humanAffirmRecorded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "humanRejectRecorded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "humanDeferRecorded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "syntheticAffirmRecorded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reached": {
              "type": "boolean"
            }
          },
          "required": [
            "required",
            "humanAffirmRecorded",
            "humanRejectRecorded",
            "humanDeferRecorded",
            "syntheticAffirmRecorded",
            "reached"
          ],
          "additionalProperties": false
        },
        "admissionChanged": {
          "type": "boolean",
          "const": false
        },
        "humanGoldScoringEligible": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "schemaVersion",
        "subjectId",
        "packetArtifact",
        "decisionArtifact",
        "decision",
        "reviewerProvenance",
        "quorum",
        "admissionChanged",
        "humanGoldScoringEligible"
      ],
      "additionalProperties": false
    },
    "terminalFencingToken": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "verificationContractVersion",
    "tenantId",
    "operationId",
    "requestDigest",
    "output",
    "terminalFencingToken"
  ],
  "additionalProperties": false
}
