{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "verification-recovery-receipt.v1"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "failureSetDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "questionIds": {
      "minItems": 1,
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "questionDenominator": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "results": {
      "minItems": 1,
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "originalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "originalInputDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "outputInputDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "preserved_admitted",
              "recovered_admitted",
              "partial_support",
              "resolved_rejected",
              "review_required",
              "operator_required",
              "exhausted",
              "cancelled",
              "reconciliation_unresolved",
              "unresolved_gap"
            ]
          },
          "questionIds": {
            "minItems": 1,
            "maxItems": 512,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "coveredRequirementIds": {
            "maxItems": 512,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "gapRequirementIds": {
            "maxItems": 512,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "artifacts": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "tenantId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "mediaType": {
                  "type": "string",
                  "minLength": 1
                },
                "byteLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "downloadHandle": {
                  "type": "string",
                  "minLength": 1
                },
                "objectKey": {
                  "type": "string",
                  "minLength": 1
                },
                "contentEncoding": {
                  "type": "string",
                  "minLength": 1
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "producerActivityId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "producerVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "encryptionClass": {
                  "type": "string",
                  "minLength": 1
                },
                "retentionClass": {
                  "type": "string",
                  "minLength": 1
                },
                "dataClassification": {
                  "type": "string",
                  "enum": [
                    "public",
                    "internal",
                    "confidential",
                    "restricted"
                  ]
                },
                "parentArtifactIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "transformationSignature": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "attestationArtifactId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "required": [
                "artifactId",
                "tenantId",
                "digest",
                "mediaType",
                "byteLength",
                "objectKey",
                "createdAt",
                "producerActivityId",
                "producerVersion",
                "encryptionClass",
                "retentionClass",
                "dataClassification",
                "parentArtifactIds"
              ],
              "additionalProperties": false
            }
          },
          "usedRounds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "attemptedInputDigests": {
            "maxItems": 512,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "attemptedRepairDigests": {
            "maxItems": 512,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "pendingReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "originalId",
          "originalInputDigest",
          "outcome",
          "questionIds",
          "coveredRequirementIds",
          "gapRequirementIds",
          "artifacts",
          "usedRounds",
          "attemptedInputDigests",
          "attemptedRepairDigests"
        ],
        "additionalProperties": false
      }
    },
    "coveredQuestionIdsBefore": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "coveredQuestionIdsAfter": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "remainingQuestionIds": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "invalidatedOutputIds": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "revalidatedOutputIds": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "invalidationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "invalidationObservationDigests": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "costMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "calls",
        "costMicros"
      ],
      "additionalProperties": false
    },
    "retainedReservation": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "costMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "calls",
        "costMicros"
      ],
      "additionalProperties": false
    },
    "remainingLimits": {
      "type": "object",
      "properties": {
        "maxRoundsPerOriginal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "maxProbeRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "remainingCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "remainingCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "maxRoundsPerOriginal",
        "maxProbeRounds",
        "remainingCalls",
        "remainingCostMicros",
        "deadline"
      ],
      "additionalProperties": false
    },
    "checkpointReferences": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "probeRounds": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependencyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "receiptDigests": {
            "maxItems": 512,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "required": [
          "dependencyId",
          "used",
          "receiptDigests"
        ],
        "additionalProperties": false
      }
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "caseId",
    "failureSetDigest",
    "planDigest",
    "questionIds",
    "questionDenominator",
    "results",
    "coveredQuestionIdsBefore",
    "coveredQuestionIdsAfter",
    "remainingQuestionIds",
    "invalidatedOutputIds",
    "revalidatedOutputIds",
    "invalidationDigest",
    "invalidationObservationDigests",
    "usage",
    "retainedReservation",
    "remainingLimits",
    "checkpointReferences",
    "probeRounds",
    "payloadDigest"
  ],
  "additionalProperties": false
}
