{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "verification-structured-extraction-source-custody.v1"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "scope": {
      "type": "string",
      "const": "listed_files"
    },
    "files": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 4,
            "maxLength": 512,
            "pattern": "^(?:KS|DB)\\/[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144
          },
          "bytesBase64": {
            "type": "string",
            "maxLength": 349528,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "path",
          "sha256",
          "byteLength",
          "bytesBase64"
        ],
        "additionalProperties": false
      }
    },
    "totalByteLength": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1048576
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "scope",
    "files",
    "totalByteLength"
  ],
  "additionalProperties": false
}
