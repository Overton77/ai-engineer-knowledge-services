{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verificationContractVersion": {
      "type": "string",
      "const": "verification.v1"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "datasetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "datasetVersionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "experimentDefinitionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "variantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "versions": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "grader": {
          "type": "string",
          "minLength": 1
        },
        "parser": {
          "type": "string",
          "minLength": 1
        },
        "normalizer": {
          "type": "string",
          "minLength": 1
        },
        "extractor": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "policy",
        "schema",
        "normalizer"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        },
        "dirtyStateArtifactId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "gitSha",
        "dirty"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "container": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "deploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "platform",
        "deploymentId"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "endpointIdentity": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "nativeConfiguration": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "pricingSnapshotArtifactId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "endpointIdentity",
        "model",
        "nativeConfiguration",
        "pricingSnapshotArtifactId"
      ],
      "additionalProperties": false
    },
    "inputArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "downloadHandle": {
            "type": "string",
            "minLength": 1
          },
          "objectKey": {
            "type": "string",
            "minLength": 1
          },
          "contentEncoding": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "producerActivityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "producerVersion": {
            "type": "string",
            "minLength": 1
          },
          "encryptionClass": {
            "type": "string",
            "minLength": 1
          },
          "retentionClass": {
            "type": "string",
            "minLength": 1
          },
          "dataClassification": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "parentArtifactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "transformationSignature": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "attestationArtifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "artifactId",
          "tenantId",
          "digest",
          "mediaType",
          "byteLength",
          "objectKey",
          "createdAt",
          "producerActivityId",
          "producerVersion",
          "encryptionClass",
          "retentionClass",
          "dataClassification",
          "parentArtifactIds"
        ],
        "additionalProperties": false
      }
    },
    "outputArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "downloadHandle": {
            "type": "string",
            "minLength": 1
          },
          "objectKey": {
            "type": "string",
            "minLength": 1
          },
          "contentEncoding": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "producerActivityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "producerVersion": {
            "type": "string",
            "minLength": 1
          },
          "encryptionClass": {
            "type": "string",
            "minLength": 1
          },
          "retentionClass": {
            "type": "string",
            "minLength": 1
          },
          "dataClassification": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "parentArtifactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "transformationSignature": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "attestationArtifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "artifactId",
          "tenantId",
          "digest",
          "mediaType",
          "byteLength",
          "objectKey",
          "createdAt",
          "producerActivityId",
          "producerVersion",
          "encryptionClass",
          "retentionClass",
          "dataClassification",
          "parentArtifactIds"
        ],
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed",
              "skipped"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "name",
          "status",
          "startedAt",
          "endedAt"
        ],
        "additionalProperties": false
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "providerResponseId": {
            "type": "string",
            "minLength": 1
          },
          "requestDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "responseArtifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reservationCostMicros": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "costState": {
            "type": "string",
            "enum": [
              "reserved",
              "estimated",
              "actual",
              "unknown_dispatched"
            ]
          },
          "estimatedCostMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "actualCostMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "requestDigest",
          "retries",
          "reservationCostMicros",
          "costState"
        ],
        "additionalProperties": false
      }
    },
    "randomSeed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "toolPolicy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "networkPolicy": {
      "type": "string",
      "enum": [
        "disabled",
        "allowlisted",
        "unrestricted"
      ]
    },
    "deterministicResult": {
      "type": "object",
      "properties": {
        "verificationContractVersion": {
          "type": "string",
          "const": "verification.v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "review_required"
          ]
        },
        "semanticEligibility": {
          "type": "boolean"
        },
        "deploymentSeparation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "established",
                "not_established"
              ]
            },
            "basis": {
              "type": "string",
              "const": "runtime_principal_binding"
            },
            "producerDeploymentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "verifierDeploymentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "required": [
            "status",
            "basis",
            "producerDeploymentId",
            "verifierDeploymentId"
          ],
          "additionalProperties": false
        },
        "captureChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "review_required"
                ]
              },
              "deterministic": {
                "type": "boolean",
                "const": true
              },
              "severity": {
                "type": "string",
                "enum": [
                  "hard",
                  "review"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "targetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            },
            "required": [
              "code",
              "status",
              "deterministic",
              "severity",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "assertionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "review_required"
                ]
              },
              "semanticEligibility": {
                "type": "boolean"
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "pending_semantic_review",
                  "directly_supported",
                  "supported_with_qualification",
                  "partially_supported",
                  "context_only",
                  "contradicted",
                  "mixed_or_conflicting",
                  "not_supported",
                  "insufficient_evidence",
                  "unverifiable",
                  "source_unavailable",
                  "locator_error",
                  "parser_error",
                  "derived_verified",
                  "derived_failed"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "evidenceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "passed",
                        "failed",
                        "review_required"
                      ]
                    },
                    "resolution": {
                      "type": "object",
                      "properties": {
                        "captureId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        "representationArtifactId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "representationDigest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "selectorDigest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "selectorKind": {
                          "type": "string",
                          "enum": [
                            "text_quote",
                            "character_position",
                            "multi_fragment_text",
                            "json_pointer",
                            "html",
                            "pdf_text",
                            "bounding_box",
                            "table",
                            "media_timecode",
                            "repository",
                            "dataset",
                            "api_record"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "resolved",
                            "not_found",
                            "ambiguous",
                            "invalid",
                            "parse_error"
                          ]
                        },
                        "occurrenceCount": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "selectedContentDigest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "selectedValue": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "resolvedRanges": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": "number",
                                "minimum": 0
                              },
                              "end": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "coordinateSpace": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "start",
                              "end",
                              "coordinateSpace"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "normalization": {
                          "type": "string",
                          "enum": [
                            "none",
                            "lf",
                            "lf_whitespace_collapsed",
                            "casefold_whitespace_filler_removed"
                          ]
                        },
                        "resolverVersion": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "captureId",
                        "representationArtifactId",
                        "representationDigest",
                        "selectorDigest",
                        "selectorKind",
                        "status",
                        "occurrenceCount",
                        "resolvedRanges",
                        "normalization",
                        "resolverVersion"
                      ],
                      "additionalProperties": false
                    },
                    "checks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "minLength": 1
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "passed",
                              "failed",
                              "review_required"
                            ]
                          },
                          "deterministic": {
                            "type": "boolean",
                            "const": true
                          },
                          "severity": {
                            "type": "string",
                            "enum": [
                              "hard",
                              "review"
                            ]
                          },
                          "detail": {
                            "type": "string",
                            "minLength": 1
                          },
                          "targetId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255
                          }
                        },
                        "required": [
                          "code",
                          "status",
                          "deterministic",
                          "severity",
                          "detail"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "evidenceId",
                    "status",
                    "resolution",
                    "checks"
                  ],
                  "additionalProperties": false
                }
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
