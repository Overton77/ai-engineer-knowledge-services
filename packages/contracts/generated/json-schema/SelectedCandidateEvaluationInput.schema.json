{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "knowledge.selected-candidate-evaluation/v1"
    },
    "candidate": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "knowledge.selected-candidate-index/v1"
        },
        "selection": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string",
              "const": "promotion-selection.v1"
            },
            "tenantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "expectedKnowledgeHead": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "runPinDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "policyDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "selected": {
              "minItems": 1,
              "maxItems": 512,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "memberId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "content": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "node",
                          "chunk",
                          "claim",
                          "entity",
                          "record",
                          "summary"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "kind",
                      "id",
                      "digest"
                    ],
                    "additionalProperties": false
                  },
                  "target": {
                    "type": "object",
                    "properties": {
                      "projectionTargetId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "entity",
                          "claim",
                          "record",
                          "summary",
                          "chunk"
                        ]
                      },
                      "canonicalId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      }
                    },
                    "required": [
                      "projectionTargetId",
                      "kind",
                      "canonicalId"
                    ],
                    "additionalProperties": false
                  },
                  "targetSpaces": {
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "engineering_claims",
                        "tool_capabilities",
                        "implementation_examples",
                        "paper_case_study_knowledge",
                        "entity_profiles",
                        "model_capabilities",
                        "benchmark_intelligence",
                        "source_native_sections"
                      ]
                    }
                  },
                  "sourceChunks": {
                    "minItems": 1,
                    "maxItems": 512,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "chunkId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "chunkDigest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "representationId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "representationDigest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "representationClass": {
                          "type": "string",
                          "enum": [
                            "source_native",
                            "rendered_snapshot",
                            "faithful_normalization",
                            "structural_extraction",
                            "semantic_projection",
                            "retrieval_projection"
                          ]
                        },
                        "captureId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "sourceFamilyId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "required": [
                        "chunkId",
                        "chunkDigest",
                        "representationId",
                        "representationDigest",
                        "representationClass",
                        "captureId",
                        "sourceFamilyId"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "admittedClaims": {
                    "maxItems": 512,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "runId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "claimId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "claimDigest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        },
                        "admissionDigest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "runId",
                        "claimId",
                        "claimDigest",
                        "admissionDigest"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "contentLinkReceiptIds": {
                    "minItems": 1,
                    "maxItems": 512,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "estimatedBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "estimatedTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "estimatedCostMicros": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "memberId",
                  "content",
                  "target",
                  "targetSpaces",
                  "sourceChunks",
                  "admittedClaims",
                  "contentLinkReceiptIds",
                  "reason",
                  "estimatedBytes",
                  "estimatedTokens",
                  "estimatedCostMicros"
                ],
                "additionalProperties": false
              }
            },
            "excluded": {
              "maxItems": 512,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "node",
                          "chunk",
                          "claim",
                          "entity",
                          "record",
                          "summary"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "kind",
                      "id",
                      "digest"
                    ],
                    "additionalProperties": false
                  },
                  "targetSpaces": {
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "engineering_claims",
                        "tool_capabilities",
                        "implementation_examples",
                        "paper_case_study_knowledge",
                        "entity_profiles",
                        "model_capabilities",
                        "benchmark_intelligence",
                        "source_native_sections"
                      ]
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "content",
                  "targetSpaces",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "budget": {
              "type": "object",
              "properties": {
                "maxMembers": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 512
                },
                "maxBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxCostMicros": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "deadline": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "maxMembers",
                "maxBytes",
                "maxTokens",
                "maxCostMicros",
                "deadline"
              ],
              "additionalProperties": false
            },
            "proposedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "requiredReviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "schemaVersion",
            "tenantId",
            "expectedKnowledgeHead",
            "runPinDigest",
            "policyDigest",
            "selected",
            "excluded",
            "budget",
            "proposedBy",
            "requiredReviewer"
          ],
          "additionalProperties": false
        },
        "selectionArtifact": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "digest"
          ],
          "additionalProperties": false
        },
        "preparation": {
          "type": "object",
          "properties": {
            "operationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "receiptId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "proposalId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "operationId",
            "receiptId",
            "proposalId"
          ],
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "properties": {
            "operationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "receiptId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "decisionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "operationId",
            "receiptId",
            "decisionId"
          ],
          "additionalProperties": false
        },
        "embeddings": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operationId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "receiptId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "embeddingRunId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "vectorSpaceVersionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "projectionIds": {
                "minItems": 1,
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              }
            },
            "required": [
              "operationId",
              "receiptId",
              "embeddingRunId",
              "vectorSpaceVersionId",
              "projectionIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "selection",
        "selectionArtifact",
        "preparation",
        "review",
        "embeddings"
      ],
      "additionalProperties": false
    },
    "candidateEvidenceDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evaluatorIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "queries": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "queryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "embedding": {
            "minItems": 1536,
            "maxItems": 1536,
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "queryId",
          "embedding"
        ],
        "additionalProperties": false
      }
    },
    "resultLimit": {
      "default": 20,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "minimumRecallAtK": {
      "default": 1,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "schemaVersion",
    "candidate",
    "candidateEvidenceDigest",
    "evaluatorIdentity",
    "queries",
    "resultLimit",
    "minimumRecallAtK"
  ],
  "additionalProperties": false
}
