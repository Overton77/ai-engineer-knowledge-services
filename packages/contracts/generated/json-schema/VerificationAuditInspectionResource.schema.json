{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verificationContractVersion": {
      "type": "string",
      "const": "verification.v1"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resultArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifactId",
        "digest"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "verification-audit-inspection.v1"
        },
        "verificationContractVersion": {
          "type": "string",
          "const": "verification.v1"
        },
        "auditArtifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "artifactId",
            "digest",
            "mediaType",
            "sizeBytes"
          ],
          "additionalProperties": false
        },
        "run": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "manifestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "manifestDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "deterministicResultDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "policyDecisionDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "policyOutcome": {
              "type": "string",
              "enum": [
                "pass",
                "pass_with_warnings",
                "review",
                "fail",
                "abstain"
              ]
            },
            "startedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "completedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "runId",
            "manifestId",
            "manifestDigest",
            "deterministicResultDigest",
            "policyDecisionDigest",
            "policyOutcome",
            "startedAt",
            "completedAt"
          ],
          "additionalProperties": false
        },
        "proof": {
          "type": "object",
          "properties": {
            "payloadDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "signatureStatus": {
              "type": "string",
              "const": "verified"
            },
            "deterministicReplay": {
              "type": "string",
              "const": "exact"
            },
            "policyReplay": {
              "type": "string",
              "const": "exact"
            },
            "replayedArtifactCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "inputArtifactCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "outputArtifactCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "payloadDigest",
            "signatureStatus",
            "deterministicReplay",
            "policyReplay",
            "replayedArtifactCount",
            "inputArtifactCount",
            "outputArtifactCount"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "verificationContractVersion",
        "auditArtifact",
        "run",
        "proof"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "verificationContractVersion",
    "tenantId",
    "operationId",
    "requestDigest",
    "resultArtifact",
    "output"
  ],
  "additionalProperties": false
}
