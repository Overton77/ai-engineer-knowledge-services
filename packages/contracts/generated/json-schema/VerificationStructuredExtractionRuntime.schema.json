{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deploymentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "capabilityVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "platform": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "containerImageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "code": {
      "type": "object",
      "properties": {
        "gitSha": {
          "anyOf": [
            {
              "type": "string",
              "const": "uncommitted"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
            }
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "dirtyStateArtifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "tenantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "mediaType": {
              "type": "string",
              "minLength": 1
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "downloadHandle": {
              "type": "string",
              "minLength": 1
            },
            "objectKey": {
              "type": "string",
              "minLength": 1
            },
            "contentEncoding": {
              "type": "string",
              "minLength": 1
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "producerActivityId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "producerVersion": {
              "type": "string",
              "minLength": 1
            },
            "encryptionClass": {
              "type": "string",
              "minLength": 1
            },
            "retentionClass": {
              "type": "string",
              "minLength": 1
            },
            "dataClassification": {
              "type": "string",
              "enum": [
                "public",
                "internal",
                "confidential",
                "restricted"
              ]
            },
            "parentArtifactIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "transformationSignature": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "attestationArtifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "artifactId",
            "tenantId",
            "digest",
            "mediaType",
            "byteLength",
            "objectKey",
            "createdAt",
            "producerActivityId",
            "producerVersion",
            "encryptionClass",
            "retentionClass",
            "dataClassification",
            "parentArtifactIds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "gitSha",
        "dirty"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "deploymentId",
    "capabilityVersion",
    "platform",
    "code"
  ],
  "additionalProperties": false
}
