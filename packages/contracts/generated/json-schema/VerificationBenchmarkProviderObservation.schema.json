{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "verification-benchmark-provider-observation.v1"
    },
    "observationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "caseDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "luna_extractor",
        "interfaze_extractor",
        "haiku_judge"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "gateway",
        "interfaze"
      ]
    },
    "model": {
      "type": "string",
      "enum": [
        "openai/gpt-5.6-luna",
        "anthropic/claude-haiku-4.5",
        "interfaze-beta"
      ]
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "rawResponseDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "envelopeDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "output": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "support": {
              "type": "string",
              "enum": [
                "full",
                "partial",
                "none",
                "contradicted"
              ]
            },
            "qualifiers_preserved": {
              "type": "boolean"
            },
            "unsupported_facets": {
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "public_rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "required": [
            "support",
            "qualifiers_preserved",
            "unsupported_facets",
            "public_rationale"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string",
              "const": "verification-semantic-judge.v1"
            },
            "assertionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "verdict": {
              "type": "string",
              "enum": [
                "directly_supported",
                "supported_with_qualification",
                "partially_supported",
                "context_only",
                "contradicted",
                "not_supported",
                "insufficient_evidence"
              ]
            },
            "nliLabel": {
              "type": "string",
              "enum": [
                "entailed",
                "neutral",
                "contradicted"
              ]
            },
            "supportingFragmentIds": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            },
            "contradictingFragmentIds": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            },
            "unsupportedFacets": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "qualifiersPreserved": {
              "type": "boolean"
            },
            "publicRationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "rawProviderConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "schemaVersion",
            "assertionId",
            "verdict",
            "nliLabel",
            "supportingFragmentIds",
            "contradictingFragmentIds",
            "unsupportedFacets",
            "qualifiersPreserved",
            "publicRationale"
          ],
          "additionalProperties": false
        }
      ]
    },
    "promptTokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "completionTokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "actualCostMicros": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "reservationCostMicros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latencyMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "costState": {
      "type": "string",
      "enum": [
        "actual",
        "unknown_dispatched"
      ]
    },
    "runDisposition": {
      "type": "string",
      "enum": [
        "fresh_in_run",
        "recorded_exact_reuse"
      ]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "custody": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "registered",
            "recovered_bytes_original_registration_lost"
          ]
        },
        "sourceReceiptDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "recoveryInventoryDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recoveryWrapperArtifactId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "sourceReceiptDigest",
        "recoveryInventoryDigest",
        "recoveryWrapperArtifactId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "observationDigest",
    "caseId",
    "caseDigest",
    "role",
    "provider",
    "model",
    "requestDigest",
    "rawResponseDigest",
    "envelopeDigest",
    "output",
    "promptTokens",
    "completionTokens",
    "actualCostMicros",
    "reservationCostMicros",
    "latencyMs",
    "costState",
    "runDisposition",
    "capturedAt",
    "custody"
  ],
  "additionalProperties": false
}
