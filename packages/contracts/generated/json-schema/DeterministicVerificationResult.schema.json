{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verificationContractVersion": {
      "type": "string",
      "const": "verification.v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "review_required"
      ]
    },
    "semanticEligibility": {
      "type": "boolean"
    },
    "deploymentSeparation": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "established",
            "not_established"
          ]
        },
        "basis": {
          "type": "string",
          "const": "runtime_principal_binding"
        },
        "producerDeploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "verifierDeploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "status",
        "basis",
        "producerDeploymentId",
        "verifierDeploymentId"
      ],
      "additionalProperties": false
    },
    "captureChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "review_required"
            ]
          },
          "deterministic": {
            "type": "boolean",
            "const": true
          },
          "severity": {
            "type": "string",
            "enum": [
              "hard",
              "review"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "code",
          "status",
          "deterministic",
          "severity",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assertionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "review_required"
            ]
          },
          "semanticEligibility": {
            "type": "boolean"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pending_semantic_review",
              "directly_supported",
              "supported_with_qualification",
              "partially_supported",
              "context_only",
              "contradicted",
              "mixed_or_conflicting",
              "not_supported",
              "insufficient_evidence",
              "unverifiable",
              "source_unavailable",
              "locator_error",
              "parser_error",
              "derived_verified",
              "derived_failed"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidenceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed",
                    "review_required"
                  ]
                },
                "resolution": {
                  "type": "object",
                  "properties": {
                    "captureId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "representationArtifactId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "representationDigest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "selectorDigest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "selectorKind": {
                      "type": "string",
                      "enum": [
                        "text_quote",
                        "character_position",
                        "multi_fragment_text",
                        "json_pointer",
                        "html",
                        "pdf_text",
                        "bounding_box",
                        "table",
                        "media_timecode",
                        "repository",
                        "dataset",
                        "api_record"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "resolved",
                        "not_found",
                        "ambiguous",
                        "invalid",
                        "parse_error"
                      ]
                    },
                    "occurrenceCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "selectedContentDigest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "selectedValue": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "resolvedRanges": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "coordinateSpace": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "start",
                          "end",
                          "coordinateSpace"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "normalization": {
                      "type": "string",
                      "enum": [
                        "none",
                        "lf",
                        "lf_whitespace_collapsed",
                        "casefold_whitespace_filler_removed"
                      ]
                    },
                    "resolverVersion": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "captureId",
                    "representationArtifactId",
                    "representationDigest",
                    "selectorDigest",
                    "selectorKind",
                    "status",
                    "occurrenceCount",
                    "resolvedRanges",
                    "normalization",
                    "resolverVersion"
                  ],
                  "additionalProperties": false
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "passed",
                          "failed",
                          "review_required"
                        ]
                      },
                      "deterministic": {
                        "type": "boolean",
                        "const": true
                      },
                      "severity": {
                        "type": "string",
                        "enum": [
                          "hard",
                          "review"
                        ]
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1
                      },
                      "targetId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      }
                    },
                    "required": [
                      "code",
                      "status",
                      "deterministic",
                      "severity",
                      "detail"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "evidenceId",
                "status",
                "resolution",
                "checks"
              ],
              "additionalProperties": false
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed",
                    "review_required"
                  ]
                },
                "deterministic": {
                  "type": "boolean",
                  "const": true
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "hard",
                    "review"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                },
                "targetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              },
              "required": [
                "code",
                "status",
                "deterministic",
                "severity",
                "detail"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "assertionId",
          "status",
          "semanticEligibility",
          "verdict",
          "evidence",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "review_required"
            ]
          },
          "semanticEligibility": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed",
                    "review_required"
                  ]
                },
                "deterministic": {
                  "type": "boolean",
                  "const": true
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "hard",
                    "review"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                },
                "targetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              },
              "required": [
                "code",
                "status",
                "deterministic",
                "severity",
                "detail"
              ],
              "additionalProperties": false
            }
          },
          "replayedValue": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^-?(?:0|[1-9]\\d{0,63})(?:\\.\\d{1,63})?$"
          }
        },
        "required": [
          "observationId",
          "status",
          "semanticEligibility",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "capturesTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capturesPassed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assertionsTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assertionsPassed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "metricsTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "metricsPassed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedCheckCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "capturesTotal",
        "capturesPassed",
        "assertionsTotal",
        "assertionsPassed",
        "metricsTotal",
        "metricsPassed",
        "failedCheckCodes",
        "reviewReasons"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "verificationContractVersion",
    "status",
    "semanticEligibility",
    "deploymentSeparation",
    "captureChecks",
    "assertions",
    "metrics",
    "summary"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
