{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verificationContractVersion": {
      "type": "string",
      "const": "verification.v1"
    },
    "subjectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "packetArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifactId",
        "digest"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "string",
      "enum": [
        "affirm",
        "reject",
        "defer"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  },
  "required": [
    "verificationContractVersion",
    "subjectId",
    "packetArtifact",
    "decision",
    "rationale"
  ],
  "additionalProperties": false
}
