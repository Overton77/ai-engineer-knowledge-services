{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verificationContractVersion": {
      "type": "string",
      "const": "verification.v1"
    },
    "context": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "v1"
        },
        "verificationContractVersion": {
          "type": "string",
          "const": "verification.v1"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "missionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "workItemId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "causationId": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "human"
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "service"
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "serviceIdentity": {
                  "type": "string",
                  "enum": [
                    "knowledge_api",
                    "knowledge_worker",
                    "acquisition_executor",
                    "conversion_executor",
                    "inspection_agent",
                    "content_curator_agent",
                    "embedding_executor",
                    "retrieval_executor",
                    "evaluation_executor",
                    "human_reviewer",
                    "mission_control_client",
                    "retention_worker",
                    "control_plane"
                  ]
                }
              },
              "required": [
                "kind",
                "id",
                "serviceIdentity"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "model"
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "serviceIdentity": {
                  "type": "string",
                  "enum": [
                    "inspection_agent",
                    "content_curator_agent"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "providerRunId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "id",
                "serviceIdentity",
                "model",
                "providerRunId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "capabilityVersion": {
          "type": "string",
          "minLength": 1
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 255
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "dataClassification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "requestedPolicyVersion": {
          "type": "string",
          "minLength": 1
        },
        "inputArtifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "artifactId",
              "digest"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contractVersion",
        "verificationContractVersion",
        "tenantId",
        "operationId",
        "attemptId",
        "correlationId",
        "actor",
        "capabilityVersion",
        "idempotencyKey",
        "requestedAt",
        "dataClassification",
        "requestedPolicyVersion",
        "inputArtifacts"
      ],
      "additionalProperties": false
    },
    "baselineRunManifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidateRunManifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "paired": {
      "type": "boolean",
      "const": true
    },
    "clusterUnit": {
      "type": "string",
      "enum": [
        "source_family",
        "report_cluster"
      ]
    },
    "confidenceLevel": {
      "type": "number",
      "const": 0.95
    },
    "bootstrapReplicates": {
      "type": "integer",
      "minimum": 100,
      "maximum": 10000
    },
    "correction": {
      "type": "string",
      "enum": [
        "none",
        "holm"
      ]
    }
  },
  "required": [
    "verificationContractVersion",
    "context",
    "baselineRunManifestDigest",
    "candidateRunManifestDigest",
    "paired",
    "clusterUnit",
    "confidenceLevel",
    "bootstrapReplicates",
    "correction"
  ],
  "additionalProperties": false
}
