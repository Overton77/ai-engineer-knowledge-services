{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verificationContractVersion": {
      "type": "string",
      "const": "verification.v1"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "policyOutcome": {
          "type": "string",
          "enum": [
            "pass",
            "pass_with_warnings",
            "review",
            "fail",
            "abstain"
          ]
        },
        "networkPolicy": {
          "type": "string",
          "enum": [
            "disabled",
            "allowlisted",
            "unrestricted"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "policyOutcome",
        "networkPolicy",
        "startedAt",
        "completedAt"
      ],
      "additionalProperties": false
    },
    "policyBinding": {
      "type": "object",
      "properties": {
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "policyArtifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "artifactId",
            "digest",
            "mediaType",
            "sizeBytes"
          ],
          "additionalProperties": false
        },
        "recordedPolicyInputsArtifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "artifactId",
            "digest",
            "mediaType",
            "sizeBytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "policyVersion",
        "policyArtifact",
        "recordedPolicyInputsArtifact"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "inputCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "inputCount",
        "outputCount"
      ],
      "additionalProperties": false
    },
    "calls": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reservedCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimatedCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actualCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actualCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimatedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reservedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknownDispatchedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "count",
        "reservedCostMicros",
        "estimatedCostMicros",
        "actualCostMicros",
        "actualCount",
        "estimatedCount",
        "reservedCount",
        "unknownDispatchedCount"
      ],
      "additionalProperties": false
    },
    "datasetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "datasetVersionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "experimentDefinitionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "variantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "versions": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "grader": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "parser": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "normalizer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "prompt": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "policy",
        "schema",
        "normalizer"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "gitSha",
        "dirty"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "container": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "deploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "platform",
        "deploymentId"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "endpointIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "pricingSnapshotArtifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "artifactId",
            "digest",
            "mediaType",
            "sizeBytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "endpointIdentity",
        "model",
        "pricingSnapshotArtifact"
      ],
      "additionalProperties": false
    },
    "inputArtifacts": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "artifactId",
          "digest",
          "mediaType",
          "sizeBytes"
        ],
        "additionalProperties": false
      }
    },
    "outputArtifacts": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "artifactId",
          "digest",
          "mediaType",
          "sizeBytes"
        ],
        "additionalProperties": false
      }
    },
    "stages": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed",
              "skipped"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "name",
          "status",
          "startedAt",
          "endedAt"
        ],
        "additionalProperties": false
      }
    },
    "randomSeed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "toolPolicy": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "gateDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "replayOfRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "canonicalization": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "RFC8785"
        },
        "implementationVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "implementationVersion",
        "manifestDigest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "verificationContractVersion",
    "tenantId",
    "runId",
    "manifestId",
    "manifestDigest",
    "resultDigest",
    "lifecycle",
    "policyBinding",
    "artifacts",
    "calls",
    "versions",
    "code",
    "runtime",
    "inputArtifacts",
    "outputArtifacts",
    "stages",
    "toolPolicy",
    "canonicalization"
  ],
  "additionalProperties": false
}
