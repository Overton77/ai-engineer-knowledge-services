{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "needs_review",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "statusUrl": {
      "type": "string",
      "format": "uri"
    },
    "eventStreamUrl": {
      "type": "string",
      "format": "uri"
    },
    "cancellationUrl": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "taskId",
    "operationId",
    "state",
    "statusUrl",
    "eventStreamUrl",
    "cancellationUrl"
  ],
  "additionalProperties": false
}
