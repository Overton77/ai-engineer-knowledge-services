{
  "name": "@aiengineer/knowledge-ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic ingestion executor: knowledge-ingestion-intent.v1 → plan → apply through the temporal helpers as executor_service → knowledge-ingestion-receipt.v1.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc --emitDeclarationOnly --rootDir src --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiengineer/knowledge-contracts": "workspace:*",
    "@aiengineer/knowledge-db-read": "workspace:*",
    "@aiengineer/knowledge-domain": "workspace:*",
    "@aiengineer/knowledge-persistence": "workspace:*",
    "@aiengineer/knowledge-schema-workspace": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aiengineer/knowledge-chunking": "workspace:*",
    "@aiengineer/knowledge-documents": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
