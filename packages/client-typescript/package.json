{
  "name": "@aiengineer/knowledge-client",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jev": {
      "types": "./dist/jev.d.ts",
      "import": "./dist/jev.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/jev.ts --format esm && tsc --emitDeclarationOnly --rootDir src --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiengineer/knowledge-contracts": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
