{
  "name": "@aiengineer/knowledge-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "import": "./dist/local.js"
    }
  },
  "scripts": {
    "build": "tsup --entry.index=src/index.ts --entry.config=src/config/index.ts --entry.local=src/local/index.ts --format esm && tsc --emitDeclarationOnly --rootDir src --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiengineer/knowledge-acquisition": "workspace:*",
    "@aiengineer/knowledge-application": "workspace:*",
    "@aiengineer/knowledge-contracts": "workspace:*",
    "@aiengineer/knowledge-core": "workspace:*",
    "@aiengineer/knowledge-persistence": "workspace:*",
    "@aiengineer/knowledge-preparation": "workspace:*",
    "@aiengineer/knowledge-retrieval": "workspace:*",
    "@aiengineer/knowledge-verification": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
