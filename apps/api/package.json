{
  "name": "@aiengineer/knowledge-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiengineer/knowledge-application": "workspace:*",
    "@aiengineer/knowledge-contracts": "workspace:*",
    "@aiengineer/knowledge-embeddings": "workspace:*",
    "@aiengineer/knowledge-domain": "workspace:*",
    "@aiengineer/knowledge-persistence": "workspace:*",
    "@aiengineer/knowledge-runtime": "workspace:*",
    "@aiengineer/knowledge-testkit": "workspace:*",
    "@aiengineer/knowledge-config": "workspace:*",
    "fastify": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
