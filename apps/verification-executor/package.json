{
  "name": "@aiengineer/knowledge-verification-executor",
  "version": "0.1.0",
  "description": "Knowledge executor host: deterministic verification (knowledge-verify), schema workspace + bounded database reads + deterministic ingestion (knowledge). One process, three surfaces: CLI, Streamable HTTP MCP (/mcp), and HTTP routes for sandbox handoff.",
  "private": true,
  "type": "module",
  "exports": {
    "./root-host/v1": "./dist/root-host.js",
    "./scoped-host/v1": "./dist/scoped-host.js",
    "./evidence-reader/v1": {
      "types": "./dist/evidence-reader.d.ts",
      "import": "./dist/evidence-reader.js"
    }
  },
  "bin": {
    "knowledge-verify": "./dist/index.js",
    "knowledge": "./dist/knowledge.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.evidence-reader.json",
    "dev": "tsx src/index.ts",
    "dev:knowledge": "tsx src/knowledge.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "pack:sandbox": "node scripts/pack-sandbox.mjs",
    "examples": "node skills/knowledge-verify/examples/offline.mjs dist/index.js"
  },
  "dependencies": {
    "@aiengineer/database-contract": "file:../../vendor/aiengineer-database-contract-0.4.16.tgz",
    "@aiengineer/knowledge-application": "workspace:*",
    "@aiengineer/knowledge-contracts": "workspace:*",
    "@aiengineer/knowledge-core": "workspace:*",
    "@aiengineer/knowledge-db": "workspace:*",
    "@aiengineer/knowledge-persistence": "workspace:*",
    "@aiengineer/knowledge-policy": "workspace:*",
    "@aiengineer/knowledge-verification": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "pg": "8.16.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aiengineer/knowledge-core": "workspace:*",
    "@aiengineer/knowledge-host": "workspace:*",
    "@aiengineer/knowledge-preparation": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.15.5",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
