ia-label=\"Suggestions\"></ul>\n</span>\n<button class=\"usa-button\" type=\"submit\" formaction=\"https://pmc.ncbi.nlm.nih.gov/search/\" data-ga-category=\"search\" data-ga-action=\"PMC\" data-ga-label=\"PMC_search_button\">\n<span class=\"usa-search__submit-text\">Search in PMC</span>\n<img src=\"https://cdn.ncbi.nlm.nih.gov/pmc/pd-medc-pmc-cloudpmc-viewer/production/9b1d9d87/var/data/static/img/usa-icons-bg/search--white.svg\" class=\"usa-search__submit-icon\" alt=\"Search\" width=\"300\" height=\"150\">\n</button>\n</form>\n            <div class=\"display-flex flex-column tablet:flex-row tablet:flex-justify flex-justify-center flex-align-center width-full desktop:maxw-44\">\n                <ul class=\"pmc-header__search__menu\">\n                    <li>\n                        \n                            <a class=\"usa-link\" href=\"https://pmc.ncbi.nlm.nih.gov/journals/\" data-ga-action=\"featured_link\" data-ga-label=\"journal list\">\n                                Journal List\n                            </a>\n                        \n                    </li>\n                    <li>\n                        \n                            <a class=\"usa-link\" href=\"https://pmc.ncbi.nlm.nih.gov/about/userguide/\" data-ga-action=\"featured_link\" data-ga-label=\"user guide\">\n                                User Guide\n                            </a>\n                        \n                    </li>\n                </ul>\n            </div>\n        </div>\n    </div>\n</section>\n\n    \n\n\n        \n        \n\n       \n  <div class=\"usa-section padding-top-0 desktop:padding-top-6 pmc-article-section\" data-article-db=\"pmc\" data-article-id=\"8853656\">\n\n    \n\n   \n\n\n\n<div class=\"grid-container pmc-actions-bar is-not-intersecting\" aria-label=\"Actions bar\" role=\"complementary\">\n    <div class=\"grid-row\">\n        <div class=\"grid-col-fill display-flex\">\n             <div class=\"display-flex\">\n                <ul clas