":"#text","text":"\n"}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":", "},{"tag":"a","hidden":false,"attributes":{"href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Marioni%20RE%22[Author]","class":"usa-link","aria-describedby":"id30","aria-expanded":"false"},"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Riccardo E Marioni"}]}]},{"tag":"div","hidden":false,"id":"id30","children":[{"tag":"#text","text":"\n"},{"tag":"h3","hidden":false,"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Riccardo E Marioni"}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p"},"children":[{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"8"}]},{"tag":"#text","text":"Institute of Genetics and Cancer, University of Edinburgh, Edinburgh, UK "}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Find articles by "},{"tag":"a","hidden":false,"attributes":{"href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Marioni%20RE%22[Author]","class":"usa-link"},"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Riccardo E Marioni"}]}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"8"}]},{"tag":"#text","text":", "},{"tag":"a","hidden":false,"attributes":{"href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Higgins-Chen%20AT%22[Author]","class":"usa-link","aria-describedby":"id31","aria-expanded":"false"},"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Albert T Higgins-Chen"}]}]},{"tag":"div","hidden":false,"id":"id31","children":[{"tag":"#text","text":"\n"},{"tag":"h3","hidden":false,"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Albert T Higgins-Chen"}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p"},"children":[{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"4"}]},{"tag":"#text","text":"Program in Computational Biology and Bioinformatics, Yale University, New Haven, CT USA "}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p"},"children":[{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"5"}]},{"tag":"#text","text":"Department of Psychiatry, Yale University School of Medicine, New Haven, CT USA "}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p"},"children":[{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"19"}]},{"tag":"#text","text":"Department of Pathology, Yale University School of Medicine, New Haven, CT USA "}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Find articles by "},{"tag":"a","hidden":false,"attributes":{"href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Higgins-Chen%20AT%22[Author]","class":"usa-link"},"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Albert T Higgins-Chen"}]}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"4,"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"5,"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"19"}]},{"tag":"#text","text":", "},{"tag":"a","hidden":false,"attributes":{"href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Smith%20R%22[Author]","class":"usa-link","aria-describedby":"id32","aria-expanded":"false"},"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Ryan Smith"}]}]},{"tag":"div","hidden":false,"id":"id32","children":[{"tag":"#text","text":"\n"},{"tag":"h3","hidden":false,"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Ryan Smith"}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p"},"children":[{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"3"}]},{"tag":"#text","text":"TruDiagnostic, Lexington, KY USA "}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Find articles by "},{"tag":"a","hidden":false,"attributes":{"href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Smith%20R%22[Author]","class":"usa-link"},"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Ryan Smith"}]}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"3"}]},{"tag":"#text","text":", "},{"tag":"a","hidden":false,"attributes":{"href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Lasky-Su%20J%22[Author]","class":"usa-link","aria-describedby":"id33","aria-expanded":"false"},"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Jessica Lasky-Su"}]}]},{"tag":"div","hidden":false,"id":"id33","children":[{"tag":"#text","text":"\n"},{"tag":"h3","hidden":false,"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Jessica Lasky-Su"}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p"},"children":[{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":"Channing Division of Network Medicine, Department of Medicine, Brigham and Women’s Hospital and Harvard Medical School, Boston, MA USA "}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Find articles by "},{"tag":"a","hidden":false,"attributes":{"href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Lasky-Su%20J%22[Author]","class":"usa-link"},"children":[{"tag":"span","hidden":false,"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Jessica Lasky-Su"}]}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"1,"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"✉"}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"},{"tag":"ul","hidden":false,"attributes":{"class":"d-buttons inline-list"},"children":[{"tag":"#text","text":"\n"},{"tag":"li","hidden":false,"children":[{"tag":"button","hidden":false,"attributes":{"class":"d-button","aria-controls":"aip_a","aria-expanded":"false"},"children":[{"tag":"#text","text":"Author information"}]}]},{"tag":"#text","text":"\n"},{"tag":"li","hidden":false,"children":[{"tag":"button","hidden":false,"attributes":{"class":"d-button","aria-controls":"anp_a","aria-expanded":"false"},"children":[{"tag":"#text","text":"Article notes"}]}]},{"tag":"#text","text":"\n"},{"tag":"li","hidden":false,"children":[{"tag":"button","hidden":false,"attributes":{"class":"d-button","aria-controls":"clp_a","aria-expanded":"false"},"children":[{"tag":"#text","text":"Copyright and License information"}]}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"d-panels font-secondary-light"},"children":[{"tag":"#text","text":"\n"},{"tag":"div","hidden":true,"id":"aip_a"},{"tag":"#text","text":"\n"},{"tag":"div","hidden":true,"id":"anp_a"},{"tag":"#text","text":"\n"},{"tag":"div","hidden":true,"id":"clp_a"},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"children":[{"tag":"#text","text":"PMCID: PMC13004675  PMID: "},{"tag":"a","hidden":false,"attributes":{"href":"https://pubmed.ncbi.nlm.nih.gov/41741793/","class":"usa-link"},"children":[{"tag":"#text","text":"41741793"}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"attributes":{"aria-label":"Article content"},"children":[{"tag":"section","hidden":false,"attributes":{"class":"body main-article-body"},"children":[{"tag":"section","hidden":false,"id":"Abs1","attributes":{"class":"abstract"},"children":[{"tag":"h2","hidden":false,"attributes":{"data-anchor-id":"Abs1"},"children":[{"tag":"a","hidden":false,"id":"Abs1-anchor","attributes":{"data-anchor-id":"Abs1","class":"usa-anchor"}},{"tag":"#text","text":"Abstract"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par1","children":[{"tag":"#text","text":"Biological aging reflects complex cellular and biochemical processes that can be measured across multiple omic layers. Using routine clinical laboratory data from ~31,000 participants in the Mass General Brigham Biobank, we developed EMRAge, a biomarker of mortality risk that can be broadly recapitulated across electronic medical records. Here we show that EMRAge can be modeled using elastic net regression with DNA methylation and multi-omics to generate DNAmEMRAge and OMICmAge, respectively. Both biomarkers are strongly associated with incident and prevalent chronic diseases and mortality, performing comparably or better than current biomarkers across discovery (Massachusetts General Brigham Aging Biobank Cohort, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 3,451) and validation cohorts (TruDiagnostic, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 14,213; Generation Scotland, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 18,672). Importantly, OMICmAge leverages epigenetic biomarker proxies to integrate proteomic, metabolomic and clinical domains while remaining quantifiable from DNA methylation alone. This framework establishes an accessible, scalable measure of biological aging with potential to reveal molecular interconnections that shape healthspan and disease risk."}]},{"tag":"#text","text":"\n"},{"tag":"section","hidden":false,"id":"kwd-group1","attributes":{"class":"kwd-group"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Subject terms:"}]},{"tag":"#text","text":" Predictive markers, Predictive markers, Ageing"}]}]}]},{"tag":"section","hidden":false,"id":"Abs2","attributes":{"class":"abstract"},"children":[{"tag":"hr","hidden":false,"attributes":{"class":"headless"}},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par2","children":[{"tag":"#text","text":"Chen et al. present EMRAge, a biological age measure built using electronic medical records, and OMICmAge, a multi-omic signal superimposed on DNA methylation. Both measures show strong associations with disease and mortality in validation cohorts."}]}]},{"tag":"section","hidden":false,"id":"Sec1","children":[{"tag":"h2","hidden":false,"attributes":{"class":"pmc_sec_title","data-anchor-id":"Sec1"},"children":[{"tag":"a","hidden":false,"id":"Sec1-anchor","attributes":{"data-anchor-id":"Sec1","class":"usa-anchor"}},{"tag":"#text","text":"Main"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par3","children":[{"tag":"#text","text":"A major goal of aging research is to define biomarkers of aging that capture interindividual differences in functional decline, chronic disease development and mortality not identified through chronological age alone"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR1","class":"usa-link","aria-describedby":"CR1","aria-expanded":"false"},"children":[{"tag":"#text","text":"1"}]}]},{"tag":"#text","text":". Molecular and clinical data quantify complementary attributes of biological aging. Multiple molecular biomarkers of aging, or ‘clocks’, have been developed as proxies for these hallmarks of aging"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR2","class":"usa-link","aria-describedby":"CR2","aria-expanded":"false"},"children":[{"tag":"#text","text":"2"}]}]},{"tag":"#text","text":". These biomarkers have been based on a variety of measures such as telomere length"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR3","class":"usa-link","aria-describedby":"CR3","aria-expanded":"false"},"children":[{"tag":"#text","text":"3"}]}]},{"tag":"#text","text":", neuroimaging data"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR4","class":"usa-link","aria-describedby":"CR4","aria-expanded":"false"},"children":[{"tag":"#text","text":"4"}]},{"tag":"#text","text":"–"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR7","class":"usa-link","aria-describedby":"CR7","aria-expanded":"false"},"children":[{"tag":"#text","text":"7"}]}]},{"tag":"#text","text":", immune cell counts"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR8","class":"usa-link","aria-describedby":"CR8","aria-expanded":"false"},"children":[{"tag":"#text","text":"8"}]}]},{"tag":"#text","text":" and large-scale omics including DNA methylation (DNAm)"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR2","class":"usa-link","aria-describedby":"CR2","aria-expanded":"false"},"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":","},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR9","class":"usa-link","aria-describedby":"CR9","aria-expanded":"false"},"children":[{"tag":"#text","text":"9"}]},{"tag":"#text","text":"–"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR11","class":"usa-link","aria-describedby":"CR11","aria-expanded":"false"},"children":[{"tag":"#text","text":"11"}]}]},{"tag":"#text","text":", metabolomics"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR12","class":"usa-link","aria-describedby":"CR12","aria-expanded":"false"},"children":[{"tag":"#text","text":"12"}]}]},{"tag":"#text","text":", glycomics"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR13","class":"usa-link","aria-describedby":"CR13","aria-expanded":"false"},"children":[{"tag":"#text","text":"13"}]}]},{"tag":"#text","text":" and proteomics"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR14","class":"usa-link","aria-describedby":"CR14","aria-expanded":"false"},"children":[{"tag":"#text","text":"14"}]},{"tag":"#text","text":"–"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR17","class":"usa-link","aria-describedby":"CR17","aria-expanded":"false"},"children":[{"tag":"#text","text":"17"}]}]},{"tag":"#text","text":"."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par4","children":[{"tag":"#text","text":"Over the last two decades, electronic medical records (EMRs) have been widely used in clinical research, in particular for precision medicine, enabling deep phenotype mining from dense, comprehensive time-dependent data"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR18","class":"usa-link","aria-describedby":"CR18","aria-expanded":"false"},"children":[{"tag":"#text","text":"18"}]}]},{"tag":"#text","text":". These data track longitudinal physiological change and real-time health status. Capitalizing on EMRs provides a unique opportunity to quantify the aging process in a reproducible way across clinical settings. While healthy aging encompasses both quality of life and lifespan, metrics of biological age have traditionally focused on using either clinical data to quantify quality of life"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR19","class":"usa-link","aria-describedby":"CR19","aria-expanded":"false"},"children":[{"tag":"#text","text":"19"}]},{"tag":"#text","text":","},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR20","class":"usa-link","aria-describedby":"CR20","aria-expanded":"false"},"children":[{"tag":"#text","text":"20"}]}]},{"tag":"#text","text":", or mortality risk to quantify lifespan"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR21","class":"usa-link","aria-describedby":"CR21","aria-expanded":"false"},"children":[{"tag":"#text","text":"21"}]}]},{"tag":"#text","text":", resulting in biological phenotypes that are optimized to one of these attributes, while not fully reflecting the other. With the wealth of data available via EMRs, biological aging phenotypes that incorporate both dense clinical data and mortality can be created to synthesize these important attributes of aging into a single measure."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par5","children":[{"tag":"#text","text":"Clinical data are essential in constructing and validating age readouts; connecting them to molecular underpinnings is equally important. Here we combine EMR data with multi-omic profiling to develop a more biologically informed measure of aging. The strong molecular link between DNAm and aging has driven widespread development of DNAm clocks reflecting clinical biomarkers (for example, PhenoAge"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR19","class":"usa-link","aria-describedby":"CR19","aria-expanded":"false"},"children":[{"tag":"#text","text":"19"}]}]},{"tag":"#text","text":"), mortality (for example, GrimAge"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR21","class":"usa-link","aria-describedby":"CR21","aria-expanded":"false"},"children":[{"tag":"#text","text":"21"}]}]},{"tag":"#text","text":") and the rate of aging (for example, DunedinPACE"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR22","class":"usa-link","aria-describedby":"CR22","aria-expanded":"false"},"children":[{"tag":"#text","text":"22"}]}]},{"tag":"#text","text":")."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par6","children":[{"tag":"#text","text":"Proteomics and metabolomics directly reflect biological processes that inform the aging process. The proteome is altered by hallmarks of aging including loss of proteostasis, dysregulated nutrient sensing, altered intercellular communication and cellular senescence"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR23","class":"usa-link","aria-describedby":"CR23","aria-expanded":"false"},"children":[{"tag":"#text","text":"23"}]}]},{"tag":"#text","text":". Although the source of circulating proteins and metabolites is often unclear, individual blood-based proteins and metabolites are established biomarkers for specific organ function (for example, albumin, C-reactive protein and creatinine), while peripheral omic signatures reflect organ-specific changes with aging"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR17","class":"usa-link","aria-describedby":"CR17","aria-expanded":"false"},"children":[{"tag":"#text","text":"17"}]},{"tag":"#text","text":","},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR23","class":"usa-link","aria-describedby":"CR23","aria-expanded":"false"},"children":[{"tag":"#text","text":"23"}]},{"tag":"#text","text":","},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR24","class":"usa-link","aria-describedby":"CR24","aria-expanded":"false"},"children":[{"tag":"#text","text":"24"}]}]},{"tag":"#text","text":". The metabolome not only provides critical information about metabolic processes, but also captures measures of environmental exposures, including xenobiotics, that may be critically linked to the aging process"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR25","class":"usa-link","aria-describedby":"CR25","aria-expanded":"false"},"children":[{"tag":"#text","text":"25"}]},{"tag":"#text","text":","},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR26","class":"usa-link","aria-describedby":"CR26","aria-expanded":"false"},"children":[{"tag":"#text","text":"26"}]}]},{"tag":"#text","text":". Blood metabolomics captures molecules from multiple tissues across the body, providing rich information on aging information that may not be captured in methylation and transcriptomic clocks"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR27","class":"usa-link","aria-describedby":"CR27","aria-expanded":"false"},"children":[{"tag":"#text","text":"27"}]},{"tag":"#text","text":","},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR28","class":"usa-link","aria-describedby":"CR28","aria-expanded":"false"},"children":[{"tag":"#text","text":"28"}]}]},{"tag":"#text","text":"."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par7","children":[{"tag":"#text","text":"Despite the important advantages of other omics, the development of epigenomic, proteomic and metabolomic clocks for biologic aging phenotypes has been limited. Initial work has demonstrated that while individual omics clocks share commonalities, each omic data type provides a distinct window on the aging process"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR29","class":"usa-link","aria-describedby":"CR29","aria-expanded":"false"},"children":[{"tag":"#text","text":"29"}]}]},{"tag":"#text","text":", suggesting that the best and most clinically informative approach would integrate information from multiple omic measurements to create an optimized aging biomarker. However, the integration of multiple omics into a multi-omic clock or to inform DNAm-based readouts remains an area of unfulfilled clinical potential."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par8","children":[{"tag":"#text","text":"To this end, we used ~31,000 participants from the Massachusetts General Brigham (MGB) Biobank to develop and validate three distinct and clinically relevant measures of biological age: (1) EMRAge, a clinically based mortality predictor that can be broadly recapitulated across EMRs; (2) DNAmEMRAge, a DNAm aging biomarker trained to predict EMRAge; and (3) OMICmAge, a multi-omic-informed aging biomarker trained to predict EMRAge, using proteomic, metabolomic and clinical data distilled into DNAm via epigenetic biomarker proxies (EBPs). Overall, these aging biomarkers show strong associations with both incident and prevalent chronic disease outcomes and mortality, while further substantiating the biological relevance and value of integrating multiple omics data into one biological aging biomarker. To validate the findings, we used three independent cohorts—All of Us, TruDiagnostic Biobank and Generation Scotland."}]}]},{"tag":"section","hidden":false,"id":"Sec2","children":[{"tag":"h2","hidden":false,"attributes":{"class":"pmc_sec_title","data-anchor-id":"Sec2"},"children":[{"tag":"a","hidden":false,"id":"Sec2-anchor","attributes":{"data-anchor-id":"Sec2","class":"usa-anchor"}},{"tag":"#text","text":"Results"}]},{"tag":"#text","text":"\n"},{"tag":"section","hidden":false,"id":"Sec3","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Overview of study design"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par9","children":[{"tag":"#text","text":"We developed and validated three aging biomarkers: EMRAge, DNAmEMRAge and OMICmAge. Participants in the MGB Biobank with available plasma and clinical data were used to develop EMRAge ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 31,264; Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig7","class":"usa-link"},"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":"), which was validated using the All of Us cohort ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 10,769). A subset of individuals from the MGB cohort also had available multi-omic data and were used to develop DNAmEMRAge and OMICmAge (Massachusetts General Brigham Aging Biobank Cohort or MGB-ABC; "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 3,451). These aging biomarkers were validated using two independent cohorts—the TruDiagnostic Biobank ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 14,213) and the Generation Scotland ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 18,672; Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig1","class":"usa-link"},"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":"). Additional clinical characteristics and demographics are in Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM2","class":"usa-link"},"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":"."}]},{"tag":"#text","text":"\n"},{"tag":"figure","hidden":false,"id":"Fig7","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h4","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Extended Data Fig. 1. Flowchart for inclusion of participants from the Massachusetts General Brigham (MGB) Biobank for the development of "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"EMRAge, DNAmEMRAge and OMICmAge."}]},{"tag":"#text","text":"\n"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig7_ESM.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e2639","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/47f0d821ca5f/43587_2026_1073_Fig7_ESM.jpg","loading":"lazy","height":"807","width":"722","alt":"Extended Data Fig. 1"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig7/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Among 60,370 MGB Biobank participants with plasma samples, 59,213 adults with verified vital status were retained after excluding individuals under 18 years and those with missing survival data. After exclusion of participants with missing non-imputable clinical variables, 29,222 individuals with complete data on 27 clinical phenotypes remained. These were encoded into 43 features, of which 19 significantly associated with mortality were selected to construct EMRAge, yielding a final cohort of 31,264 participants (training "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 21,885; test "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 9,379). A subset with available DNA methylation and proteomic data ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 3,451) was used to develop DNAmEMRAge and OMICmAge (training "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 2,762; test "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 689). An independent subset with available PhenoAge ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 17,252) was used for comparative analyses."}]}]}]},{"tag":"figure","hidden":false,"id":"Fig1","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h4","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Fig. 1. Overall study design."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig1_HTML.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e815","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/6f42f71a3560/43587_2026_1073_Fig1_HTML.jpg","loading":"lazy","height":"1035","width":"735","alt":"Fig. 1"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig1/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"a"}]},{"tag":"#text","text":", Workflow of the study. "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"b"}]},{"tag":"#text","text":", Description of the study population. TruD, TruDiagnostic. GS, Generation Scotland."}]}]}]}]},{"tag":"section","hidden":false,"id":"Sec4","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Development of EMRAge"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par10","children":[{"tag":"#text","text":"We filtered 60,370 individuals and 28 clinical phenotypes (43 clinical variables; Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM3","class":"usa-link"},"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":") from the MGB Biobank down to 31,264 individuals with complete data on 19 clinical variables that were used to develop EMRAge (Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig7","class":"usa-link"},"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":"). We split the cohort by 70:30 into training and testing sets. A Cox proportional-hazards model was fitted in the training set to estimate the weightings of the 19 selected clinical variables (Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM4","class":"usa-link"},"children":[{"tag":"#text","text":"3"}]},{"tag":"#text","text":"). In a manner analogous to the GrimAge approach"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR21","class":"usa-link","aria-describedby":"CR21","aria-expanded":"false"},"children":[{"tag":"#text","text":"21"}]}]},{"tag":"#text","text":", we converted the linear combination of estimated weights and predictor values into an ‘age’ metric. The Pearson correlation coefficient ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":") between EMRAge and chronological age was 0.76 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 0.001) in the testing set and 0.75 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 0.001) in the training set (Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig8","class":"usa-link"},"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":"). We validated the EMRAge predictors by retraining the algorithm at four time points in 2-year increments: 1 January 2008, 2010, 2012 and 2014. The four derived equations were then applied to participants ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 11,673) on 1 January 2016. The Pearson correlations among these estimates were ~1, affirming robustness (Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig2","class":"usa-link"},"children":[{"tag":"#text","text":"2a"}]},{"tag":"#text","text":"). We then assessed the association between EMRAge, PhenoAge and chronological age with aging-related health outcomes, including all-cause mortality, stroke, type 2 diabetes, chronic obstructive pulmonary disease (COPD), depression, cardiovascular disease (CVD) and any type of cancer. All association tests were adjusted for age (if using EMRAge or PhenoAge), sex, race, smoking status and alcohol consumption. The prospective association analysis in the testing set shows that EMRAge has the largest hazard ratios (HRs) for all-cause mortality (HR = 4.53, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 4.42 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−129"}]},{"tag":"#text","text":"), stroke (HR = 2.00, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.20"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−22"}]},{"tag":"#text","text":"), COPD (HR = 2.21, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 4.01"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−15"}]},{"tag":"#text","text":") and cancer (HR = 2.22, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 2.00 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−27"}]},{"tag":"#text","text":") and demonstrates comparable HRs for type 2 diabetes (HR = 2.05, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 2.07 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−19"}]},{"tag":"#text","text":"), depression (HR = 1.59, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 3.89 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−12"}]},{"tag":"#text","text":") and CVD (HR = 1.99, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 7.27 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−32"}]},{"tag":"#text","text":") when compared to PhenoAge (HR = 2.26, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.03 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−18"}]},{"tag":"#text","text":"; HR = 1.67, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 3.33 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−10"}]},{"tag":"#text","text":"; HR = 2.00 "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.00 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−20"}]},{"tag":"#text","text":", respectively; Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig2","class":"usa-link"},"children":[{"tag":"#text","text":"2b"}]},{"tag":"#text","text":" and Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM5","class":"usa-link"},"children":[{"tag":"#text","text":"4"}]},{"tag":"#text","text":"). All associations were significant with a false discovery rate (FDR) threshold of 0.05 after adjusting for multiple testing. Kaplan–Meier plots show that EMRAge provides the best divergence of survival probabilities among ‘age’ groups, compared to PhenoAge and chronological age (Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig2","class":"usa-link"},"children":[{"tag":"#text","text":"2c"}]},{"tag":"#text","text":"). Additionally, a comparative analysis including both EMRAge and PhenoAge into the same model revealed that EMRAge consistently shows higher HRs for the aging-related incident outcomes (Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig2","class":"usa-link"},"children":[{"tag":"#text","text":"2d"}]},{"tag":"#text","text":" and Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM6","class":"usa-link"},"children":[{"tag":"#text","text":"5"}]},{"tag":"#text","text":")."}]},{"tag":"#text","text":"\n"},{"tag":"figure","hidden":false,"id":"Fig8","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h4","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Extended Data Fig. 2. Pearson’s correlation between "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"EMRAge"}]},{"tag":"#text","text":" and chronological age in the MGB test and train sets."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"img","hidden":false,"id":"d33e2654","attributes":{"class":"graphic","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/44bb77218e68/43587_2026_1073_Fig8_ESM.jpg","loading":"lazy","height":"427","width":"702","alt":"Extended Data Fig. 2"}}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig8/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The Pearson correlation coefficient (ρ) was tested for significance using a two-sided t-test. The resulting P-values in both the MGB test and train sets were highly significant (P < 2.22E − 308)."}]}]}]},{"tag":"figure","hidden":false,"id":"Fig2","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h4","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Fig. 2. Development, robustness and comparators of EMRAge."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig2_HTML.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e1017","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/20597026008e/43587_2026_1073_Fig2_HTML.jpg","loading":"lazy","height":"597","width":"721","alt":"Fig. 2"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig2/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"a"}]},{"tag":"#text","text":", Pairwise correlation (Corr) between four different estimates of EMRAge at the following time points: 1 January 2008, 2010, 2012 and 2014. ***"},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 0.001. "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"b"}]},{"tag":"#text","text":", HRs and confidence intervals (CIs) of a 1-s.d. change to onset of aging-related diseases. These values were estimated in a subset of the testing dataset from the MGB Cohort, in which PhenoAge is available ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 5,171). The models were adjusted for chronological age (if EMRAge or PhenoAge), sex, race, body mass index (BMI), smoking status and alcohol consumption. "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"c"}]},{"tag":"#text","text":", Kaplan–Meier plot of EMRAge versus PhenoAge versus chronological age in the testing dataset. Error bands show the 95% CIs for the estimated survival probabilities in each age group. "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"d"}]},{"tag":"#text","text":", Forest plot of HRs and ORs per s.d. change of EMRAge or PhenoAge for aging-related health outcomes when both variables are included as predictors in a single model, without additional adjustment for covariates. Error bars show the 95% CIs of the estimated HRs/ORs. The number of incident cases ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":") and sample sizes ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":") for each phenotype are as follows. Incident cases: all-cause mortality, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 5,171 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 496); stroke, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 4,794 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 443); type 2 diabetes, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 4,072 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 339); COPD, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 4,642 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 217); depression, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 3,549 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 523); CVD (excluding stroke), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 3,040 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 699); cancer, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 4,172 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 385). Prevalent cases: The total sample size for prevalent diseases is 5,171, with the following case numbers; stroke, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 377; type 2 diabetes, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 1,099; COPD, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 529; depression, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 1,622; CVD (excluding stroke), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 2,131; cancer, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 999."}]}]}]}]},{"tag":"section","hidden":false,"id":"Sec5","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Validation of EMRAge"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par11","children":[{"tag":"#text","text":"We validated EMRAge using data from the All of Us Research Program (CDR version 8). Median imputation of missing lab values occurred within ±1 year of enrollment. Following imputation, the cohort comprised 10,769 adult participants with complete data for both EMRAge and PhenoAge calculation. Among these participants, 378 (3.5%) were recorded as deceased by 1 October 2023. Demographic characteristics are detailed in Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM2","class":"usa-link"},"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":". We then performed association analyses between EMRAge, PhenoAge or chronological age with aging-related diseases. All association tests were adjusted for the same set of covariates as previously described. Our prospective analysis (Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig9","class":"usa-link"},"children":[{"tag":"#text","text":"3a"}]},{"tag":"#text","text":" and Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM7","class":"usa-link"},"children":[{"tag":"#text","text":"6"}]},{"tag":"#text","text":") revealed that EMRAge demonstrated the strongest association with all-cause mortality (HR = 3.08 (per s.d., same below), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 4.97 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"74"}]},{"tag":"#text","text":"). Similarly, our cross-sectional analysis (Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig9","class":"usa-link"},"children":[{"tag":"#text","text":"3a"}]},{"tag":"#text","text":" and Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM8","class":"usa-link"},"children":[{"tag":"#text","text":"7"}]},{"tag":"#text","text":") indicated that EMRAge exhibited the strongest associations with multiple prevalent aging-related diseases, including stroke (odds ratio (OR) = 1.08, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 3.14 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−62"}]},{"tag":"#text","text":"), COPD (OR = 1.10, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 3.16 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−96"}]},{"tag":"#text","text":"), depression (OR = 1.07, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.48 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−27"}]},{"tag":"#text","text":") and cancer (OR = 1.10, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 7.32 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−90"}]},{"tag":"#text","text":"), when compared to PhenoAge and chronological age. Furthermore, in a joint analysis including both EMRAge and PhenoAge in the same model (Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig9","class":"usa-link"},"children":[{"tag":"#text","text":"3b"}]},{"tag":"#text","text":"), EMRAge showed a stronger association with all-cause mortality in the prospective analysis (HR = 2.40, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 9.08 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"22"}]},{"tag":"#text","text":"; Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM9","class":"usa-link"},"children":[{"tag":"#text","text":"8"}]},{"tag":"#text","text":"). The cross-sectional analysis from this joint model (Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM10","class":"usa-link"},"children":[{"tag":"#text","text":"9"}]},{"tag":"#text","text":") further demonstrated that EMRAge exhibited stronger associations, as illustrated in Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig9","class":"usa-link"},"children":[{"tag":"#text","text":"3b"}]},{"tag":"#text","text":"."}]},{"tag":"#text","text":"\n"},{"tag":"figure","hidden":false,"id":"Fig9","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h4","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Extended Data Fig. 3. Comparison of EMRAge and PhenoAge in association with aging-related health outcomes in the All of Us cohort."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig9_ESM.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e2678","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/08f9a3f05526/43587_2026_1073_Fig9_ESM.jpg","loading":"lazy","height":"764","width":"722","alt":"Extended Data Fig. 3"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig9/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The analysis compares associations from individual ("},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"a"}]},{"tag":"#text","text":") and joint ("},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"b"}]},{"tag":"#text","text":") perspectives. Error bars show hazard/odds ratios and 95% confidence intervals per one-standard deviation change from the estimated mean value. For individual analysis, each aging metric (EMRAge, PhenoAge, or chronological age) was tested separately, adjusting for sex, race, BMI, smoking status, and alcohol consumption. Chronological age was also adjusted for when testing EMRAge or PhenoAge. For joint analysis, both EMRAge and PhenoAge were included as predictors in a single model, without additional adjustment. The number of cases (n) and sample sizes (N) for each phenotype are as follows: "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Incident Cases"}]},{"tag":"#text","text":": all-cause mortality, N = 10,769 (n = 378); stroke, N = 9,285 (n = 548); type-2 diabetes, N = 6,946 (n = 503); COPD, N = 8,878 (n = 402); Depression, N = 6,226 (n = 639); CVD (excl. stroke), N = 4,734 (n = 658); cancer, N = 8,942 (n = 380). "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Prevalent Cases"}]},{"tag":"#text","text":": The total sample size for prevalent diseases is 10,769, with the following case numbers: stroke, n = 1,484; type-2 diabetes, n = 3,823; COPD, n = 1,891; Depression, n = 4,543; CVD (excl. stroke), n = 6,035; cancer, n = 1,827."}]}]}]}]},{"tag":"section","hidden":false,"id":"Sec6","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Development of DNAmEMRAge"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par12","children":[{"tag":"#text","text":"After developing the EMRAge measure, we created a DNAm surrogate predictor of EMRAge, DNAmEMRAge, using DNAm data in an elastic net regression model (alpha = 0.1) to select the CpG sites that are most predictive of EMRAge. The model for DNAmEMRAge included 1,097 CpG sites and age as predictors. A 25-fold cross-validation selected an optimal lambda value with "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"R"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 0.827 between the observed and predicted values, suggesting good concordance in prediction. To further assess agreement, the data were resampled to identify a training set composed of samples used to generate the model and samples not in the model ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 2,762). Within the training data, DNAmEMRAge and EMRAge values showed high correlation (Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig3","class":"usa-link"},"children":[{"tag":"#text","text":"3a"}]},{"tag":"#text","text":"; "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 2,762, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"R"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 0.82, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 2.2 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−16"}]},{"tag":"#text","text":", "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.91, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 2.2 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−16"}]},{"tag":"#text","text":"). A test dataset showed comparable correlations ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 689, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"R"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 0.83, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 2.2 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−16"}]},{"tag":"#text","text":", "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.91, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 2.2 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−16"}]},{"tag":"#text","text":"; Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig3","class":"usa-link"},"children":[{"tag":"#text","text":"3b"}]},{"tag":"#text","text":"). The mean absolute error between DNAmEMRAge and EMRAge is 8.33 years in the training set and 8.50 years in the testing set, and the intraclass correlation coefficient (ICC) was 0.995 (Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig3","class":"usa-link"},"children":[{"tag":"#text","text":"3c"}]},{"tag":"#text","text":")."}]},{"tag":"#text","text":"\n"},{"tag":"figure","hidden":false,"id":"Fig3","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h4","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Fig. 3. Correlation plots to EMRAge and ICCs for DNAmEMRAge and OMICmAge."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig3_HTML.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e1245","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/eda812b77fc4/43587_2026_1073_Fig3_HTML.jpg","loading":"lazy","height":"379","width":"721","alt":"Fig. 3"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig3/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The two-sided "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"t"}]},{"tag":"#text","text":"-test was used to test the significance of the Pearson correlation coefficient ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":"). "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"a"}]},{"tag":"#text","text":", Correlation ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.906, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value < 2.22 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−308"}]},{"tag":"#text","text":") between DNAmEMRAge and EMRAge in the training set ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 2,762). "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"b"}]},{"tag":"#text","text":", Correlation ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.913, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value = 6.26 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−269"}]},{"tag":"#text","text":") between DNAmEMRAge and EMRAge in the testing set ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 689). "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"c"}]},{"tag":"#text","text":", ICCs ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.995, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value = 1.45 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−29"}]},{"tag":"#text","text":") for DNAmEMRAge using 30 replicates. "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"d"}]},{"tag":"#text","text":", Correlation ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.911, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value < 2.22 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"308"}]},{"tag":"#text","text":") between OMICmAge and EMRAge in the training set ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 2,762). "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"e"}]},{"tag":"#text","text":", Correlation ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.915, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value = 5.02 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−273"}]},{"tag":"#text","text":") between OMICmAge and EMRAge in the testing set ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 689). "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"f"}]},{"tag":"#text","text":", ICCs ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.998, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value = 3.96 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−35"}]},{"tag":"#text","text":") for OMICmAge using 30 replicates."}]}]}]}]},{"tag":"section","hidden":false,"id":"Sec7","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Development of OMICmAge"}]},{"tag":"#text","text":"\n"},{"tag":"section","hidden":false,"id":"Sec8","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Metabolomic, proteomic and clinical EBPs"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par13","children":[{"tag":"#text","text":"Untargeted global plasma metabolomic profiling was performed on the Metabolon platform. After preprocessing and scaling, the final metabolomic dataset consisted of 1,459 metabolites, covering a broad range of metabolic pathways (Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig10","class":"usa-link"},"children":[{"tag":"#text","text":"4"}]},{"tag":"#text","text":") across 1,986 individuals, among whom 1,691 were matched to methylation data. Global proteomic data were generated using the Seer SP100 platform, based on liquid chromatography–mass spectrometry (LC–MS). The final processed dataset consisted of 2,098 nonunique annotated proteins and 536 unique protein groups (denoted as ‘proteins’) across 1,789 individuals, among whom 1,475 were matched with methylation data. We further considered 46 clinical variables that have potential relationships with aging and aging-related outcomes. As implemented in the development of other aging biomarkers"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR21","class":"usa-link","aria-describedby":"CR21","aria-expanded":"false"},"children":[{"tag":"#text","text":"21"}]}]},{"tag":"#text","text":", we restricted the number of EBPs for inclusion by selecting proteins and clinical variables with a significant Pearson correlation to EMRAge greater than 0.1 and a nominal "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value < 0.05 (Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM11","class":"usa-link"},"children":[{"tag":"#text","text":"10"}]},{"tag":"#text","text":"). To select metabolites highly correlated with EMRAge while minimizing interdependence among the selected metabolites, we used hierarchical clustering. This process grouped the metabolites into 286 clusters characterized by low intercluster correlation (that is, the 90th percentile of average intercorrelations between clusters was below 0.15) and high intra-cluster correlation (that is, the 10th percentile of average intra-correlations within clusters was above 0.5). Subsequently, we selected the metabolite exhibiting the strongest correlation with EMRAge from each cluster. Following this strategy, 286 metabolites, 110 proteins and 25 clinical variables were retained (Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig4","class":"usa-link"},"children":[{"tag":"#text","text":"4"}]},{"tag":"#text","text":"). We then generated epigenetic predictors (that is, EBPs) for each selected metabolite, protein and clinical variable—via an elastic net regression model. We retained all EBPs with a nominal "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 0.05) and a Pearson correlation above 0.2 with their estimated metabolite/protein/clinical value. We observed strong correlations between several of the selected EBPs and actual clinical values (for example, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.66 and 0.63 for C-reactive protein and HbA1C EBPs, respectively). In total, 266 metabolite EBPs, 109 protein EBPs and 21 clinical EBPs were retained, totaling 396 EBPs that were included as features in the predictive model for OMICmAge (Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM12","class":"usa-link"},"children":[{"tag":"#text","text":"11"}]},{"tag":"#text","text":"). OMICmAge was then generated by integrating proteomic, metabolomic and clinical data EBPs into a DNAm clock."}]},{"tag":"#text","text":"\n"},{"tag":"figure","hidden":false,"id":"Fig10","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h5","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Extended Data Fig. 4. Metabolite EBPs by super pathway and sub pathways."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig10_ESM.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e2689","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/10ffb1210fba/43587_2026_1073_Fig10_ESM.jpg","loading":"lazy","height":"457","width":"719","alt":"Extended Data Fig. 4"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig10/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Distribution of super pathways (a) and sub pathways for all the metabolites (b). A total of 1,459 metabolites were categorized into nine super-pathways and sixty-three sub-pathways. The number of metabolites in each category is displayed above the respective bars."}]}]}]},{"tag":"figure","hidden":false,"id":"Fig4","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h5","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Fig. 4. Illustration of the filtration process for DNAm-based multi-omic features used in the development of OMICmAge."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig4_HTML.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e1335","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/ff56229bc81b/43587_2026_1073_Fig4_HTML.jpg","loading":"lazy","height":"1228","width":"639","alt":"Fig. 4"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig4/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"a"}]},{"tag":"#text","text":", Diagram describing the filtration and selection of EBPs included in the OMICmAge model. "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"b"}]},{"tag":"#text","text":", Histograms show the full distributions of feature-wise Pearson correlations to EMRAge for three data modalities: 2,098 proteins, 1,459 metabolites (collapsed to 286 clusters via hierarchical clustering) and 46 clinical variables. Gray bars represent the unfiltered ‘background’ for each modality. Colored overlays (green indicates protein EBP, orange indicates metabolite EBP, and black indicates clinical EBP) show the subset of features meeting our a priori filter ( | "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" | > 0.1 and "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value < 0.05), yielding 421 total features (protein, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 110; metabolite, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 286; clinical, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 25). "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"c"}]},{"tag":"#text","text":", Of the 421 EMRAge-correlated candidates, we next required that predicted epigenetic biomarkers (EBPs) also correlate with their measured counterparts at Pearson "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" > 0.2 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value < 0.05). Histograms again show the EMRAge-selected background distributions in gray, with colored overlays (green, protein; orange, metabolite; black, clinical) indicating the features that passed this second filter (protein, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 109; metabolite, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 266; clinical, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 21). Pearson correlation coefficients for each multi-omic feature and EBP are reported in Supplementary Tables "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM11","class":"usa-link"},"children":[{"tag":"#text","text":"10"}]},{"tag":"#text","text":" and "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM12","class":"usa-link"},"children":[{"tag":"#text","text":"11"}]},{"tag":"#text","text":"."}]}]}]}]}]},{"tag":"section","hidden":false,"id":"Sec9","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Predictive model for the OMICmAge"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par14","children":[{"tag":"#text","text":"OMICmAge was generated via a penalized elastic net regression model of EMRAge that included methylation CpG values, relative percentages of 12 immune cell subsets, 396 EBPs, age and sex as features in the model. This model retained 990 CpGs, 40 EBPs (16 protein EBPs, 14 metabolite EBPs and 10 clinical EBPs; Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig4","class":"usa-link"},"children":[{"tag":"#text","text":"4"}]},{"tag":"#text","text":") and age as selected predictors of EMRAge with varying weightings in the final model. The model did not retain any of the immune cell subsets after penalization. We tested an independent model including them as unpenalized features, but results did not change substantially. Thus, we continued with the model where all the features were penalized. Figure "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig3","class":"usa-link"},"children":[{"tag":"#text","text":"3d–f"}]},{"tag":"#text","text":" shows the correlation between EMRAge and OMICmAge in the training ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 2,762, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"R"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 0.83, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 2.2 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−16"}]},{"tag":"#text","text":"; "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.91, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 2.2 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−16"}]},{"tag":"#text","text":") and testing ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 689, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"R"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 0.84, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 2.2 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−16"}]},{"tag":"#text","text":"; "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" = 0.92, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 2.2 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−16"}]},{"tag":"#text","text":") sets, as well as the ICCs using 30 replicates (0.998). In terms of error, the mean absolute error between OMICmAge and EMRAge was 4.96 years in the training set and 4.97 years in the testing set, lower than the mean absolute error for DNAmEMRAge (8.33 and 8.50, respectively)."}]},{"tag":"#text","text":"\n"},{"tag":"section","hidden":false,"id":"Sec10","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Comparison of OMICmAge to previous epigenetic biomarkers of aging"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par15","children":[{"tag":"#text","text":"We compared DNAmEMRAge and OMICmAge to previous epigenetic aging biomarkers, including DunedinPACE"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR22","class":"usa-link","aria-describedby":"CR22","aria-expanded":"false"},"children":[{"tag":"#text","text":"22"}]}]},{"tag":"#text","text":" and the principal component (PC) versions of PCHorvath"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR10","class":"usa-link","aria-describedby":"CR10","aria-expanded":"false"},"children":[{"tag":"#text","text":"10"}]}]},{"tag":"#text","text":", PCHannum"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR11","class":"usa-link","aria-describedby":"CR11","aria-expanded":"false"},"children":[{"tag":"#text","text":"11"}]}]},{"tag":"#text","text":", PCPhenoAge"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR19","class":"usa-link","aria-describedby":"CR19","aria-expanded":"false"},"children":[{"tag":"#text","text":"19"}]}]},{"tag":"#text","text":" and PCGrimAge"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR21","class":"usa-link","aria-describedby":"CR21","aria-expanded":"false"},"children":[{"tag":"#text","text":"21"}]}]},{"tag":"#text","text":" for their improved precision"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR30","class":"usa-link","aria-describedby":"CR30","aria-expanded":"false"},"children":[{"tag":"#text","text":"30"}]}]},{"tag":"#text","text":". We compared the CpG sites included in the predictive model, and their relationship with immune cell subsets, aging-related disease outcomes and five- and ten-year mortality. Overall, we observed consistent correlations between all epigenetic clocks and immune subsets. We observed stronger correlations with sex for both OMICmAge and DNAmEMRAge ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"R"}]},{"tag":"#text","text":" = 0.28, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value = 0.02, and "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"R"}]},{"tag":"#text","text":" = 0.36, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" value = 0.009, respectively) when compared to previous aging biomarkers (Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig11","class":"usa-link"},"children":[{"tag":"#text","text":"5"}]},{"tag":"#text","text":"). There was minimal overlap between the CpG sites retained in DNAmEMRAge and OMICmAge and prior aging biomarkers (Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig5","class":"usa-link"},"children":[{"tag":"#text","text":"5a"}]},{"tag":"#text","text":"); DNAmEMRAge and OMICmAge had 660 and 657 unique CpG sites, respectively, with 411 CpG sites shared between these measures. While PhenoAge and Horvath biomarkers share 50 CpG sites and Horvath and Hannum share 29, the maximum number of probes shared between OMICmAge and any previous aging biomarker is 3."}]},{"tag":"#text","text":"\n"},{"tag":"figure","hidden":false,"id":"Fig11","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h5","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Extended Data Fig. 5. Correlation plots between DNAm-based aging biomarkers and immune cell fractions in the MGB-ABC and TruDiagnostic Biobank cohorts."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig11_ESM.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e2711","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/55226d788ce5/43587_2026_1073_Fig11_ESM.jpg","loading":"lazy","height":"510","width":"722","alt":"Extended Data Fig. 5"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig11/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"a"}]},{"tag":"#text","text":") Discovery cohort - MGB-ABC biobank. "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"b"}]},{"tag":"#text","text":") Validation cohort - TruDiagnostic Biobank. Each column represents a covariate, including age, sex (male/female), and immune cell fractions. The size is adjusted to the magnitude of the correlation and the color to the direction (positive or negative). *: p-value < 0.05, **: p-value < 0.01, ***: p-value < 0.001. All Pearson correlation coefficients and associated P-values are included in the Source Data."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM24","class":"usa-link"},"children":[{"tag":"#text","text":"Source data"}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"figure","hidden":false,"id":"Fig5","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h5","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Fig. 5. Comparison of OMICmAge and DNAmEMRAge to previously established aging biomarkers."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig5_HTML.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e1522","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/275114433ed5/43587_2026_1073_Fig5_HTML.jpg","loading":"lazy","height":"1079","width":"679","alt":"Fig. 5"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig5/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"a"}]},{"tag":"#text","text":", Intersection of predictive CpG sites included in the previously published epigenetic clocks, DNAmEMRAge and OMICmAge. The horizontal bars represent the total number of CpG sites included in each epigenetic aging biomarker. The vertical bars represent the number of unique or shared CpG sites between clocks. PhenoAge refers to the DNAm version. "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"b"}]},{"tag":"#text","text":", Horizontal error bar plot of ORs/HRs of each methylation biomarker and chronological age to aging-related diseases in the testing set of the MGB-ABC cohort. The ratios and 95% CIs are based on a 1-s.d. change around the estimated mean values from the statistical models. The number of cases ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":") and sample sizes ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":") for each phenotype are as follows. Incident cases: all-cause mortality, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 662 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 83); stroke, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 616 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 45); type 2 diabetes, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 428 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 52); COPD, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 485 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 39); depression, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 361 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 52); CVD (excluding stroke), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 287 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 82); cancer, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 524 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 68). Prevalent cases: The total sample size for prevalent diseases is 689, with the following case numbers; stroke, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 73; type 2 diabetes, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 261; COPD, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 204; depression, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 328; CVD (excluding stroke), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 402; cancer, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 162. "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"c"}]},{"tag":"#text","text":", Receiver operating characteristic curves comparing 5-year and 10-year survival predictions based on DNAm aging biomarkers and chronological age within the MGB-ABC cohort. Individual lines denote specific biomarkers."}]}]}]},{"tag":"p","hidden":false,"id":"Par16","children":[{"tag":"#text","text":"To estimate OMICmAge, we use the 990 CpG sites retained in the model and the 40 EBPs, which require 10,315 additional CpG sites. Remarkably, 50.8% of them (5,740) are available on the 450 K array. A version for 450 K is in development."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par17","children":[{"tag":"#text","text":"We compared the prevalence and incidence of aging-related disease associations between OMICmAge, DNAmEMRAge and other aging biomarkers in MGB-ABC (Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig5","class":"usa-link"},"children":[{"tag":"#text","text":"5b"}]},{"tag":"#text","text":" and Supplementary Tables "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM13","class":"usa-link"},"children":[{"tag":"#text","text":"12"}]},{"tag":"#text","text":" and "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM14","class":"usa-link"},"children":[{"tag":"#text","text":"13"}]},{"tag":"#text","text":"). For prevalent disease associations, OMICmAge had the highest ORs for four of six aging-related chronic diseases assessed, with particularly high ORs for type 2 diabetes (OR = 5.04, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.37 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−15"}]},{"tag":"#text","text":") and CVD (OR = 4.62, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 3.56 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−12"}]},{"tag":"#text","text":"). The association between PCGrimAge and COPD (OR = 3.97, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 6.90 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−6"}]},{"tag":"#text","text":") was also particularly high. OMICmAge also had the highest ORs for stroke (OR = 2.21, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.4 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−4"}]},{"tag":"#text","text":") and depression (HR = 1.94, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 9.77 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−5"}]},{"tag":"#text","text":") and chronological age had the highest OR for cancer (OR = 2.40, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 4.85 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−13"}]},{"tag":"#text","text":"). However, the differences between several of the strongest aging biomarkers were all within the CIs. All these associations were significant after adjusting for multiple testing (FDR "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"Q"}]},{"tag":"#text","text":" value ≤ 0.05). For incident disease associations, we also observed that OMICmAge had the highest HRs for type 2 diabetes (HR = 2.68, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 6.14 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−4"}]},{"tag":"#text","text":"), CVD (HR = 3.28, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 4.85 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−6"}]},{"tag":"#text","text":") and all-cause mortality (HR = 11.31, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 2.65 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"23"}]},{"tag":"#text","text":"), which all met FDR significance ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"Q"}]},{"tag":"#text","text":" value ≤ 0.05). PCGrimAge, PCPhenoAge and chronological age were also FDR significant for CVD, while chronological age was the only measure that was significant for stroke (HR = 1.85, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 9.59 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−4"}]},{"tag":"#text","text":"). No aging biomarkers were significantly associated with the incidence of depression, COPD or cancer."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par18","children":[{"tag":"#text","text":"We conducted similar analyses in the Generation Scotland cohort (Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig12","class":"usa-link"},"children":[{"tag":"#text","text":"6b"}]},{"tag":"#text","text":" and Supplementary Tables "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM15","class":"usa-link"},"children":[{"tag":"#text","text":"14"}]},{"tag":"#text","text":" and "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM16","class":"usa-link"},"children":[{"tag":"#text","text":"15"}]},{"tag":"#text","text":"). While chronological age showed the strongest associations with all-cause mortality (HR = 5.58, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 1 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"99"}]},{"tag":"#text","text":"), incident stroke (HR = 4.10, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.64 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"88"}]},{"tag":"#text","text":") and cancer (HR = 2.76, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 9.15 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"192"}]},{"tag":"#text","text":"), OMICmAge generally ranked second after PCGrimAge (except cancer). OMICmAge also ranked among the top two aging biomarkers for incident type 2 diabetes (HR = 4.18, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 5.75 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"25"}]},{"tag":"#text","text":"), CVD (HR = 4.14, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 2.46 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"21"}]},{"tag":"#text","text":") and COPD (HR = 1.97, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.90 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"10"}]},{"tag":"#text","text":"). Notably, OMICmAge exhibited the strongest association with incident depression (HR = 3.14, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.52 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"5"}]},{"tag":"#text","text":"). For prevalent disease associations, OMICmAge was also among the top two aging biomarkers by OR estimates, following PCGrimAge. However, no aging biomarkers were significantly associated with prevalent stroke after adjusting for chronological age and other covariates."}]},{"tag":"#text","text":"\n"},{"tag":"figure","hidden":false,"id":"Fig12","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h5","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Extended Data Fig. 6. Horizontal error bar plot of odds/hazard ratios of each aging biomarker and chronological age to aging-related diseases and all-cause mortality in the two validation cohorts."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig12_ESM.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e2821","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/13b54612fef9/43587_2026_1073_Fig12_ESM.jpg","loading":"lazy","height":"599","width":"719","alt":"Extended Data Fig. 6"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig12/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"a"}]},{"tag":"#text","text":", Odds ratio of the TruDiagnostic Biobank. "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"b"}]},{"tag":"#text","text":", Hazard Ratio (left) and odds ratio (right) of the Generation Scotland. The ratios and 95% confidence intervals are based on a one- standard deviation change around the estimated mean values from the statistical models. Sample sizes (N) and the number of cases (n) for each phenotype are provided for the TruD (N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":"), and GS (N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":") cohorts: "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Incident case"}]},{"tag":"#text","text":": all-cause mortality, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,672 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 1,503); type-2 diabetes, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,488 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 589); stroke, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,588 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 314); CVD (excl. stroke), N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 17,953 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 1,026); depression, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,491 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 172); COPD, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,535 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 492); cancer, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,222 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 1,203). "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Prevalent case"}]},{"tag":"#text","text":": type-2 diabetes, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 14,213 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 299), N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,672 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 184); stroke, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 14,213 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 115), N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,672 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 84); CVD (excl. stroke), N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 14,213 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 5,046), N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,672 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 719); depression, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 14,213 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 1,329), N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,672 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 181); COPD, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 14,213 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 45), N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,672 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 137); cancer, N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 14,213 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 1,501), N"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 18,672 (n"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 450)."}]}]}]},{"tag":"p","hidden":false,"id":"Par19","children":[{"tag":"#text","text":"We further evaluated the prevalent disease associations in one additional cohort, the TruDiagnostic Biobank. In this cohort, PCGrimAge, OMICmAge, DNAmEMRAge and chronologic age had FDR-significant associations with type 2 diabetes, CVD, COPD and cancer. PCGrimAge had the highest OR with COPD (OR = 6.15, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.59 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"04"}]},{"tag":"#text","text":"). Overall, chronological age had stronger associations with aging-related diseases in the TruDiagnostic cohort than in the other cohorts. Chronological age was the only measure that was associated with stroke (OR = 2.21, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 8.51 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"15"}]},{"tag":"#text","text":") and had the highest ORs with CVD (OR = 1.74, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.93 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"172"}]},{"tag":"#text","text":") and cancer (OR = 2.27, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 3.26 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"146"}]},{"tag":"#text","text":"). OMICmAge was in the top two highest associations for type 2 diabetes (OR = 2.78, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 3.61 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"13"}]},{"tag":"#text","text":"), depression (OR = 1.26, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 3.53 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"3"}]},{"tag":"#text","text":") and cancer (OR = 1.50, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 6.28 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"8"}]},{"tag":"#text","text":"; Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig12","class":"usa-link"},"children":[{"tag":"#text","text":"6a"}]},{"tag":"#text","text":" and Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM17","class":"usa-link"},"children":[{"tag":"#text","text":"16"}]},{"tag":"#text","text":")."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par20","children":[{"tag":"#text","text":"We also calculated the area under the curve (AUC) for 5-year and 10-year survival using prediction classifiers for OMICmAge, DNAmEMRAge, PCGrimAge, chronological age and other aging biomarkers in both MGB and Generation Scotland cohorts (Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig5","class":"usa-link"},"children":[{"tag":"#text","text":"5c"}]},{"tag":"#text","text":" and Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig13","class":"usa-link"},"children":[{"tag":"#text","text":"7"}]},{"tag":"#text","text":"). In the prediction models, we included age for those biomarkers in which age is not included as a feature (all except OMICmAge, DNAmEMRAge and PCGrimAge). In the MGB testing set, DNAmEMRAge showed the highest AUC values (5-year AUC: 0.898, OR = 10.77, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.14 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"14"}]},{"tag":"#text","text":"; 10-year AUC: 0.89, OR = 7.99, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 2.17 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"17"}]},{"tag":"#text","text":"), followed by OMICmAge with very similar values (5-year AUC: 0.892, OR = 14.83, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 5.25 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"14"}]},{"tag":"#text","text":"; 10-year AUC: 0.873, OR = 10.42, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 2.53 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"16"}]},{"tag":"#text","text":"). Chronological age and the other methylation clocks had AUC values lower than OMICmAge and DNAmEMRAge. In the Generation Scotland cohort, OMICmAge also ranked as the second-best aging biomarker based on AUC values for both the 5-year (AUC: 0.861; OR = 3.86, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 1.58 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"12"}]},{"tag":"#text","text":") and 10-year (AUC: 0.859; OR = 4.13, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 3.30 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"29"}]},{"tag":"#text","text":") periods, following PCGrimAge (5-year AUC: 0.870, OR = 8.13, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 9.03 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"15"}]},{"tag":"#text","text":"; 10-year AUC: 0.866, OR = 8.08, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" = 2.30 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"31"}]},{"tag":"#text","text":")."}]},{"tag":"#text","text":"\n"},{"tag":"figure","hidden":false,"id":"Fig13","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h5","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Extended Data Fig. 7. ROC curves showing performance of survival prediction: 5-/10-year in the Generation Scotland cohort."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig13_ESM.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e2839","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/2757ed5ef168/43587_2026_1073_Fig13_ESM.jpg","loading":"lazy","height":"416","width":"731","alt":"Extended Data Fig. 7"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig13/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"ROC curves for 5-year ("},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"a"}]},{"tag":"#text","text":") and 10-year ("},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"b"}]},{"tag":"#text","text":") survival predictions in the GS cohort. Individual lines represent DNAm aging biomarkers compared against chronological age. 5-Year Survival AUCs: PCGrimAge (0.870), DunedinPACE (0.861), OMICmAge (0.861), DNAm EMRAge (0.857), PCPhenoAge (0.853), PCHannum (0.842), PCHorvath1 (0.839), PCHorvath2 (0.839), and chronological age (0.836). 10-Year Survival AUCs: PCGrimAge (0.866), OMICmAge (0.859), DunedinPACE (0.857), PCPhenoAge (0.852), DNAm EMRAge (0.848), chronological age (0.847), PCHannum (0.845), PCHorvath1 (0.841), and PCHorvath2 (0.841)."}]}]}]},{"tag":"p","hidden":false,"id":"Par21","children":[{"tag":"#text","text":"Finally, we evaluated the association between OMICmAge and lifestyle factors in both MGB and TruDiagnostic Biobank cohorts with varying lifestyle information, using the FDR to identify significance after adjusting for multiple testing (FDR "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"Q"}]},{"tag":"#text","text":" value ≤ 0.05; Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig6","class":"usa-link"},"children":[{"tag":"#text","text":"6"}]},{"tag":"#text","text":" and Supplementary Tables "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM18","class":"usa-link"},"children":[{"tag":"#text","text":"17"}]},{"tag":"#text","text":" and "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM19","class":"usa-link"},"children":[{"tag":"#text","text":"18"}]},{"tag":"#text","text":"). In all the cohorts, we observed significant negative associations with female sex, education level and exercise per week. We also observed consistent significant positive associations with Black race, obesity and tobacco smoking across all cohorts. While we observed a significant positive association with being underweight in the MGB-ABC cohort, this is likely an indication of illness among individuals with low body weight that is present in the MGB Biobank and not observed in the other cohorts. This relationship has been previously reported in epidemiological studies and in the proteomics-aging clock paper developed by Oh et al."},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR17","class":"usa-link","aria-describedby":"CR17","aria-expanded":"false"},"children":[{"tag":"#text","text":"17"}]}]},{"tag":"#text","text":". Finally, occasional recreational drug use was significantly associated with higher OMICmAge, while antioxidants and omega-3 fish oil intake were significantly associated with a lower biological age in the TruDiagnostic cohort."}]},{"tag":"#text","text":"\n"},{"tag":"figure","hidden":false,"id":"Fig6","attributes":{"class":"fig xbox font-sm"},"children":[{"tag":"h5","hidden":false,"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Fig. 6. Forest plot for the representation of the lifestyle factors associated with OMICmAge in the MGB-ABC and TruDiagnostic Biobank."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"tileshop","target":"_blank","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=13004675_43587_2026_1073_Fig6_HTML.jpg"},"children":[{"tag":"img","hidden":false,"id":"d33e2088","attributes":{"class":"graphic zoom-in","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/63e9/13004675/e99bf27feaea/43587_2026_1073_Fig6_HTML.jpg","loading":"lazy","height":"298","width":"726","alt":"Fig. 6"}}]}]},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"p text-right font-secondary"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/figure/Fig6/","class":"usa-link","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"Open in a new tab"}]}]},{"tag":"#text","text":"\n"},{"tag":"figcaption","hidden":false,"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The effect size and 95% CIs, derived from the multivariate linear regression model, are shown as error bars for each lifestyle factor. All the associations are adjusted by chronological age, biological sex, ethnicity, BMI, tobacco use and alcohol consumption, when appropriate. The sample sizes ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":") for each factor level across the MGB-ABC ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":") and TruD ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":") cohorts are presented below. FDR values are shown in parentheses for factor levels that are not the reference group (ref.). Biological sex: male (ref.), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 1,158, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 8,361; female, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 2,064 (FDR = 5.51 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−128"}]},{"tag":"#text","text":"), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 5,852 (FDR < 2.22 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−308"}]},{"tag":"#text","text":"). Race: white (ref.), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 2,615, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = "},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":"2,114; Black, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 241 (FDR = "},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":".75 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−15"}]},{"tag":"#text","text":"), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 454 (FDR = 1.24 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−23"}]},{"tag":"#text","text":"); Asian, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 53 (FDR = 0.473), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 787 (FDR = 7.28 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−9"}]},{"tag":"#text","text":"); other, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 237 (FDR = 0.026), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 858 (FDR = 1.00 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−5"}]},{"tag":"#text","text":"). Education Level: did not complete high school (ref.), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 46, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 1"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":"0; high school or associate degree, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 516 (FDR = 0.343), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 2,907 (FDR = 0.610); bachelor’s degree, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 401 (FDR = 0.097); graduate degree, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 493 (FDR = 0.005), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 2,813 (FDR = 0.225). BMI class: underweight, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 35 (FDR = 0.011), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 396 (FDR = 0.170); normal weight (ref.), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 763, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 6,960; overweight, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 971 (FDR = 0.011), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 4,988 (FDR = 1.88 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−4"}]},{"tag":"#text","text":"); obesity, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 1,355 (FDR = 0.140), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 1,869 (FDR = 5.32 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−35"}]},{"tag":"#text","text":"). Exercise per week: no exercise (ref.), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 444, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = "},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":",148; less than 5 h, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 737 (FDR = 0.002), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 7,477 (FDR = 1.47 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−8"}]},{"tag":"#text","text":"); 5 to 10 h, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 155 (FDR = 6.41 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−6"}]},{"tag":"#text","text":"), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 4,927 (FDR = 6.84 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−11"}]},{"tag":"#text","text":"); more than 10 h, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 40 (FDR = 0.002), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 552 (FDR = 3.29 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−7"}]},{"tag":"#text","text":"). Hours of sleep: less than 6 h (ref.), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 47, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 2,4"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":"4; 6 to 9 h, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 805 (FDR = 0.209), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 10,358 (FDR = 0.008); more than 9 h, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 299 (FDR = 0.847), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 1,388 (FDR = 0.462). Smoking: non-smoker (ref.), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 2,052, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = "},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":"3,652; current smoker, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 192 (FDR = 5.13 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−8"}]},{"tag":"#text","text":"), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 561 (FDR = 4.25 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−9"}]},{"tag":"#text","text":"); former smoker, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 978 (FDR = 0.002). Alcohol: no alcohol (ref.), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 1,609, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 2,739; current drinker, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 1,521 (FDR = 1.20 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−27"}]},{"tag":"#text","text":"), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 11,474 (FDR = 0.610); former drinker, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":" = 21 (FDR = 0.769). Recreational drugs: never (ref.), "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 494; occasionally, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 2,005 (FDR = 0.002). Interventions: antioxidants, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 3,905 (FDR = 8.4 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−4"}]},{"tag":"#text","text":"); fish oil omega, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" = 7085 (FDR = 5.25 × 10"},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":"−6"}]},{"tag":"#text","text":")."}]}]}]}]}]}]},{"tag":"section","hidden":false,"id":"Sec11","children":[{"tag":"h2","hidden":false,"attributes":{"class":"pmc_sec_title","data-anchor-id":"Sec11"},"children":[{"tag":"a","hidden":false,"id":"Sec11-anchor","attributes":{"data-anchor-id":"Sec11","class":"usa-anchor"}},{"tag":"#text","text":"Discussion"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par22","children":[{"tag":"#text","text":"The objective of this study was to develop a clinically relevant aging biomarker that can be implemented into the current electronic infrastructure and an analogous DNAm biomarker informed by multi-omic data. We did this through the generation of EMRAge, DNAmEMRAge and OMICmAge. The motivating premise is that biological aging is a multifactorial process involving complex interactions of cellular and biochemical processes that is best understood via multiple omic profiles. To date, aging biomarkers (also known as ‘clocks’) have been generated predominantly with singular omic data types"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR3","class":"usa-link","aria-describedby":"CR3","aria-expanded":"false"},"children":[{"tag":"#text","text":"3"}]},{"tag":"#text","text":"–"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR13","class":"usa-link","aria-describedby":"CR13","aria-expanded":"false"},"children":[{"tag":"#text","text":"13"}]}]},{"tag":"#text","text":". While this approach most often generates highly predictive aging biomarkers, without additional molecular data the overall biological understanding is limited. This leaves a gap between predictive accuracy and driving physiological mechanisms."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par23","children":[{"tag":"#text","text":"A major goal for aging biomarkers is to implement these measures into clinical care and improve overall health. We used common clinical laboratory measures in ~30,000 individuals from the MGB Biobank to develop EMRAge. The use of readily available EMR data suggests that EMRAge can be broadly recapitulated across multiple EMR systems. While prior aging biomarkers were developed using either clinical data or mortality prediction models"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR31","class":"usa-link","aria-describedby":"CR31","aria-expanded":"false"},"children":[{"tag":"#text","text":"31"}]},{"tag":"#text","text":"–"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR33","class":"usa-link","aria-describedby":"CR33","aria-expanded":"false"},"children":[{"tag":"#text","text":"33"}]}]},{"tag":"#text","text":", EMRAge reflects a hybrid aging biomarker that distills health status and mortality into a single aging biomarker. EMRAge is highly reproducible, has strong associations with incident and prevalent chronic disease outcomes, and is an accurate predictor of mortality risk that outperforms chronologic age and PhenoAge in both our discovery cohort and a large independent cohort. The broad clinical relevance and ease of large-scale implementation highlight the translational potential of EMRAge. Further assessment in diverse populations and across different EMR systems will characterize its generalizability."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par24","children":[{"tag":"#text","text":"Because EMRAge alone does not resolve specific physiology, we used machine learning to predict EMRAge with DNAm and multiple omics, generating DNAmEMRAge and OMICmAge, respectively. Both aging biomarkers had excellent accuracy for 5-year and 10-year mortality risk, and DNAmEMRAge maintained the highest accuracy in one of the validation cohorts. We also demonstrated that both DNAmEMRAge and OMICmAge have strong associations with aging-related health outcomes, including CVD, stroke, type 2 diabetes, COPD, depression and mortality. Notably, among studied DNAm-based aging biomarkers, OMICmAge often exhibits either the strongest (for example, for depression) or second strongest (for example, for type 2 diabetes) association with prevalent or incident aging-related morbidities across cohorts. These patterns hold across cohorts with differing health profiles and ascertainment. The consistency in the association findings suggests that DNAmEMRAge and OMICmAge are reliable and broadly applicable across a diverse range of cohort characteristics. This argument for OMICmAge is further supported by previous studies"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR34","class":"usa-link","aria-describedby":"CR34","aria-expanded":"false"},"children":[{"tag":"#text","text":"34"}]},{"tag":"#text","text":"–"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR36","class":"usa-link","aria-describedby":"CR36","aria-expanded":"false"},"children":[{"tag":"#text","text":"36"}]}]},{"tag":"#text","text":" indicating that a significant portion of the signal captured by epigenetic aging biomarkers stems from the accumulation of stochastic variation over time. In essence, as an aging biomarker becomes more predictive (that is, higher correlation) of chronological age, it increasingly reflects a pure stochastic process, thereby demonstrating less biological relevance. Given that OMICmAge exhibited a moderate correlation with chronological age in both MGB and TruDiagnostic Biobank cohorts, its broad applicability is largely justified by its substantial deviation from purely stochastic accumulation. This suggests that OMICmAge reflects non-stochastic physiological processes related to aging."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par25","children":[{"tag":"#text","text":"In addition, consistent reproducibility has previously been an issue with epigenetic biomarkers, which has traditionally only been improved through the inclusion of summary features such as PCs"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR30","class":"usa-link","aria-describedby":"CR30","aria-expanded":"false"},"children":[{"tag":"#text","text":"30"}]},{"tag":"#text","text":","},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR37","class":"usa-link","aria-describedby":"CR37","aria-expanded":"false"},"children":[{"tag":"#text","text":"37"}]}]},{"tag":"#text","text":". With OMICmAge, we observed high ICCs, demonstrating strong reproducibility. One ongoing challenge with multi-omic aging biomarkers is the complexity of integrating different omic data together and the subsequent interpretation of the findings. Moreover, multi-omic clocks are often impractical due to high costs and logistics. The approach we used to develop OMICmAge has the advantage of estimating metabolites, proteins and clinical data (via EBPs) while distilling this into a single DNAm-based aging algorithm"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR29","class":"usa-link","aria-describedby":"CR29","aria-expanded":"false"},"children":[{"tag":"#text","text":"29"}]},{"tag":"#text","text":","},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR31","class":"usa-link","aria-describedby":"CR31","aria-expanded":"false"},"children":[{"tag":"#text","text":"31"}]},{"tag":"#text","text":","},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR38","class":"usa-link","aria-describedby":"CR38","aria-expanded":"false"},"children":[{"tag":"#text","text":"38"}]}]},{"tag":"#text","text":". Using DNAm as the primary metric was selected for its stability and cost-effectiveness. In this sense, OMICmAge reflects aging processes on multiple levels of systems biology while only necessitating DNAm in its calculation."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par26","children":[{"tag":"#text","text":"An advantage of OMICmAge and the development with concurrent multi-omic data is the ability to further elucidate the biological mechanisms associated with this biomarker. Although the epigenome is central to aging, functions implied by specific methylation perturbations are often unclear, limiting clinical interpretability when accelerated aging arises from heterogeneous mechanisms. In contrast to the epigenome, proteins reflect a broad range of aging-related biology, including immune function and inflammatory processes that are often well understood and have clear clinical implications for treatment and/or modification. Changes in oxidative stress, hormones and lipid profiles are just a few examples of the metabolic processes reflected via the metabolome that represent specific biology relevant for aging processes"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR37","class":"usa-link","aria-describedby":"CR37","aria-expanded":"false"},"children":[{"tag":"#text","text":"37"}]}]},{"tag":"#text","text":". When developing OMICmAge, we included protein and metabolite EBPs that were correlated with EMRAge to improve the likelihood of retaining physiologically relevant measures. Retained EBPs included albumin"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR38","class":"usa-link","aria-describedby":"CR38","aria-expanded":"false"},"children":[{"tag":"#text","text":"38"}]}]},{"tag":"#text","text":" and the androgenic steroid androsterone sulfate. The algorithm for OMICmAge also retained protein and metabolite EBPs with a less well-understood relationship with aging, such as ribitol, which has been identified as a metabolite predictive of mortality but has very little mechanistic information"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR39","class":"usa-link","aria-describedby":"CR39","aria-expanded":"false"},"children":[{"tag":"#text","text":"39"}]}]},{"tag":"#text","text":". It is important to highlight that not all retained features are causal, nor do they necessarily have the strongest overall associations with OMICmAge. Follow-up functional work and/or causal modeling is necessary to infer any potential causal links between these proteins/metabolites and EMRAge."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par27","children":[{"tag":"#text","text":"There are several limitations that need to be addressed in future work. First, EMRAge was developed using EMR data and is, therefore, primarily tailored for clinical data. The major advantage of this is that this measure uses real-world data and can be recapitulated in several EMR systems. However, real-world data are not systematically collected and so missingness is universal. To assess robustness, we calculated the median values in different time increments surrounding the time point when EMRAge is being estimated and found that the EMRAge estimates had near-perfect pairwise correlations among reconstructed EMRAge estimates. Furthermore, while EMRAge demonstrated superior performance over PhenoAge in predicting the risk of all-cause mortality using the All of Us Research Program data, EMRAge did not consistently outperform PhenoAge for other incident aging-related diseases, likely influenced by shorter follow-up periods (median: 3 years versus 5.5 years). Future work should test EMRAge across diverse populations and EMR systems to confirm validity and generalizability. A major advantage of OMICmAge is the incorporation of proteins, metabolites and clinical EBPs; however, more work is necessary to further improve the accuracy and precision of EBPs. Targeted, quantitative protein and metabolites assays will improve EBP accuracy and reflect the actual clinical levels. There is also room to expand upon the EBPs that were included into the feature space, both with additional metabolites/proteins and with other omics. Finally, additional validation of OMICmAge across diverse populations and with more aging biomarkers will continue to highlight potential advantages and limitations in this aging biomarker."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par28","children":[{"tag":"#text","text":"The present study introduces several notable steps in aging biomarkers. First, EMRAge advances the field as a hybrid aging biomarker that integrates clinical health data and mortality risk into a robust measure readily scalable across EMRs. Building on this foundation, we established DNAmEMRAge and OMICmAge, epigenetic aging algorithms that extend predictive accuracy and mechanistic insight. OMICmAge in particular integrates DNAm with proteomic, metabolomic and clinical data through EBPs, yet it remains measurable from DNAm alone. This systems-biology framework unifies multiple biological levels into a single readout of aging, enabling a more comprehensive and interpretable view than prior clocks. Together, these tools establish a clinically practical and biologically grounded platform for assessing biological age. Ongoing validation across diverse populations will extend their translational reach, with the potential to transform both research and clinical practice in aging and aging-related diseases."}]}]},{"tag":"section","hidden":false,"id":"Sec12","children":[{"tag":"h2","hidden":false,"attributes":{"class":"pmc_sec_title","data-anchor-id":"Sec12"},"children":[{"tag":"a","hidden":false,"id":"Sec12-anchor","attributes":{"data-anchor-id":"Sec12","class":"usa-anchor"}},{"tag":"#text","text":"Methods"}]},{"tag":"#text","text":"\n"},{"tag":"section","hidden":false,"id":"Sec13","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Discovery cohort"}]},{"tag":"#text","text":"\n"},{"tag":"section","hidden":false,"id":"Sec14","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"MGB Biobank"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par29","children":[{"tag":"#text","text":"The MGB Biobank is a large biorepository that provides access to research data and approximately 130,000 high-quality banked samples (plasma, serum and DNA) from >100,000 consented individuals enrolled in the MGB system"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR40","class":"usa-link","aria-describedby":"CR40","aria-expanded":"false"},"children":[{"tag":"#text","text":"40"}]}]},{"tag":"#text","text":". Written informed consent was obtained from all participants upon enrollment in the biobank. Participants were linkable to EMR data spanning their MGB medical histories and to surveys on lifestyle, environment and family history. Plasma donors initially totaled 60,371 from the MGB Biobank; 124 were excluded for being <18 years old at collection. Among remaining adults, vital status for 59,213 was verified (alive/deceased) with death dates recorded as of 28 July 2022. Another 28,329 participants were excluded for missing phenotype data (Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig7","class":"usa-link"},"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":")."}]}]},{"tag":"section","hidden":false,"id":"Sec15","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"MGB-ABC"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par30","children":[{"tag":"#text","text":"The MGB-ABC comprises 3,451 randomly selected MGB Biobank participants to yield an age-, sex- and BMI-balanced sample representative of the Biobank. For selected participants, comprehensive EMRs plus metabolomic, proteomic and epigenetic data are available. Blood samples obtained during clinical care or research draws at Brigham and Women’s Hospital or Massachusetts General Hospital were used for serum, plasma and DNA/genomic analyses. Typical draws collected 30–50 ml and were linked to EMR data; the Biobank also captured additional health information at collection. Questionnaires were administered electronically or on paper and took approximately 10–15 min to complete. Items covered family history, lifestyle and environmental factors. Confidentiality and data security were prioritized: no personally identifiable information was collected, identities were protected, and survey data were encrypted."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par31","children":[{"tag":"#text","text":"The Phenotype Discovery Center of MGB integrates various data sources, including the Research Patient Data Registry, health information surveys and genotype results, into the Biobank Portal. This portal combines specimen data with EMR data, creating a comprehensive SQL Server database with a user-friendly web-based application"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR40","class":"usa-link","aria-describedby":"CR40","aria-expanded":"false"},"children":[{"tag":"#text","text":"40"}]}]},{"tag":"#text","text":". Researchers can perform queries, visualize longitudinal data with timestamps, use established algorithms to define phenotypes, utilize automated natural language processing tools for analyzing EMR data using the Informatics for Integrating Biology and the Bedside (i2b2) tool kit"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR41","class":"usa-link","aria-describedby":"CR41","aria-expanded":"false"},"children":[{"tag":"#text","text":"41"}]}]},{"tag":"#text","text":" and request samples from cases and controls. Biobank Portal data include narrative clinical notes; text reports (cardiology, pathology, radiology, operative, discharge summaries); codified elements (demographics, diagnoses, procedures, labs, medications); and patient-reported exposures and family history from surveys. Additional measures (for example, lung function) were extracted using an in-house natural language processing-based algorithm."}]}]},{"tag":"section","hidden":false,"id":"Sec16","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Metabolomic profiling"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par32","children":[{"tag":"#text","text":"Untargeted global plasma metabolomics profiling was generated by Metabolon. Coefficients of variation were measured in blinded quality-control (QC) samples randomly distributed among study samples. Batch variation was controlled for in the analysis. Sample preparation and global metabolomics profiling was performed according to methods described previously"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR42","class":"usa-link","aria-describedby":"CR42","aria-expanded":"false"},"children":[{"tag":"#text","text":"42"}]}]},{"tag":"#text","text":". Metabolomic profiling was performed using four LC–MS methods that measure complementary sets of metabolite classes"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR43","class":"usa-link","aria-describedby":"CR43","aria-expanded":"false"},"children":[{"tag":"#text","text":"43"}]}]},{"tag":"#text","text":": (1) amines and polar metabolites that ionize in the positive ion mode; (2) central metabolites and polar metabolites that ionize in the negative ion mode; (3) polar and nonpolar lipids; (4) free fatty acids, bile acids and metabolites of intermediate polarity. All reagents and columns for this project will be purchased in bulk from a single lot, and all instruments will be calibrated for mass resolution and mass accuracy daily"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR44","class":"usa-link","aria-describedby":"CR44","aria-expanded":"false"},"children":[{"tag":"#text","text":"44"}]}]},{"tag":"#text","text":"."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par33","children":[{"tag":"#text","text":"Metabolite peaks were quantified by the AUC. Raw area counts for each metabolite in each sample were normalized to the run-day median to correct inter-day instrument tuning differences, setting each run’s median to 1.0. Metabolites were identified by automated comparison of ion features to a ~8,000-entry reference library of chemical standards that includes retention time, molecular weight ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"m/z"}]},{"tag":"#text","text":"), preferred adducts, in-source fragments and associated mass spectrometry spectra, with visual QC using software developed at Metabolon"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR44","class":"usa-link","aria-describedby":"CR44","aria-expanded":"false"},"children":[{"tag":"#text","text":"44"}]}]},{"tag":"#text","text":". Known chemical entities were identified by comparison to library entries of purified standards. Recurrent, structurally unnamed biochemicals generated additional spectral entries; these may be resolved upon acquisition of matching purified standards or by classical structural analysis. QC and data processing used an in-house method"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR45","class":"usa-link","aria-describedby":"CR45","aria-expanded":"false"},"children":[{"tag":"#text","text":"45"}]},{"tag":"#text","text":"–"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR47","class":"usa-link","aria-describedby":"CR47","aria-expanded":"false"},"children":[{"tag":"#text","text":"47"}]}]},{"tag":"#text","text":". Metabolite features with signal-to-noise ratio < 10 or with undetectable/missing values in >10% of samples were excluded. Remaining missing values were imputed as half the minimum peak intensity for that feature across the cohort. Features with a pooled-sample coefficient of variation > 25% were removed to ensure technical reproducibility. Analyses used LC–MS peak areas; values were subjected to log transformation (approximate normality, variance stabilization) and Pareto scaling to harmonize measurement scales. After QC, 1,459 metabolites from 1,986 samples remained for analysis."}]}]},{"tag":"section","hidden":false,"id":"Sec17","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Methylation profiling"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par34","children":[{"tag":"#text","text":"DNAm data were generated with the Illumina Infinium MethylationEPIC 850 K BeadChip (>850,000 sites) covering CpG islands, non-CpG and differentially methylated sites, FANTOM5 enhancers, ENCODE open chromatin and transcription-factor binding, and microRNA promoters. Biobanked samples were stored at −80 °C and shipped to TruDiagnostic for extraction and preprocessing. From whole blood, 500 ng DNA was extracted and bisulfite-converted using the Zymo Research EZ DNA Methylation kit per the manufacturer’s instructions. Converted DNA was randomly assigned to Infinium HumanMethylationEPIC chip wells. Laboratory preprocessing comprised DNA amplification, hybridization to the EPIC array, staining/washing and imaging on the Illumina iScan SQ to generate raw intensities."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par35","children":[{"tag":"#text","text":"Raw methylation data for the MGB Biobank were processed using the ‘minfi’ pipeline"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR48","class":"usa-link","aria-describedby":"CR48","aria-expanded":"false"},"children":[{"tag":"#text","text":"48"}]}]},{"tag":"#text","text":", and low-quality samples were identified using the qcfilter() function from the ENmix package"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR49","class":"usa-link","aria-describedby":"CR49","aria-expanded":"false"},"children":[{"tag":"#text","text":"49"}]}]},{"tag":"#text","text":", using default parameters. Overall, a total of 4,803 samples passed the quality assurance/QC ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 0.05) and were deemed to be high-quality samples. In addition, we removed low-quality probes ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 0.05 out-of-band) that were identified among the samples. This process retained 721,802 among 866,239 probes that were high quality and indicated that a large portion of the methylation data were of high quality. A combinatorial normalization processing using the Funnorm procedure (‘minfi"},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"’"}]},{"tag":"#text","text":" package), followed by the RCP method (ENmix package) was performed to minimize sample-to-sample variation as noted in Foox et al."},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR50","class":"usa-link","aria-describedby":"CR50","aria-expanded":"false"},"children":[{"tag":"#text","text":"50"}]}]},{"tag":"#text","text":"."}]}]},{"tag":"section","hidden":false,"id":"Sec18","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Proteomic profiling"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par36","children":[{"tag":"#text","text":"We used the Seer proteomic platform to identify proteins and peptides related to chronological and biological aging. This uses nanoparticles with different binding capabilities to isolate and extract peptides and proteins via corona covalent attachment to the surface, paired with LC–MS/MS, and thus enables detection of low-abundance peptides and proteins."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par37","children":[{"tag":"#text","text":"Relative protein levels were quantified in 2,000 samples (1,600 MGB-ABC; 400 process controls) using the Proteograph Product Suite (Seer) with LC–MS. Samples were incubated with five proprietary nanoparticles on the Seer SP100 Proteograph to form protein coronas enabling physicochemical capture. Proteins were digested by trypsin, and relative levels quantified by the default data-independent acquisition method in Proteograph Analysis Software. To address peptide–protein ambiguity and improve quantification, peptides were aggregated into protein groups, then preprocessed with control-based normalization and outlier detection. This yielded estimates for 28,490 peptides across blood samples (mean 15,239) and 10,265 in controls (mean 4,281). Peptides were consolidated into 3,695 protein groups in MGB-ABC samples (mean 2,587) and 1,360 in plate controls. Following the signal drift and batch effect correction via the QC-robust spline correction algorithm"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR51","class":"usa-link","aria-describedby":"CR51","aria-expanded":"false"},"children":[{"tag":"#text","text":"51"}]}]},{"tag":"#text","text":", we applied log"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"10"}]},{"tag":"#text","text":" transformation, Pareto scaling and "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"k"}]},{"tag":"#text","text":"-nearest-neighbor imputation based on current guidelines"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR48","class":"usa-link","aria-describedby":"CR48","aria-expanded":"false"},"children":[{"tag":"#text","text":"48"}]}]},{"tag":"#text","text":". Stringent filters, including 80% protein presence, relative standard deviation of quality control (RSD-qc) < 0.20%, and the D-ratio comparing technical variability to biological variability < 0.70, were utilized to reinforce data validity and reliability"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR52","class":"usa-link","aria-describedby":"CR52","aria-expanded":"false"},"children":[{"tag":"#text","text":"52"}]}]},{"tag":"#text","text":". The final processed dataset consists of 2,805 nonunique, or 536 unique, protein groups, across 1,789 samples, in which the majority of samples ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 1,475) matched to methylation data."}]}]},{"tag":"section","hidden":false,"id":"Sec19","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Definition of aging-related diseases"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par38","children":[{"tag":"#text","text":"We utilized International Classification of Diseases (ICD)-9/ICD-10 codes to identify aging-related diseases, including type 2 diabetes, COPD, depression, cancer, stroke and other CVDs, as detailed in Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM20","class":"usa-link"},"children":[{"tag":"#text","text":"19"}]},{"tag":"#text","text":". We also utilized SNOMED codes to identify the same set of diseases for the All of Us cohort, as detailed in Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM21","class":"usa-link"},"children":[{"tag":"#text","text":"20"}]},{"tag":"#text","text":"."}]}]}]},{"tag":"section","hidden":false,"id":"Sec20","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Validation cohort"}]},{"tag":"#text","text":"\n"},{"tag":"section","hidden":false,"id":"Sec21","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"All of Us cohort"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par39","children":[{"tag":"#text","text":"The All of Us Research Program, an initiative launched by the National Institutes of Health (NIH) in 2018, represents a national collaborative effort to aggregate genetic, lifestyle, environmental and EMR data from one million participants"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR53","class":"usa-link","aria-describedby":"CR53","aria-expanded":"false"},"children":[{"tag":"#text","text":"53"}]}]},{"tag":"#text","text":". All the participants provided a written consent form at the time of enrollment. Given the diverse data sources utilized by All of Us, including EMR data from healthcare facilities, participant surveys and self-reported measurements, the program implemented the Observational Medical Outcomes Partnership Common Data Model"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR54","class":"usa-link","aria-describedby":"CR54","aria-expanded":"false"},"children":[{"tag":"#text","text":"54"}]}]},{"tag":"#text","text":" to store and standardize this heterogeneous data, which were coded using the SNOMED CT dictionary. To facilitate the efficient retrieval of diagnosis records, we mapped the curated ICD-9 and ICD-10 codes to corresponding SNOMED CT codes, as detailed in Supplementary Tables "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM21","class":"usa-link"},"children":[{"tag":"#text","text":"20"}]},{"tag":"#text","text":" and "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM22","class":"usa-link"},"children":[{"tag":"#text","text":"21"}]},{"tag":"#text","text":"."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par40","children":[{"tag":"#text","text":"On 4 February 2025, All of Us released the latest version of its Curated Data Repository (CDR v8), encompassing participant data up to a cutoff date of 1 October 2023. Within CDR v8, 389,379 adult participants had both EMR and lifestyle survey data available. Following that, we extracted demographic information, lifestyle factors, diagnosis records and laboratory test results necessary for the calculation of EMRAge and PhenoAge. To address missing laboratory values and ensure a sufficient sample size for association analyses, we imputed missing values with the median of all measurements recorded within one year of each participant’s enrollment date. This imputation process resulted in a final cohort of 10,769 participants with complete data from the All of Us Research Program."}]}]},{"tag":"section","hidden":false,"id":"Sec22","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"TruDiagnostic Biobank cohort"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par41","children":[{"tag":"#text","text":"The TruDiagnostic Biobank included 14,698 individuals who underwent the commercial TruDiagnostic TruAge test with DNAm profiling. Participants, recruited from October 2020 to April 2023, were predominantly based in the United States and generally healthier than MGB Biobank participants, likely reflecting proactive health interest and willingness to pay for testing. Most samples were obtained under healthcare provider guidance, and <5% were via direct-to-consumer testing. This recruitment likely introduces self-selection toward preventive care and fewer comorbidities. At enrollment, participants completed surveys covering personal information, medical, social, lifestyle and family history. The study was approved by the Institute for Regenerative and Cellular Medicine Institutional Review Board, and all participants provided written informed consent."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par42","children":[{"tag":"#text","text":"Peripheral blood was collected via lancet/capillary, placed in lysis buffer and DNA extracted. Bisulfite conversion of 500 ng DNA was performed with the Zymo Research EZ DNA Methylation kit per the manufacturer’s instructions. Converted DNA was randomly assigned to Infinium HumanMethylationEPIC BeadChip wells, then amplified, hybridized, stained/washed and imaged on an Illumina iScan SQ to generate raw intensities."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par43","children":[{"tag":"#text","text":"TruDiagnostic methylation data were preprocessed using the MGB-ABC pipeline, with normalization adapted for computational constraints. In total, 14,213 individuals (96.7% of originals) passed quality assurance/QC ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 0.05). To retain CpGs needed for clock calculation, no probes were removed. We applied normal-exponential out-of-band (Noob) normalization using minfi’s preprocessNoob function. Finally, we used a 12-cell immune deconvolution method to estimate cell-type proportions"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR55","class":"usa-link","aria-describedby":"CR55","aria-expanded":"false"},"children":[{"tag":"#text","text":"55"}]},{"tag":"#text","text":"–"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR57","class":"usa-link","aria-describedby":"CR57","aria-expanded":"false"},"children":[{"tag":"#text","text":"57"}]}]},{"tag":"#text","text":"."}]}]},{"tag":"section","hidden":false,"id":"Sec23","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Generation Scotland"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par44","children":[{"tag":"#text","text":"Generation Scotland is a Scottish, family-based cohort study with over 24,000 volunteers, aged 17–99, stemming from >5,500 families"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR58","class":"usa-link","aria-describedby":"CR58","aria-expanded":"false"},"children":[{"tag":"#text","text":"58"}]}]},{"tag":"#text","text":". The majority of volunteers provided blood samples at a baseline clinic between 2006 and 2011 in addition to completing health and lifestyle questionnaires and giving consent for data linkage to their electronic health records. All components of Generation Scotland received ethical approval from the NHS Tayside Committee on Medical Research Ethics (REC reference number: 05/S1401/89). All participants provided broad and enduring written informed consent for biomedical research. This study was performed in accordance with the Helsinki declaration."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par45","children":[{"tag":"#text","text":"DNAm data have been profiled using the Illumina EPICv1 array. QC details have been described previously"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR59","class":"usa-link","aria-describedby":"CR59","aria-expanded":"false"},"children":[{"tag":"#text","text":"59"}]}]},{"tag":"#text","text":". Briefly, samples were assessed in four sets yielding data for 18,869 individuals after QC ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":"-set1 = 5,087, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":"-set2 = 459, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":"-set3 = 4,450, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":"-set4 = 8,873). Here, after the removal of 11 individuals who subsequently withdrew consent, we had data for 18,858 volunteers. Secondary care linkage was available for 99% of Generation Scotland volunteers ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":"-analysis = 18,672). OMICmAge and the other epigenetic biomarkers were estimated as described for the MGB-ABC cohort."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par46","children":[{"tag":"#text","text":"Event status and age at event for six disease outcomes and all-cause mortality were determined via linkage to electronic health records. The secondary (ICD) and primary care (READ) codes used to define each outcome are listed in Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM23","class":"usa-link"},"children":[{"tag":"#text","text":"22"}]},{"tag":"#text","text":". Secondary care linkage was available for 99% of Generation Scotland volunteers. While all volunteers provided consent for linkage to primary care records, currently these are only available for ~40% of volunteers due to consent constraints with the data holders (individual GP surgeries). The latest date of linkage for primary and secondary care records was October 2023, which was set at the censoring date for the time-to-event analyses. Mortality records up to October 2023 were obtained via linkage to the National Records of Scotland."}]}]}]},{"tag":"section","hidden":false,"id":"Sec24","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Statistical analysis"}]},{"tag":"#text","text":"\n"},{"tag":"section","hidden":false,"id":"Sec25","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Development of EMRAge"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par47","children":[{"tag":"#text","text":"From 60,370 MGB Biobank participants with plasma samples, we extracted 28 clinical phenotypes (Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM3","class":"usa-link"},"children":[{"tag":"#text","text":"2"}]},{"tag":"#text","text":" and Extended Data Fig. "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#Fig7","class":"usa-link"},"children":[{"tag":"#text","text":"1"}]},{"tag":"#text","text":") spanning sociodemographics, clinical chemistries and behaviors (for example, smoking, alcohol). To address missingness and instrument variation, all phenotypes except height and age were subjected to median imputation using observations within 5 years of the first plasma collection. Categorical variables (for example, sex, race, Charlson Comorbidity Index, smoking status, alcohol status) were one-hot encoded; numerical variables were standardized, yielding 43 clinical variables from 28 phenotypes. Participants with complete variables ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 29,222) entered a two-step selection for EMRAge. First, a LASSO Cox model predicting time to death (Harrell’s C) selected 30 variables. Second, each variable’s association with time to death was tested in a Cox proportional-hazards model; variables with adjusted "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" ≤ 0.05 were retained, leaving 19. Re-adding 2,042 participants with complete data for these 19 variables yielded a final cohort of 31,264 participants and 19 variables for EMRAge development."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par48","children":[{"tag":"#text","text":"We split 31,264 samples by 70:30 into training ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 21,885) and testing ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 9,379) sets. A Cox proportional-hazards model was fitted on the training set to estimate coefficients for the 19 variables; variables were not scaled to preserve generalizability. For each individual, the linear predictor Xβ provided a risk estimate, which we transformed to EMRAge (matching the mean and variance of chronological age): EMRAge = 9.70296 × Xβ"},{"tag":"sub","hidden":false,"children":[{"tag":"#text","text":"train"}]},{"tag":"#text","text":" + 51.68254. We then evaluated the Pearson correlation of EMRAge to chronological age in the training and testing sets."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par49","children":[{"tag":"#text","text":"Because EMRAge predictors were selected on imputed data, we tested their robustness by retraining at four time points (1 January 2008, 2010, 2012 and 2014). For each time point, selected clinical variables were replaced with medians from a 1-year window, ensuring no overlap of data scans. To enable fair comparison, Charlson Comorbidity Index indicators were excluded as relatively time insensitive. This yielded four estimating equations (same predictors, different data). We applied these to participants with complete predictors within a 1-year window centered on 1 January 2016 ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 11,673); we computed and assessed Pearson correlations among the four EMRAge estimates."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par50","children":[{"tag":"#text","text":"We assessed associations of EMRAge with incident and prevalent aging-related outcomes (all-cause mortality, stroke, type 2 diabetes, COPD, depression, other CVD, any cancer). Cases required ≥2 relevant ICD-9/ICD-10 codes with first and last codes ≥1 day apart. Incident risks were modeled with Cox proportional hazards adjusting for age, sex, race, BMI, smoking and alcohol; prevalent morbidities were modeled with logistic regression using the same covariates. Effect sizes are reported per s.d. increase in EMRAge."}]}]},{"tag":"section","hidden":false,"id":"Sec26","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Construction of EMRAge and PhenoAge in All of Us cohort"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par51","children":[{"tag":"#text","text":"Using the CDR v8 dataset, we identified all participants with both EMR and survey data. We then utilized the Observational Medical Outcomes Partnership standard concept IDs to retrieve clinical measurements for the following biomarkers: BMI (‘3038553’), diastolic blood pressure (‘3012888’), albumin (‘3024561’), alanine aminotransferase (ALT, ‘3006923’, ‘46235106’), alkaline phosphatase (ALP, ‘3001110’, ‘3035995’), aspartate aminotransferase (AST, ‘3013721’), eosinophil counts (‘3013115’, ‘3028615’, ‘3009932’), red cell distribution width (RDW, ‘3002888’, ‘3015182’, ‘3002385’, ‘3019897’), glucose (‘3037110’, ‘3000483’, ‘3004501’), hematocrit (‘3009542’, ‘3023314’), neutrophil counts (‘3017732’, ‘3013650’, ‘3017501’), platelet counts (‘3007461’, ‘3024929’), triglycerides (‘3022038’, ‘3022192’) and blood urea nitrogen (‘3004295’, ‘3013682’). Additionally, we mapped ICD-9 and ICD-10 codes to SNOMED CT codes, as detailed in Supplementary Table "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM22","class":"usa-link"},"children":[{"tag":"#text","text":"21"}]},{"tag":"#text","text":", for the calculation of the Charlson Comorbidity Index. Furthermore, we extracted smoking-related lifestyle survey data to categorize participants into smokers and non-smokers/former smokers. A similar retrieval method was used to extract additional clinical measurements for C-reactive protein (‘3020460’, ‘3010156’), creatinine (‘3016723’), leukocyte counts (white blood cell count, ‘3010813’, ‘3000905’), lymphocyte percentage (‘3002030’, ‘3037511’, ‘3038058’), and mean corpuscular volume (‘3024731’, ‘3023599’) for the construction of PhenoAge."}]}]},{"tag":"section","hidden":false,"id":"Sec27","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Comparison of EMRAge and PhenoAge"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par52","children":[{"tag":"#text","text":"We compared EMRAge and PhenoAge regarding their associations with the incidence and prevalence of aging-related diseases. This was done by applying the same regression models described above, using either PhenoAge or EMRAge as the main predictor. We calculated PhenoAge for our MGB Biobank cohort and All of Us cohort using the established tool kit, as initially proposed by Levine et al."},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR19","class":"usa-link","aria-describedby":"CR19","aria-expanded":"false"},"children":[{"tag":"#text","text":"19"}]}]},{"tag":"#text","text":" and developed by Belsky and Kwon"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR60","class":"usa-link","aria-describedby":"CR60","aria-expanded":"false"},"children":[{"tag":"#text","text":"60"}]}]},{"tag":"#text","text":". Although PhenoAge is derived from eight clinical lab metrics, one specific parameter, C-reactive protein, is not frequently ordered in routine clinical settings. To maximize sample retention, we used the same strategy to retain the median value of observations over a 5-year (1-year for All of Us cohort) window centered on the plasma collection date. Following this imputation, our sub-cohort of the MGB Biobank cohort consisted of 17,252 participants, with 12,081 samples in the training set and 5,171 in the testing set, while the All of Us cohort finally consisted of 10,769 samples."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par53","children":[{"tag":"#text","text":"Additionally, we also conducted a comparative analysis by including both EMRAge and PhenoAge into the same regression model without additional covariates. HRs and ORs per s.d. were estimated for each aging-related health outcome in both the MGB training and testing sets, as well as in the All of Us cohort."}]}]},{"tag":"section","hidden":false,"id":"Sec28","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Development of DNAmEMRAge"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par54","children":[{"tag":"#text","text":"After developing the EMRAge measure, we next created a DNAm surrogate predictor of EMRAge using matched EPIC array data (DNAmEMRAge). To this end, we used the MGB-ABC cohort, which is a subset of the MGB Biobank that was created with the aim of possessing a proportionate aging biobank population. DNAm was generated from a total of 4,803 samples using the EPICv1 array. To allow for training, samples were then selected for having EMRAge quantified and the availability of chronological age and sex information, which retained 3,451 samples. Using an 80:20 train–test split, the glmnet R package"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR61","class":"usa-link","aria-describedby":"CR61","aria-expanded":"false"},"children":[{"tag":"#text","text":"61"}]}]},{"tag":"#text","text":" (version 4.1-8) was used to train a Gaussian penalized regression model using an alpha parameter of 0.1. Based on a previous paper that demonstrates the benefits of increasing the number of folds in cross-validation"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR62","class":"usa-link","aria-describedby":"CR62","aria-expanded":"false"},"children":[{"tag":"#text","text":"62"}]}]},{"tag":"#text","text":", we used 25-fold to identify an optimal lambda based on the alpha parameter. Sex was classified as Gender_M (males) and Gender_F (females) using one-hot encoding and was included as penalized features along with chronological age and the relative cell proportions of 12 immune cell types. All CpGs and the covariates mentioned were included as penalized features. Those features that showed a nonzero coefficient were selected for the final model."}]}]},{"tag":"section","hidden":false,"id":"Sec29","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Development of EBP models"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par55","children":[{"tag":"#text","text":"To reduce dimensionality, mitigate multicollinearity and enhance computational efficiency, we selected proteins and clinical phenotypes exhibiting a Pearson correlation coefficient greater than 0.1 with EMRAge. For metabolites, we used hierarchical clustering to group similar metabolites into distinct clusters. This approach leverages the observation that metabolites within the same cluster are highly intercorrelated, whereas metabolites between different clusters show only moderate-to-low correlation. Subsequently, from each identified cluster, we selected the metabolite demonstrating the strongest correlation with EMRAge."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par56","children":[{"tag":"#text","text":"For each significant clinical, metabolite and protein-group outcome, we fit Gaussian penalized regression (glmnet) with 25-fold cross-validation to select "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"λ"}]},{"tag":"#text","text":". We set "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"α"}]},{"tag":"#text","text":" = 0.1 to maximize CpG inclusion, except for smoking pack-years, total bilirubin and total cholesterol, where "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"α"}]},{"tag":"#text","text":" = 0.5 yielded the highest predicted-versus-observed correlation. Sex (one-hot: Gender_M, Gender_F) and chronological age were included as penalized covariates. Features with nonzero coefficients define each EBP. EBPs showing Pearson "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"ρ"}]},{"tag":"#text","text":" > 0.20 with "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" < 0.05 were retained as inputs for OMICmAge."}]}]},{"tag":"section","hidden":false,"id":"Sec30","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Development of OMICmAge"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par57","children":[{"tag":"#text","text":"OMICmAge was also developed using the MGB-ABC cohort ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 3,451) with an 80:20 train–test split. Penalized regression (alpha = 0.1) with 25-fold cross-validation to select lambda trained a single composite model on the training set to predict EMRAge. Predictors included all QC-passed CpG sites; selected clinical, metabolite and protein EBP estimates; relative abundances of 12 immune cell subtypes; and demographics (age, sex, BMI). Sex was one-hot encoded (Gender_M, Gender_F). Features with nonzero coefficients were retained in the final multivariate model."}]}]},{"tag":"section","hidden":false,"id":"Sec31","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Comparison of OMICmAge, DNAmEMRAge and previous clocks"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par58","children":[{"tag":"#text","text":"For comparison of OMICmAge and DNAmEMRAge clocks to previous methods of biological age prediction, we chose to analyze PCHorvath"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR10","class":"usa-link","aria-describedby":"CR10","aria-expanded":"false"},"children":[{"tag":"#text","text":"10"}]}]},{"tag":"#text","text":", PCHannum"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR11","class":"usa-link","aria-describedby":"CR11","aria-expanded":"false"},"children":[{"tag":"#text","text":"11"}]}]},{"tag":"#text","text":", PCPhenoAge"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR19","class":"usa-link","aria-describedby":"CR19","aria-expanded":"false"},"children":[{"tag":"#text","text":"19"}]}]},{"tag":"#text","text":", PCGrimAge"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR21","class":"usa-link","aria-describedby":"CR21","aria-expanded":"false"},"children":[{"tag":"#text","text":"21"}]}]},{"tag":"#text","text":" and DunedinPACE"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR22","class":"usa-link","aria-describedby":"CR22","aria-expanded":"false"},"children":[{"tag":"#text","text":"22"}]}]},{"tag":"#text","text":". We chose their PC versions as they have much better precision while still maintaining their relationships to health outcomes"},{"tag":"sup","hidden":false,"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#CR63","class":"usa-link","aria-describedby":"CR63","aria-expanded":"false"},"children":[{"tag":"#text","text":"63"}]}]},{"tag":"#text","text":". To compare the CpG sites included in each model, we used the non-PC clocks because the PC models do not contain CpG sites as predictors."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par59","children":[{"tag":"#text","text":"We evaluated associations between each clock and incident aging-related diseases (type 2 diabetes, stroke, depression, COPD, other CVDs, any type of cancer) using Cox proportional-hazards regression, and with prevalent diseases using logistic regression. All models adjusted for age, gender, race, BMI, smoking status and alcohol drinking habits. To predict 4-year, 5-year and 10-year survival, we fit simple logistic models with a binary survival flag as the outcome and each clock as the sole predictor, then generated receiver operating characteristic curves and model AUCs. For fair comparison across biomarkers, all metrics were standardized by subtracting the mean and dividing by the s.d., making DunedinPACE performance comparable to other aging biomarkers."}]}]}]},{"tag":"section","hidden":false,"id":"Sec32","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Statistics and reproducibility"}]},{"tag":"#text","text":"\n"},{"tag":"section","hidden":false,"id":"Sec33","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Programs and sample sizes"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par60","children":[{"tag":"#text","text":"All analyses were conducted in R (version 4.3.0 or later) using standard packages including minfi, ENmix, dplyr, ggplot2, glmnet, survival, pROC and stats. The primary training and validation datasets comprised 31,264 individuals from the MGB Biobank with complete clinical data, used for training ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 21,885) and testing ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 9,379) of EMRAge. Independent testing was performed in 10,769 participants from the All of Us cohort. The MGB-ABC ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 3,451) with clinical and methylation data was used for training ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 2,762) and testing ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 689) of DNAmEMRAge and OMICmAge. Additional validation datasets included Generation Scotland ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 18,672) and the TruDiagnostic Biobank ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"n"}]},{"tag":"#text","text":" = 14,213 with self-reported health and lifestyle information). Technical reliability of DNAmEMRAge and OMICmAge was assessed using 30 duplicate blood samples from the MGB-ABC cohort."}]}]},{"tag":"section","hidden":false,"id":"Sec34","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Statistical models"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par61","children":[{"tag":"#text","text":"Cox proportional-hazards models were applied to time-to-event outcomes (for example, all-cause mortality, incident cancer), whereas binomial logistic regression was used for binary outcomes (for example, cancer prevalence at plasma collection, sex). Multinomial logistic regression was applied for categorical traits with more than two classes (for example, smoking status and BMI category). Model assumptions included conditional independence and linearity for logistic regression and proportional hazards for Cox models. All input variables were standardized before modeling. Data were assumed to follow an approximately normal distribution, although this assumption was not formally tested. For technical reliability estimation, ICCs were calculated using a two-way random-effects model."}]}]},{"tag":"section","hidden":false,"id":"Sec35","children":[{"tag":"h4","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Multiple testing and blinding"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par62","children":[{"tag":"#text","text":"To account for multiple hypothesis testing, Benjamini–Hochberg FDR correction was applied across all aging biomarkers tested per phenotype. As these were prospective observational studies, there was no blinding to the conditions of the experiments."}]}]}]},{"tag":"section","hidden":false,"id":"Sec36","children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Reporting summary"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"id":"Par63","children":[{"tag":"#text","text":"Further information on research design is available in the "},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC13004675/#MOESM1","class":"usa-link"},"children":[{"tag":"#text","text":"Nature Portfolio Reporting Summary"}]},{"tag":"#text","text":" linked to this article."}]}]}]},{"tag":"section","hidden":false,"id":"Sec38","children":[{"tag":"h2","hidden":false,"attributes":{"class":"pmc_sec_title","data-anchor-id":"Sec38"},"children":[{"tag":"a","hidden":false,"id":"Sec38-anchor","attributes":{"data-anchor-id":"Sec38","class":"usa-anchor"}},{"tag":"#text","text":"Supplementary information"}]},{"tag":"#text","text":"\n"},{"tag":"section","hidden":false,"id":"MOESM1","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/13004675/bin/43587_2026_1073_MOESM1_ESM.pdf","data-ga-action":"click_feat_suppl","class":"usa-link"},"children":[{"tag":"#text","text":"Reporting Summary"}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (95.1KB, pdf) "}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"id":"MOESM2","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/13004675/bin/43587_2026_1073_MOESM2_ESM.xlsx","data-ga-action":"click_feat_suppl","class":"usa-link"},"children":[{"tag":"span","hidden":false,"children":[{"tag":"#text","text":"Supplementary Table 1"}]}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (13.3KB, xlsx) "}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Demographics for the study populations used for developing and validating EMRAge, DNAmEMRAge and OMICmAge."}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"id":"MOESM3","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/13004675/bin/43587_2026_1073_MOESM3_ESM.xlsx","data-ga-action":"click_feat_suppl","class":"usa-link"},"children":[{"tag":"span","hidden":false,"children":[{"tag":"#text","text":"Supplementary Table 2"}]}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (9.8KB, xlsx) "}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The extracted clinical phenotypes ("},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"N"}]},{"tag":"#text","text":" = 28) from the MGB Biobank."}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"id":"MOESM4","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/13004675/bin/43587_2026_1073_MOESM4_ESM.xlsx","data-ga-action":"click_feat_suppl","class":"usa-link"},"children":[{"tag":"span","hidden":false,"children":[{"tag":"#text","text":"Supplementary Table 3"}]}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (18.2KB, xlsx) "}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Selected clinical variables and their estimated weighting for calculation of EMRAge."}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"id":"MOESM5","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/13004675/bin/43587_2026_1073_MOESM5_ESM.xlsx","data-ga-action":"click_feat_suppl","class":"usa-link"},"children":[{"tag":"span","hidden":false,"children":[{"tag":"#text","text":"Supplementary Table 4"}]}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (42.5KB, xlsx) "}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"HRs, ORs, "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" values and standard deviations of associations between EMRAge, PhenoAge or chronological age and aging-related diseases in the MGB cohort. The models were adjusted for chronological age (if EMRAge or PhenoAge), sex, race, smoking status and alcohol consumption."}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"id":"MOESM6","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/13004675/bin/43587_2026_1073_MOESM6_ESM.xlsx","data-ga-action":"click_feat_suppl","class":"usa-link"},"children":[{"tag":"span","hidden":false,"children":[{"tag":"#text","text":"Supplementary Table 5"}]}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (32KB, xlsx) "}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"HRs, ORs and "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" values for EMRAge and PhenoAge, when both variables are included as predictors in a single linear model with aging-related health outcomes, in the MGB cohort. This model compares the relative effect sizes for EMRAge and PhenoAge when included together in one model. No additional adjustment for covariates is included in these models."}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"id":"MOESM7","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/13004675/bin/43587_2026_1073_MOESM7_ESM.xlsx","data-ga-action":"click_feat_suppl","class":"usa-link"},"children":[{"tag":"span","hidden":false,"children":[{"tag":"#text","text":"Supplementary Table 6"}]}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (11.8KB, xlsx) "}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"HRs of one standard unit change of EMRAge, PhenoAge or chronological age to all-cause mortality or incident aging-related diseases in the All of Us cohort."}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"id":"MOESM8","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"ht