pplementary Table 20"}]}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (267.7KB, xlsx) "}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"SNOMED codes for aging-related diseases in All of Us."}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"id":"db_ds_supplementary-material22_reqid_","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/13004675/bin/43587_2026_1073_MOESM22_ESM.xlsx","data-ga-action":"click_feat_suppl","class":"usa-link"},"children":[{"tag":"span","hidden":false,"children":[{"tag":"#text","text":"Supplementary Table 21"}]}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (441.6KB, xlsx) "}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"SNOMED codes for Charlson Comorbidity Index in All of Us."}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"id":"db_ds_supplementary-material23_reqid_","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/13004675/bin/43587_2026_1073_MOESM23_ESM.xlsx","data-ga-action":"click_feat_suppl","class":"usa-link"},"children":[{"tag":"span","hidden":false,"children":[{"tag":"#text","text":"Supplementary Table 22"}]}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (343.6KB, xlsx) "}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Diagnostic codes for aging-related diseases in GS cohort."}]},{"tag":"#text","text":"\n"}]}]}]},{"tag":"section","hidden":false,"id":"db_ds_supplementary-material24_reqid_","attributes":{"class":"sm xbox font-sm"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"media p"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"tag":"a","hidden":false,"attributes":{"href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/13004675/bin/43587_2026_1073_MOESM24_ESM.xlsx","data-ga-action":"click_feat_suppl","class":"usa-link"},"children":[{"tag":"span","hidden":false,"children":[{"tag":"#text","text":"Source Data Extended Data Fig. 5"}]}]},{"tag":"sup","hidden":false,"children":[{"tag":"#text","text":" (25.1KB, xlsx) "}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Tables of Pearson correlation coefficients and associated "},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"P"}]},{"tag":"#text","text":" values on relationship between DNAm-based aging biomarkers and age, sex or immune cell fractions."}]},{"tag":"#text","text":"\n"}]}]}]}]},{"tag":"section","hidden":false,"id":"_adda93_","attributes":{"lang":"en","class":"data-availability-statement"},"children":[{"tag":"h3","hidden":false,"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Data Availability Statement"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The data used in this study were generated from two biobank cohorts housed at MGB and TruDiagnostic, respectively. Requests for raw data, analyzed data and materials used in MGB and TruDiagnostic Biobank cohorts to generate the results in this study will be reviewed by the contact PIs (J.L.-S. or V.B.D.). Due to participant consent restrictions, individual-level data linked to electronic health records cannot be made publicly available. However, we are committed to supporting scientific collaboration and transparency wherever possible. Researchers interested in noncommercial academic use of the data, algorithms or derived biomarkers are encouraged to contact the corresponding author (J.L.-S.) or first author (V.B.D., varun@trudiagnostic.com). Upon review, a collaborative agreement or data use agreement can be established to enable:"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"• Access to de-identified omics data for research purposes"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"• Application of algorithms or generation of derived biomarker scores on external datasets"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"• Internal use of electronic health record-linked clinical data for validation, replication or joint analyses with external collaborators"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Requests will be assessed to determine whether they are subject to intellectual property or confidentiality obligations. Access to certain raw or analyzed data may be restricted if it relates to ongoing or future patent filings, or if release could compromise the commercialization strategy of MGB or TruDiagnostic. Access may also be limited for data containing proprietary algorithms or other commercially sensitive information. We welcome such requests and aim to respond within 30 days."}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Publicly available datasets referenced in this study include:"}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"• All of Us Research Program: "},{"tag":"a","hidden":false,"attributes":{"href":"https://allofus.nih.gov/","class":"usa-link","data-ga-action":"click_feat_suppl","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"https://allofus.nih.gov/"}]}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"• Generation Scotland: "},{"tag":"a","hidden":false,"attributes":{"href":"https://genscot.ed.ac.uk/","class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"https://genscot.ed.ac.uk/"}]}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"• SEER proteomics data for the MGB-ABC cohort are available under PRIDE accession "},{"tag":"a","hidden":false,"attributes":{"href":"http://proteomecentral.proteomexchange.org/cgi/GetDataset?ID=PXD048709","class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"PXD048709"}]}]},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Code to calculate all metrics is accessible via TruDiagnostic’s DNAm Analysis Software. You can request access to the software at "},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/softwarerequest/","class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"https://www.trudiagnostic.com/softwarerequest/"}]},{"tag":"#text","text":", at no cost for research purposes. Access is contingent upon the requestor agreeing to a standard, noncommercial software license agreement that confirms the intended use is strictly for academic, nonprofit research and that the requestor will not attempt to reverse engineer or commercially exploit the software. All R codes used to develop and validate EMRAge, DNAmEMRAge and OMICmAge are available at "},{"tag":"a","hidden":false,"attributes":{"href":"https://github.com/LaskySuLab/OMICmAge/","class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","target":"_blank","rel":"noopener noreferrer"},"children":[{"tag":"#text","text":"https://github.com/LaskySuLab/OMICmAge/"}]},{"tag":"#text","text":"."}]}]}]}]},{"tag":"footer","hidden":false,"attributes":{"class":"p courtesy-note font-secondary font-sm text-center"},"children":[{"tag":"hr","hidden":false,"attributes":{"class":"headless"}},{"tag":"#text","text":"\n"},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Articles from Nature Aging are provided here courtesy of "},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Nature Publishing Group"}]}]}]}]}]},{"tag":"#text","text":"\n\n                      \n\n                    "}]},{"tag":"#text","text":"\n                "}]},{"tag":"#text","text":"\n            "}]},{"tag":"#text","text":"\n        "}]},{"tag":"#text","text":"\n\n        \n\n\n\n"},{"tag":"#text","text":"\n"},{"tag":"div","hidden":false,"attributes":{"class":"pmc-sidenav desktop:grid-col-4 display-flex"},"children":[{"tag":"#text","text":"\n    "},{"tag":"section","hidden":false,"attributes":{"class":"pmc-sidenav__container","aria-label":"Article resources and navigation"},"children":[{"tag":"#text","text":"\n        "},{"tag":"button","hidden":false,"attributes":{"type":"button","class":"pmc-sidenav__container__close"},"children":[{"tag":"#text","text":"\n            "},{"tag":"img","hidden":false,"attributes":{"src":"https://cdn.ncbi.nlm.nih.gov/pmc/pd-medc-pmc-cloudpmc-viewer/production/9b1d9d87/var/data/static/img/usa-icons/close.svg","role":"img","alt":"Close","width":"300","height":"150"}},{"tag":"#text","text":"\n        "}]},{"tag":"#text","text":"\n    "},{"tag":"div","hidden":false,"attributes":{"class":"display-none desktop:display-block"},"children":[{"tag":"#text","text":"\n       "},{"tag":"section","hidden":false,"attributes":{"class":"margin-top-4 desktop:margin-top-0"},"children":[{"tag":"#text","text":"\n              "},{"tag":"h2","hidden":false,"attributes":{"class":"margin-top-0"},"children":[{"tag":"#text","text":"ACTIONS"}]},{"tag":"#text","text":"\n           "},{"tag":"ul","hidden":false,"attributes":{"class":"usa-list usa-list--unstyled usa-li