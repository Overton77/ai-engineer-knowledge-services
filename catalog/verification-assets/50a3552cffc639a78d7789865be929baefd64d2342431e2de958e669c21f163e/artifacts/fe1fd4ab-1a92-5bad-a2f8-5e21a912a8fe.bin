ly working."}]},{"tag":"div","hidden":false,"attributes":{"class":"item-results-v2_title"},"children":[{"tag":"#text","text":"HOW TRUDIAGNOSTIC MAY HELP"}]},{"tag":"div","hidden":false,"attributes":{"class":"item-results-v2_text mt8"},"children":[{"tag":"#text","text":"TruAge can give her a full picture across biological age, individual organ systems through the SYMPHONYAge clocks, and pace of aging. In a profile like Elena’s, seeing immune and heart ages running ahead of calendar age could focus her plan, and ongoing testing may show her aging speed easing from 1.11 toward 0.88 as her organ ages trend younger."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item-results-v2_cta-wrap"},"children":[{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-transparent--variant":"full","href":"https://portal.trudiagnostic.com/sign-in","class":"cta-transparent w-variant-cc64accf-5b4f-aad9-61af-c2fc1b05ec90 w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular white cta"},"children":[{"tag":"#text","text":"Start Testing"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-transparent-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]}]}]}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item-results-mobile-v2"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-results-mobile-v2_head","aria-expanded":"false","aria-controls":"faq-panel-1"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-results-mobile-v2_avatar"},"children":[{"tag":"img","hidden":false,"attributes":{"src":"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a5df758dfaf827d52c757aa_Avatar.png","loading":"lazy","alt":"","class":"item-results-mobile-v2_avatar-img"}}]},{"tag":"div","hidden":false,"attributes":{"class":"item-results-mobile-v2_info"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-results-mobile-v2_name"},"children":[{"tag":"#text","text":"HEART HEALTH"}]},{"t