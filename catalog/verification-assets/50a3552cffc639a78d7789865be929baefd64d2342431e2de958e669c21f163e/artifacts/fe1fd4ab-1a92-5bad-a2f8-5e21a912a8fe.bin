:[{"tag":"div","hidden":false,"attributes":{"class":"padding-global"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"container-large"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"faq-with-image_wrapper"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"faq-with-image_title-wrap"},"children":[{"tag":"h2","hidden":false,"attributes":{"class":"title-h2-new blue"},"children":[{"tag":"#text","text":"How TruAge Benefits Your Clinic"}]}]},{"tag":"div","hidden":false,"attributes":{"class":"faq-with-image_text-wrap"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular is-dark"},"children":[{"tag":"#text","text":"TruAge is a precision longevity tool that analyzes more than 75 essential aging biomarkers to empower healthcare providers with personalized recommendations to help patients live longer, healthier lives."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"faq-with-image_layout"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"faq-with-image_content"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"faq-with-image_faq"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2 is-full"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_head","aria-expanded":"false","aria-controls":"faq-panel-0"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_title"},"children":[{"tag":"#text","text":"Establish a baseline"}]},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon-vertical"}},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon-horizontal"}}]}]},{"tag":"div","hidden":false,"id":"faq-panel-0","attributes":{"class":"item-faq-v2_panel"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"item-faq-v2_text"},"children":[{"tag":"#text","text":"An initial test establishes where your patient stands biologically today, giving you the clinical anchor that turns every follow-up visit into a progress conversation."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2 is-full"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_head","aria-expanded":"false","aria-controls":"faq-panel-1"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_title"},"children":[{"tag":"#text","text":"Personalize a care plan"}]},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon-vertical"}},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon-horizontal"}}]}]},{"tag":"div","hidden":false,"id":"faq-panel-1","attributes":{"class":"item-faq-v2_panel"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"item-faq-v2_text"},"children":[{"tag":"#text","text":"When your patient’s history and labs leave the picture incomplete,  fill the gaps with the biological context you need to build a care plan that actually fits."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2 is-full"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_head","aria-expanded":"false","aria-controls":"faq-panel-2"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_title"},"children":[{"tag":"#text","text":"Monitor intervention response"}]},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon-vertical"}},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon-horizontal"}}]}]},{"tag":"div","hidden":false,"id":"faq-panel-2","attributes":{"class":"item-faq-v2_panel"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"item-faq-v2_text"},"children":[{"tag":"#text","text":"Show whether the protocols you’re recommending are actually working at the biological level, giving your patients evidence  that lifestyle changes are making a measurable difference."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2 is-full"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_head","aria-expanded":"false","aria-controls":"faq-panel-3"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_title"},"children":[{"tag":"#text","text":"Prioritize areas for follow-up"}]},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon-vertical"}},{"tag":"div","hidden":false,"attributes":{"class":"item-faq-v2_icon-horizontal"}}]}]},{"tag":"div","hidden":false,"id":"faq-panel-3","attributes":{"class":"item-faq-v2_panel"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"item-faq-v2_text"},"children":[{"tag":"#text","text":"When a patient has multiple concerns, testing helps you see which biological systems need the most attention, turning a complex clinical picture into a clear set of priorities."}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"faq-with-image_cta-wrap"},"children":[{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-yellow--variant":"full-width-height","href":"https://portal.trudiagnostic.com/sign-in","class":"cta-yellow w-variant-5b9601e6-6a59-2b05-1b12-8de340a701eb w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue cta"},"children":[{"tag":"#text","text":"Start Testing"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon-v2 w-embed"},"children":[{"tag":"#text","text":"\n"}]}]},{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-blue--variant":"full-width-height","href":"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/684b0280d60621d