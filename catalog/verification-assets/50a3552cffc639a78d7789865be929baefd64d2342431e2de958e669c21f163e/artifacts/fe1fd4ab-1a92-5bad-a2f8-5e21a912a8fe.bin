er, or as expected for your calendar age. It’s ideal for tracking the effectiveness of lifestyle and protocol interventions over time — regular monitoring shows how lifestyle and other interventions may impact biological age, giving patients the data and motivation to stay on track."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"developed_cta-wrap"},"children":[{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-yellow--variant":"modify","href":"https://www.trudiagnostic.com/dunedin-pace","class":"cta-yellow w-variant-927ae097-63d8-7236-ec7b-a65ed4a0b41b w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue cta"},"children":[{"tag":"#text","text":"Learn More"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon w-variant-927ae097-63d8-7236-ec7b-a65ed4a0b41b w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon-v2 w-variant-927ae097-63d8-7236-ec7b-a65ed4a0b41b w-embed"},"children":[{"tag":"#text","text":"\n"}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"developed_image"},"children":[{"tag":"img","hidden":false,"attributes":{"src":"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a5e018cee9272a0cc6bcdb4_Image.png","loading":"lazy","alt":"","class":"developed_img"}}]}]}]}]}]}]}]},{"tag":"section","hidden":false,"attributes":{"class":"section_choose"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"padding-global"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"container-large"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"choose_wrapper"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"choose_title-wrap"},"children":[{"tag":"h2","hidden":false,"attributes":{"class":"title-h2-new white"},"children":[{"tag":"#text","text":"Why Physicians Choose TruAge"}]}]},{"tag":"div","hidden":false,"attributes":{"class":"choose_subtitle-wrap"},"children"