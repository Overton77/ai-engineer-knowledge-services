children":[{"tag":"#text","text":"Saliva"}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"table-choose_col is-no-border"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"table-choose_text-wrap"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"table-choose_title"},"children":[{"tag":"#text","text":"Saliva"}]}]}]}]}]}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"choose_code w-embed"}}]},{"tag":"section","hidden":false,"attributes":{"class":"section_faq-new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"padding-global new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"container-large medium"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"faq-new_wrapper"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"faq-new_content"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"faq-new_title-wrap"},"children":[{"tag":"h2","hidden":false,"attributes":{"class":"title-h2-new blue"},"children":[{"tag":"#text","text":"FAQs"}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"faq-new_list"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-flex"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"label-large-2 ls-1"},"children":[{"tag":"#text","text":"Which biomarkers are tested with TruAge?"}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-icon"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-minus"}},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-plus"}}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-content w-richtext"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"TruAge measures biological age, aging speed, and organ-level aging through multiple aging clocks and epigenetic biomarker panels. All TruAge reports include three core aging clocks, each analyzing a distinct set of biomarkers from a single blood sample:"},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"OMICmAge™"}]},{"tag":"#text","text":", our primary biological age clock developed with Harvard, analyzes epigenetic biomarkers spanning proteins, metabolites, and clinical measures: Albumin, Hemoglobin, HbA1c, Hematocrit, Blood Urea Nitrogen, Alkaline Phosphatase, IGFBP-2, Carboxypeptidase B2, Serum Paraoxonase/Arylesterase 1 (PON1), Ribonuclease Pancreatic, Inter-Alpha-Trypsin Inhibitor Heavy Chain H3 (ITIH3), Ribitol, Phenylacetylglutamine, Uridine, 4-Methoxyphenol Sulfate, 1-Margaroyl-Glycerophospholipid (GPE)(17:0), Vanillactic Acid, Red Blood Cell Distribution Width, Creatinine, Fasting Glucose, Carotene Diol, Bone Morphogenetic Protein 1 (BMP1), Versican Core Protein, N-Acetyl-Isoputreanine, Gluconate, 4-Hydroxyphenylacetylglutamine, Androsterone Sulfate, 3-Ureidopropionate, 1-Stearoyl-2-Adrenoyl-GPC (18:0/22:4), and Histone H2B Type 1-K."},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"DunedinPACE™"}]},{"tag":"#text","text":", our aging speed clock developed with Duke, uses DNA methylation patterns across the epigenome to calculate your patient's pace of aging – the number of biological years elapsed per calendar year – providing a dynamic rate of aging rather than a static biological age estimate."},{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"SYMPHONYAge™"}]},{"tag":"#text","text":", our organ-level age clock developed with Yale, analyzes clinical biomarkers across 11 organ systems:"}]},{"tag":"ul","hidden":false,"attributes":{"role":"list"},"children":[{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Blood"}]},{"tag":"#text","text":": Ferritin, Hematocrit, Hemoglobin, Mean Corpuscular Hemoglobin, Mean Corpuscular Hemoglobin Concentration, Mean Corpuscular Volume, Mean Platelet Volume, Platelet Distribution Width, Platelet Count, Red Blood Cell Count, Red Cell Distribution Width"}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Brain"}]},{"tag":"#text","text":": Homocysteine, BDNF (serum), Clusterin, Stroke, Total Mental Status Summary Score, Total Cognition Summary Score, Immediate Word Recall, Delayed Word Recall, Total Word Recall Summary Score, Serial 7s"}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Inflammation"}]},{"tag":"#text","text":": Ferritin, C-Reactive Protein, Transforming Growth Factor Beta, Interleukin-10, Interleukin-1 Receptor Antagonist, Interleukin-6, Tumor Necrosis Factor Receptor 1"}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Heart"}]},{"tag":"#text","text":": Shortness of Breath While Awake, PC Components of GrimAge, Previous High Blood Pressure, Previous Heart Attack, Previous Stroke, Homocysteine, BMI"}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Hormone"}]},{"tag":"#text","text":": IGF-1, DHEA-S"}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Immune"}]},{"tag":"#text","text":": Eosinophil Count, Lymphocyte Count, Monocyte Count, Neutrophil Count, Percent Basophils, Percent Eosinophils, Percent Lymphocytes, Percent Monocytes, White Blood Cell Count, Myeloid Dendritic Cells (DC-M) Percentage, Plasmacytoid Dendritic Cells (DC-P) Percentage, NK Cells CD56HI Percentage, NK Cells CD56LO Percentage, CD16- Monocytes Percentage, CD16+ Monocytes Percentage, B Cells Percentage, CD8+ T Cells Central Memory Percentage, CD4+ T Cells Central Memory Percentage, CD8+ T Cells Percentage, CD8+ T Cells TemRA Percentage, CD4+ T Cells TemRA Percentage, CD4+ T Cells Percentage, IgD+ Memory B Cells Percentage, IgD- Memory B Cells Percentage, CD8+ T Cells Naïve Percentage, CD4+ T Cells Naïve Percentage, T Cells Percentage, Naïve B Cells Percentage, CD8+ T Cells Effector Memory Percentage, CD4+ T Cells Effector Memory Percentage, Natural Killer (NK) Cells Percentage, Monocytes Percentage, Dendritic Cells Percentage"}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Kidney"}]},{"tag":"#text","text":": Albumin, Urea Nitrogen, Chloride, Bicarbonate, Creatinine, Cystatin C, Potassium, Sodium"}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Liver"}]},{"tag":"#text","text":": Albumin, Alkaline Phosphatase, ALT, AST, Bilirubin, Total Protein"}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Metabolic"}]},{"tag":"#text","text":": PC Smoking Pack-Years, Previous Diabetes, C-Reactive Protein, Fasting Glucose, HDL Cholesterol, LDL Cholesterol, Triglycerides, Interleukin-6, BMI, Waist Circumference"}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Lung"}]},{"tag":"#text","text":": Peak Expiratory Flow, Bicarbonate, Chronic Lung Disease, Shortness of Breath While Awake, Persistent Wheezing/Cough/Phlegm, PC Smoking Pack-Years"}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Musculoskeletal"}]},{"tag":"#text","text":": Vitamin D3, DHEA-S, IGF-1"}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-flex"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"label-large-2 ls-1"},"children":[{"tag":"#text","text":"How does TruAge measure biological age?"}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-icon"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-minus"}},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-plus"}}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-content w-richtext"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"TruAge measures biological age through DNA methylation (DNAm) analysis – a chemical tagging system cells use to regulate gene activity. Rather than analyzing genetic sequence, TruAge reads epigenetic patterns across more than 1,000,000 sites on a patient's DNA. These patterns shift with age, lifestyle, and environment, making them a more dynamic and clinically meaningful signal than a birth date alone."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-flex"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"label-large-2 ls-1"},"children":[{"tag":"#text","text":"Why is measuring epigenetic aging important?"}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-icon"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-minus"}},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-plus"}}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-content w-richtext"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Aging is the single largest risk factor for all-cause mortality and most chronic disease. But chronological age – the number a patient celebrates on their birthday – tells you very little about their current biological health trajectory. Two patients born the same year can have dramatically different cellular ages and aging rates depending on genetics, environment, lifestyle, and medical history."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Epigenetic biomarkers fill a gap that conventional labs can't. Traditional blood biomarkers are snapshot measurements – highly sensitive to near-term factors like meals, hydration, or acute stress. DNA methylation patterns, by contrast, reflect a sustained biological signal across weeks to months. They can reveal whether a patient is progressing toward disease risk faster than expected, whether a current intervention is actually working at the cellular level, and which organ systems are most under biological strain."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Crucially, epigenetic age is modifiable. Unlike genetic tests, which produce a fixed result, DNAm-based measurements change in response to diet, exercise, sleep, medications, and other interventions. That makes them an actionable tool for longitudinal patient monitoring – not just a one-time assessment."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-flex"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"label-large-2 ls-1"},"children":[{"tag":"#text","text":"What type of patients benefit from TruAge?"}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-icon"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-minus"}},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-plus"}}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-content w-richtext"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"TruAge is most clinically useful for patients who are motivated to understand and address their long-term health trajectory – and for providers who want objective, longitudinal data to guide preventive or lifestyle medicine protocols."},{"tag":"br","hidden":false},{"tag":"#text","text":"​"},{"tag":"br","hidden":false},{"tag":"#text","text":"Strong candidate profiles include:"},{"tag":"br","hidden":false},{"tag":"#text","text":"​"},{"tag":"br","hidden":false},{"tag":"#text","text":"• Patients with unexplained symptoms or accelerated phenotypic aging (fatigue, cognitive changes, metabolic dysfunction) where conventional labs are inconclusive"},{"tag":"br","hidden":false},{"tag":"#text","text":"• Patients managing chronic disease risk factors (cardiovascular disease, metabolic syndrome, obesity) who want to track biological progress beyond traditional markers"},{"tag":"br","hidden":false},{"tag":"#text","text":"• Patients on active interventions – including GLP-1 agonists, caloric restriction, exercise protocols, or supplementation – where you want to measure cellular impact, not just clinical endpoints"},{"tag":"br","hidden":false},{"tag":"#text","text":"• Patients interested in longevity and preventive medicine who are looking for a quantitative baseline and repeat testing to track progress over time"},{"tag":"br","hidden":false},{"tag":"#text","text":"• Patients with a family history of age-related disease who are seeking earlier, actionable risk insight"},{"tag":"br","hidden":false},{"tag":"#text","text":"​"},{"tag":"br","hidden":false},{"tag":"#text","text":"Because TruAge is not a diagnostic test, it is best positioned as an adjunct to clinical evaluation – a longitudinal signal to complement, not replace, standard workup."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-flex"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"label-large-2 ls-1"},"children":[{"tag":"#text","text":"What are the validated clinical outcomes for TruAge?"}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-icon"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-minus"}},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-plus"}}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-content w-richtext"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"TruAge's underlying aging clocks and algorithms are each published in peer-reviewed literature and validated against hard outcomes across large longitudinal cohorts."},{"tag":"br","hidden":false},{"tag":"#text","text":"​"},{"tag":"br","hidden":false},{"tag":"#text","text":"Key validated associations include:"},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"• OMICmAge – our biological age clock developed in partnership with Harvard University, was published most recently in Nature Aging² and validated across multiple independent cohorts. Head-to-head benchmarking showed OMICmAge matched or exceeded all other tested clocks on 5- and 10-year survival prediction."},{"tag":"br","hidden":false},{"tag":"#text","text":"• SYMPHONYAge – our organ-level clock has been validated at Yale to reflect differential aging across tissue systems."},{"tag":"br","hidden":false},{"tag":"#text","text":"• DunedinPACE – our aging speed clock has been validated as the strongest epigenetic predictor of mortality among 14 consensus biomarkers of aging, as demonstrated in the peer-reviewed, BASE-II cohort study¹."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-flex"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"label-large-2 ls-1"},"children":[{"tag":"#text","text":"How do I order TruAge?"}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-icon"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"item_faq-minus"}},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-plus"}}]}]},{"tag":"div","hidden":false,"attributes":{"class":"item_faq-content w-richtext"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Providers order directly through the TruDiagnostic Provider Portal. Once your account is set up, you can place orders for clinic delivery or patient drop-ship."},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"Full pricing is available in the Provider Portal once your account is active. To get started, register as a provider at "},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/provider-application","target":"_blank"},"children":[{"tag":"#text","text":"www.trudiagnostic.com/provider-application."}]}]}]}]}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"faq-new_script w-embed w-script"},"children":[{"tag":"script","hidden":true}]}]},{"tag":"section","hidden":false,"attributes":{"class":"section_reference"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"padding-global"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"container-large"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"reference_wrapper"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"reference_rich w-richtext"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"REFERENCES"}]},{"tag":"ol","hidden":false,"attributes":{"role":"list"},"children":[{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Demuth I, et al. Comparing fourteen consensus biomarkers of aging: epigenetic pace of aging as the strongest predictor of mortality in BASE-II. Biomarker Research. 2026. PMID: 41792861. "},{"tag":"a","hidden":false,"attributes":{"href":"https://link.springer.com/article/10.1186/s40364-026-00909-z","target":"_blank"},"children":[{"tag":"#text","text":"https://link.springer.com/article/10.1186/s40364-026-00909-z"}]}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Dwaraka V, et al. OMICmAge: An integrative multi-omics approach to quantify biological age with electronic medical records. Nature Aging. 2026. "},{"tag":"a","hidden":false,"attributes":{"href":"https://www.nature.com/articles/s43587-026-01073-7","target":"_blank"},"children":[{"tag":"#text","text":"https://www.nature.com/articles/s43587-026-01073-7"}]}]}]}]}]}]}]}]}]},{"tag":"footer","hidden":false,"attributes":{"class":"footer below-fold"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"footer-new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"padding-global padding-section-footer"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"container-large"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"footer_wrapper new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"footer_top new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"footer-new_col"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"footer-new_col-title"},"children":[{"tag":"#text","text":"About"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/about-us","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"About Us"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://trudiagnostic.my.site.com/support/s/?language=en_US","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Help Center"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/careers","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Careers"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://manage.kmail-lists.com/subscriptions/subscribe?a=LmGkBQ&g=W7Xgyt","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Newsletter"}]}]},{"tag":"div","hidden":false,"attributes":{"class":"footer-new_col"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"footer-new_col-title"},"children":[{"tag":"#text","text":"Partners"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/become-a-provider","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Become a Provider"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/become-an-affiliate","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Become an Affiliate"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/research-services","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Research Services"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/requisition-form","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Requisition Form"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://trudiagnostic.notion.site/Tru-Diagnostic-v2-API-100865e61b7e803fa038dee5e55e6cc2","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"API Reference"}]}]},{"tag":"div","hidden":false,"attributes":{"class":"footer-new_col"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"footer-new_col-title"},"children":[{"tag":"#text","text":"Members"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://portal.trudiagnostic.com/sign-in","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Log In"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://portal.trudiagnostic.com/registration","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Register My Kit"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://portal.trudiagnostic.com/sign-in","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"View My Reports"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/return-and-refund-policy","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Return Policy"}]}]},{"tag":"div","hidden":false,"attributes":{"class":"footer-new_col"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"footer-new_col-title"},"children":[{"tag":"#text","text":"CONTACT"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/about-truage#","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"881 Corporate Dr. "},{"tag":"br","hidden":false},{"tag":"#text","text":"Lexington, KY 40503"}]},{"tag":"div","hidden":false,"attributes":{"class":"footer-new_col-flex"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"tel:+18889093634","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"(888) 909-3634"}]},{"tag":"div","hidden":false,"id":"standartTime","attributes":{"class":"footer-span"},"children":[{"tag":"#text","text":"Mon-Fri 9am-7pm | Sat 9am-3pm"},{"tag":"br","hidden":false},{"tag":"#text","text":"Eastern Time (UTC-4:00)"}]}]},{"tag":"a","hidden":false,"attributes":{"href":"mailto:support@trudiagnostic.com","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"support@trudiagnostic.com"}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"footer_bot new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"footer-span"},"children":[{"tag":"#text","text":"DNAm biomarker outputs are intended to support, not replace, clinical judgment. They should be interpreted within the full clinical context, including history, physical examination, conventional laboratory testing, and imaging studies where clinically indicated. They should not be used as the sole basis for diagnosis or treatment decisions."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"footer_copyright"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"footer_copyright-left"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/terms-of-service","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Terms of Service"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/privacy-policy","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"Privacy Policy"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://www.trudiagnostic.com/fcoi-policy","class":"footer-new_col-item"},"children":[{"tag":"#text","text":"FCIO Policy"}]}]},{"tag":"div","hidden":false,"attributes":{"class":"footer-span"},"children":[{"tag":"#text","text":"© TruDiagnostic 2026, All Rights Reserved"}]}]}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"footer_code w-embed w-script"},"children":[{"tag":"script","hidden":true}]}]}]},{"tag":"script","hidden":true},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n\n"},{"tag":"#text","text":"\n"},{"tag":"noscript","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n"},{"tag":"noscript","hidden":true},{"tag":"#text","text":"\n"},{"tag":"#text","text":"\n\n"},{"tag":"#text","text":"\n"},{"tag":"#text","text":"\n\n"},{"tag":"#text","text":"\n"},{"tag":"#text","text":"\n\n\n\n"},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n\n"},{"tag":"script","hidden":true},{"tag":"#text","text":"\n"}]}]},"canonicalText":"\n\n\n  Skip to main content\n🇺🇸 Labor Day: 20% off all tests—save up to $340. Ends Sept 8. Use code LABORDAY26\n\nProviders\nBecome a Provider\n\nOur TestsAbout TruAgeAbout TruHealthResourcesClinical Case StudiesReport EducationIntervention TrackingIndividuals\nPatientsShop All TestsTruHealth + TruAgeTruHealthTruAgePartners\nOur ServicesResearch ServicesCommercial ServicesWork With Us\n\nOur Science\nScienceOur LaboratoryWhat is epigenetics?Our ArraysIntervention TrackingAlgorithmsOMICmAgeSYMPHONYAgeDunedinPACEOur Publications\n\n\n\nLog In\n\nProvidersBecome a ProviderAbout TruAgeAbout TruHealthClinical Case StudiesReport EducationIntervention TrackingIndividualsShop All TestsTruHealth + TruAgeTruHealthTruAgePartnersResearch ServicesCommercial ServicesWork With UsOur ScienceOur LaboratoryOur ArraysIntervention TrackingDNA MethylationOMICmAgeSYMPHONYAgeDunedinPACEOur Publications\n\n\nTRUAGE™The Most Trusted Biological Age TestTruAge combines 3 of the most advanced epigenetic age clocks to deliver a multi-dimensional view of how a patient's body is aging.Download Sample Report\n\n\n\n\n\n\nPOWERED BY SCIENCE FROMWhat Epigenetics Reveals about AgingHow old is the body biologically?The OMICmAge™ algorithm is a multi-omic–informed methylation clock that quantifies biological age against chronological age.OMICmAge™\nWhich organ systems are aging fastest?The SymphonyAge™ algorithm reveals the age of 11 organ systems key for longevity.SymphonyAge™\nHow fast is the patient aging right now?The DunedinPACE™ algorithm can track how fast the body is aging and the impact of lifestyle changes.DunedinPACE™\nThe Results of Epigenetic TestingExample shown for illustrative purposes; not an actual patient resultPROACTIVE LONGEVITYElena M.HEART HEALTHRobert K.COGNITIVE HEALTHSarah L.ATHLETIC PERFORMANCETyler R.Elena feels healthy but has a family history of early heart disease and wants an objective baseline before problems appear. She is tired of guessing whether her habits are actually working.HOW TRUDIAGNOSTIC MAY HELPTruAge can give her a full picture across biological age, individual organ systems through the SYMPHONYAge clocks, and pace of aging. In a profile like Elena’s, seeing immune and heart ages running ahead of calendar age could focus her plan, and ongoing testing may show her aging speed easing from 1.11 toward 0.88 as her organ ages trend younger.Start Testing\nYEAR 11.11AGING SPEEDBIOLOGICAL AGE+4 yrsHEART AGE+3 yrsBRAIN AGE+2 yrsIMMUNE AGE+5 yrsYEAR 334%INFLAMMATIONBIOLOGICAL AGE−2 yrsHEART AGE0 yrsBRAIN AGE−1 yrIMMUNE AGE+1 yrRobert has had a borderline stress test and wants to know how old his cardiovascular system really is, not just his cholesterol number. He is looking for something concrete to hold himself accountable to.HOW TRUDIAGNOSTIC MAY HELPTruAge SYMPHONYAge can break his aging down by organ system and reveal whether his heart age is running ahead of his calendar age. In a profile like Robert’s, that insight could guide care alongside his cardiologist, and repeat testing may show his heart age moving from several years ahead back toward his actual age.Start Testing\nBEFORE+7 yrsHEART AGEBIOLOGICAL AGE+6 yrsAGING SPEED1.20INFLAMMATION AGE+4 yrsBLOOD AGE+5 yrsBEFORE+1 yrHEART AGEBIOLOGICAL AGE+1 yrAGING SPEED0.97INFLAMMATION AGE0 yrsBLOOD AGE+2 yrsWith both parents affected by dementia, Sarah wants to track her brain aging early rather than wait for symptoms. She is looking for a measurable way to see whether her interventions are helping.HOW TRUDIAGNOSTIC MAY HELPTruAge SYMPHONYAge can give her a brain age to follow over time alongside her other organ systems. In a profile like Sarah’s, watching a brain age that starts ahead of calendar age move closer to it could show that sleep, exercise, and diet changes are working, with pace of aging improving in parallel.Start Testing\nBEFORE+6 yrsBRAIN AGEBIOLOGICAL AGE+4 yrsAGING SPEED1.14HORMONE AGE+3 yrsIMMUNE AGE+5 yrsBEFORE84%STRESS RESILIENCEBIOLOGICAL AGE−1 yrAGING SPEED0.95HORMONE AGE0 yrsIMMUNE AGE+2 yrsTyler is already fit but wants proof that his training and recovery choices are adding up to real biological benefit, not just aesthetics. He wants to optimize, not just maintain.HOW TRUDIAGNOSTIC MAY HELPTruAge can let him benchmark his biological age, his organ systems through the SYMPHONYAge clocks, and his pace of aging against his training, and fine tune recovery if an organ system like immune age lags. In a profile like Tyler’s, consistent testing could show his aging speed trending down with each organ system tracking younger than his calendar age.Start Testing\nBEFORE0.95AGING SPEEDBIOLOGICAL AGE−2 yrsMUSCULOSKELETAL AGE−1 yrHEART AGE−2 yrsIMMUNE AGE+1 yrAFTER0.82AGING SPEEDBIOLOGICAL AGE−4 yrsMUSCULOSKELETAL AGE−3 yrsHEART AGE−3 yrsIMMUNE AGE−2 yrsPROACTIVE LONGEVITYElena M.AGING SPEED1.11→0.88CRPYEAR 1YEAR 3BIOLOGICAL AGE+4 yrs−2 yrsHEART AGE+3 yrs0 yrsBRAIN AGE+2 yrs−1 yrIMMUNE AGE+5 yrs+1 yrElena feels healthy but has a family history of early heart disease and wants an objective baseline before problems appear. She is tired of guessing whether her habits are actually working.HOW TRUDIAGNOSTIC MAY HELPTruAge can give her a full picture across biological age, individual organ systems through the SYMPHONYAge clocks, and pace of aging. In a profile like Elena’s, seeing immune and heart ages running ahead of calendar age could focus her plan, and ongoing testing may show her aging speed easing from 1.11 toward 0.88 as her organ ages trend younger.Start Testing\nHEART HEALTHRobert K.HEART AGE+7 yrs→+1 yrCRPBEFOREAFTERBIOLOGICAL AGE+6 yrs+1 yrAGING SPEED1.200.97INFLAMMATION AGE+4 yrs0 yrsBLOOD AGE+5 yrs+2 yrsRobert has had a borderline stress test and wants to know how old his cardiovascular system really is, not just his cholesterol number. He is looking for something concrete to hold himself accountable to.HOW TRUDIAGNOSTIC MAY HELPTruAge SYMPHONYAge can break his aging down by organ system and reveal whether his heart age is running ahead of his calendar age. In a profile like Robert’s, that insight could guide care alongside his cardiologist, and repeat testing may show his heart age moving from several years ahead back toward his actual age.Start Testing\nCOGNITIVE HEALTHSarah L.BRAIN AGE+6 yrs→+1 yrCRPBEFOREAFTERBIOLOGICAL AGE+4 yrs−1 yrAGING SPEED1.140.95HORMONE AGE+3 yrs0 yrsIMMUNE AGE+5 yrs+2 yrsWith both parents affected by dementia, Sarah wants to track her brain aging early rather than wait for symptoms. She is looking for a measurable way to see whether her interventions are helping.HOW TRUDIAGNOSTIC MAY HELPTruAge SYMPHONYAge can give her a brain age to follow over time alongside her other organ systems. In a profile like Sarah’s, watching a brain age that starts ahead of calendar age move closer to it could show that sleep, exercise, and diet changes are working, with pace of aging improving in parallel.Start Testing\nATHLETIC PERFORMANCETyler R.AGING SPEED0.95→0.82CRPBEFOREAFTERBIOLOGICAL AGE−2 yrs−4 yrsMUSCULOSKELETAL AGE−1 yr−3 yrsHEART AGE−2 yrs−3 yrsIMMUNE AGE+1 yr−2 yrsTyler is already fit but wants proof that his training and recovery choices are adding up to real biological benefit, not just aesthetics. He wants to optimize, not just maintain.HOW TRUDIAGNOSTIC MAY HELPTruAge can let him benchmark his biological age, his organ systems through the SYMPHONYAge clocks, and his pace of aging against his training, and fine tune recovery if an organ system like immune age lags. In a profile like Tyler’s, consistent testing could show his aging speed trending down with each organ system tracking younger than his calendar age.Start Testing\n\n\n\n\nHow TruAge Benefits Your ClinicTruAge is a precision longevity tool that analyzes more than 75 essential aging biomarkers to empower healthcare providers with personalized recommendations to help patients live longer, healthier lives.Establish a baselineAn initial test establishes where your patient stands biologically today, giving you the clinical anchor that turns every follow-up visit into a progress conversation.Personalize a care planWhen your patient’s history and labs leave the picture incomplete,  fill the gaps with the biological context you need to build a care plan that actually fits.Monitor intervention responseShow whether the protocols you’re recommending are actually working at the biological level, giving your patients evidence  that lifestyle changes are making a measurable difference.Prioritize areas for follow-upWhen a patient has multiple concerns, testing helps you see which biological systems need the most attention, turning a complex clinical picture into a clear set of priorities.Start Testing\n\nDownload Sample Report\n\n\nSEAMLESS CLINIC WORKFLOWHow does TruAge work?Order TruAge for Your PracticeRegister as a TruDiagnostic provider and order directly through the Provider Portal – either in bulk for clinic delivery or shipped directly to individual patients.Patient Sample CollectionEach test includes a simple finger-stick blood collection that takes approximately 3 minutes. Patients follow the enclosed instructions and return their sample via USPS drop-off using the prepaid materials provided.Receive Actionable ResultsResults are available in your Provider Portal within 2–4 weeks from the date the lab receives the sample, including biological age, organ system–level ages, and aging speed, ready to review with your patient.The Aging Clocks of TruAgeDEVELOPED WITH HARVARDBiological AgeOMICmAge™The OMICmAge™ algorithm is one of the most precise and comprehensive methods for measuring biological aging. Its multi-omic approach analyzes proteins, metabolites, and clinical biomarkers to reveal the true state of the body’s aging process — and the factors accelerating or decelerating it — empowering you to optimize patient health and potentially slow aging.Learn More\n\nDEVELOPED BY YALEOrgan System AgingSYMPHONYAge™SYMPHONYAge™ offers a revolutionary way to understand aging across multiple organ systems. This system-specific epigenetic algorithm evaluates organs like the brain, liver, heart, and immune system independently, pinpointing where targeted health interventions may be most effective. Easy-to-read reports deliver actionable recommendations and highlight key areas for improvement, allowing providers to direct protocols to where biological burden is the highest.Learn More\n\nDEVELOPED BY DUKE AND COLUMBIAAging SpeedDunedinPACE™The DunedinPACE™ algorithm measures the rate at which the body is aging, providing a clear picture of whether you’re aging faster, slower, or as expected for your calendar age. It’s ideal for tracking the effectiveness of lifestyle and protocol interventions over time — regular monitoring shows how lifestyle and other interventions may impact biological age, giving patients the data and motivation to stay on track.Learn More\n\nWhy Physicians Choose TruAgeThe #1 biological age test and why it matters.TruAge™Generation LabsMyDNAgeElysiumDoNotAgeEpiAgeAdvanced PrecisionAverage of > 0.98 ICCExtremely high intraclass correlation coefficient (ICC) for results you can trustNot PublishedNot PublishedNot PublishedNot PublishedNot PublishedPublished Algorithms\nPeer-reviewed science from Harvard, Yale, & Duke\n\n\n\n\nGeneration Clock2nd + 3rdThe most advanced algorithms for tracking epigenetics longitudinally1st Gen1st Gen1st Gen1st Gen1st GenImmune Deconvolution\nFilters out cellular noise to reflect the most precise aging insights\n\n\n\n\nSample TypeBloodNo phlebotomies neededBloodBlood + SalivaSalivaSalivaSalivaFAQsWhich biomarkers are tested with TruAge?TruAge measures biological age, aging speed, and organ-level aging through multiple aging clocks and epigenetic biomarker panels. All TruAge reports include three core aging clocks, each analyzing a distinct set of biomarkers from a single blood sample:OMICmAge™, our primary biological age clock developed with Harvard, analyzes epigenetic biomarkers spanning proteins, metabolites, and clinical measures: Albumin, Hemoglobin, HbA1c, Hematocrit, Blood Urea Nitrogen, Alkaline Phosphatase, IGFBP-2, Carboxypeptidase B2, Serum Paraoxonase/Arylesterase 1 (PON1), Ribonuclease Pancreatic, Inter-Alpha-Trypsin Inhibitor Heavy Chain H3 (ITIH3), Ribitol, Phenylacetylglutamine, Uridine, 4-Methoxyphenol Sulfate, 1-Margaroyl-Glycerophospholipid (GPE)(17:0), Vanillactic Acid, Red Blood Cell Distribution Width, Creatinine, Fasting Glucose, Carotene Diol, Bone Morphogenetic Protein 1 (BMP1), Versican Core Protein, N-Acetyl-Isoputreanine, Gluconate, 4-Hydroxyphenylacetylglutamine, Androsterone Sulfate, 3-Ureidopropionate, 1-Stearoyl-2-Adrenoyl-GPC (18:0/22:4), and Histone H2B Type 1-K.DunedinPACE™, our aging speed clock developed with Duke, uses DNA methylation patterns across the epigenome to calculate your patient's pace of aging – the number of biological years elapsed per calendar year – providing a dynamic rate of aging rather than a static biological age estimate.SYMPHONYAge™, our organ-level age clock developed with Yale, analyzes clinical biomarkers across 11 organ systems:Blood: Ferritin, Hematocrit, Hemoglobin, Mean Corpuscular Hemoglobin, Mean Corpuscular Hemoglobin Concentration, Mean Corpuscular Volume, Mean Platelet Volume, Platelet Distribution Width, Platelet Count, Red Blood Cell Count, Red Cell Distribution WidthBrain: Homocysteine, BDNF (serum), Clusterin, Stroke, Total Mental Status Summary Score, Total Cognition Summary Score, Immediate Word Recall, Delayed Word Recall, Total Word Recall Summary Score, Serial 7sInflammation: Ferritin, C-Reactive Protein, Transforming Growth Factor Beta, Interleukin-10, Interleukin-1 Receptor Antagonist, Interleukin-6, Tumor Necrosis Factor Receptor 1Heart: Shortness of Breath While Awake, PC Components of GrimAge, Previous High Blood Pressure, Previous Heart Attack, Previous Stroke, Homocysteine, BMIHormone: IGF-1, DHEA-SImmune: Eosinophil Count, Lymphocyte Count, Monocyte Count, Neutrophil Count, Percent Basophils, Percent Eosinophils, Percent Lymphocytes, Percent Monocytes, White Blood Cell Count, Myeloid Dendritic Cells (DC-M) Percentage, Plasmacytoid Dendritic Cells (DC-P) Percentage, NK Cells CD56HI Percentage, NK Cells CD56LO Percentage, CD16- Monocytes Percentage, CD16+ Monocytes Percentage, B Cells Percentage, CD8+ T Cells Central Memory Percentage, CD4+ T Cells Central Memory Percentage, CD8+ T Cells Percentage, CD8+ T Cells TemRA Percentage, CD4+ T Cells TemRA Percentage, CD4+ T Cells Percentage, IgD+ Memory B Cells Percentage, IgD- Memory B Cells Percentage, CD8+ T Cells Naïve Percentage, CD4+ T Cells Naïve Percentage, T Cells Percentage, Naïve B Cells Percentage, CD8+ T Cells Effector Memory Percentage, CD4+ T Cells Effector Memory Percentage, Natural Killer (NK) Cells Percentage, Monocytes Percentage, Dendritic Cells PercentageKidney: Albumin, Urea Nitrogen, Chloride, Bicarbonate, Creatinine, Cystatin C, Potassium, SodiumLiver: Albumin, Alkaline Phosphatase, ALT, AST, Bilirubin, Total ProteinMetabolic: PC Smoking Pack-Years, Previous Diabetes, C-Reactive Protein, Fasting Glucose, HDL Cholesterol, LDL Cholesterol, Triglycerides, Interleukin-6, BMI, Waist CircumferenceLung: Peak Expiratory Flow, Bicarbonate, Chronic Lung Disease, Shortness of Breath While Awake, Persistent Wheezing/Cough/Phlegm, PC Smoking Pack-YearsMusculoskeletal: Vitamin D3, DHEA-S, IGF-1How does TruAge measure biological age?TruAge measures biological age through DNA methylation (DNAm) analysis – a chemical tagging system cells use to regulate gene activity. Rather than analyzing genetic sequence, TruAge reads epigenetic patterns across more than 1,000,000 sites on a patient's DNA. These patterns shift with age, lifestyle, and environment, making them a more dynamic and clinically meaningful signal than a birth date alone.Why is measuring epigenetic aging important?Aging is the single largest risk factor for all-cause mortality and most chronic disease. But chronological age – the number a patient celebrates on their birthday – tells you very little about their current biological health trajectory. Two patients born the same year can have dramatically different cellular ages and aging rates depending on genetics, environment, lifestyle, and medical history.Epigenetic biomarkers fill a gap that conventional labs can't. Traditional blood biomarkers are snapshot measurements – highly sensitive to near-term factors like meals, hydration, or acute stress. DNA methylation patterns, by contrast, reflect a sustained biological signal across weeks to months. They can reveal whether a patient is progressing toward disease risk faster than expected, whether a current intervention is actually working at the cellular level, and which organ systems are most under biological strain.Crucially, epigenetic age is modifiable. Unlike genetic tests, which produce a fixed result, DNAm-based measurements change in response to diet, exercise, sleep, medications, and other interventions. That makes them an actionable tool for longitudinal patient monitoring – not just a one-time assessment.What type of patients benefit from TruAge?TruAge is most clinically useful for patients who are motivated to understand and address their long-term health trajectory – and for providers who want objective, longitudinal data to guide preventive or lifestyle medicine protocols.​Strong candidate profiles include:​• Patients with unexplained symptoms or accelerated phenotypic aging (fatigue, cognitive changes, metabolic dysfunction) where conventional labs are inconclusive• Patients managing chronic disease risk factors (cardiovascular disease, metabolic syndrome, obesity) who want to track biological progress beyond traditional markers• Patients on active interventions – including GLP-1 agonists, caloric restriction, exercise protocols, or supplementation – where you want to measure cellular impact, not just clinical endpoints• Patients interested in longevity and preventive medicine who are looking for a quantitative baseline and repeat testing to track progress over time• Patients with a family history of age-related disease who are seeking earlier, actionable risk insight​Because TruAge is not a diagnostic test, it is best positioned as an adjunct to clinical evaluation – a longitudinal signal to complement, not replace, standard workup.What are the validated clinical outcomes for TruAge?TruAge's underlying aging clocks and algorithms are each published in peer-reviewed literature and validated against hard outcomes across large longitudinal cohorts.​Key validated associations include:• OMICmAge – our biological age clock developed in partnership with Harvard University, was published most recently in Nature Aging² and validated across multiple independent cohorts. Head-to-head benchmarking showed OMICmAge matched or exceeded all other tested clocks on 5- and 10-year survival prediction.• SYMPHONYAge – our organ-level clock has been validated at Yale to reflect differential aging across tissue systems.• DunedinPACE – our aging speed clock has been validated as the strongest epigenetic predictor of mortality among 14 consensus biomarkers of aging, as demonstrated in the peer-reviewed, BASE-II cohort study¹.How do I order TruAge?Providers order directly through the TruDiagnostic Provider Portal. Once your account is set up, you can place orders for clinic delivery or patient drop-ship.Full pricing is available in the Provider Portal once your account is active. To get started, register as a provider at www.trudiagnostic.com/provider-application.REFERENCESDemuth I, et al. Comparing fourteen consensus biomarkers of aging: epigenetic pace of aging as the strongest predictor of mortality in BASE-II. Biomarker Research. 2026. PMID: 41792861. https://link.springer.com/article/10.1186/s40364-026-00909-zDwaraka V, et al. OMICmAge: An integrative multi-omics approach to quantify biological age with electronic medical records. Nature Aging. 2026. https://www.nature.com/articles/s43587-026-01073-7AboutAbout UsHelp CenterCareersNewsletterPartnersBecome a ProviderBecome an AffiliateResearch ServicesRequisition FormAPI ReferenceMembersLog InRegister My KitView My ReportsReturn PolicyCONTACT881 Corporate Dr. Lexington, KY 40503(888) 909-3634Mon-Fri 9am-7pm | Sat 9am-3pmEastern Time (UTC-4:00)support@trudiagnostic.comDNAm biomarker outputs are intended to support, not replace, clinical judgment. They should be interpreted within the full clinical context, including history, physical examination, conventional laboratory testing, and imaging studies where clinically indicated. They should not be used as the sole basis for diagnosis or treatment decisions.Terms of ServicePrivacy PolicyFCIO Policy© TruDiagnostic 2026, All Rights Reserved\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"}],"residuals":[{"code":"CSS_LAYOUT_NOT_EXECUTED","detail":"External styles, script rendering and computed layout are not evaluated; hidden flags cover only declared inert/hidden content. Hidden subtrees are represented only by their inert root placeholder; their original bytes remain in the capture."}]}