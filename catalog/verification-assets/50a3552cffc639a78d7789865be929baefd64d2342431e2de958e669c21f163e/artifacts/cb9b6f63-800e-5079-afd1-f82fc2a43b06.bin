lse,"tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"id18","tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"11"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"id19","aria-expanded":"false","class":"usa-link","href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Williams%20BS%22[Author]"},"children":[{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Benjamin S Williams"}],"hidden":false,"tag":"span"}],"hidden":false,"tag":"a"},{"children":[{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Benjamin S Williams"}],"hidden":false,"tag":"span"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"3"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":"Department of Psychology and Neuroscience, Duke University, Durham, United States"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Find articles by "},{"attributes":{"class":"usa-link","href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Williams%20BS%22[Author]"},"children":[{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Benjamin S Williams"}],"hidden":false,"tag":"span"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"id19","tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"3"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"id20","aria-expanded":"false","class":"usa-link","href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Moffitt%20TE%22[Author]"},"children":[{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Terrie E Moffitt"}],"hidden":false,"tag":"span"}],"hidden":false,"tag":"a"},{"children":[{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Terrie E Moffitt"}],"hidden":false,"tag":"span"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"3"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":"Department of Psychology and Neuroscience, Duke University, Durham, United States"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Find articles by "},{"attributes":{"class":"usa-link","href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Moffitt%20TE%22[Author]"},"children":[{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Terrie E Moffitt"}],"hidden":false,"tag":"span"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"id20","tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"3"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"cg p"},"children":[{"tag":"#text","text":"Editors: "},{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Joris Deelen"}],"hidden":false,"tag":"span"},{"children":[{"tag":"#text","text":"13"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":", "},{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Jessica K Tyler"}],"hidden":false,"tag":"span"},{"children":[{"tag":"#text","text":"14"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"d-buttons inline-list"},"children":[{"tag":"#text","text":"\n"},{"children":[{"attributes":{"aria-controls":"aip_a","aria-expanded":"false","class":"d-button"},"children":[{"tag":"#text","text":"Author information"}],"hidden":false,"tag":"button"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"aria-controls":"anp_a","aria-expanded":"false","class":"d-button"},"children":[{"tag":"#text","text":"Article notes"}],"hidden":false,"tag":"button"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"aria-controls":"clp_a","aria-expanded":"false","class":"d-button"},"children":[{"tag":"#text","text":"Copyright and License information"}],"hidden":false,"tag":"button"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"ul"},{"tag":"#text","text":"\n"},{"attributes":{"class":"d-panels font-secondary-light"},"children":[{"tag":"#text","text":"\n"},{"hidden":true,"id":"aip_a","tag":"div"},{"tag":"#text","text":"\n"},{"hidden":true,"id":"anp_a","tag":"div"},{"tag":"#text","text":"\n"},{"hidden":true,"id":"clp_a","tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"PMCID: PMC8853656  PMID: "},{"attributes":{"class":"usa-link","href":"https://pubmed.ncbi.nlm.nih.gov/35029144/"},"children":[{"tag":"#text","text":"35029144"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"aria-label":"Related or updated information about this article","class":"ra xbox p","role":"complementary"},"children":[{"children":[{"tag":"#text","text":"See \""},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC7282814/"},"children":[{"tag":"#text","text":"Quantification of the pace of biological aging in humans through a blood test, the DunedinPoAm DNA methylation algorithm"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\" in  volume 9, e54870."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"section"}],"hidden":false,"tag":"section"},{"attributes":{"aria-label":"Article content"},"children":[{"attributes":{"class":"body main-article-body"},"children":[{"attributes":{"class":"abstract"},"children":[{"attributes":{"data-anchor-id":"abstract1"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"abstract1"},"hidden":false,"id":"abstract1-anchor","tag":"a"},{"tag":"#text","text":"Abstract"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Background:"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Measures to quantify changes in the pace of biological aging in response to intervention are needed to evaluate geroprotective interventions for humans. Previously, we showed that quantification of the pace of biological aging from a DNA-methylation blood test was possible (Belsky et al., 2020). Here, we report a next-generation DNA-methylation biomarker of Pace of Aging, DunedinPACE (for Pace of Aging Calculated from the Epigenome)."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"abs1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Methods:"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We used data from the Dunedin Study 1972–1973 birth cohort tracking within-individual decline in 19 indicators of organ-system integrity across four time points spanning two decades to model Pace of Aging. We distilled this two-decade Pace of Aging into a single-time-point DNA-methylation blood-test using elastic-net regression and a DNA-methylation dataset restricted to exclude probes with low test-retest reliability. We evaluated the resulting measure, named DunedinPACE, in five additional datasets."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"abs2","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Results:"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"DunedinPACE showed high test-retest reliability, was associated with morbidity, disability, and mortality, and indicated faster aging in young adults with childhood adversity. DunedinPACE effect-sizes were similar to GrimAge Clock effect-sizes. In analysis of incident morbidity, disability, and mortality, DunedinPACE and added incremental prediction beyond GrimAge."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"abs3","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Conclusions:"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"DunedinPACE is a novel blood biomarker of the pace of aging for gerontology and geroscience."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"abs4","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Funding:"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"This research was supported by US-National Institute on Aging grants AG032282, AG061378, AG066887, and UK Medical Research Council grant MR/P005918/1."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"abs5","tag":"section"},{"attributes":{"class":"kwd-group"},"children":[{"children":[{"children":[{"tag":"#text","text":"Research organism:"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" Biological Aging, Methylation, Geroscience, Healthspan, Biomarker, Epigenetics"}],"hidden":false,"tag":"p"}],"hidden":false,"id":"kwd-group2","tag":"section"}],"hidden":false,"id":"abstract1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"s1"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"s1"},"hidden":false,"id":"s1-anchor","tag":"a"},{"tag":"#text","text":"Introduction"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Guided by research on the cellular hallmarks of aging, model-organism studies are yielding treatments that slow the accumulation of deterioration in cells and organs ("},{"attributes":{"aria-describedby":"bib3","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib3"},"children":[{"tag":"#text","text":"Barzilai et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib5","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib5"},"children":[{"tag":"#text","text":"Bellantuono, 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib12","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib12"},"children":[{"tag":"#text","text":"Campisi et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). However, human geroprotector trials face a barrier when it comes to outcome measures: humans’ long lifespan makes it prohibitively time-consuming to test whether a treatment extends healthspan ("},{"attributes":{"aria-describedby":"bib37","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib37"},"children":[{"tag":"#text","text":"Justice et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). What is needed is a way to measure each clinical trial participant’s personal pace of biological aging, before, during, after, and at long-term follow-up, to test whether a gero-protective therapy slows that pace, and whether benefits fade out ("},{"attributes":{"aria-describedby":"bib7","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib7"},"children":[{"tag":"#text","text":"Belsky et al., 2017"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib53","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib53"},"children":[{"tag":"#text","text":"Moffitt et al., 2017"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib67","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib67"},"children":[{"tag":"#text","text":"Sierra et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"An ideal research design for isolating biological patterns that differentiate faster and slower aging is longitudinal follow-up of a cohort of individuals who are all the same chronological age. We originally applied this design to test the geroscience-derived hypothesis that the process of biological aging was ongoing in healthy young adults and, critically, that it was already variable across individuals decades before most chronic diseases onset ("},{"attributes":{"aria-describedby":"bib6","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib6"},"children":[{"tag":"#text","text":"Belsky et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib21","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib21"},"children":[{"tag":"#text","text":"Elliott et al., 2021b"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). We studied a single-year birth cohort of all 1037 babies born in the city of Dunedin, New Zealand, during 1972–1973 and followed-up through midlife. Because aging can be understood as gradual, progressive deterioration simultaneously affecting different organ systems, we tracked declines in the cardiovascular, metabolic, renal, hepatic, immune, periodontal, and pulmonary systems of each participant using multiple biomarker measurements of each organ system, first at ages 26, 32, and 38 years, and subsequently including a fourth assessment at age 45 years. Modeling this one-of-a-kind dataset yielded a metric which quantified how slowly or rapidly each participant had been aging. We called this metric the Pace of Aging."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"People with faster Pace of Aging tend to experience more rapid aging-related decline in physical and cognitive functions and develop early signs of brain aging ("},{"attributes":{"aria-describedby":"bib6","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib6"},"children":[{"tag":"#text","text":"Belsky et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib20","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib20"},"children":[{"tag":"#text","text":"Elliott et al., 2021a"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib21","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib21"},"children":[{"tag":"#text","text":"Elliott et al., 2021b"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib63","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib63"},"children":[{"tag":"#text","text":"Rasmussen et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). This evidence suggests that intervention to slow Pace of Aging could preserve functions lost with aging and extend healthspan. However, Pace of Aging takes many years to measure and requires data from several types of clinical and biological assays, limiting its utility in clinical trials. To address this limitation, we applied machine-learning tools to genome-wide DNA methylation data from Dunedin cohort members’ blood samples to distill the multi-timepoint, multi-assay Pace of Aging measure into a single-timepoint, single-assay blood biomarker previously described in this journal: DunedinPoAm (for Dunedin Study Pace of Aging from methylation; "},{"attributes":{"aria-describedby":"bib8","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib8"},"children":[{"tag":"#text","text":"Belsky et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). DunedinPoAm was designed to measure Pace of Aging biological change over time from a single blood sample. Like the original Pace of Aging, people with faster DunedinPoAm scores more often experienced declines in cognitive and physical functioning by midlife and showed more rapid facial aging "},{"attributes":{"aria-describedby":"bib8","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib8"},"children":[{"tag":"#text","text":"Belsky et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; in older adults, faster DunedinPoAm predicted increased risk of disease and death ("},{"attributes":{"aria-describedby":"bib8","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib8"},"children":[{"tag":"#text","text":"Belsky et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib28","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib28"},"children":[{"tag":"#text","text":"Graf et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"); in young people, experiences of early-life adversity were linked to faster DunedinPoAm ("},{"attributes":{"aria-describedby":"bib8","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib8"},"children":[{"tag":"#text","text":"Belsky et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib62","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib62"},"children":[{"tag":"#text","text":"Raffington et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"DunedinPoAm provided proof of concept that Pace of Aging could be measured from a single blood test. But DunedinPoAm was based on biological change observed over just twelve years spanning the transition from young adulthood to midlife, limiting the scope of biological change that could be observed. And this biological change was measured from just three assessment waves, limiting precision. In addition, similar to other DNA methylation composites measured from microarray data, the measure had only moderate test-retest reliability ("},{"attributes":{"aria-describedby":"bib33","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib33"},"children":[{"tag":"#text","text":"Higgins-Chen et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), limiting its value to clinical trials seeking to test within-participant changes from pre-treatment baseline to post-treatment follow-up. To address these limitations, we incorporated new data from the Dunedin cohort extending Pace of Aging follow-up to include a fourth measurement occasion in the fifth decade of life ("},{"attributes":{"aria-describedby":"bib21","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib21"},"children":[{"tag":"#text","text":"Elliott et al., 2021b"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") and restricted DNA-methylation data to exclude probes with poor reliability ("},{"attributes":{"aria-describedby":"bib68","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib68"},"children":[{"tag":"#text","text":"Sugden et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") to refine our DNA-methylation biomarker of Pace of Aging. The longer follow-up period, which allowed us to observe more aging-related change in system integrity, and the additional measurement occasion included in analysis improve the power and precision of our modeling of longitudinal change in system integrity ("},{"attributes":{"aria-describedby":"bib11","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib11"},"children":[{"tag":"#text","text":"Brandmaier et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib64","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib64"},"children":[{"tag":"#text","text":"Rast and Hofer, 2014"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). The refined DNA-methylation dataset used for machine-learning improves reliability of measurement. We name the novel algorithm DunedinPACE, for Dunedin (P)ace of (A)ging (C)alculated from the (E)pigenome."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"As a new DNA methylation measure of biological aging, DunedinPACE joins a well-established battery of DNA methylation measures known as ‘clocks’, so-named for their accurate prediction of chronological age ("},{"attributes":{"aria-describedby":"bib35","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib35"},"children":[{"tag":"#text","text":"Horvath and Raj, 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). However, DunedinPACE is distinct from the DNA methylation clocks in the method of its design and in its interpretation. DunedinPACE is derived from analysis of longitudinal data collected from a cohort of individuals who are all the same chronological age. It reflects differences between those individuals in the rate of deterioration in system integrity occurring over a fixed time interval, age 26 to age 45 years. It therefore has three distinguishing features that isolate aging from other confounds: (1) analysis of a single-year birth cohort distinguishes aging from confounding effects of exposures to factors that alter the methylome and that differ across generations, referred to hereafter as ‘cohort effects’; (2) initiation of follow-up in young adults distinguishes aging from the effects of disease and excludes contamination from survival bias; and (3) focus on changes in multi-organ-system integrity during adult life distinguishes ongoing aging processes from deficits established early in development. The clocks, in contrast, were developed using a single cross-section of data from samples of mixed-age and older adults. They do not distinguish aging from cohort effects, are vulnerable to survival bias and contamination of aging signal by disease processes, and do not distinguish aging-related changes from prenatal/childhood deficits. DunedinPACE, therefore, represents a complementary tool with useful advantages for DNA methylation quantification of biological aging."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"s2"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"s2"},"hidden":false,"id":"s2-anchor","tag":"a"},{"tag":"#text","text":"Results"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We developed the DunedinPACE measure reported here by analyzing the pace of biological aging in a 1972–1973 birth cohort (N = 1037), the Dunedin Study. This analysis consisted of two parts. The first part of analysis followed our original method ("},{"attributes":{"aria-describedby":"bib6","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib6"},"children":[{"tag":"#text","text":"Belsky et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") to quantify Pace of Aging from two decades of longitudinal organ-system integrity data ("},{"attributes":{"aria-describedby":"bib21","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib21"},"children":[{"tag":"#text","text":"Elliott et al., 2021b"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). First, we measured longitudinal changes in 19 biomarkers assessing cardiovascular, metabolic, renal, hepatic, immune, dental, and pulmonary systems, measured at ages 26, 32, 38 and, most recently in 2019, 45 years ("},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#supp1"},"children":[{"tag":"#text","text":"Supplementary file 1A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" provides measurement details about the tracked biomarkers). Second, linear mixed-effects modeling was used to fit growth models to estimate each study member’s personal rate of change for each of the 19 biomarkers. Third, these 19 personal rates of change were combined across biomarkers to calculate each Study member’s personal Pace of Aging. In line with the geroscience hypothesis ("},{"attributes":{"aria-describedby":"bib38","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib38"},"children":[{"tag":"#text","text":"Kaeberlein, 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib40","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib40"},"children":[{"tag":"#text","text":"Kennedy et al., 2014"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), which states that aging represents progressive decline across organ systems, we calculated each Study member’s Pace of Aging as the sum of age-dependent annual changes across all biomarkers: Pace of Aging"},{"children":[{"children":[{"tag":"#text","text":"i"}],"hidden":false,"tag":"sub"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = "},{"attributes":{"xmlns:mml":"http://www.w3.org/1998/Math/MathML"},"children":[{"attributes":{"class":"CtxtMenu_Attached_0","ctxtmenu_counter":"0","tabindex":"0"},"children":[{"attributes":{"data-mjx-lazy":"0"},"hidden":false,"tag":"mjx-lazy"}],"hidden":false,"tag":"mjx-container"}],"hidden":false,"tag":"span"},{"tag":"#text","text":" μ"},{"children":[{"tag":"#text","text":"1"},{"children":[{"tag":"#text","text":"iB"}],"hidden":false,"tag":"em"}],"hidden":false,"tag":"sub"},{"tag":"#text","text":". The resulting Pace of Aging was then scaled to a mean of 1, so that it could be interpreted with reference to an average rate of 1 year of biological aging per year of chronological aging. Study members showed wide variation in their Pace of Aging (Mean = 1 biological year per chronological year, SD = 0.29). Over the two decades that we measured biological aging, the Study member with the slowest Pace of Aging aged by just 0.40 biological years per chronological year, while the Study member with the fastest Pace of Aging accrued 2.44 biological years per chronological year ("},{"attributes":{"aria-describedby":"bib21","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib21"},"children":[{"tag":"#text","text":"Elliott et al., 2021b"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The second part of the analysis followed our original method to distill Pace of Aging into a blood test ("},{"attributes":{"aria-describedby":"bib8","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib8"},"children":[{"tag":"#text","text":"Belsky et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Using Illumina EPIC array DNA methylation data from blood collected at age 45, we developed DunedinPACE to provide a surrogate for the 20-year Pace of Aging. Briefly, we used elastic-net-regression ("},{"attributes":{"aria-describedby":"bib75","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib75"},"children":[{"tag":"#text","text":"Zou and Hastie, 2005"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") to develop a DNA methylation algorithm to predict the 20-year Pace of Aging. Analysis included the subset of probes included on both the Illumina 450 k and EPIC arrays which we previously determined to have acceptable test-retest reliability (ICC >0.4, n = 81,2392) ("},{"attributes":{"aria-describedby":"bib68","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib68"},"children":[{"tag":"#text","text":"Sugden et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Following the method established by "},{"attributes":{"aria-describedby":"bib34","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib34"},"children":[{"tag":"#text","text":"Horvath, 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and used in our prior analysis, we fixed the alpha parameter of the elastic net at 0.5. The final lamda value selected by the analysis was 0.042. The resulting algorithm included 173 CpG sites. The CpGs included in DunedinPACE are listed in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#supp1"},"children":[{"tag":"#text","text":"Supplementary file 1B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"DunedinPACE distills the 20-year pace of aging into a single-timepoint DNA methylation blood test"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"DunedinPACE demonstrated a high in-sample correlation with Pace of Aging to age 45 ("},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.78, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig1"},"children":[{"tag":"#text","text":"Figure 1a"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). The value indicates improved fit of the DunedinPACE model to the 20-year Pace of Aging as compared to the original DunedinPoAm version’s fit to the 12-year Pace of Aging (in-sample correlation "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.6). Correlations among the 12- and 20-year Pace of Aging measures and the DunedinPoAm and DunedinPACE DNA methylation measures are shown in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig1s1"},"children":[{"tag":"#text","text":"Figure 1—figure supplement 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 1. DunedinPACE correlation with 20-year Pace of Aging and association with decline in physical and cognitive functions and subjective signs of aging."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"Panel A shows the association of DunedinPACE with the 20-year Pace of Aging in the Dunedin Study cohort ("},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.78). Panel B shows effect-sizes for associations of DunedinPACE with measures of physical and cognitive functioning and subjective signs of aging in Dunedin Study members at age 45 years. Colors indicate groupings of measures (physical functions in shades of orange, cognitive functions in shades of yellow, subjective signs of aging in shades of green). Stars next to labels for Physical Limitations and Facial Aging indicate that these meaures were reverse-coded for this analysis. Panel C shows binned scatterplots of associations of DunedinPACE with declines in physical and cognitive function and subjective signs of aging. Plotted points show average values for ‘bins’ of approximately 20 Study members. Regression slopes are estimated from the raw, un-binned data. In Panel C, y-axis scales are denominated in units of standard deviations computed from the baseline measurement for all outcomes except self-rated health, for which the y-axis shows probability of incident fair/poor self-rated health. Changes were calculated over the interval between age-38 and age-45 assessments for all measures except cognition, for which change was calculated over the interval between the age-13 and age-45 assessments. DunedinPACE and DunedinPoAm were developed from analysis of Pace of Aging in the Dunedin cohort; effect-sizes for these measures may be over-estimated."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig1.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 1.","class":"graphic zoom-in","height":"526","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/c9f9a6eb149b/elife-73420-fig1.jpg","width":"727"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 1—figure supplement 1. Correlations among the 12-year and 20-year Pace of Aging measures and the DunedinPoAm and DunedinPACE DNA methylation measures."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig1-figsupp1.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 1—figure supplement 1.","class":"graphic zoom-in","height":"684","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/14283961b1b4/elife-73420-fig1-figsupp1.jpg","width":"778"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"}],"hidden":false,"id":"fig1s1","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 1—figure supplement 2. Effect-sizes for associations of DunedinPACE and the 20-year Pace of Aging with measures of physical and cognitive functioning and subjective signs of aging measured when Dunedin Study participants were aged 45 years."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig1-figsupp2.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 1—figure supplement 2.","class":"graphic zoom-in","height":"435","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/eee77663d940/elife-73420-fig1-figsupp2.jpg","width":"663"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"The * indicates measures reverse-coded for analysis."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"fig1s2","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 1—figure supplement 3. Effect-sizes for associations of DunedinPACE, DunedinPoAm, and the DNA methylation clocks proposed by "},{"attributes":{"aria-describedby":"bib34","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib34"},"children":[{"tag":"#text","text":"Horvath, 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"bib31","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib31"},"children":[{"tag":"#text","text":"Hannum et al., 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"bib49","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib49"},"children":[{"tag":"#text","text":"Levine et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" (PhenoAge), and "},{"attributes":{"aria-describedby":"bib50","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib50"},"children":[{"tag":"#text","text":"Lu et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" (GrimAge) with measures of physical and cognitive functioning and subjective signs of aging measured when Dunedin Study participants were aged 45 years."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig1-figsupp3.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 1—figure supplement 3.","class":"graphic zoom-in","height":"425","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/bf774acad349/elife-73420-fig1-figsupp3.jpg","width":"674"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"The * indicates measures reverse-coded for analysis. DunedinPACE and DunedinPoAm were developed from analysis of Pace of Aging in the Dunedin cohort; effect-sizes for these measures may be over-estimated."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"fig1s3","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 1—figure supplement 4. Effect-sizes for associations of aging measures with measures of change in physical functioning and subjective signs of aging over ages 38–45 years and with cognitive functioning from adolescent baseline to age-45 follow-up."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"alt":"Figure 1—figure supplement 4.","class":"graphic","height":"1305","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/d47a97c2b4cf/elife-73420-fig1-figsupp4.jpg","width":"724"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"The * indicates measures reverse-coded for analysis. DunedinPACE and DunedinPoAm were developed from analysis of Pace of Aging in the Dunedin cohort; effect-sizes for these measures may be over-estimated."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"fig1s4","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/figure/fig1/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"fig1","tag":"figure"},{"children":[{"tag":"#text","text":"Consistent with the high correlation of DunedinPACE with 20-year Pace of Aging, effect-sizes for associations of DunedinPACE with measures of physical and cognitive functioning and subjective signs of aging measured at age 45 in the Dunedin Study were similar to effect-sizes for the 20-year Pace of Aging. Effect-sizes for DunedinPACE are graphed in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig1"},"children":[{"tag":"#text","text":"Figure 1b"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Comparison with effect-sizes for the 20-year Pace of Aging reported previously ("},{"attributes":{"aria-describedby":"bib21","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib21"},"children":[{"tag":"#text","text":"Elliott et al., 2021b"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib63","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib63"},"children":[{"tag":"#text","text":"Rasmussen et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") are shown in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig1s2"},"children":[{"tag":"#text","text":"Figure 1—figure supplement 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We also repeated analysis of decline in physical and cognitive functions included in our original 2020 "},{"children":[{"tag":"#text","text":"eLife"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" report of DunedinPoAm. This analysis tested associations between DunedinPACE and worsening in physical functions and subjective signs of aging between the age-38 and age-45 assessments and change in cognitive functioning from adolescent baseline to the age-45 assessment. Effect-sizes are graphed in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig1"},"children":[{"tag":"#text","text":"Figure 1c"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Comparison of DunedinPACE effect-sizes for associations with function tests and subjective signs of aging to effect-sizes for the original DunedinPoAm and the DNA methylation clocks proposed by Horvath, Hannum et al., Levine et al. (PhenoAge Clock), and Lu et al. (GrimAge Clock) are shown in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig1s3"},"children":[{"tag":"#text","text":"Figure 1—figure supplements 3"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig1s4"},"children":[{"tag":"#text","text":"4"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". DunedinPACE effect-sizes are similar to or larger than those for DunedinPoAm and the GrimAge clock and larger than those for the other DNA methylation clocks. DunedinPACE and DunedinPoAm were developed from analysis of Pace of Aging in the Dunedin cohort; effect-sizes for these measures may be over-estimated in analyses of Dunedin data. We therefore conducted further validation analysis in four additional cohorts."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s2-1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"DunedinPACE shows exceptional test-retest reliability"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"A Pace of Aging measure should have high test-retest reliability in order to be able to quantify change from pre-treatment baseline to post-treatment follow-up in intervention studies or exposure-related changes in longitudinal observational studies. We first evaluated test-retest reliability of DunedinPACE using a publicly available database of 36 replicate adult-blood-sample Illumina 450 k datasets ("},{"attributes":{"aria-describedby":"bib46","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib46"},"children":[{"tag":"#text","text":"Lehne et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") (GEO Accession "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). We estimated intraclass correlation coefficients (ICCs) for these replicates using mixed-effects regression. For the original DunedinPoAm, reliability was good (ICC = 0.89 95% CI [0.79–0.94]). For DunedinPACE, reliability was excellent (ICC = 0.96 [0.93–0.98]; "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig2"},"children":[{"tag":"#text","text":"Figure 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":").We repeated this analysis in two additional databases of replicates reported by "},{"attributes":{"aria-describedby":"bib68","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib68"},"children":[{"tag":"#text","text":"Sugden et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", a database of n = 28 replicate Illumina EPIC-array datasets and a database of n = 350 replicates in which one dataset was generated from the Illumina 450 k array and the other dataset was generated from the Illumina EPIC array. DunedinPACE ICCs were 0.97 [0.94–0.98] in the EPIC-EPIC database and 0.87 [0.82–0.90] in the 450k-EPIC database."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 2. Test-retest reliability of DunedinPACE."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"The figure graphs DunedinPACE values for replicate Illumnina450k datasets for n = 36 individuals in the dataset published by Lehne and colleagues ("},{"attributes":{"aria-describedby":"bib46","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib46"},"children":[{"tag":"#text","text":"Lehne et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") (GEO Accession "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). The ICC for DunedinPACE in the Lehne dataset is 0.96 95% CI [0.92–0.98]."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"alt":"Figure 2.","class":"graphic","height":"722","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/b93d9ee03b22/elife-73420-fig2.jpg","width":"732"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 2—figure supplement 1. Reliability of DunedinPACE, DunedinPoAm, and DNA methylation clocks."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig2-figsupp1.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 2—figure supplement 1.","class":"graphic zoom-in","height":"421","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/0f86fd614c46/elife-73420-fig2-figsupp1.jpg","width":"663"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"The figure plots intraclass correlation coefficients (ICCs) estimated from replicate DNA methylation datasets for DunedinPACE, original DunedinPoAm, and the DNA methylation clocks proposed by Horvath, Hannum et al., Levine et al. (PhenoAge), and Lu et al. (GrimAge). Error bars show 95% confidence intervals. Data are graphed from three datasets, 36 Illumina 450 k technical replicates from "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" ("},{"attributes":{"aria-describedby":"bib46","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib46"},"children":[{"tag":"#text","text":"Lehne et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), and 28 Illumina EPIC array technical replicates and 350 Illumina 450k-EPIC replicates from "},{"attributes":{"aria-describedby":"bib68","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib68"},"children":[{"tag":"#text","text":"Sugden et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The Sugden et al. EPIC technical replicate dataset (Sugden A) included arrays analyzed as part of the Dunedin Study dataset. The Sugden et al. 450k-EPIC dataset (Sugden B) was used to identify probes for inclusion in the machine learning analysis from which DunedinPACE was derived."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"fig2s1","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/figure/fig2/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"fig2","tag":"figure"},{"children":[{"tag":"#text","text":"Comparison of DunedinPACE reliability to reliabilities for the original DunedinPoAm and the DNA methylation clocks are shown in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig2s1"},"children":[{"tag":"#text","text":"Figure 2—figure supplement 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". DunedinPACE is as reliable as the GrimAge clock and more reliable in comparison to the other clocks, although methods have been proposed that may improve reliabilities for the other clocks ("},{"attributes":{"aria-describedby":"bib33","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib33"},"children":[{"tag":"#text","text":"Higgins-Chen et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We conducted analysis to evaluate the extent to which improved fit to longitudinal Pace of Aging and better test-retest reliability for DunedinPACE as compared to the original DunedinPoAm might reflect (a) the four-time-point follow-up design of 20-year Pace of Aging and (b) the restriction of elastic net regression to develop DunedinPACE to probes that demonstrated higher test-retest reliabilities in blood in an independent sample. Results suggest that both four-time-points to measure Pace of Aging and restricting machine-learning analysis to CpG sites with higher test-retest reliability contributed to the technical improvement in DunedinPACE over DunedinPoAm (see "},{"children":[{"tag":"#text","text":"Appendix 1"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s2-2","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"DunedinPACE is faster in chronologically and biologically older individuals"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"In demography, the pace of biological aging in a population can be estimated from the rate of increase in mortality risk from younger to older chronological ages ("},{"attributes":{"aria-describedby":"bib29","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib29"},"children":[{"tag":"#text","text":"Hägg et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). In humans and many other species, the increase in mortality risk with advancing chronological age is nonlinear, suggesting that the pace of biological aging accelerates as we grow older ("},{"attributes":{"aria-describedby":"bib27","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib27"},"children":[{"tag":"#text","text":"Gompertz, 1997"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib41","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib41"},"children":[{"tag":"#text","text":"Kirkwood, 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib57","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib57"},"children":[{"tag":"#text","text":"Olshansky and Carnes, 1997"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). We tested if, consistent with this hypothesis, DunedinPACE was faster in chronologically older as compared to younger individuals in data from the Understanding Society Study (n = 1175,, age range 28–95). Chronologically older Understanding Society participants had faster DunedinPACE as compared to younger ones ("},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.32, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig3"},"children":[{"tag":"#text","text":"Figure 3A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). This correlation was threefold larger as compared to the correlation for the original DunedinPoAm ("},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.11)."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 3. Associations of DunedinPACE with chronological age, epigenetic clocks, Physiology-based measures of biological age, and self-rated health in Understanding Society."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"Panel A shows a scatterplot and fitted slopes illustrating the association between chronological age (x-axis) and DunedinPACE (y-axis) in women and men in the Understanding Society sample. Data for women are plotted with yellow dots (orange slope) and for men with blue crosses (navy slope). The figure illustrates a positive association between chronological age and DunedinPACE (Pearson "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.32). Panel B shows a matrix of correlations and association plots among DunedinPACE and age-acceleration residuals of Horvath, Hannum, Levine-PhenoAge and Lu-GrimAge epigenetic clocks. The diagonal cells of the matrix list the DNA methylation measures. The half of the matrix below the diagonal shows scatter plots of associations. For each scatter-plot cell, the y-axis corresponds to the variable named along the matrix diagonal to the right of the plot and the x-axis corresponds to the variable named along the matrix diagonal above the plot. The half of the matrix above the diagonal lists Pearson correlations between the DNA methylation measures. For each correlation cell, the value reflects the correlation of the variables named along the matrix diagonal to the left of the cell and below the cell. Panel C graphs scatterplots of associations of DunedinPACE with three physiology-based measures of biological age (KDM Biological Age Advancement, "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.30 [0.24–0.36]; Phenotypic Age Advancement, "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.32 95% CI [0.26–0.38]; and Homeostatic Dysregulation "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.09 [0.03–0.16]) and a plot of DunedinPACE means and 95% confidence intervals by self-rated health category ("},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.20 [0.15–0.26])."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig3.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 3.","class":"graphic zoom-in","height":"602","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/5859e21f34f9/elife-73420-fig3.jpg","width":"751"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 3—figure supplement 1. Effect-sizes for associations of DunedinPACE, DunedinPoAm, and DNA methylation clocks with physiology-based measures of biological age and self-rated health."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig3-figsupp1.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 3—figure supplement 1.","class":"graphic zoom-in","height":"422","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/b46ea93c801e/elife-73420-fig3-figsupp1.jpg","width":"674"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Figure shows effect-sizes estimated from the Understanding Society data (n=1,175). Effect-sizes are reported as standardized regression coefficients interpretable as Pearson r values. Error bars show 95% confidence intervals. DNA methylation clocks were residualized for chronological age prior to analysis. Models included covariates for chronological age and sex. Physiology-based measures of biological age were computed from Understanding Society biomarker data (albumin, alkaline phosphatase, creatinine, C-reactive protein, blood urea nitrogen, glycated hemoglobin, systolic blood pressure, and forced expiratory volume in 1second) based on algorithms derived in data from the US NHANES according to the methods developed by "},{"attributes":{"aria-describedby":"bib49","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib49"},"children":[{"tag":"#text","text":"Levine et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", ("},{"attributes":{"aria-describedby":"bib42","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib42"},"children":[{"tag":"#text","text":"Klemera and Doubal, 2006"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), and ("},{"attributes":{"aria-describedby":"bib13","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib13"},"children":[{"tag":"#text","text":"Cohen et al., 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"fig3s1","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/figure/fig3/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"fig3","tag":"figure"},{"children":[{"tag":"#text","text":"Between-individual correlation of older chronological age with faster DunedinPACE could be confounded by differences in exposure histories across birth cohorts, that is not an effect of within-individual aging ("},{"attributes":{"aria-describedby":"bib54","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib54"},"children":[{"tag":"#text","text":"Moffitt, 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). To rule out such confounding, we conducted analysis of within-individual change in DunedinPACE in the US Veterans Administration Normative Aging Study (NAS). Among NAS participants with repeated-measures DNA methylation data (n = 536), DunedinPACE increased by b = 0.021 (SE = 0.003) per 5 years of follow-up, or approximately 0.2 standard deviation units, similar to what we previously reported for the original DunedinPoAm ("},{"attributes":{"aria-describedby":"bib8","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib8"},"children":[{"tag":"#text","text":"Belsky et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"DunedinPACE is faster in individuals measured to be biologically older using prior measures derived from DNA methylation and physiological data, and who report poorer self-rated health. We compared DunedinPACE with the epigenetic clocks proposed by "},{"attributes":{"aria-describedby":"bib31","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib31"},"children":[{"tag":"#text","text":"Hannum et al., 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib34","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib34"},"children":[{"tag":"#text","text":"Horvath, 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib49","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib49"},"children":[{"tag":"#text","text":"Levine et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib50","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib50"},"children":[{"tag":"#text","text":"Lu et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", with measurements of biological age derived from physiological data and with participants’ subjective perceptions of their own health status in data from the UK-based Understanding Society Study (n = 1175,, mean age = 58, SD = 15, 42% male)."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Epigenetic clock analysis"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"For each epigenetic clock, we calculated the measure referred to as epigenetic ‘age acceleration’ by regressing participants’ clock-estimated ages on their chronological ages and computing residual values. This measure is often used as an estimate of the aging rate. It quantifies the difference between the amount of aging expected based on a person’s chronological age and the amount of aging observed based on DNA methylation. DunedinPACE was weakly correlated with age acceleration computed from the Horvath clock ("},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.13) and somewhat more strongly correlated with age acceleration computed from the Hannum and Levine clocks (Hannum "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.26; PhenoAge "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.36). These correlations were similar to those reported on our 2020 "},{"children":[{"tag":"#text","text":"eLife"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" article for the original DunedinPoAm measure. For the GrimAge clock proposed by Lu et al., the correlation with the age-acceleration residuals was stronger ("},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.58). Correlations are plotted in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig3"},"children":[{"tag":"#text","text":"Figure 3B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s2-3-1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Physiology-based measurements of biological age"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We used published methods to measure participants’ biological ages from blood-chemistry, blood-pressure, and lung function data collected at the same time as the DNA methylation data. We computed indices of biological age using three different methods: the Klemera and Doubal method (KDM) Biological Age estimates the age at which a person’s physiology would appear normal in a reference population "},{"attributes":{"aria-describedby":"bib42","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib42"},"children":[{"tag":"#text","text":"Klemera and Doubal, 2006"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; the Phenotypic Age method estimates the age at which a person’s physiology-predicted mortality risk would be approximately normal in a reference population "},{"attributes":{"aria-describedby":"bib49","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib49"},"children":[{"tag":"#text","text":"Levine et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; the homeostatic dysregulation method estimates the extent to which a person’s physiology deviates from a state of health ("},{"attributes":{"aria-describedby":"bib13","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib13"},"children":[{"tag":"#text","text":"Cohen et al., 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). These algorithms generate correlated but distinct estimates conceptually related to biological age ("},{"attributes":{"aria-describedby":"bib32","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib32"},"children":[{"tag":"#text","text":"Hastings et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib59","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib59"},"children":[{"tag":"#text","text":"Parker et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Algorithms were parameterized using a set of biomarkers available in Understanding Society and included in Levine’s original implementation of the Klemera-Doubal Biological Age ("},{"attributes":{"aria-describedby":"bib48","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib48"},"children":[{"tag":"#text","text":"Levine, 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; albumin, alkaline phosphatase, blood urea nitrogen, creatinine, C-reactive protein, HbA1C, systolic blood pressure, forced expiratory volume in one second) and training data from the US National Health and Nutrition Examination Surveys (NHANES) ("},{"attributes":{"aria-describedby":"bib43","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib43"},"children":[{"tag":"#text","text":"Kwon and Belsky, 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Consistent with analysis of epigenetic age acceleration, participants with more advanced biological aging measured from physiological data also showed faster DunedinPACE (KDM Biological Age Advancement "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.30; Phenotypic Age Advancement "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.32; Homeostatic Dysregulation "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.09; "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig3"},"children":[{"tag":"#text","text":"Figure 3C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s2-3-2","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Self-rated health"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Participants who rated themselves as being in worse health also showed faster DunedinPACE. The difference in DunedinPACE between those rating their health as excellent and poor was large (Cohen’s d = 0.74 [0.46–1.03]; "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig3"},"children":[{"tag":"#text","text":"Figure 3C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Comparison of effect-sizes for associations with physiology-based measures of biological age and self-rated health between DunedinPACE and the original DunedinPoAm and the four DNA methylation clocks is shown in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig3s1"},"children":[{"tag":"#text","text":"Figure 3—figure supplement 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". DunedinPACE effect-sizes are similar effect-sizes for DunedinPoAm and the GrimAge clock and larger in comparison to the other clocks."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s2-3-3","tag":"section"}],"hidden":false,"id":"s2-3","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Faster DunedinPACE is associated with morbidity, disability, and mortality"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We conducted analysis of morbidity and mortality in older men in the VA Normative Aging Study (NAS) and in the Framingham Heart Study Offspring cohort."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"NAS analysis was conducted using the same methods reported in our original article ("},{"attributes":{"aria-describedby":"bib8","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib8"},"children":[{"tag":"#text","text":"Belsky et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Briefly, analysis included n = 771 older men with average age of 77 years (SD = 7) at DNA methylation measurement. Over follow-up from DNA collection in 1999–2013, 46% died and 23% were diagnosed with a new chronic disease, including any of hypertension, type-2 diabetes, cardiovascular disease, chronic obstructive pulmonary disease, chronic kidney disease, and cancer. Participants with faster DunedinPACE were at increased risk for morbidity and mortality (for incident chronic disease morbidity, DunedinPACE HR = 1.23 [1.07–1.42]; for prevalent chronic disease morbidity, DunedinPACE RR = 1.16 [1.12–1.20]; for mortality, DunedinPACE HR = 1.26 95% CI [1.14–1.40], "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig4"},"children":[{"tag":"#text","text":"Figure 4A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 4. Association of DunedinPACE with mortality."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"Panel A shows mortality in the Normative Aging Study (NAS). Panel B shows mortality in the Framingham Heart Study Offspring Cohort. The figure plots Kaplan-Meier curves for three groups of participants in each of the two cohorts: those with DunedinPACE 1 SD or more below the mean (‘slow’ DunedinPACE, blue line); those with DunedinPACE within 1 SD of the mean (‘average’ DunedinPACE, purple line); and those with DunedinPACE 1 SD or more above the mean (‘fast’ DunedinPACE, red line). Censoring of participants prior to death is indicated with a gold hash marks. The table below the figure details the number of participants at risk per 3-year interval and, in parentheses, the number who died during the interval."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig4.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 4.","class":"graphic zoom-in","height":"883","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/d319511485f8/elife-73420-fig4.jpg","width":"646"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 4—figure supplement 1. Effect-sizes for analysis of mortality in the Normative Aging Study and the Framingham Heart Study Offspring cohort."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig4-figsupp1.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 4—figure supplement 1.","class":"graphic zoom-in","height":"412","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/a894c8b5f745/elife-73420-fig4-figsupp1.jpg","width":"663"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Effect-sizes are reported as hazard ratios (HR) per standard deviation increment of the aging measures estimated from Cox proportional hazard regression. All models included covariates for chronological age and sex."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"fig4s1","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 4—figure supplement 2. Effect-sizes for analysis of incident and prevalent chronic disease morbidity in the Normative Aging Study."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig4-figsupp2.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 4—figure supplement 2.","class":"graphic zoom-in","height":"413","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/438a498abdb6/elife-73420-fig4-figsupp2.jpg","width":"663"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Effect-sizes are reported as relative risks (RR) per standard deviation increment of the aging measures estimated from Poisson regression. All models included covariates for chronological age and sex."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"fig4s2","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 4—figure supplement 3. Effect-sizes for analysis of time-to-diagnosis with cardiovascular disease (CVD) and time to stroke or transient ischemic attack (TIA) in the Framingham Heart Study Offspring Cohort."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig4-figsupp3.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 4—figure supplement 3.","class":"graphic zoom-in","height":"421","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/ae234f895c26/elife-73420-fig4-figsupp3.jpg","width":"663"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Effect-sizes are reported as hazard ratios (HR) per standard deviation increment of the aging measures estimated from Cox proportional hazard regression. All models included covariates for chronological age and sex."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"fig4s3","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 4—figure supplement 4. Effect-sizes for analysis of incident disability from repeated-measures of limitations to activities of daily living (ADLs)."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig4-figsupp4.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 4—figure supplement 4.","class":"graphic zoom-in","height":"421","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/8e057190e35d/elife-73420-fig4-figsupp4.jpg","width":"663"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"For all panels, error bars show 95% confidence intervals. DNA methylation clocks were residualized for chronological age prior to analysis. All models included covariates for chronological age and sex."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"fig4s4","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/figure/fig4/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"fig4","tag":"figure"},{"children":[{"tag":"#text","text":"Framingham analysis included n = 2471 members of the Offspring cohort (54% women) with average age of 66 years (SD = 9) at DNA methylation measurement during 2005–2008. Over follow-up through 2018, "},{"children":[{"tag":"#text","text":"23%"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" died, "},{"children":[{"tag":"#text","text":"13%"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" were newly diagnosed with cardiovascular disease (CVD), and "},{"children":[{"tag":"#text","text":"6%"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" had a first stroke or transient ischemic attack (TIA). Disability follow-up was conducted through 2015 based on participant reports of limitations to activities of daily living (ADLs) on the Nagi, Katz, and Rosow-Brelsau scales. Participants with faster DunedinPACE at baseline were at increased risk for CVD, stroke/TIA, and mortality (CVD HR = 1.39 [1.26–1.54]; stroke/TIA HR = 1.37 [1.19–1.58]; mortality HR = 1.65 95% CI [1.51–1.79], "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig4"},"children":[{"tag":"#text","text":"Figure 4B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). They were also more likely to develop disability (Nagi ADL IRR = 1.40 [1.19–1.65]; Katz ADL IRR = 1.33 [1.16–1.53]; Rosow-Breslau ADL IRR = 1.39 [1.24–1.56])."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Comparison of effect-sizes for associations with morbidity, disability, and mortality between DunedinPACE and the original DunedinPoAm and the DNA methylation clocks are shown in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig4s1"},"children":[{"tag":"#text","text":"Figure 4—figure supplements 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig4s4"},"children":[{"tag":"#text","text":"4"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". DunedinPACE effect-sizes were similar to those for DunedinPoAm and the GrimAge clock and larger than effect-sizes for the other measures."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s2-4","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Childhood exposure to poverty and victimization is associated with faster DunedinPACE"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"A Pace of Aging measure should be sensitive to histories of exposure associated with earlier onset of morbidity and shorter lifespan and should provide indications of faster aging before clinical signs of aging-related disease develop, in time for prevention. To test if DunedinPACE indicated faster aging in young people with histories of exposure thought to shorten healthy lifespan, we analyzed data from n = 1,658 members of the E-Risk Longitudinal Study. The E-Risk Study follows a 1994–1995 birth cohort of same-sex twins. Blood DNA methylation data were collected when participants were aged 18 years. We analyzed two exposures associated with shorter healthy lifespan, childhood low socioeconomic status and childhood victimization. Socioeconomic status was measured from data on parents’ education, occupation, and income ("},{"attributes":{"aria-describedby":"bib70","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib70"},"children":[{"tag":"#text","text":"Trzesniewski et al., 2006"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Victimization was measured from exposure dossiers compiled from interviews with the children’s mothers and home-visit assessments conducted when the children were aged 5, 7, 10, and 12 ("},{"attributes":{"aria-describedby":"bib23","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib23"},"children":[{"tag":"#text","text":"Fisher et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). The dossiers recorded children’s exposure to domestic violence, peer bullying, physical and sexual harm by an adult, and neglect. 72% of the analysis sample had no victimization exposure, 21% had one type of victimization exposure, 4% had two types of exposure, and 2% had three or more types of exposure."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"E-Risk participants with exposure to childhood poverty and victimization showed faster DunedinPACE (For low as compared to high childhood socioeconomic status, d = 0.38 95% CI [0.25–0.51]; for polyvictimization as compared to no victimization, d = 0.47 [0.17–0.77]; "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig5"},"children":[{"tag":"#text","text":"Figure 5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 5. DunedinPACE levels by strata of childhood socioeconomic status (SES) and victimization in the E-Risk Study."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"Panel A (left side) plots means and 95% CIs for DunedinPACE measured at age 18 among E-Risk participants who grew up low, middle, and high socioeconomic status households. Panel B (right side) plots means and 95% CIs for DunedinPACE measured at age 18 among E-Risk participants who experienced 0, 1, 2, or 3 or more types of victimization through age 12 years."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig5.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 5.","class":"graphic zoom-in","height":"353","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/8a299079976d/elife-73420-fig5.jpg","width":"758"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 5—figure supplement 1. Effect-sizes for associations of childhood socioeconomic conditions and childhood victimization history with DunedinPACE, DunedinPoAm, and DNA methylation clocks at age 18."}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=8853656_elife-73420-fig5-figsupp1.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 5—figure supplement 1.","class":"graphic zoom-in","height":"526","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f555/8853656/b733a008ef72/elife-73420-fig5-figsupp1.jpg","width":"759"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Panel A plots effect-sizes for low socioeconomic status (SES) in childhood (vs. high SES in childhood). Panel B plots effect-sizes for childhood polyvictimization (vs. no childhood victimization). Effect-sizes are reported as Cohen’s d. For both panels, error bars show 95% confidence intervals. DNA methylation clocks were residualized for chronological age prior to analysis. All models included sex as a covariate. (All E-Risk participants are the same chronological age; no age covariate is needed.)."}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"fig5s1","tag":"figure"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/figure/fig5/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"fig5","tag":"figure"},{"children":[{"tag":"#text","text":"Comparison of effect-sizes for associations with childhood poverty and victimization between DunedinPACE and the original DunedinPoAm and the DNA methylation clocks are shown in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig5s1"},"children":[{"tag":"#text","text":"Figure 5—figure supplement 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". DunedinPACE effect-sizes were similar to those for DunedinPoAm and the GrimAge clock and larger than effect-sizes for the other clocks."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s2-5","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Sensitivity analysis"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Results for analysis of all studies including covariate adjustment for cell counts and smoking are reported in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#supp2"},"children":[{"tag":"#text","text":"Supplementary file 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Covariate adjustment for estimated cell counts and participant reports of smoking history resulted in modest attenuation of some effect-sizes, although DunedinPACE effect-sizes remained statistically different from zero in nearly all cases (associations with declines in balance and cognitive function were attenuated below the alpha = 0.05 threshold in Dunedin Study analysis including smoking as a covariate; differences between un-victimized and those with one type of victimization were attenuated below the alpha = 0.05 threshold in E-Risk Study analysis including smoking as a covariate; differences between high- and middle-SES groups were attenuated below the alpha = 0.05 threshold in E-Risk Study analysis excluding smokers). Compared to the original DunedinPoAm, covariate adjustment for smoking tended to have a smaller impact on effect-size estimates for DunedinPACE. In follow-up analysis of the Understanding Society Study, we found that participant-reported smoking history explained 30% of variance in DunedinPoAm, but only 13% of variance in DunedinPACE. Results were similar in analysis of the Framingham Heart Study Offspring Cohort (R"},{"children":[{"tag":"#text","text":"2"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":" = 23% for DunedinPoAm vs. 12% for DunedinPACE)."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s2-6","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Incremental predictive value of DunedinPACE in an analysis of morbidity, disability, and mortality"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"DunedinPACE is distinct from DNA methylation clocks in the method of its development and in its interpretation. However, DunedinPACE is moderately correlated with some DNA methylation clocks, in particular GrimAge (see "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#fig3"},"children":[{"tag":"#text","text":"Figure 3B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). We therefore conducted analysis to test if DunedinPACE contributed new information about health-span and lifespan over and above existing DNA methylation clocks. We tested if DunedinPACE associations with morbidity, disability, and mortality were statistically independent of each of the DNA methylation clocks within the Framingham Heart Study. In the case of the GrimAge clock, which was developed to predict mortality using this Framingham dataset, this analysis provides an especially rigorous test."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"DunedinPACE associations with health-span endpoints were little-changed by covariate adjustment for the Horvath, Hannum, or PhenoAge Clocks. In models adjusted for GrimAge, DunedinPACE associations with mortality, CVD, and disability were attenuated, but remained statistically different from zero (mortality HR = 1.24 [1.49–1.74], CVD HR = 1.18 [1.05–1.34], Nagi ADL IRR = 1.27 [1.02–1.58], Katz ADL IRR = 1.26 [1.02–1.54], Rosow-Breslau ADL IRR = 1.27 [1.08–1.50]); associations with stroke were similar to unadjusted models (HR = 1.33 [1.05–1.69]). Results for all models are reported in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#supp1"},"children":[{"tag":"#text","text":"Supplementary file 1C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Thus, Dunedin PACE adds incremental prediction over and above all clocks studied here."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s2-7","tag":"section"}],"hidden":false,"id":"s2","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"s3"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"s3"},"hidden":false,"id":"s3-anchor","tag":"a"},{"tag":"#text","text":"Discussion"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We developed a novel DNA methylation measure of the pace of biological aging from analysis of two decades of longitudinal data from members of the Dunedin Study 1972–1973 birth cohort. The new measure is named DunedinPACE. As in our original report ("},{"attributes":{"aria-describedby":"bib8","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib8"},"children":[{"tag":"#text","text":"Belsky et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), we utilized a two-step approach that first modeled the Pace of Aging from within-individual changes in organ-system integrity markers and then distilled this longitudinal change measure into a single-time-point DNA-methylation blood test. DunedinPACE is therefore distinct from the DNA methylation clocks in both theory and method. The clocks estimate the progress of aging up to a cross-section in time. DunedinPACE is a DNA methylation estimate of the Pace of Aging, the ongoing rate of decline in system integrity."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The DunedinPACE measure advances DNA methylation measurement of the Pace of Aging for clinical trials of geroprotective therapies beyond our original DunedinPoAm measure in four ways: (1) Pace of Aging analysis included 20 years of follow-up (instead of 12); (2) Pace of Aging analysis included four time points of measurement (instead of three); (3) DNA methylation modeling of Pace of Aging excluded CpG sites for which probes were determined to have low test-retest reliability in blood datasets; (4) the algorithm to implement DunedinPACE includes a normalization step that allows DunedinPACE values for individual samples to be compared to the Dunedin Study cohort in which the measure was developed."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"As a result of these advances, DunedinPACE provides a more precise measurement of the Pace of Aging as compared to the original DunedinPoAm and shows higher test-retest reliability. Interestingly, in contrast to reports for some epigenetic clocks ("},{"attributes":{"aria-describedby":"bib33","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib33"},"children":[{"tag":"#text","text":"Higgins-Chen et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), the restriction of machine learning analysis to a more-reliably-measured subset of CpG sites on the Illumina EPIC array did not harm criterion validity of DunedinPACE; effect-sizes for prediction of morbidity and mortality were as large or larger in comparison to DunedinPoAm. Analysis of this more precise and reliable measurement revealed stronger associations with signs of aging. DunedinPACE showed a stronger correlation with chronological age as compared to the original DunedinPoAm, consistent with demographic evidence that biological processes of aging accelerate in later life ("},{"attributes":{"aria-describedby":"bib22","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib22"},"children":[{"tag":"#text","text":"Finch and Crimmins, 2016"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). In analysis of construct and criterion validity, DunedinPACE was associated with functional decline in midlife adults; it was correlated with measures of biological age derived from blood chemistry and DNA methylation data, and with research participants’ subjective perceptions of their own health; it was predictive of morbidity and mortality in midlife and older adults; and it indicated faster Pace of Aging in young adults with histories of exposure to poverty and victimization. DunedinPACE effect-sizes were similar to or larger than those for the original DunedinPoAm measure even as DunedinPACE was less influenced by participant smoking history. In analysis that took smoking history into account, DunedinPACE effect-sizes were more robust than those for DunedinPoAm, most notably in analysis of mortality in the Framingham Heart Study and of early-life adversity in the E-Risk cohort."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"DunedinPACE effect-sizes in analysis of construct and criterion validity were also larger than those for benchmark DNA methylation clocks proposed by Horvath, Hannum et al., and Levine et al. (PhenoAge), and similar to those for the clock proposed by Lu et al. (GrimAge), and were robust to covariate adjustment for smoking and DNA methylation estimates of cell counts. Moreover, in Framingham Heart Study Offspring Cohort analysis of incremental predictive validity, DunedinPACE associations with morbidity, disability, and mortality were robust to covariate adjustment for the DNA methylation clocks, including GrimAge, although some associations were attenuated in GrimAge-adjusted models. Framingham analysis represents a decisive test of value added by DunedinPACE over and above GrimAge because GrimAge was developed within the Framingham cohort."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"In sum, DunedinPACE represents a novel measure of aging that is conceptually and empirically distinct from the DNA methylation clocks and that constitutes an advance on the original DunedinPoAm measure. DunedinPACE can complement existing DNA methylation measures of aging in analysis of observational studies and randomized trials to help advance the frontiers of geroscience."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We acknowledge limitations. Foremost, the Dunedin Study sample we analyzed to develop DunedinPACE is a relatively modestly sized cohort and is drawn from a single country. As additional cohorts develop the multi-time-point organ-system-function datasets to model Pace of Aging, integrating these data into DNA methylation algorithms to measure Pace of Aging may enhance precision. Nevertheless, DunedinPACE does show consistent evidence of criterion and construct validity in several additional datasets, boosting confidence in its external validity. In addition, our work on DunedinPACE thus far has not addressed population diversity in biological aging. The Dunedin cohort and the Understanding Society, NAS, Framingham, and E-Risk cohorts were mostly of white European descent. Follow-up of DunedinPACE in more diverse samples is needed to establish cross-population validity. Importantly, our original DunedinPoAm measure has been followed-up in diverse cohorts and has showed evidence of consistent validity across race/ethnic subgroups ("},{"attributes":{"aria-describedby":"bib15","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib15"},"children":[{"tag":"#text","text":"Crimmins et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib28","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib28"},"children":[{"tag":"#text","text":"Graf et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib62","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib62"},"children":[{"tag":"#text","text":"Raffington et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib66","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib66"},"children":[{"tag":"#text","text":"Schmitz et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Criterion validity analyses conducted in this article do not consider specific diseases or causes of death because the cohorts used for follow-up are relatively small. Geroscience theory predicts aging should increase risk of chronic disease and death overall. Analysis of DunedinPACE in larger datasets with more deaths will allow for tests of whether particular incident diseases or causes of death drive associations. Comparative analyses in this article include only other DNA methylation measures of aging. Recent reports suggest valuable information about aging and healthspan may also be captured in metabolomic and proteomic datasets ("},{"attributes":{"aria-describedby":"bib18","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib18"},"children":[{"tag":"#text","text":"Deelen et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib19","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib19"},"children":[{"tag":"#text","text":"Eiriksdottir et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib36","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib36"},"children":[{"tag":"#text","text":"Jansen et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib45","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib45"},"children":[{"tag":"#text","text":"Lehallier et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib69","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib69"},"children":[{"tag":"#text","text":"Tanaka et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Future studies should compare DunedinPACE to measures derived from these biological levels of analysis. As with all proposed measures of biological aging, ultimately establishing DunedinPACE as a surrogate endpoint for healthspan will require evidence that it is modifiable by intervention and that intervention-induced changes result in changes in healthy-lifespan phenotypes ("},{"attributes":{"aria-describedby":"bib37","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib37"},"children":[{"tag":"#text","text":"Justice et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib61","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib61"},"children":[{"tag":"#text","text":"Prentice, 1989"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Within the bounds of these limitations, our analysis establishes DunedinPACE as a novel single-time-point measure that quantifies Pace of Aging from a blood test. It can be implemented in Illumina 450 k or in EPIC array data, making it immediately available for testing in a wide range of existing datasets as a complement to existing methylation measures of aging. Code to compute DunedinPACE is publicly available on GitHub ("},{"attributes":{"aria-describedby":"bib14","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib14"},"children":[{"tag":"#text","text":"Corcoran et al., 2022"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Through collaboration with ongoing cohort studies, DunedinPACE will soon be available from the US Health and Retirement Study and other studies. Because of its high test-retest reliability, DunedinPACE offers a unique measurement for intervention trials and natural experiment studies investigating how the rate of aging may be changed by behavioral or drug therapy, or by environmental modification."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s3","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"s4"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"s4"},"hidden":false,"id":"s4-anchor","tag":"a"},{"tag":"#text","text":"Materials and methods"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Data sources"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Data were used from five studies: The Dunedin Study, the Understanding Society Study, the Normative Aging Study (NAS), the Framingham Heart Study, and the Environmental Risk (E-Risk) Longitudinal Twin Study. In addition, we accessed the Gene Expression Omnibus dataset "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The datasets and measures analyzed within each of them are described below."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"The Dunedin Study"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The Dunedin Study is a longitudinal investigation of health and behavior in a complete birth cohort. Study members (N = 1037; 91% of eligible births; 52% male) were all individuals born between April 1972 and March 1973 in Dunedin, New Zealand (NZ), who were eligible based on residence in the province and who participated in the first assessment at age 3. The cohort represents the full range of socioeconomic status on NZ’s South Island and matches the NZ National Health and Nutrition Survey on key health indicators (e.g. BMI, smoking, physical activity, GP visits) ("},{"attributes":{"aria-describedby":"bib60","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib60"},"children":[{"tag":"#text","text":"Poulton et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). The cohort is primarily white (93%) ("},{"attributes":{"aria-describedby":"bib60","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib60"},"children":[{"tag":"#text","text":"Poulton et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Assessments were carried out at birth and ages 3, 5, 7, 9, 11, 13, 15, 18, 21, 26, 32, 38 and, most recently, 45 years, when 94% of the 997 study members still alive took part. At each assessment, each study member is brought to the research unit for a full day of interviews and examinations. Study data may be accessed through agreement with the Study investigators ("},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://moffittcaspi.trinity.duke.edu/research-topics/dunedin","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://moffittcaspi.trinity.duke.edu/research-topics/dunedin"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Dunedin Study measures of physical and cognitive functioning and subjective signs of aging are described in detail in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#supp1"},"children":[{"tag":"#text","text":"Supplementary file 1D"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-1-1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" is a publicly available dataset including technical replicate Illumina 450 k DNA methylation array data for 36 adult human samples ("},{"attributes":{"aria-describedby":"bib46","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib46"},"children":[{"tag":"#text","text":"Lehne et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Data are available from the Gene Expression Omnibus ("},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-1-2","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Understanding Society"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Understanding Society is an ongoing panel study of the United Kingdom population ("},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://www.understandingsociety.ac.uk/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.understandingsociety.ac.uk/"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). During 2010–2012, participants were invited to take part in a nurse’s exam involving a blood draw. Of the roughly 20,000 participants who provided clinical data in this exam, methylation data have been generated for just under 1200. We analyzed data from 1175 participants with available methylation and blood chemistry data. Documentation of the methylation ("},{"attributes":{"aria-describedby":"bib74","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib74"},"children":[{"tag":"#text","text":"Yanchun, 2017"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") and blood chemistry ("},{"attributes":{"aria-describedby":"bib72","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib72"},"children":[{"tag":"#text","text":"University of Essex, 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") data resource is available online ("},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://www.understandingsociety.ac.uk/sites/default/files/downloads/documentation/health/user-guides/7251-UnderstandingSociety-Biomarker-UserGuide-2014.pdf","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"here"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Physiology-based biological age measures"}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We measured biological aging from blood chemistry, systolic blood pressure, and lung-function data using the algorithms proposed by Klemera and Doubal, Levine, and Cohen ("},{"attributes":{"aria-describedby":"bib13","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib13"},"children":[{"tag":"#text","text":"Cohen et al., 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib42","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib42"},"children":[{"tag":"#text","text":"Klemera and Doubal, 2006"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib48","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib48"},"children":[{"tag":"#text","text":"Levine, 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib49","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib49"},"children":[{"tag":"#text","text":"Levine et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), trained in data from US National Health and Nutrition Examination Surveys (NHANES; "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://wwwn.cdc.gov/nchs/nhanes/Default.aspx","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://wwwn.cdc.gov/nchs/nhanes/Default.aspx"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") following the methods described by Hastings ("},{"attributes":{"aria-describedby":"bib32","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib32"},"children":[{"tag":"#text","text":"Hastings et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") and using the software developed by Kwon ("},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://github.com/dayoonkwon/BioAge","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://github.com/dayoonkwon/BioAge"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", copy archived at "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://archive.softwareheritage.org/swh:1:dir:2e1f44b6e1dd33abf81fd0baa71617d059ad5053;origin=https://github.com/dayoonkwon/BioAge;visit=swh:1:snp:c7c21b09270d93b728a09576a316286d20f04010;anchor=swh:1:rev:bac0d617f4d04eb76350c0750cc367d8d1fd719e","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"swh:1:rev:bac0d617f4d04eb76350c0750cc367d8d1fd719e"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"bib44","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib44"},"children":[{"tag":"#text","text":"Kwon, 2022"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Following the procedure in our original eLife article ("},{"attributes":{"aria-describedby":"bib8","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib8"},"children":[{"tag":"#text","text":"Belsky et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), we included 8 of 10 biomarkers included in Levine’s original implementation of the Klemera-Doubal method Biological Age ("},{"attributes":{"aria-describedby":"bib48","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib48"},"children":[{"tag":"#text","text":"Levine, 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"): albumin, alkaline phosphatase (log), blood urea nitrogen, creatinine (log), C-reactive protein (log), HbA1C, systolic blood pressure, and forced expiratory volume in 1 second (FEV"},{"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"sub"},{"tag":"#text","text":"). We omitted total cholesterol because of evidence this biomarker shows different directions of association with aging in younger and older adults ("},{"attributes":{"aria-describedby":"bib1","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib1"},"children":[{"tag":"#text","text":"Arbeev et al., 2016"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Cytomegalovirus optical density was not available in the Understanding Society database."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-1-3-1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Self-rated health"}],"hidden":false,"tag":"h5"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Understanding Society participants rated their health as excellent, very-good, good, fair, or poor. We standardized this measure to have Mean = 0, Standard Deviation = 1 for analysis."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-1-3-2","tag":"section"}],"hidden":false,"id":"s4-1-3","tag":"section"}],"hidden":false,"id":"s4-1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"The Normative Aging Study"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The Normative Aging Study (NAS) is an ongoing longitudinal study on aging established by the US Department of Veterans Affairs in 1963. Details of the study have been published previously ("},{"attributes":{"aria-describedby":"bib4","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib4"},"children":[{"tag":"#text","text":"Bell et al., 1972"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Briefly, the NAS is a closed cohort of 2280 male veterans from the Greater Boston area enrolled after an initial health screening to determine that they were free of known chronic medical conditions. Participants have been re-evaluated every 3–5 years on a continuous rolling basis using detailed on-site physical examinations and questionnaires. DNA from blood samples was collected from 771 participants beginning in 1999. We analyzed blood DNA methylation data from up to four repeated assessments conducted through 2013 ("},{"attributes":{"aria-describedby":"bib25","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib25"},"children":[{"tag":"#text","text":"Gao et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib58","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib58"},"children":[{"tag":"#text","text":"Panni et al., 2016"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Of the 771 participants with DNA methylation data, n = 536 (70%) had data from two repeated assessments and n = 178 (23%) had data from three or four repeated assessments. We restricted the current analysis to participants with at least one DNA methylation data point. The NAS was approved by the Department of Veterans Affairs Boston Healthcare System and written informed consent was obtained from each subject before participation."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Mortality"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Regular mailings to study participants have been used to acquire vital-status information and official death certificates were obtained from the appropriate state health department to be reviewed by a physician. Participant deaths are routinely updated by the research team and the last available update was on 31 December 2013. During follow-up, n = 354 (46%) of the 771 NAS participants died."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-2-1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Chronic disease morbidity"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We measured chronic disease morbidity from participants medical histories and prior diagnoses ("},{"attributes":{"aria-describedby":"bib26","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib26"},"children":[{"tag":"#text","text":"Gao et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib47","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib47"},"children":[{"tag":"#text","text":"Lepeule et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). We counted the number of chronic diseases to compose an ordinal index with categories of 0, 1, 2, 3, or 4+ of the following comorbidities: hypertension, type-2 diabetes, cardiovascular disease, chronic obstructive pulmonary disease, chronic kidney disease, and cancer."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-2-2","tag":"section"}],"hidden":false,"id":"s4-2","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"The Framingham Heart Study"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The Framingham Heart Study tracks the development of cardiovascular disease in three generations of families recruited in Framingham Massachusetts beginning in 1948 ("},{"attributes":{"aria-describedby":"bib71","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib71"},"children":[{"tag":"#text","text":"Tsao and Vasan, 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). We analyzed data from the Offspring Cohort, the second generation of study participants, who were recruited beginning in 1971. Blood samples used for DNA methylation analysis were collected from Offspring Cohort members at their 8th follow-up visit during 2005–2008. We analyzed data for n = 2471 cohort members with available DNA methylation and mortality data. This sample was 54% women and had an average age of 66 years (SD = 9) at the time blood draws for DNA methylation analysis were conducted. Data for the Framingham Study were obtained from dbGaP (phs000007.v32.p13)."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Mortality"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Mortality ascertainment in our dataset extended through 2018 (dbGaP accession pht003317.v9.p13, dataset vr_survdth_2018_a_1268 s). Participants contributed a maximum of 14 years of follow-up time. A total of 575 deaths were recorded at an average age of 81 years (SD = 9)."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-3-1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Cardiovascular disease (CVD)"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"CVD ascertainment in our dataset extended through 2018 (dbGaP accession pht003316.v9.p13, dataset vr_survcvd_2018_a_1267 s). N = 2,075 participants free of cardiovascular disease at baseline contributed a maximum of 14 years of follow-up time during which 327 incident cases of CVD were recorded at an average age of 77 years (SD = 6)."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-3-2","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Stroke/transient ischemic attack (TIA)"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Stroke/TIA ascertainment in our dataset extended through 2018 (dbGaP accession pht006024.v4.p13, dataset vr_svstktia_2018_a_1270 s). N = 2364 participants with no history of stroke/TIA at baseline contributed a maximum of 14 years of follow-up time during which 149 events were recorded at an average age of 78 years (SD = 8)."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-3-3","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Disability"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Disability was measured from participant reports about limitations to activities of daily living (ADLs) during interviews conducted at the 8th and 9th assessment waves. ADL information was collected using the Nagi, Katz, and Rosow-Breslau scales ("},{"attributes":{"aria-describedby":"bib39","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib39"},"children":[{"tag":"#text","text":"Katz et al., 1970"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib55","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib55"},"children":[{"tag":"#text","text":"Nagi, 1976"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib65","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib65"},"children":[{"tag":"#text","text":"Rosow and Breslau, 1966"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Scales are described in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#supp1"},"children":[{"tag":"#text","text":"Supplementary file 1E"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Incident disability was analyzed for participants free of disability at baseline (Nagi n = 1830; Katz n = 1826; Rosow-Breslau n = 1670). Over follow-up, n = 123 participants developed new limitations in Nagi ADLs; n = 181 developed new limitations in Katz ADLs; and n = 224 developed new limitations in Rosow-Breslau ADLs."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-3-4","tag":"section"}],"hidden":false,"id":"s4-3","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"The Environmental Risk Longitudinal Study"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The Environmental Risk Longitudinal Twin Study (E-Risk) tracks the development of a birth cohort of 2232 British participants. The sample was drawn from a larger birth register of twins born in England and Wales in 1994–1995. Full details about the sample are reported elsewhere ("},{"attributes":{"aria-describedby":"bib52","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib52"},"children":[{"tag":"#text","text":"Moffitt and Team, 2002"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Briefly, the E-Risk sample was constructed in 1999–2000, when 1116 families (93% of those eligible) with same-sex 5-year-old twins participated in home-visit assessments. This sample comprised 56% monozygotic (MZ) and 44% dizygotic (DZ) twin pairs; sex was evenly distributed within zygosity (49% male). Families were recruited to represent the UK population of families with newborns in the 1990s, on the basis of residential location throughout England and Wales and mother’s age. Teenaged mothers with twins were over-selected to replace high-risk families who were selectively lost to the register through non-response. Older mothers having twins via assisted reproduction were under-selected to avoid an excess of well-educated older mothers. The study sample represents the full range of socioeconomic conditions in the UK, as reflected in the families’ distribution on a neighborhood-level socioeconomic index (ACORN [A Classification of Residential Neighborhoods], developed by CACI Inc for commercial use): 25.6% of E-Risk families lived in ‘wealthy achiever’ neighborhoods compared to 25.3% nationwide; 5.3% vs 11.6% lived in ‘urban prosperity’ neighborhoods; 29.6% vs 26.9% lived in ‘comfortably off’ neighborhoods; 13.4% vs 13.9% lived in ‘moderate means’ neighborhoods, and 26.1% vs 20.7% lived in ‘hard-pressed’ neighborhoods. E-Risk underrepresents ‘urban prosperity’ neighborhoods because such households are likely to be childless."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Home-visits assessments took place when participants were aged 5, 7, 10, 12, and 18 years, when 93% of the participants took part. At ages 5, 7, 10, and 12 years, assessments were carried out with participants as well as their mothers (or primary caretakers); the home visit at age 18 included interviews only with participants. Each twin was assessed by a different interviewer. These data are supplemented by searches of official records and by questionnaires that are mailed, as developmentally appropriate, to teachers, and co-informants nominated by participants themselves. The Joint South London and Maudsley and the Institute of Psychiatry Research Ethics Committee approved each phase of the study. Parents gave informed consent and twins gave assent between 5 and 12 years and then informed consent at age 18. Study data may be accessed through the Study investigators ("},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://moffittcaspi.trinity.duke.edu/research-topics/erisk","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://moffittcaspi.trinity.duke.edu/research-topics/erisk"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Childhood Socioeconomic Status"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Childhood Socioeconomic Status (SES) was defined through a standardized composite of parental income, education, and occupation ("},{"attributes":{"aria-describedby":"bib70","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib70"},"children":[{"tag":"#text","text":"Trzesniewski et al., 2006"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). The three SES indicators were highly correlated ("},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.57–0.67) and loaded significantly onto one factor. The population-wide distribution of the resulting factor was divided in tertiles for analyses."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-4-1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Childhood victimization"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"As previously described ("},{"attributes":{"aria-describedby":"bib17","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib17"},"children":[{"tag":"#text","text":"Danese et al., 2017"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), we assessed exposure to six types of childhood victimization between birth to age 12: exposure to domestic violence between the mother and her partner, frequent bullying by peers, physical and sexual harm by an adult, and neglect."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-4-2","tag":"section"}],"hidden":false,"id":"s4-4","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"DNA methylation data"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"DNA methylation was measured from Illumina 450 k Arrays in "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", NAS, Framingham, and E-Risk and from Illumina EPIC 850 k Arrays in the Dunedin Study and Understanding Society. DNA was derived from whole blood samples in all studies. Dunedin Study blood draws were conducted at the cohort’s age-38 assessment during 2010–12 for the prior DunedinPoAm measure, and at the cohort’s age-45 assessment during 2017–2019 for the new DunedinPACE measure. Understanding Society blood draws were conducted in 2012. NAS blood draws were conducted during 1999–2013. Framingham blood draws were conducted during 2005–2008. E-Risk blood draws were conducted at the cohort’s age-18 assessment during 2012–13. Dunedin methylation assays were run by the Molecular Genomics Shared Resource at Duke Molecular Physiology Institute, Duke University (USA). Understanding Society and E-Risk assays were run by the Complex Disease Epigenetics Group at the University of Exeter Medical School (UK) ("},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://www.epigenomicslab.com/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.epigenomicslab.com"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). NAS methylation assays were run by the Genome Research Core of the University of Illinois at Chicago. Framingham methylation assays were run by the University of Minnesota and John’s Hopkins University (dbGaP phs000724.v9.p13). Processing protocols for the methylation data from all studies have been described previously ("},{"attributes":{"aria-describedby":"bib16","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib16"},"children":[{"tag":"#text","text":"Dai et al., 2017"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib30","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib30"},"children":[{"tag":"#text","text":"Hannon et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib51","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib51"},"children":[{"tag":"#text","text":"Marzi et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"; "},{"attributes":{"aria-describedby":"bib58","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib58"},"children":[{"tag":"#text","text":"Panni et al., 2016"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"DNA methylation clocks"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We computed the methylation clocks proposed by "},{"attributes":{"aria-describedby":"bib34","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib34"},"children":[{"tag":"#text","text":"Horvath, 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"bib31","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib31"},"children":[{"tag":"#text","text":"Hannum et al., 2013"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"bib49","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib49"},"children":[{"tag":"#text","text":"Levine et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", and "},{"attributes":{"aria-describedby":"bib50","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib50"},"children":[{"tag":"#text","text":"Lu et al., 2019"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" using the methylation data provided by the individual studies and the Horvath Lab’s webtool ("},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"http://dnamage.genetics.ucla.edu/new","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"http://dnamage.genetics.ucla.edu/new"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-5-1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"DunedinPACE"}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The new Dunedin Pace of Aging methylation algorithm (DunedinPACE) was developed using elastic-net regression analysis carried out in the Dunedin Study, as described in detail in the Results. The criterion variable was 20-year Pace of Aging. Development of the 20-year Pace of Aging is described in detail elsewhere ("},{"attributes":{"aria-describedby":"bib21","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib21"},"children":[{"tag":"#text","text":"Elliott et al., 2021b"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Briefly, we conducted mixed-effects growth modeling of longitudinal change in 19 biomarkers measuring integrity of the cardiovascular, metabolic, renal, hepatic, pulmonary, periodontal, and immune systems. Biomarkers were measured at the age 26, 32, 38, and 45 assessments. Biomarkers are listed in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#supp1"},"children":[{"tag":"#text","text":"Supplementary file 1A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". For each biomarker, we estimated random slopes quantifying each participant’s own rate of change in that biomarker. We then composited, the 19 slopes across the biomarkers to calculate a participant’s Pace of Aging. Pace of Aging was scaled in units representing the mean trend in the cohort, that is the average physiological change occurring during one calendar year (N = 955, M = 1, SD = 0.29). Of the N = 818 Dunedin Study members with methylation data at age 45, N = 817 had measured Pace of Aging (M = 0.99, SD = 0.30). This group formed the analysis sample to develop DunedinPACE."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"To compute DunedinPACE in the "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", Understanding Society, NAS, Framingham, and E-Risk datasets, we applied the scoring algorithm derived from elastic net regression in the Dunedin Study. CpG weights for the scoring algorithm are provided in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#supp2"},"children":[{"tag":"#text","text":"Supplementary file 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". To apply the scoring algorithm, a panel of 20,000 probes that represent the underlying distribution of all probes included in the analysis to develop DunedinPACE are drawn from the target dataset. This new dataset is then quantile-normalized to match the reference distribution from the Dunedin Study. The set of 20,000 probes is composed of the 173 probes that make up the DunedinPACE algorithm and 19,827 additional probes selected at random from the full set of probes included in analysis to develop DunedinPACE i.e probes passing quality control checks, which are included on Illumina 450 k and EPIC arrays, and which were reliable at an ICC threshold of 0.4 in the analysis by "},{"attributes":{"aria-describedby":"bib68","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib68"},"children":[{"tag":"#text","text":"Sugden et al., 2020"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-5-2","tag":"section"}],"hidden":false,"id":"s4-5","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Statistical analysis"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We conducted analysis of Dunedin, "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", Understanding Society, NAS, Framingham, and E-Risk, data using regression models. We analyzed continuous outcome data using linear regression. We analyzed count outcome data using Poisson and negative binomial regression. We analyzed time-to-event outcome data using Cox proportional hazard regression. To estimate intraclass correlation coefficients for technical replicates in "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", we used mixed-effects regression models. For analysis of repeated-measures longitudinal DNA methylation data in the NAS, we used generalized estimating equations to account for non-independence of repeated observations of individuals ("},{"attributes":{"aria-describedby":"bib2","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib2"},"children":[{"tag":"#text","text":"Ballinger, 2016"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), following the method in previous analysis of those data ("},{"attributes":{"aria-describedby":"bib24","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib24"},"children":[{"tag":"#text","text":"Gao et al., 2018"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), and econometric fixed-effects regression ("},{"attributes":{"aria-describedby":"bib73","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib73"},"children":[{"tag":"#text","text":"Wooldridge, 2012"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") to test within-person change over time. For analysis in E-Risk, which include data on twin siblings, we clustered standard errors at the family level to account for non-independence of data. For regression analysis, methylation measures were adjusted for batch effects by regressing the measure on batch controls and predicting residual values. Dunedin Study, Understanding Society, Framingham, and E-Risk analyses included covariate adjustment for sex (the NAS included only men). Understanding Society, NAS, and Framingham analyses included covariate adjustment for chronological age. (Dunedin and E-Risk are birth-cohort studies and participants are all the same chronological age.) Sensitivity analyses testing covariate adjustment for leukocyte distributions and smoking are reported in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#supp2"},"children":[{"tag":"#text","text":"Supplementary file 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Leukocyte distributions were measured from complete blood count data in the Dunedin Cohort and were estimated from DNA methylation data for other cohorts."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-6","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Code for Analysis"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Code is available at "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://github.com/danbelsky/DunedinPACE-eLife-2022","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://github.com/danbelsky/DunedinPACE-eLife-2022"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" (copy archived at "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://archive.softwareheritage.org/swh:1:dir:eef3b4232ae87079a409a02f5582ed0b8ebbd060;origin=https://github.com/danbelsky/DunedinPACE-eLife-2022;visit=swh:1:snp:97e16d5328d312f824bbcac8c663713adf1e7822;anchor=swh:1:rev:e38233555b70c34f84f0b73e18f1a6bc4cb0852e","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"swh:1:rev:e38233555b70c34f84f0b73e18f1a6bc4cb0852e"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"bib9","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib9"},"children":[{"tag":"#text","text":"Belsky, 2022a"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Code to calculate DunedinPACE from Illumina 450 k or Epic Array Data. Code is available at "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://github.com/danbelsky/DunedinPACE","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://github.com/danbelsky/DunedinPACE"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", (copy archived at "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://archive.softwareheritage.org/swh:1:dir:e02601074da808da142deeba7aec4cc881dbd8ed;origin=https://github.com/danbelsky/DunedinPACE;visit=swh:1:snp:651d9015164e26c46fa6c0309b0943acefb142fd;anchor=swh:1:rev:a878c3706aec2ac41bc029704cef321f7c0a4e38","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"swh:1:rev:a878c3706aec2ac41bc029704cef321f7c0a4e38"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"bib10","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib10"},"children":[{"tag":"#text","text":"Belsky, 2022b"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"s4-7","tag":"section"}],"hidden":false,"id":"s4","tag":"section"},{"attributes":{"class":"ack"},"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"ack"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"ack"},"hidden":false,"id":"ack-anchor","tag":"a"},{"tag":"#text","text":"Acknowledgements"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"This research was supported by US-National Institute on Aging grants AG032282, AG061378, AG066887, and UK Medical Research Council grant MR/P005918/1."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The Dunedin Multidisciplinary Health and Development Research Unit is supported by the New Zealand Health Research Council Programme Grant (16-604), and the New Zealand Ministry of Business, Innovation and Employment (MBIE). We thank the Dunedin Study members, Unit research staff, and Study founder Phil Silva."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Understanding Society data come from The UK Household Longitudinal Study, which is led by the Institute for Social and Economic Research at the University of Essex and funded by the Economic and Social Research Council (ES/M008592/1). Information on how to access the data can be found on the Understanding Society website "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://www.understandingsociety.ac.uk/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.understandingsociety.ac.uk"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Data governance was provided by the METADAC data access committee, funded by ESRC, Wellcome, and MRC (2015–2018: MR/N01104X/1; 2018–2020: ES/S008349/1)."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The Normative Aging Study is supported by the National Institute of Environmental Health Sciences (grants P30ES009089, R01ES021733, R01ES025225, and R01ES027747). The VA Normative Aging Study is supported by the Cooperative Studies Program/Epidemiology Research and Information Center of the U.S. Department of Veterans Affairs competeand is a component of the Massachusetts Veterans Epidemiology Research and Information Center, Boston, Massachusetts."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The Framingham Heart Study is conducted and supported by the National Heart, Lung, and Blood Institute (NHLBI) in collaboration with Boston University (Contract No. N01-HC-25195, HHSN268201500001I and 75N92019D00031). This manuscript was not prepared in collaboration with investigators of the Framingham Heart Study and does not necessarily reflect the opinions or views of the Framingham Heart Study, Boston University, or NHLBI."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The E-Risk Study is supported by the UK Medical Research Council (grant G1002190), the US National Institute of Child Health and Development (grant HD077482), and the Jacobs Foundation. The generation of DNA methylation data was supported by the American Asthma Foundation."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"This work used a high-performance computing facility partially supported by grant 2016-IDG-1013 (HARDAC+: Reproducible HPC for Next-generation Genomics\") from the North Carolina Biotechnology Center. We would like to acknowledge the assistance of the Duke Molecular Physiology Institute Molecular Genomics Core for the generation of data for the manuscript."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"AC, DC, DWB, KS, RP, and TEM are listed as inventors on a Duke University and University of Otago invention that was licensed to a commercial entity."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"ack","tag":"section"},{"attributes":{"class":"app"},"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"appendix-1"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"appendix-1"},"hidden":false,"id":"appendix-1-anchor","tag":"a"},{"tag":"#text","text":"Appendix 1"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Correlation with criterion Pace of Aging and test-retest reliability for DunedinPACE, original DunedinPoAm, and alternative versions of these algorithms developed using different sets of CpG sites."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"DunedinPACE and DunedinPoAm were both developed from machine-learning analysis fitting DNA methylation data to Pace of Aging measures derived from longitudinal analysis of organ-function and blood chemistry data within the Dunedin Study."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"There are two key differences between the measures. First, the Pace of Aging measure modeled to develop DunedinPoAm included data from only three repeated measures spanning 12 years of follow-up. In contrast, the Pace of Aging measure modeled to develop DunedinPACE included data from four repeated measurements collected over 20 years of follow-up. Second, DunedinPoAm was developed from a DNA methylation dataset including all probes included on both the Illumina450k and EPIC arrays. In contrast, the DNA methylation dataset used to develop DunedinPACE was restricted to a subset of CpG sites meeting a test-retest reliability threshold."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"These differences should have two consequences for DunedinPACE. First, the inclusion of a 4"},{"children":[{"tag":"#text","text":"th"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":" timepoint in Pace of Aging analysis should increase precision of measurement and result in improved fit of DNA methylation data to the 4-timepoint Pace of Aging criterion as compared to the 3-timepoint version. (A less precise Pace of Aging will be harder for the elastic net machine learning analysis to model since more of the variation will be random noise.) Second, the restriction of machine learning to more reliable CpG sites should result in improved test-retest reliability."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"To further test these improvements, we conducted a sensitivity analysis. We repeated the machine-learning analysis to construct DunedinPACE using the unrestricted set of CpG sites included in the original DunedinPoAm analysis. We refer to the resulting measure as “All-probes DunedinPACE”. In parallel, we repeated the machine-learning analysis to construct DunedinPoAm using the subset of more-reliable CpG sites included in the original DunedinPACE analysis. We refer to the resulting measure as “Reliable Probes DunedinPoAm”. We then repeated our analyses testing correlation of the DNA methylation measures with the criterion Pace of Aging and our analysis of test-retest reliability."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Consistent with the expectation that a 4"},{"children":[{"tag":"#text","text":"th"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":" timepoint would increase precision of Pace of Aging measurement and result in improved criterion fit, both versions of DunedinPACE showed stronger correlation with 4-timepoint Pace of Aging than did the versions of DunedinPoAm with 3-timepoint Pace of Aging. For algorithms trained on all probes, "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.87 DunedinPACE vs. "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.58 for original DunedinPoAm. For algorithms trained on reliable probes, "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.77 for DunedinPACE vs. "},{"children":[{"tag":"#text","text":"r"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" = 0.65 for DunedinPoAm."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Consistent with the expectation that training the algorithm using more reliable probes would improve test-retest reliability, the reliable-probes-trained DunedinPACE showed superior test-retest reliability to the all-probes trained DunedinPACE in the test-retest reliability dataset published by Lehne et al. ("},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") (reliable-probes ICC = 0.96 vs 0.72 for all-probes). ICCs were similar for the two version of DunedinPoAm (reliable-probes ICC = 0.90 vs 0.89 for all probes)."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"appendix-1","tag":"section"},{"attributes":{"lang":"en"},"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"funding-statement1"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"funding-statement1"},"hidden":false,"id":"funding-statement1-anchor","tag":"a"},{"tag":"#text","text":"Funding Statement"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The funders had no role in study design, data collection and interpretation, or the decision to submit the work for publication."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"funding-statement1","tag":"section"},{"attributes":{"class":"contrib-info","lang":"en"},"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"_ci93_"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"_ci93_"},"hidden":false,"id":"_ci93_-anchor","tag":"a"},{"tag":"#text","text":"Contributor Information"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Daniel W Belsky, Email: daniel.belsky@columbia.edu."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Joris Deelen, Max Planck Institute for Biology of Ageing, Cologne, Germany."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Jessica K Tyler, Weill Cornell Medicine, Cornell University, Ithaca, United States."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"_ci93_","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"sec42"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"sec42"},"hidden":false,"id":"sec42-anchor","tag":"a"},{"tag":"#text","text":"Funding Information"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"This paper was supported by the following grants:"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"list","style":"list-style-type:disc"},"children":[{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"\nNational Institute on Aging\n\nAG032282 to Terrie E Moffitt."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"\nMedical Research Council\n\nMR/P005918/1 to Terrie E Moffitt."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"\nNational Institute on Aging\n\nAG066887 to Daniel W Belsky."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"\nNational Institute on Aging\n\nAG061378 to Daniel W Belsky."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"\nNew Zealand Health Research Council\n\n16-604 to Richie Poulton."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"tag":"#text","text":"\nNew Zealand Ministry of Business, Innovation and Employment (MBIE)\n to Richie Poulton."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"ul"}],"hidden":false,"id":"sec42","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"s5"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"s5"},"hidden":false,"id":"s5-anchor","tag":"a"},{"tag":"#text","text":"Additional information"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn-group"},"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Competing interests"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn-group p font-secondary-light font-sm"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"is listed as an inventor on a Duke University and University of Otago invention that was licensed to a commercial entity."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"conf1","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"No competing interests declared."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"conf2","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"No competing interests declared."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"conf3","tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"fn-group1","tag":"section"},{"attributes":{"class":"fn-group"},"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Author contributions"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn-group p font-secondary-light font-sm"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Conceptualization, Data curation, Formal analysis, Funding acquisition, Investigation, Methodology, Project administration, Resources, Software, Supervision, Validation, Visualization, Writing – original draft, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con1","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Conceptualization, Funding acquisition, Investigation, Project administration, Supervision, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con2","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Formal analysis, Methodology, Software, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con3","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Data curation, Methodology, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con4","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Data curation, Funding acquisition, Project administration, Resources, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con5","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Data curation, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con6","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Data curation, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con7","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con8","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Formal analysis, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con9","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Data curation, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con10","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Data curation, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con11","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Formal analysis, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con12","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Formal analysis, Visualization, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con13","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Formal analysis, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con14","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Data curation, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con15","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Data curation, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con16","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Data curation, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con17","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con18","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Data curation, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con19","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"tag":"#text","text":"Conceptualization, Data curation, Funding acquisition, Project administration, Resources, Supervision, Writing – review and editing."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"con20","tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"fn-group2","tag":"section"}],"hidden":false,"id":"s5","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"s6"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"s6"},"hidden":false,"id":"s6-anchor","tag":"a"},{"tag":"#text","text":"Additional files"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"attributes":{"class":"sm xbox font-sm"},"children":[{"attributes":{"class":"caption p"},"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Supplementary file 1. Supplementary file 1A-E."}],"hidden":false,"tag":"span"},{"children":[{"tag":"#text","text":"("},{"children":[{"tag":"#text","text":"A"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Measurements included in modeling Pace of Aging in the Dunedin Study Birth Cohort. We measured Pace of Aging from repeated assessments of a panel of 19 biomarkers: Body mass index (BMI), Waist-hip ratio, Glycated hemoglobin, Leptin, Blood pressure (mean arterial pressure), Cardiorespiratory fitness (VO"},{"children":[{"tag":"#text","text":"2"}],"hidden":false,"tag":"sub"},{"tag":"#text","text":"Max), Forced vital capacity ratio (FEV"},{"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"sub"},{"tag":"#text","text":"/FVC), Forced expiratory volume in one second (FEV"},{"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"sub"},{"tag":"#text","text":"), Total cholesterol, Triglycerides, High density lipoprotein (HDL), Lipoprotein(a), Apolipoprotein B100/A1 ratio, estimated Glomerular Filtration Rate (eGFR), Blood Urea Nitrogen (BUN), High Sensitivity C-reactive Protein (hs-CRP), White blood cell count, mean periodontal attachment loss (AL), and the number of dental-caries-affected tooth surfaces (tooth decay). This list includes two new biomarkers, leptin and caries, not included in the original Pace of Aging ("},{"attributes":{"aria-describedby":"bib6","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib6"},"children":[{"tag":"#text","text":"Belsky et al., 2015"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), both of which have now been assessed at multiple waves, allowing growth curve modeling. Telomere length was dropped because of an emerging and yet-unresolved field-wide debate about its measurement ("},{"attributes":{"aria-describedby":"bib56","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib56"},"children":[{"tag":"#text","text":"Nettle et al., 2021"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). All other biomarkers were the same. The 20 year Pace of Aging measure is described in detail elsewhere ("},{"attributes":{"aria-describedby":"bib21","aria-expanded":"false","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC8853656/#bib21"},"children":[{"tag":"#text","text":"Elliott et al., 2021b"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). ("},{"children":[{"tag":"#text","text":"B"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") CpGs included in the DunedinPACE DNA methylation algorithm, their mean values in the Dunedin Study, and the coefficients for their weights in the DunedinPACE algorithm. ("},{"children":[{"tag":"#text","text":"C"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Independent associations of DunedinPACE with mortality, morbidity, and disability in models including covariate adjustment for DNA methylation clocks. The table reports effect-sizes for DunedinPACE and DNA methylation clocks from time-to-event analysis of mortality, cardiovascular disease (CVD), and stroke or transient ischemic attack (TIA) and repeated-measures analysis of incident limitations to activities of daily living (ADLs) in the Framingham Heart Study Offspring cohort. Each model includes DunedinPACE, one of the DNA methylation clocks, and covariates for age and sex. Time-to-event model effect-sizes are reported as hazard ratios (HR). Repeated-measures model effect-sizes are reported as incidence-rate ratios (IRR). ("},{"children":[{"tag":"#text","text":"D"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Physical and cognitive functioning and subjective signs of aging measures in the Dunedin Study. ("},{"children":[{"tag":"#text","text":"E"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Items included in Nagi, Katz, and Rosow-Breslau scales of limitations to Activities of Daily Living (ADLs)."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"media p"},"children":[{"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/8853656/bin/elife-73420-supp1.docx"},"children":[{"tag":"#text","text":"elife-73420-supp1.docx"}],"hidden":false,"tag":"a"},{"children":[{"tag":"#text","text":" (161.4KB, docx) "}],"hidden":false,"tag":"sup"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"d64e1664","tag":"div"}],"hidden":false,"id":"supp1","tag":"section"},{"attributes":{"class":"sm xbox font-sm"},"children":[{"attributes":{"class":"caption p"},"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Supplementary file 2. Effect-sizes for analysis of DunedinPACE, DunedinPoAm, and DNA methylation clocks in models with covariate adjustment for age and sex only and for models with additional covariate adjustment for DNA methylation estimated cell counts and for smoking."}],"hidden":false,"tag":"span"},{"children":[{"tag":"#text","text":"Effect-sizes are reported for a one standard deviation increment of DunedinPACE. Outcome variables in Dunedin Study, Understanding Society Study, and E-Risk Study (Panels A, B, C, and E) were z-transformed for analysis; effect-sizes are interpretable as Pearson r or Cohen’s d. For Normative Aging Study and Framingham Analysis (Panel C), effect-sizes for time-to event outcomes are reported as hazard ratios (HR), effect-sizes for prevalent chronic disease are reported as Risk Ratios (RR), and effect-sizes for incident disability are reported as incidence rate ratios (IRR). ("},{"children":[{"tag":"#text","text":"A"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Effect-sizes for associations of DunedinPACE, DunedinPoAm, and DNA methylation clocks with functional assessments at age 45 in the Dunedin Study. Effect-sizes are standardized coefficients from linear regressions of the outcomes on the aging measures. The models adjusted for cell counts (middle column of results) were adjusted for cell counts measured from complete blood count data (white blood cell count and percentages of lymphocytes, monocytes, neutrophils, eosinophils, and basophils). The models adjusted for smoking (left-most column of results) included a covariate for number of pack-years smoked. ("},{"children":[{"tag":"#text","text":"B"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Effect-sizes for associations of DunedinPACE, DunedinPoAm, and DNA methylation clocks with functional decline in the Dunedin Study. Decline was measured as change between the age-38 and age-45 assessments for all measures except cognition, for which change was computed over the interval beginning with an adolescent baseline test at age 13 and ending with the most recent cognitive assessment at age 45. Effect-sizes are coefficients from linear regressions of change scores on aging measures for all outcomes except incident fair/poor health, for which effect-sizes are risk ratios (RR) estimated from Poisson regression of incidence on the aging measures. Change scores were computed by standardizing baseline and follow-up measurements using the mean and standard deviation (SD) of the baseline assessment and computing the difference in standardized scores. A single unit of change therefore corresponds to 1 SD of variation at baseline. Effect-sizes are reported for a one SD difference in the aging measures. The models adjusted for smoking (left-most column of results) included a covariate for number of pack-years smoked. ("},{"children":[{"tag":"#text","text":"C"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Effect-sizes for associations of DunedinPACE, DunedinPoAm, and DNA methylation clocks with clinical-biomarker measures of biological age and self-rated health in the Understanding Society Study. Effect-sizes are standardized coefficients from linear regressions of the outcomes on the DNA methylation measures of aging. The models adjusted for smoking included covariates for smoking status and current smoking quantity (cigarettes per day). ("},{"children":[{"tag":"#text","text":"D"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Effect-sizes for associations of DunedinPACE, DunedinPoAm, and DNA methylation clocks with mortality, morbidity, and disability in the Normative Aging Study and the Framingham Heart Study Offspring Cohort. Effect-sizes are hazard ratios (HR) for time-to-event analyses and relative risks (RR) and incidence rate ratios (IRR) for repeated-measures analyses. Analysis of mortality was conducted in both cohorts. Analysis of incident and prevalent chronic disease morbidity was conducted only in the Normative Aging Study. Time-to-event analysis of cardiovascular disease (CVD) and stroke/transient ischemic attack (TIA) and repeated measures analysis of incident disability were conducted only in the Framingham Heart Study Offspring Cohort. The models adjusted for smoking included covariates for smoking history (pack-years smoked) in the Normative Aging Study and for smoking status and current smoking quantity (cigarettes per day) in the Framingham Heart Study. ("},{"children":[{"tag":"#text","text":"E"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Effect-sizes for associations of childhood socioeconomic status (SES) and childhood victimization with aging measures in the E-Risk Study. Effect-sizes are standardized coefficients (Cohen’s d) from linear regressions of the aging measures on exposure groups (low and middle SES vs. high SES; one, two, and three or more types of victimization vs. no victimization). Models included covariate adjustment for sex. Standard errors were clustered at the family level to account for non-independence of sibling data."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"media p"},"children":[{"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/8853656/bin/elife-73420-supp2.xlsx"},"children":[{"tag":"#text","text":"elife-73420-supp2.xlsx"}],"hidden":false,"tag":"a"},{"children":[{"tag":"#text","text":" (54.7KB, xlsx) "}],"hidden":false,"tag":"sup"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"d64e1681","tag":"div"}],"hidden":false,"id":"supp2","tag":"section"},{"attributes":{"class":"sm xbox font-sm"},"children":[{"attributes":{"class":"caption p"},"children":[{"children":[{"tag":"#text","text":"Transparent reporting form"}],"hidden":false,"tag":"span"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"media p"},"children":[{"attributes":{"class":"caption"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://pmc.ncbi.nlm.nih.gov/articles/instance/8853656/bin/elife-73420-transrepform1.pdf"},"children":[{"tag":"#text","text":"elife-73420-transrepform1.pdf"}],"hidden":false,"tag":"a"},{"children":[{"tag":"#text","text":" (397.2KB, pdf) "}],"hidden":false,"tag":"sup"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"d64e1684","tag":"div"}],"hidden":false,"id":"transrepform","tag":"section"}],"hidden":false,"id":"s6","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title","data-anchor-id":"s7"},"children":[{"attributes":{"class":"usa-anchor","data-anchor-id":"s7"},"hidden":false,"id":"s7-anchor","tag":"a"},{"tag":"#text","text":"Data availability"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Datasets are available from the data owners. Data from the Dunedin and E-Risk Study can be accessed through agreement with the Study investigators. Instructions are available at "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://sites.google.com/site/moffittcaspiprojects/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://sites.google.com/site/moffittcaspiprojects/"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The data access application form can be downloaded here: "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://sites.google.com/site/moffittcaspiprojects/forms-for-new-projects/concept-paper-template","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://sites.google.com/site/moffittcaspiprojects/forms-for-new-projects/concept-paper-template"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Data from the Understanding Society Study is available through METADAC at "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://www.metadac.ac.uk/ukhls/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.metadac.ac.uk/ukhls/"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". All details are on the Metadac website ("},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://www.metadac.ac.uk/data-access-through-metadac/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.metadac.ac.uk/data-access-through-metadac/"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). The data access application form can be found here "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://www.metadac.ac.uk/files/2019/02/v2.41-UKHLS-METADAC-application-form-2019-2hak8bv.docx","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.metadac.ac.uk/files/2019/02/v2.41-UKHLS-METADAC-application-form-2019-2hak8bv.docx"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Data from the Normative Aging Study were obtained from the Study investigators. Data are accessible through dbGaP, accession phs000853.v1.p1. Data from the Framingham Heart Study were obtained from dbGaP, accession phs000007.v32.p13. "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" is a publicly available dataset available from the Gene Expression Omnibus ("},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE55763"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The following previously published datasets were used:"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\nBaccarelli AA, Schwartz J. 2015. The Normative Aging Study. dbGaP. phs000853.v1.p1\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\nThe National Heart Lung and Blood Institute. Boston University  2020. The Framingham Heart Study. NCBI dbGaP. phs000007.v32.p13\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\nLehne  2021. A coherent approach for analysis of th