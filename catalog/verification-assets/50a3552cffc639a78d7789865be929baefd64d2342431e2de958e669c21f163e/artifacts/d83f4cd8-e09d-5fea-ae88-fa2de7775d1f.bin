                        <ul class="c-article-author-list c-article-author-list--short js-no-scroll" data-test="authors-list" data-component-authors-activator="authors-list"><li class="c-article-author-list__item"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="1_3" data-track-context="researcher popup with profile" href="https://link.springer.com/article/10.1007/s11357-024-01460-1#auth-Colin_M_-Skinner-Aff1" data-author-popup="auth-Colin_M_-Skinner-Aff1" data-track-label="Colin M. Skinner" data-author-search="Skinner, Colin M.">Colin M. Skinner</a><sup class="u-js-hide"><a href="https://link.springer.com/article/10.1007/s11357-024-01460-1#Aff1" tabindex="-1">1</a></sup>, </li><li class="c-article-author-list__item"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="2_3" data-track-context="researcher popup with no profile" href="https://link.springer.com/article/10.1007/s11357-024-01460-1#auth-Michael_J_-Conboy-Aff1" data-author-popup="auth-Michael_J_-Conboy-Aff1" data-track-label="Michael J. Conboy" data-author-search="Conboy, Michael J.">Michael J. Conboy</a><sup class="u-js-hide"><a href="https://link.springer.com/article/10.1007/s11357-024-01460-1#Aff1" tabindex="-1">1</a></sup> &amp; </li><li class="c-article-author-list__item"><a data-test="author-name" data-track="click_view_author" data-track-action="open author" data-track-index="3_3" data-track-context="researcher popup with no profile" href="https://link.springer.com/article/10.1007/s11357-024-01460-1#auth-Irina_M_-Conboy-Aff1" data-author-popup="auth-Irina_M_-Conboy-Aff1" data-track-label="Irina M. Conboy" data-author-search="Conboy, Irina M." data-corresp-id="c1">Irina M. Conboy<svg width="16" height="16" focusable="false" role="img" aria-hidden="true" class="u-icon"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#icon-eds-i-mail-medium"></use></svg></a><span class="u-js-hide