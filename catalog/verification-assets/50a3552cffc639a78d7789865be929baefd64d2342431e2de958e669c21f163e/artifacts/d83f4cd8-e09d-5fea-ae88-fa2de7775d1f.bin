    <meta name="journal_id" content="11357">
    <meta name="dc.title" content="DNA methylation clocks struggle to distinguish inflammaging from healthy aging, but feature rectification improves coherence and enhances detection of inflammaging">
    <meta name="dc.source" content="GeroScience 2025 47:3">
    <meta name="dc.format" content="text/html">
    <meta name="dc.publisher" content="Springer">
