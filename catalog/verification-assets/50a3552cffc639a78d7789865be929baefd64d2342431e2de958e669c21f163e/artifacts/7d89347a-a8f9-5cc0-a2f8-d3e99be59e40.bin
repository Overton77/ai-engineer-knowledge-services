","text":"6"},{"tag":"#text","text":". "}],"hidden":false,"tag":"span"},{"tag":"#text","text":"Privacy & Terms"}],"hidden":false,"tag":"button"}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"nav"},{"attributes":{"class":"lg:col-span-8 xl:col-span-9"},"children":[{"attributes":{"class":"flex flex-col gap-12 w-full mt-6 lg:mt-0"},"children":[{"attributes":{"class":"flex flex-col gap-8"},"children":[{"attributes":{"class":"nk-heading-3 lg:nk-heading-2 text-nk-cold-brown-500"},"children":[{"tag":"#text","text":"SystemAge™ Test & The Science"}],"hidden":false,"tag":"h3"},{"attributes":{"class":"flex flex-col w-full gap-6"},"children":[{"attributes":{"class":"flex flex-col w-full p-4 lg:p-8 gap-4 border rounded-2xl scroll-mt-20 lg:scroll-mt-0 border-nk-cold-brown-400"},"children":[{"attributes":{"aria-controls":"faq-content-how-do-we-measure-systemage-and-what-science-is-it-based-on","aria-expanded":"true","aria-label":"Toggle How do we measure SystemAge™, and what science is it based on? FAQ","class":"flex items-start justify-between gap-8 w-full text-left cursor-pointer rounded-md focus:outline-none focus-visible:outline-2 focus-visible:outline-nk-cold-brown-500 focus-visible:outline-offset-2","type":"button"},"children":[{"attributes":{"class":"nk-text-lg lg:nk-heading-4 text-nk-cold-brown-500 flex-1"},"children":[{"tag":"#text","text":"How do we measure SystemAge™, and what science is it based on?"}],"hidden":false,"tag":"span"}],"hidden":false,"id":"faq-trigger-how-do-we-measure-systemage-and-what-science-is-it-based-on","tag":"button"},{"attributes":{"aria-labelledby":"faq-trigger-how-do-we-measure-systemage-and-what-science-is-it-based-on","class":"overflow-hidden nk-text-md lg:nk-text-base text-nk-cold-brown-500 [&_a]:break-words [&_a]:text-inherit [&_a]:underline","style":"opacity:1;height:auto"},"children":[{"attributes":{"class":"mb-2"},"children":[{"tag":"#text","text":"The SystemAge™ section encompasses both overall SystemAge™ and functional SystemAge™ calculations for a total of 21 distinct systems. Each system represents a critical system contributing to the overall functionality of the body. SystemAge™ is calculated in the report by employing a \"noise barometer\" approach, which focuses on cytosines with stable methylation throughout life. Biological age is measured by quantifying the dysregulation of these cytosines, using the sums of standard deviations of their methylation values as biomarkers of aging and disease. This method identifies increased biological noise as a key indicator of aging and disease."}],"hidden":false,"tag":"p"},{"attributes":{"class":"mb-2"},"children":[{"tag":"#text","text":"Our science and approach is rooted in extensive research led by one of our co-founders Dr. Irina Conboy, a field expert with over 20+ years of experience, which strengthens our ability to advance in biological aging science and product development. For more detailed scientific information, please refer to the following publications:"}],"hidden":false,"tag":"p"},{"children":[{"children":[{"attributes":{"class":"text-primary","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/","rel":"noopener","target":"_blank"},"children":[{"tag":"#text","text":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"li"},{"children":[{"attributes":{"class":"text-primary","href":"https://doi.org/10.1101/2024.10.09.617512","rel":"noopener","target":"_blank"},"children":[{"tag":"#text","text":"https://doi.org/10.1101/2024.10.09.617512"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"li"}],"hidden":false,"tag":"ul"}],"hidden":false,"id":"faq-content-how-do-we-measure-systemage-and-what-science-is-it-based-on","tag":"section"}],"hidden":false,"id":"how-do-we-measure-systemage-and-what-science-is-it-based-on","tag":"div"},{"attributes":{"class":"flex flex-col w-full p-4 lg:p-8 gap-4 border rounded-2xl border-[#DFDBD6] scroll-mt-20 lg:scroll-mt-0"},"ch