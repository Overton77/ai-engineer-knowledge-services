             \n    \n\n\n                        "},{"tag":"div","hidden":false,"attributes":{"data-test":"article-metrics"},"children":[{"tag":"#text","text":"\n                            \n        "},{"tag":"ul","hidden":false,"attributes":{"class":"app-article-metrics-bar"},"children":[{"tag":"#text","text":"\n            \n                "},{"tag":"li","hidden":false,"attributes":{"class":"app-article-metrics-bar__item","data-test":"access-count"},"children":[{"tag":"#text","text":"\n                    "},{"tag":"p","hidden":false,"attributes":{"class":"app-article-metrics-bar__count"},"children":[{"tag":"#text","text":"4578 "},{"tag":"span","hidden":false,"attributes":{"class":"app-article-metrics-bar__label"},"children":[{"tag":"#text","text":"Accesses"}]}]},{"tag":"#text","text":"\n                "}]},{"tag":"#text","text":"\n            \n            \n                "},{"tag":"li","hidden":false,"attributes":{"class":"app-article-metrics-bar__item","data-test":"citation-count"},"children":[{"tag":"#text","text":"\n                    "},{"tag":"p","hidden":false,"attributes":{"class":"app-article-metrics-bar__count"},"children":[{"tag":"#text","text":"6 "},{"tag":"span","hidden":false,"attributes":{"class":"app-article-metrics-bar__label"},"children":[{"tag":"#text","text":"Citations"}]}]},{"tag":"#text","text":"\n                "}]},{"tag":"#text","text":"\n            \n            \n                \n                    "},{"tag":"li","hidden":false,"attributes":{"class":"app-article-metrics-bar__item","data-test":"altmetric-score"},"children":[{"tag":"#text","text":"\n                        "},{"tag":"p","hidden":false,"attributes":{"class":"app-article-metrics-bar__count"},"children":[{"tag":"#text","text":"4 "},{"tag":"span","hidden":false,"attributes":{"class":"app-article-metrics-bar__label"},"children":[{"tag":"#text","text":"\n                                Altmetric\n                                "}]}]},{"tag":"#text","text":"\n                    "}]},{"tag":"#text","text":"\n                \n            \n            \n            \n                \n                    "},{"tag":"li","hidden":false,"attributes":{"class":"app-article-metrics-bar__item app-article-metrics-bar__item--metrics"},"children":[{"tag":"#text","text":"\n                        "},{"tag":"p","hidden":false,"attributes":{"class":"app-article-metrics-bar__details"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://link.springer.com/article/10.1007/s11357-024-01460-1/metrics","data-track":"click","data-track-action":"view metrics","data-track-label":"link","rel":"nofollow"},"children":[{"tag":"#text","text":"Explore all metrics "}]}]},{"tag":"#text","text":"\n                    "}]},{"tag":"#text","text":"\n                \n            \n        "}]},{"tag":"#text","text":"\n    \n                        "}]},{"tag":"#text","text":"\n                        \n                        \n    \n    \n\n    \n    \n\n                        \n                    "}]},{"tag":"#text","text":"\n                "}]},{"tag":"#text","text":"\n\n                "},{"tag":"div","hidden":false,"attributes":{"data-article-body":"true","data-track-component":"article body","class":"c-article-body"},"children":[{"tag":"#text","text":"\n\n                    \n                    "},{"tag":"section","hidden":false,"attributes":{"aria-labelledby":"Abs1","data-title":"Abstract","lang":"en"},"children":[{"tag":"div","hidden":false,"id":"Abs1-section","attributes":{"class":"c-article-section"},"children":[{"tag":"h2","hidden":false,"id":"Abs1","attributes":{"class":"c-article-section__title js-section-title js-c-reading-companion-sections-item"},"children":[{"tag":"#text","text":"Abstract"}]},{"tag":"div","hidden":false,"id":"Abs1-content","attributes":{"class":"c-article-section__content"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Biological age estimation from DNA methylation and determination of relevant biomarkers is an active research problem which has predominantly been tackled with black-box penalized regression. Machine learning is used to select a small subset of features from hundreds of thousands of CpG probes and to increase generalizability typically lacking with ordinary least-squares regression. Here, we show that such feature selection lacks biological interpretability and relevance in the clocks of the first and next generations and clarify the logic by which these clocks systematically exclude biomarkers of aging and age-related disease. Moreover, in contrast to the assumption that regularized linear regression is needed to prevent overfitting, we demonstrate that hypothesis-driven selection of biologically relevant features in conjunction with ordinary least squares regression yields accurate, well-calibrated, generalizable clocks with high interpretability. We further demonstrate that the interplay of inflammaging-related shifts of predictor values and their corresponding weights, which we term feature shifts, contributes to the lack of resolution between health and inflammaging in conventional linear models. Lastly, we introduce a method of feature rectification, which aligns these shifts to improve the distinction of age predictions for healthy people vs. patients with various chronic inflammation diseases."}]}]}]}]},{"tag":"#text","text":"\n\n                    \n\n                    \n    \n\n\n                    \n\n                    "},{"tag":"div","hidden":false,"attributes":{"data-test":"cobranding-download"},"children":[{"tag":"#text","text":"\n                        \n                    "}]},{"tag":"#text","text":"\n\n                    \n                        \n        \n            "},{"tag":"section","hidden":false,"attributes":{"aria-labelledby":"inline-recommendations","data-title":"Inline Recommendations","class":"c-article-recommendations","data-track-component":"inline-recommendations"},"children":[{"tag":"#text","text":"\n                "},{"tag":"h3","hidden":false,"id":"inline-recommendations","attributes":{"class":"c-article-recommendations-title"},"children":[{"tag":"#text","text":"Similar content being viewed by others"}]},{"tag":"#text","text":"\n                "},{"tag":"div","hidden":false,"attributes":{"class":"c-article-recommendations-list"},"children":[{"tag":"#text","text":"\n                    \n                        "},{"tag":"div","hidden":false,"attributes":{"class":"c-article-recommendations-list__item"},"children":[{"tag":"#text","text":"\n                            "},{"tag":"article","hidden":false,"attributes":{"class":"c-article-recommendations-card","itemscope":"","itemtype":"http://schema.org/ScholarlyArticle"},"children":[{"tag":"#text","text":"\n                                \n                                    "},{"tag":"div","hidden":false,"attributes":{"class":"c-article-recommendations-card__img"},"children":[{"tag":"img","hidden":false,"attributes":{"src":"https://media.springernature.com/w215h120/springer-static/image/art%3A10.1186%2Fs13059-019-1824-y/MediaObjects/13059_2019_1824_Fig1_HTML.png","loading":"lazy","alt":""}}]},{"tag":"#text","text":"\n                                \n                                "},{"tag":"div","hidden":false,"attributes":{"class":"c-article-recommendations-card__main"},"children":[{"tag":"#text","text":"\n                                    "},{"tag":"h3","hidden":false,"attributes":{"class":"c-article-recommendations-card__heading","itemprop":"name headline"},"children":[{"tag":"#text","text":"\n                                        "},{"tag":"a","hidden":false,"attributes":{"class":"c-article-recommendations-card__link","itemprop":"url","href":"https://link.springer.com/10.1186/s13059-019-1824-y?fromPaywallRec=false","data-track":"select_recommendations_1","data-track-context":"inline recommendations","data-track-action":"click recommendations inline - 1","data-track-label":"10.1186/s1305