en":[{"tag":"#text","text":"View author publications"}]}]},{"tag":"div","hidden":false,"attributes":{"class":"c-article-authors-search__item c-article-authors-search__list-item--right"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"search-in-title-js c-article-authors-search__text"},"children":[{"tag":"span","hidden":false,"attributes":{"class":"c-article-authors-search__links-text"},"children":[{"tag":"#text","text":"Search author on:"}]},{"tag":"span","hidden":false,"attributes":{"class":"c-article-identifiers"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"c-article-identifiers__item","href":"https://www.ncbi.nlm.nih.gov/entrez/query.fcgi?cmd=search&term=Irina%20M.%20Conboy","data-track":"click","data-track-action":"author link - pubmed","data-track-label":"link","rel":"nofollow"},"children":[{"tag":"#text","text":"PubMed"}]},{"tag":"span","hidden":false,"attributes":{"class":"u-hide"},"children":[{"tag":"#text","text":" "}]},{"tag":"a","hidden":false,"attributes":{"class":"c-article-identifiers__item","href":"https://scholar.google.co.uk/scholar?as_q=&num=10&btnG=Search+Scholar&as_epq=&as_oq=&as_eq=&as_occt=any&as_sauthors=%22Irina%20M.%20Conboy%22&as_publication=&as_ylo=&as_yhi=&as_allsubj=all&hl=en","data-track":"click","data-track-action":"author link - scholar","data-track-label":"link","rel":"nofollow"},"children":[{"tag":"#text","text":"Google Scholar"}]}]}]}]}]}]}]}]},{"tag":"h3","hidden":false,"id":"contributions","attributes":{"class":"c-article__sub-heading"},"children":[{"tag":"#text","text":"Contributions"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"CS wrote the code and conducted the data analyses and model training, formulated the modified stepwise forward selection algorithm, conceived of the coherence theory for linear models, and wrote the manuscript. MJC contributed to the development of all concepts and ideas and co-wrote the manuscript. IC conceived the ideas and approaches for testing the biological relevance of EN models and the hypothesis-driven FSS OLS, interpreted, and integrated the study and wrote the manuscript."}]},{"tag":"h3","hidden":false,"id":"corresponding-author","attributes":{"class":"c-article__sub-heading"},"children":[{"tag":"#text","text":"Corresponding author"}]},{"tag":"p","hidden":false,"id":"corresponding-author-list","children":[{"tag":"#text","text":"Correspondence to\n                "},{"tag":"a","hidden":false,"id":"corresp-c1","attributes":{"aria-label":"email Irina M. Conboy","href":"mailto:iconboy@berkeley.edu"},"children":[{"tag":"#text","text":"Irina M. Conboy"}]},{"tag":"#text","text":"."}]}]}]}]},{"tag":"section","hidden":false,"attributes":{"data-title":"Ethics declarations"},"children":[{"tag":"div","hidden":false,"id":"ethics-section","attributes":{"class":"c-article-section"},"children":[{"tag":"h2","hidden":false,"id":"ethics","attributes":{"class":"c-article-section__title js-section-title js-c-reading-companion-sections-item"},"children":[{"tag":"#text","text":"Ethics declarations"}]},{"tag":"div","hidden":false,"id":"ethics-content","attributes":{"class":"c-article-section__content"},"children":[{"tag":"#text","text":"\n              \n              \n                "},{"tag":"h3","hidden":false,"id":"FPar1","attributes":{"class":"c-article__sub-heading"},"children":[{"tag":"#text","text":"Conflict of interest"}]},{"tag":"#text","text":"\n                "},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The authors declare no competing interests."}]},{"tag":"#text","text":"\n              \n            "}]}]}]},{"tag":"section","hidden":false,"attributes":{"data-title":"Additional information"},"children":[{"tag":"div","hidden":false,"id":"additional-information-section","attributes":{"class":"c-article-section"},"children":[{"tag":"h2","hidden":false,"id":"additional-information","attributes":{"class":"c-article-section__title js-section-title js-c-reading-companion-sections-item"},"children":[{"tag":"#text","text":"Additional information"}]},{"tag":"div","hidden":false,"id":"additional-information-content","attributes":{"class":"c-article-section__content"},"children":[{"tag":"h3","hidden":false,"attributes":{"class":"c-article__sub-heading"},"children":[{"tag":"#text","text":"Publisher's Note"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations."}]},{"tag":"h3","hidden":false,"attributes":{"class":"c-article__sub-heading"},"children":[{"tag":"#text","text":"Key findings"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"• There is no apparent biological significance of the CpGs selected by first- and next-generation clocks."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":" • The range of residuals for first- and next-generation clock predictions on healthy samples is very large; for all models tested, a prediction error of + /- 10–20 years is within the 95% range of variation for healthy controls and does not signify age acceleration."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":" • There is no significant shift in the mean of residuals for patient populations relative to healthy populations for most studied first- and next-generation clocks. For those with significance, the effect size is very small."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":" • Hypothesis-driven feature pre-selection, coupled with modified forward stepwise selection, yields age predictors on par with first and next-generation clocks, EN/ML is not needed."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":" • Disease-related shifts at different CpG probes, along with learned model weights, can be either positive or negative; their combination leads to a decoherence effect in linear models."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":" • Model coherence can be induced by rectifying features to have only positive shifts in patient samples; this provides a better resolution between health and disease in DNAm age models and, expectedly, introduces more nonlinearity to the input data."}]}]}]}]},{"tag":"section","hidden":false,"attributes":{"data-title":"Supplementary Information"},"children":[{"tag":"div","hidden":false,"id":"Sec30-section","attributes":{"class":"c-article-section"},"children":[{"tag":"h2","hidden":false,"id":"Sec30","attributes":{"class":"c-article-section__title js-section-title js-c-reading-companion-sections-item"},"children":[{"tag":"#text","text":"Supplementary Information"}]},{"tag":"div","hidden":false,"id":"Sec30-content","attributes":{"class":"c-article-section__content"},"children":[{"tag":"div","hidden":false,"attributes":{"data-test":"supplementary-info"},"children":[{"tag":"div","hidden":false,"id":"figshareContainer","attributes":{"class":"c-article-figshare-container","data-test":"figshare-container"}},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Below is the link to the electronic supplementary material."}]},{"tag":"div","hidden":false,"id":"MOESM1","attributes":{"class":"c-article-supplementary__item","data-test":"supp-item"},"children":[{"tag":"h3","hidden":false,"attributes":{"class":"c-article-supplementary__title u-h3"},"children":[{"tag":"a","hidden":false,"attributes":{"data-test":"supp-info-link","class":"print-link","data-track":"call_to_action","data-track-action":"view supplementary info","data-track-context":"Supplementary Information","data-track-label":"supplementary file1 (xlsx 7.18 kb)","href":"https://media.springernature.com/original/springer-static/esm/art%3A10.1007%2Fs11357-024-01460-1/MediaObjects/11357_2024_1460_MOESM1_ESM.xlsx","data-supp-info-image":""},"children":[{"tag":"#text","text":"Supplementary file1 (XLSX 7.18 KB) (download XLSX "},{"tag":"#text","text":")"}]}]}]},{"tag":"div","hidden":false,"id":"MOESM2","attributes":{"class":"c-article-supp