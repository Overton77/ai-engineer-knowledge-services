gly."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"about_item swiper-slide new light-purple modify swiper-slide-next","role":"group","aria-label":"2 / 4","style":"margin-right: 24px;"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"about_item-icon new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"title-h4-v2 blue"},"children":[{"tag":"#text","text":"2"}]}]},{"tag":"h4","hidden":false,"attributes":{"class":"about_item-title"},"children":[{"tag":"#text","text":"Use Biological Ages for Orientation"}]},{"tag":"div","hidden":false,"attributes":{"class":"about_item-content new modify"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-small-medium"},"children":[{"tag":"#text","text":"Clocks are headlines — not conclusions. Younger biological age suggests optimization; older suggests more systemic concern. Don't act on clocks alone."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"about_item swiper-slide new light-purple modify","role":"group","aria-label":"3 / 4","style":"margin-right: 24px;"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"about_item-icon new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"title-h4-v2 blue"},"children":[{"tag":"#text","text":"3"}]}]},{"tag":"h4","hidden":false,"attributes":{"class":"about_item-title"},"children":[{"tag":"#text","text":"Read for Themes & Patterns"}]},{"tag":"div","hidden":false,"attributes":{"class":"about_item-content new modify"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-small-medium"},"children":[{"tag":"#text","text":"Two or more signals converging on the same pathway = treat as real until proven otherwise. One isolated marker = hypothesis only. Cross-reference TruAge™ and TruHealth™ together."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"about_item swiper-slide new light-purple modify","role":"group","aria-label":"4 / 4","style":"margin-right: 24px;"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"about_item-icon new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"title-h4-v2 blue"},"children":[{"tag":"#text","text":"4"}]}]},{"tag":"h4","hidden":false,"attributes":{"class":"about_item-title"},"children":[{"tag":"#text","text":"Convert Signals to a Clinical Plan"}]},{"tag":"div","hidden":false,"attributes":{"class":"about_item-content new modify"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-small-medium"},"children":[{"tag":"#text","text":"Verify epigenetic signals with conventional labs and clinical history. Introduce targeted interventions. Retest at 3–6 months. Monitor trajectory over absolute values."}]}]}]}]},{"tag":"span","hidden":false,"attributes":{"class":"swiper-notification","aria-live":"assertive","aria-atomic":"true"}}]}]}]}]}]},{"tag":"section","hidden":false,"attributes":{"class":"section_guards"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"padding-global new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"container-new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"guards_wrapper"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"guards_head"},"children":[{"tag":"h2","hidden":false,"attributes":{"class":"title-h2-new blue"},"children":[{"tag":"#text","text":"Clinical guardrails"}]},{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue"},"children":[{"tag":"#text","text":"Join 7,500+ practitioners leading the way in personalized longevity medicine. Get clinical support, wholesale pricing, and advanced interpretation tools."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"guards_list"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"guards_left-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"guards_left-block-flex"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"guards_item"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"guards_item-title"},"children":[{"tag":"#text","text":"HIPAA-compliant data"}]}]},{"tag":"div","hidden":false,"attributes":{"class":"guards_item image"},"children":[{"tag":"img","hidden":false,"attributes":{"src":"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a1d5fb78ee3dee4e5075466_cf83da648ec437c4e679e2ebfcb6d960_Grid%203.jpg","loading":"lazy","alt":"","class":"guards_item-img"}}]}]},{"tag":"div","hidden":false,"attributes":{"class":"guards_item height"},"children":[{"tag":"img","hidden":false,"attributes":{"src":"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a1d5f4d0f6437cfbe83cef9_ff083f249b99a9c257cfba90d6a49114_Grid%204.png","loading":"lazy","alt":"","class":"guards_item-img"}}]}]},{"tag":"div","hidden":false,"attributes":{"class":"guards_left-block direction"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"guards_left-block-flex row"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"guards_item blue"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"guards_item-title"},"children":[{"tag":"#text","text":"Peer-reviewed algorithms"}]}]},{"tag":"div","hidden":false,"attributes":{"class":"guards_item image d-none"},"children":[{"tag":"img","hidden":false,"attributes":{"src":"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a5e2857bfd8d0551dee1ea7_Image.png","loading":"lazy","alt":"","class":"guards_item-img"}}]}]},{"tag":"div","hidden":false,"attributes":{"class":"guards_item full-width"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"guards_item-title"},"children":[{"tag":"#text","text":"CLIA-certified processing"}]}]}]}]}]}]}]}]},{"tag":"section","hidden":false,"attributes":{"class":"section_diagnostic blue white"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"padding-global-9 no-padd-top new"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"container-large-4 medium"},"children":[{"tag":"div","hidden":false,"attrib