tag":"a","hidden":false,"id":"w-tabs-0-data-w-tab-2","attributes":{"data-w-tab":"Tab 3","class":"report-item-tabs-link w-inline-block w-tab-link","tabindex":"-1","href":"https://www.trudiagnostic.com/report-education#w-tabs-0-data-w-pane-2","role":"tab","aria-controls":"w-tabs-0-data-w-pane-2","aria-selected":"false"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report-item-tabs-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"text-regular tabs"},"children":[{"tag":"#text","text":"Pitfalls"}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"w-tab-content"},"children":[{"tag":"div","hidden":false,"id":"w-tabs-0-data-w-pane-0","attributes":{"data-w-tab":"Tab 1","class":"report_tabs-panel w-tab-pane w--tab-active","role":"tabpanel","aria-labelledby":"w-tabs-0-data-w-tab-0"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report_tabs-panel-content"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue lh-130"},"children":[{"tag":"#text","text":"A comprehensive epigenetic assessment featuring OMICmAge (biological age), SymphonyAge (organ-specific ages), and DunedinPace (aging rate)."},{"tag":"br","hidden":false},{"tag":"#text","text":"  "},{"tag":"br","hidden":false},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"Patient Script:"}]},{"tag":"#text","text":" "},{"tag":"br","hidden":false},{"tag":"#text","text":"\"Your report includes OMICmAge, which is the most precise predictor of future health risks, SymphonyAge, which lets us see exactly which organs—like your liver or heart—are aging fastest, and DunedinPace, which measures your aging rate so we can target our interventions precisely.\""}]}]},{"tag":"div","hidden":false,"attributes":{"class":"diagnostic_links top"},"children":[{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-yellow--variant":"full-width-height","href":"https://www.trudiagnostic.com/work-with-us","class":"cta-yellow w-variant-5b9601e6-6a59-2b05-1b12-8de340a701eb w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue cta"},"children":[{"tag":"#text","text":"Join Our Provider Network"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon-v2 w-embed"},"children":[{"tag":"#text","text":"\n"}]}]},{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-blue--variant":"full-width-height","href":"https://www.trudiagnostic.com/about-truage","class":"cta_blue w-variant-94260c0e-959b-bc05-fe6a-acd750cb1b17 w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular purple"},"children":[{"tag":"#text","text":"Read more about TruAge"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta_blue-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]}]}]}]},{"tag":"div","hidden":false,"id":"w-tabs-0-data-w-pane-1","attributes":{"data-w-tab":"Tab 2","class":"w-tab-pane","role":"tabpanel","aria-labelledby":"w-tabs-0-data-w-tab-1"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report_tabs-panel-content"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue lh-130"},"children":[{"tag":"#text","text":"OMICmAge: Our most advanced biological age clock, highly correlated with mortality and morbidity risk. OMICmAge is a composite whole-body biological age signal derived from DNAm patterns associated with health-outcome-relevant aging phenotypes. It is designed to summarize overall biological aging burden for risk orientation and longitudinal tracking over time."},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"SymphonyAge: A set of organ system–specific epigenetic aging models designed to estimate how different biological systems are aging. It breaks down aging across 11 organ systems to identify specific vulnerabilities by showing where aging patterns may be most pronounced. SymphonyAge includes system-level outputs such as lung, heart, brain, hormone, metabolic, musculoskeletal, blood, liver, inflammation, kidney, and immune system age, plus an overall whole-body SymphonyAge score."},{"tag":"br","hidden":false},{"tag":"#text","text":" "},{"tag":"br","hidden":false},{"tag":"#text","text":"DunedinPACE is a measure of the rate a person is aging, rather than a single-point estimate of biological age. It is often interpreted like a \"speedometer,\" comparing a person's current rate of aging to 1 calendar year. For example, a value below 1.0 suggests a slower pace of aging than average, while a value above 1.0 suggests a faster pace of aging. Because it is designed to capture rate, it is commonly used for longitudinal tracking to evaluate whether sustained interventions are associated with a slower aging rate over time."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"diagnostic_links top"},"children":[{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-yellow--variant":"full-width-height","href":"https://www.trudiagnostic.com/report-education#","class":"cta-yellow w-variant-5b9601e6-6a59-2b05-1b12-8de340a701eb w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue cta"},"children":[{"tag":"#text","text":"Apply as a Provider"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon-v2 w-embed"},"children":[{"tag":"#text","text":"\n"}]}]},{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-blue--variant":"full-width-height","href":"https://www.trudiagnostic.com/report-education#","class":"cta_blue w-variant-94260c0e-959b-bc05-fe6a-acd750cb1b17 w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular purple"},"children":[{"tag":"#text","text":"Read more about TruAge"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta_blue-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]}]}]}]},{"tag":"div","hidden":false,"id":"w-tabs-0-data-w-pane-2","attributes":{"data-w-tab":"Tab 3","class":"w-tab-pane","role":"tabpanel","aria-labelledby":"w-tabs-0-data-w-tab-2"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report_tabs-panel-content"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue lh-130"},"children":[{"tag":"#text","text":"While aging is the #1 correlate for all-cause mortality and morbidity, the test is not a diagnosis and should be interpreted in context."},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"Some TruAge biomarkers may be sensitive to recent events. Blood samples should always be collected when a patient's health is stable, not during times of illness, injury, or unusual physical or emotional stress."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"diagnostic_links top"},"children":[{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-yellow--variant":"full-width-height","href":"https://www.trudiagnostic.com/report-education#","class":"cta-yellow w-variant-5b9601e6-6a59-2b05-1b12-8de340a701eb w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue cta"},"children":[{"tag":"#text","text":"Apply as a Provider"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon-v2 w-embed"},"children":[{"tag":"#text","text":"\n"}]}]},{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-blue--variant":"full-width-height","href":"https://www.trudiagnostic.com/report-education#","class":"cta_blue w-variant-94260c0e-959b-bc05-fe6a-acd750cb1b17 w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular purple"},"children":[{"tag":"#text","text":"Read more about TruAge"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta_blue-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]}]}]}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"report-item big swiper-slide swiper-slide-next","role":"group","aria-label":"2 / 5","style":"width: 1889px;"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report-item-title-wrap"},"children":[{"tag":"h2","hidden":false,"attributes":{"class":"report-item-title"},"children":[{"tag":"#text","text":"TruHealth™: Systemic Deep-Dive"}]}]},{"tag":"div","hidden":false,"attributes":{"data-current":"Tab 1","data-easing":"ease","data-duration-in":"300","data-duration-out":"100","class":"w-tabs"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report-item-tabs w-tab-menu","role":"tablist"},"children":[{"tag":"a","hidden":false,"id":"w-tabs-1-data-w-tab-0","attributes":{"data-w-tab":"Tab 1","class":"report-item-tabs-link w-inline-block w-tab-link w--current","href":"https://www.trudiagnostic.com/report-education#w-tabs-1-data-w-pane-0","role":"tab","aria-controls":"w-tabs-1-data-w-pane-0","aria-selected":"true"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report-item-tabs-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"text-regular tabs"},"children":[{"tag":"#text","text":"Purpose"}]}]},{"tag":"a","hidden":false,"id":"w-tabs-1-data-w-tab-1","attributes":{"data-w-tab":"Tab 2","class":"report-item-tabs-link w-inline-block w-tab-link","tabindex":"-1","href":"https://www.trudiagnostic.com/report-education#w-tabs-1-data-w-pane-1","role":"tab","aria-controls":"w-tabs-1-data-w-pane-1","aria-selected":"false"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report-item-tabs-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"text-regular tabs"},"children":[{"tag":"#text","text":"Interpret"}]}]},{"tag":"a","hidden":false,"id":"w-tabs-1-data-w-tab-2","attributes":{"data-w-tab":"Tab 3","class":"report-item-tabs-link w-inline-block w-tab-link","tabindex":"-1","href":"https://www.trudiagnostic.com/report-education#w-tabs-1-data-w-pane-2","role":"tab","aria-controls":"w-tabs-1-data-w-pane-2","aria-selected":"false"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report-item-tabs-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"text-regular tabs"},"children":[{"tag":"#text","text":"Pitfalls"}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"w-tab-content"},"children":[{"tag":"div","hidden":false,"id":"w-tabs-1-data-w-pane-0","attributes":{"data-w-tab":"Tab 1","class":"report_tabs-panel w-tab-pane w--tab-active","role":"tabpanel","aria-labelledby":"w-tabs-1-data-w-tab-0"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report_tabs-panel-content"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue lh-130"},"children":[{"tag":"#text","text":"Granular epigenetic markers that assess physiological function across metabolic, inflammatory, and cellular response systems to identify the drivers of biological aging  "},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"em","hidden":false,"children":[{"tag":"#text","text":"Patient Script:"}]},{"tag":"#text","text":" "},{"tag":"br","hidden":false},{"tag":"#text","text":"\"Based on your OMICmAge and metabolic stress markers, it looks like you could benefit from optimizing your protein, vitamin D, and Omega 3 intake and other changes around nutrition.\"."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"diagnostic_links top"},"children":[{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-yellow--variant":"full-width-height","href":"https://www.trudiagnostic.com/work-with-us","class":"cta-yellow w-variant-5b9601e6-6a59-2b05-1b12-8de340a701eb w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue cta"},"children":[{"tag":"#text","text":"Join Our Provider Network"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon-v2 w-embed"},"children":[{"tag":"#text","text":"\n"}]}]},{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-blue--variant":"full-width-height","href":"https://www.trudiagnostic.com/about-truage","class":"cta_blue w-variant-94260c0e-959b-bc05-fe6a-acd750cb1b17 w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular purple"},"children":[{"tag":"#text","text":"Read more about TruAge"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta_blue-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]}]}]}]},{"tag":"div","hidden":false,"id":"w-tabs-1-data-w-pane-1","attributes":{"data-w-tab":"Tab 2","class":"w-tab-pane","role":"tabpanel","aria-labelledby":"w-tabs-1-data-w-tab-1"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report_tabs-panel-content"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue lh-130"},"children":[{"tag":"#text","text":"Nutrition: Covers vitamins, amino acids, antioxidants, and membrane-supporting fats (especially omega-3s) that support basic cellular function, enzyme activity, and redox balance. It's useful for spotting 'substrate quality' problems that can undercut everything else upstream."},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"Glycemic / Metabolic: Includes markers of glucose control, fat burning, ketones, leptin signaling, and uric acid/purine metabolism. It helps identify metabolic load and flexibility, which is central to cardiometabolic risk and energy regulation."},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"Lipids & Vascular: Includes atherogenic lipid markers (like ApoB and triglycerides), lipid oxidation/peroxidation markers, and blood pressure-related vascular signals. It's useful for assessing the vascular side of cardiometabolic risk beyond a basic cholesterol panel."},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"Immune & Inflammation: Covers immune cell counts/balance, composite inflammatory indices (like NLR/SII), and inflammatory proteins such as CRP, IL-6, and GlycA. It helps detect chronic inflammatory tone, even when individual markers look only mildly abnormal."},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"Neuro & Stress: Includes markers tied to synaptic function, neuroinflammation, dopamine metabolism, and chronic stress/catecholamine load. It's useful for understanding whether cognitive and stress-response systems may be under strain and potentially contributing to symptoms or aging signals."},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"Mito / NAD / Oxidative Defense: Covers mitochondrial function, oxidative stress/damage, NAD-related metabolism, ketones, and selected longevity-related metabolites (e.g., AKG, spermidine). It helps assess cellular energy production, repair capacity, and whether the system is keeping up with wear-and-tear."},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"Toxins & Exposures: Includes environmental exposure markers such as PFAS, combustion/air pollution metabolites, pesticides, and heavy metal burden proxies. It's useful for identifying non-obvious exposure burdens that may be driving biology in the background."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"diagnostic_links top"},"children":[{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-yellow--variant":"full-width-height","href":"https://www.trudiagnostic.com/report-education#","class":"cta-yellow w-variant-5b9601e6-6a59-2b05-1b12-8de340a701eb w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue cta"},"children":[{"tag":"#text","text":"Apply as a Provider"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon-v2 w-embed"},"children":[{"tag":"#text","text":"\n"}]}]},{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-blue--variant":"full-width-height","href":"https://www.trudiagnostic.com/report-education#","class":"cta_blue w-variant-94260c0e-959b-bc05-fe6a-acd750cb1b17 w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular purple"},"children":[{"tag":"#text","text":"Read more about TruAge"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta_blue-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]}]}]}]},{"tag":"div","hidden":false,"id":"w-tabs-1-data-w-pane-2","attributes":{"data-w-tab":"Tab 3","class":"w-tab-pane","role":"tabpanel","aria-labelledby":"w-tabs-1-data-w-tab-2"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report_tabs-panel-content"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue lh-130"},"children":[{"tag":"#text","text":"Some TruHealth biomarkers may be sensitive to recent events. Blood samples should always be collected when a patient's health is stable, not during times of illness, injury, or unusual physical or emotional stress."},{"tag":"br","hidden":false},{"tag":"br","hidden":false},{"tag":"#text","text":"Epigenetic biomarkers may detect health issues before a patient develops signs or symptoms. For example, high systemic inflammation (often reflected in high IL-6 and / or CRP) may be present years before overt signs or symptoms of a disease are noticed."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"diagnostic_links top"},"children":[{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-yellow--variant":"full-width-height","href":"https://www.trudiagnostic.com/report-education#","class":"cta-yellow w-variant-5b9601e6-6a59-2b05-1b12-8de340a701eb w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular blue cta"},"children":[{"tag":"#text","text":"Apply as a Provider"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta-yellow-icon-v2 w-embed"},"children":[{"tag":"#text","text":"\n"}]}]},{"tag":"a","hidden":false,"attributes":{"data-wf--global-cta-blue--variant":"full-width-height","href":"https://www.trudiagnostic.com/report-education#","class":"cta_blue w-variant-94260c0e-959b-bc05-fe6a-acd750cb1b17 w-inline-block"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"text-regular purple"},"children":[{"tag":"#text","text":"Read more about TruAge"}]},{"tag":"div","hidden":false,"attributes":{"class":"cta_blue-icon w-embed"},"children":[{"tag":"#text","text":"\n"}]}]}]}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"report-item big swiper-slide","role":"group","aria-label":"3 / 5","style":"width: 1889px;"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report-item-title-wrap"},"children":[{"tag":"h2","hidden":false,"attributes":{"class":"report-item-title"},"children":[{"tag":"#text","text":"Recommendations"}]}]},{"tag":"div","hidden":false,"attributes":{"data-current":"Tab 1","data-easing":"ease","data-duration-in":"300","data-duration-out":"100","class":"w-tabs"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"report-item-tabs w-tab-menu","role":"tablist"},"children":[{"tag":"a","hidden":false,"id":"w-tabs-2-data-w-tab-0","attributes":{"data-w-tab":"Tab 1","class":"report-item-tabs-link w-inline-block w-tab-link w--current","href":"https://www.trudiagnostic.com/report-education#w-tabs-2-data-w-pane-0