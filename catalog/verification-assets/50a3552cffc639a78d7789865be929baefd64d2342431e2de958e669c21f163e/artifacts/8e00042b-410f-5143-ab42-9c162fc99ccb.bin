ink.w--current .text-regular.tabs { color: rgb(86, 53, 242); }\r\n\r\n.skip-link { position: absolute; top: -40px; left: 0px; background: rgb(0, 0, 0); color: rgb(255, 255, 255); padding: 12px 16px; z-index: 9999; text-decoration: none; }\r\n\r\n.skip-link:focus { top: 0px; }\r\n\r\n.clocks_progress-bar.swiper-pagination-progressbar { position: relative; height: 4px; border-radius: 2px; overflow: hidden; background: transparent; }\r\n\r\n.clocks_progress-bar .swiper-pagination-progressbar-fill { background: linear-gradient(90deg, var(--Indigo-500, #5635F2) 0%, rgba(86, 53, 242, 0.00) 100%); border-radius: 2px; }\r\n\r\n.single-hero_content-richblock h2 { font-size: 32px !important; }\r\n\r\n.richtext-blue p { font-family: Switzer !important; }\r\n\r\n.richtext-blue { margin-bottom: 15px; }\r\n\r\n#step { scroll-margin-top: 90px; }\r\n\r\n#benefits { scroll-margin-top: 90px; }</style><style rel=\"stylesheet\" type=\"text/css\">@charset \"utf-8\";\r\n\r\n#truage_banner-btn { color: rgb(255, 255, 255); padding: 10px 20px; margin-left: 10px; background-color: rgb(86, 53, 242); border-radius: 0.5rem; }\r\n\r\n#truage_banner-btn:hover { box-shadow: rgba(0, 0, 0, 0.25) 4px 4px 8px; }\r\n\r\n@media (min-width: 320px) {\r\n  #truage_banner-btn { padding: 10px; margin-right: 10px; }\r\n}</style><style rel=\"stylesheet\" type=\"text/css\">@charset \"utf-8\";\r\n\r\n.header-v2_menu-item:hover .sub-menu { opacity: 1; visibility: visible; }\r\n\r\n.header-v2_menu { }\r\n\r\n.header-v2_menu:has(.header-v2_menu-item:hover) .header-v2_menu-item { opacity: 0.4; transition: opacity 0.2s; }\r\n\r\n.header-v2_menu-item:hover { opacity: 1 !important; }\r\n\r\n.header-v2_menu-item:hover .header-v2_menu-icon { transform: rotate(180deg); }\r\n\r\n.item-acc-mobile-menu_panel { max-height: 0px; overflow: hidden; }\r\n\r\n.item-acc-mobile-menu.active { background-color: rgb(239, 242, 255); }\r\n\r\n.item-acc-mobile-menu_head.active { color: rgb(86, 53, 242); }\r\n\r\n.item-acc-mobile-menu_head