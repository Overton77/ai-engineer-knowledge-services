width=\"16\" height=\"16\" fill=\"currentColor\"></rect>\n    </clipPath>\n  </defs>\n</svg></div></div><div class=\"item-acc-mobile-menu_panel\" id=\"faq-panel-2\"><div class=\"item-acc-mobile-menu_list\"><a href=\"https://www.trudiagnostic.com/research-services\" class=\"item-acc-mobile-menu_link\">Research Services</a><a href=\"https://www.trudiagnostic.com/commercial-services\" class=\"item-acc-mobile-menu_link\">Commercial Services</a><a href=\"https://www.trudiagnostic.com/work-with-us-hcp\" class=\"item-acc-mobile-menu_link\">Work With Us</a></div></div></div><div class=\"item-acc-mobile-menu\"><div class=\"item-acc-mobile-menu_head\" aria-controls=\"faq-panel-3\" aria-expanded=\"false\"><div class=\"item-acc-mobile-menu_title\">Our Science</div><div class=\"item-acc-mobile-menu_arrow w-embed\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n  <g clip-path=\"url(#clip0_13084_1516)\">\n    <path d=\"M11.5288 5.52864C11.7891 5.26829 12.2111 5.26829 12.4715 5.52864C12.7318 5.78899 12.7318 6.21099 12.4715 6.47134L8.47147 10.4713C8.21112 10.7317 7.78911 10.7317 7.52876 10.4713L3.52876 6.47134C3.26841 6.21099 3.26841 5.78899 3.52876 5.52864C3.78911 5.26829 4.21112 5.26829 4.47147 5.52864L8.00011 9.05728L11.5288 5.52864Z\" fill=\"#1A126E\"></path>\n  </g>\n  <defs>\n    <clipPath id=\"clip0_13084_1516\">\n      <rect width=\"16\" height=\"16\" fill=\"currentColor\"></rect>\n    </clipPath>\n  </defs>\n</svg></div></div><div class=\"item-acc-mobile-menu_panel\" id=\"faq-panel-3\"><div class=\"item-acc-mobile-menu_list\"><a href=\"https://www.trudiagnostic.com/lab-research\" class=\"item-acc-mobile-menu_link\">Our Laboratory</a><a href=\"https://www.trudiagnostic.com/our-array-platforms\" class=\"item-acc-mobile-menu_link\">Our Arrays</a><a href=\"https://www.trudiagnostic.com/interventional-studies\" class=\"item-acc-mobile-menu_link\">Intervention Tracking</a><a href=\"https://www.trudiagnostic.com/dunedin-pace#\" class=\"item-acc-mobile-menu_link\">DNA Methylation</a><a href=\"https://www.trudiagnostic.com/omicmage\" class=\"item-acc-mobile-menu_link\">OMICmAge</a><a href=\"https://www.trudiagnostic.com/symphony-age\" class=\"item-acc-mobile-menu_link\">SYMPHONYAge</a><a href=\"https://www.trudiagnostic.com/dunedin-pace\" aria-current=\"page\" class=\"item-acc-mobile-menu_link w--current\">DunedinPACE</a><a href=\"https://www.trudiagnostic.com/our-publication\" class=\"item-acc-mobile-menu_link\">Our Publications</a></div></div></div></div></div></div><div class=\"header-v2_code w-embed w-script\">\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const accHeader = document.querySelectorAll('.item-acc-mobile-menu');\n\n    function closeItem(accItem) {\n      const head = accItem.querySelector('.item-acc-mobile-menu_head');\n      const panel = accItem.querySelector('.item-acc-mobile-menu_panel');\n\n      accItem.classList.remove('active');\n      panel.classList.remove('active');\n      head.classList.remove('active');\n      head.setAttribute('aria-expanded', 'false');\n      panel.style.maxHeight = null;\n    }\n\n    function openItem(accItem) {\n      const head = accItem.querySelector('.item-acc-mobile-menu_head');\n      const panel = accItem.querySelector('.item-acc-mobile-menu_panel');\n\n      accItem.classList.add('active');\n      panel.classList.add('active');\n      head.classList.add('active');\n      head.setAttribute('aria-expanded', 'true');\n      panel.style.maxHeight = panel.scrollHeight + 'px';\n    }\n\n    accHeader.forEach((accItem, index) => {\n      const head = accItem.querySelector('.item-acc-mobile-menu_head');\n      const panel = accItem.querySelector('.item-acc-mobile-menu_panel');\n\n      // Генеруємо унікальний id для кожної панелі\n      const panelId = `faq-panel-${index}`;\n      panel.setAttribute('id', panelId);\n      head.setAttribute('aria-controls', panelId);\n\n      // Початковий стан: перший елемент відкритий, решта закриті\n      if (index === 0) {\n        head.setAttribute('aria-expanded', 'true');\n      } else {\n        head.setAttribute('aria-expanded', 'false');\n      }\n\n      accItem.addEventListener('click', function () {\n        const isActive = this.classList.contains('active');\n\n        // Закриваємо всі елементи\n        accHeader.forEach(closeItem);\n\n        // Якщо клікнутий елемент був закритий — відкриваємо його\n        if (!isActive) {\n          openItem(this);\n        }\n      });\n    });\n\n    // Відкриваємо перший елемент за замовчуванням\n    if (accHeader.length > 0) {\n      openItem(accHeader[0]);\n    }\n  });\n</script>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const burger = document.querySelector('.header-v2_burger');\n    const mobileMenu = document.querySelector('.header-v2_mobile-menu');\n    const overlay = document.querySelector('.header-v2_mobile-overlay');\n    const body = document.body;\n\n    const mq = window.matchMedia('(max-width: 991px)');\n\n    function openMenu() {\n      burger.classList.add('is-active');\n      mobileMenu.classList.add('is-visible');\n      overlay.classList.add('is-visible');\n      body.classList.add('no-scroll');\n    }\n\n    function closeMenu() {\n      burger.classList.remove('is-active');\n      mobileMenu.classList.remove('is-visible');\n      overlay.classList.remove('is-visible');\n      body.classList.remove('no-scroll');\n    }\n\n    function toggleMenu() {\n      // діємо лише на пристроях менших за 991px\n      if (!mq.matches) return;\n\n      if (burger.classList.contains('is-active')) {\n        closeMenu();\n      } else {\n        openMenu();\n      }\n    }\n\n    if (burger && mobileMenu && overlay) {\n      burger.addEventListener('click', toggleMenu);\n\n      // клік по оверлею закриває меню\n      overlay.addEventListener('click', closeMenu);\n\n      // закриваємо меню, якщо viewport став ширшим за 991px\n      mq.addEventListener('change', function (e) {\n        if (!e.matches) {\n          closeMenu();\n        }\n      });\n\n      // закриваємо меню при кліку на будь-яке посилання всередині мобільного меню\n      mobileMenu.querySelectorAll('a').forEach(function (link) {\n        link.addEventListener('click', closeMenu);\n      });\n    }\n  });\n</script></div></header></div></div><main id=\"main-content\" class=\"main-wrapper above-fold-cta\"><section class=\"section_hero-symphony\"><div class=\"padding-global new\"><div class=\"container-new\"><div class=\"hero-symphony_wrapper\"><div class=\"hero-symphony_content\"><div class=\"hero-symphony_content-head\"><div class=\"heading-xs-regular blue fz-16\">AGING SPEED</div><h1 class=\"title-h2-new blue\">DunedinPACE<sup>™</sup></h1></div><div class=\"hero-symphony_content-bot\"><div class=\"hero-symphony_content-bot-text\"><div class=\"text-regular blue\">Learn how fast you’re aging. Unlock insights into your aging speed and how you can slow it down.</div></div><div class=\"hero-symphony_content-bot-links\"><a data-wf--global-cta-yellow--variant=\"full-width-height\" href=\"https://www.trudiagnostic.com/become-a-provider\" class=\"cta-yellow w-variant-5b9601e6-6a59-2b05-1b12-8de340a701eb w-inline-block\"><div class=\"text-regular blue cta\">For Providers</div><div class=\"cta-yellow-icon w-embed\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<g clip-path=\"url(#clip0_11047_7388)\">\n<path d=\"M2 16.2002V15C2 14.4477 2.44772 14 3 14C3.55229 14 4 14.4477 4 15V16.2002C4 17.0566 4.00035 17.6388 4.03711 18.0889C4.07293 18.5273 4.13809 18.7518 4.21778 18.9082C4.40951 19.2845 4.71555 19.5905 5.0918 19.7822C5.2482 19.8619 5.47272 19.9271 5.91113 19.9629C6.36117 19.9997 6.94342 20 7.79981 20H16.2002C17.0566 20 17.6388 19.9997 18.0889 19.9629C18.5273 19.9271 18.7518 19.8619 18.9082 19.7822C19.2845 19.5905 19.5905 19.2845 19.7822 18.9082C19.8619 18.7518 19.9271 18.527