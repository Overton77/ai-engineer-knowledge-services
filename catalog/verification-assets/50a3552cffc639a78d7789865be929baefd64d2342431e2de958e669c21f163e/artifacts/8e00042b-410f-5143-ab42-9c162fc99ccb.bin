yle=\"font-feature-settings:'tnum' 1;\">0.57</text>\n  </svg>\n</div>\n\n\n\n<script>\n(function(){\n  var CX = 118.7, CY = 97.59;\n  var R_WEDGE = 113;\n  var R_ARC = 165 / 2 * 0.9926;\n  var R_IND = 74;\n\n  function angleFor(v){ return Math.PI + v * Math.PI / 2; }\n  function ptOn(r, v){\n    var t = angleFor(v);\n    return [CX + r * Math.cos(t), CY + r * Math.sin(t)];\n  }\n\n  var EASINGS = {\n    linear:        function(t){ return t; },\n    easeOutCubic:  function(t){ return 1 - Math.pow(1-t, 3); },\n    easeInOutCubic:function(t){ return t<.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2, 3)/2; },\n    easeOutQuart:  function(t){ return 1 - Math.pow(1-t, 4); }\n  };\n\n  function idleOffset(t, amp){\n    return amp * (0.66 * Math.sin(2*Math.PI*t/3200) + 0.34 * Math.sin(2*Math.PI*t/5100 + 1.7));\n  }\n\n  document.querySelectorAll('.dp-dial').forEach(function(dial){\n    var START    = parseFloat(dial.dataset.start    || '0.57');\n    var END      = parseFloat(dial.dataset.end      || '1.57');\n    var DURATION = parseFloat(dial.dataset.duration || '2000');\n    var INTRO_EASE = EASINGS[dial.dataset.easing] || EASINGS.easeOutCubic;\n    var HOVER_DUR  = parseFloat(dial.dataset.hoverDuration || '1100');\n    var REPLAY     = (dial.dataset.replay || 'true') !== 'false';\n    var BOUNCE     = (dial.dataset.bounce || 'true') !== 'false';\n    var BOUNCE_AMP = parseFloat(dial.dataset.bounceAmp || '0.045');\n    var DECIMALS   = parseInt(dial.dataset.decimals || '2', 10);\n\n    var wedgePath = dial.querySelector('.dp-wedge');\n    var innerArc  = dial.querySelector('.dp-inner-arc');\n    var indicator = dial.querySelector('.dp-indicator');\n    var label     = dial.querySelector('.dp-value');\n\n    function setValue(v){\n      v = Math.max(0, Math.min(2, v));\n      var sp = ptOn(R_WEDGE, 0);\n      var ep = ptOn(R_WEDGE, v);\n      var largeArc = v > 2 ? 1 : 0;\n      wedgePath.setAttribute('d',\n        'M '+CX+' '+CY+\n        ' L '+sp[0].toFixed(3)+' '+sp[1].toFixed(3)+\n        ' A '+R_WEDGE+' '+R_WEDGE+' 0 '+largeArc+' 1 '+ep[0].toFixed(3)+' '+ep[1].toFixed(3)+\n        ' Z'\n      );\n      var ap = ptOn(R_ARC, 0);\n      var bp = ptOn(R_ARC, v);\n      innerArc.setAttribute('d',\n        'M '+ap[0].toFixed(3)+' '+ap[1].toFixed(3)+\n        ' A '+R_ARC.toFixed(3)+' '+R_ARC.toFixed(3)+' 0 0 1 '+bp[0].toFixed(3)+' '+bp[1].toFixed(3)\n      );\n      var ip = ptOn(R_IND, v);\n      var deg = (angleFor(v) * 180 / Math.PI) + 90;\n      indicator.setAttribute('transform',\n        'translate('+ip[0].toFixed(3)+' '+ip[1].toFixed(3)+') rotate('+deg.toFixed(3)+')'\n      );\n      label.textContent = v.toFixed(DECIMALS);\n    }\n\n    var target          = END;\n    var baseValue       = START;\n    var tweenFrom       = START;\n    var tweenStart      = 0;\n    var tweenDuration   = DURATION;\n    var tweenEase       = INTRO_EASE;\n    var bouncing        = false;\n    var bounceStart     = 0;\n    var armed           = false;\n    var rafId           = null;\n\n    function startTween(toTarget, dur, ease){\n      tweenFrom     = baseValue;\n      tweenStart    = performance.now();\n      tweenDuration = dur;\n      tweenEase     = ease;\n      target        = toTarget;\n      bouncing      = false;\n    }\n\n    function tick(now){\n      if (!bouncing){\n        var k = Math.min(1, (now - tweenStart) / tweenDuration);\n        baseValue = tweenFrom + (target - tweenFrom) * tweenEase(k);\n        if (k >= 1){\n          baseValue   = target;\n          bouncing    = true;\n          bounceStart = now;\n        }\n      }\n      var v = baseValue;\n      if (bouncing && BOUNCE){\n        v += idleOffset(now - bounceStart, BOUNCE_AMP);\n      }\n      setValue(v);\n      rafId = requestAnimationFrame(tick);\n    }\n\n    function play(){\n      baseValue     = START;\n      tweenFrom     = START;\n      target        = END;\n      tweenStart    = performance.now();\n      tweenDuration = DURATION;\n      tweenEase     = INTRO_EASE;\n      bouncing      = false;\n      setValue(START);\n      if (rafId) cancelAnimationFrame(rafId);\n      rafId = requestAnimationFrame(tick);\n      armed = true;\n    }\n\n    dial.addEventListener('mouseenter', function(){\n      if (!armed) return;\n      if (target !== START) startTween(START, HOVER_DUR, EASINGS.easeInOutCubic);\n    });\n    dial.addEventListener('mouseleave', function(){\n      if (!armed) return;\n      if (target !== END) startTween(END, HOVER_DUR, EASINGS.easeInOutCubic);\n    });\n\n    setValue(START);\n\n    if ('IntersectionObserver' in window){\n      var io = new IntersectionObserver(function(entries){\n        entries.forEach(function(e){\n          if (e.isIntersecting){\n            if (!armed || REPLAY) play();\n            if (!REPLAY) io.unobserve(e.target);\n          } else if (REPLAY){\n            if (rafId){ cancelAnimationFrame(rafId); rafId = null; }\n            armed = false;\n            bouncing = false;\n            setValue(START);\n          }\n        });\n      }, { threshold: 0.35 });\n      io.observe(dial);\n    } else {\n      play();\n    }\n\n    dial.addEventListener('dp:play', play);\n\n    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches){\n      if (rafId){ cancelAnimationFrame(rafId); rafId = null; }\n      bouncing = false; armed = false;\n      baseValue = END; target = END;\n      setValue(END);\n    }\n  });\n})();\n</script></div><div class=\"hero-symphony_strapline\"><div class=\"hero-symphony_strapline-text\"><strong>speed of aging</strong></div></div></div></div></div></div></section><section class=\"section_info-new modify flex\"><div class=\"padding-global new\"><div class=\"container-new\"><div class=\"info-new_wrapper\"><div class=\"info-new_content\"><div class=\"heading-xs-regular blue\">DEVELOPED WITH DUKE</div><h2 class=\"title-h2-new blue\">Understand Your Aging Speed</h2><div class=\"text-regular blue fkex\">Our DunedinPACE science, developed with Duke, measures how quickly your body ages over time. By monitoring whether your aging speed is accelerating or decelerating, you can measure the effect of various lifestyle changes. Your aging speed, combined with your biological age, empowers you to take proactive steps to optimize your health.</div><a data-wf--global-cta-yellow--variant=\"modify\" href=\"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/684b0280d60621d1be91641c_ExampleAdvancedTruAge.pdf\" class=\"cta-yellow w-variant-927ae097-63d8-7236-ec7b-a65ed4a0b41b w-inline-block\"><div class=\"text-regular blue cta\">Download TruAge Sample Report</div><div class=\"cta-yellow-icon w-variant-927ae097-63d8-7236-ec7b-a65ed4a0b41b w-embed\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<g clip-path=\"url(#clip0_11047_7388)\">\n<path d=\"M2 16.2002V15C2 14.4477 2.44772 14 3 14C3.55229 14 4 14.4477 4 15V16.2002C4 17.0566 4.00035 17.6388 4.03711 18.0889C4.07293 18.5273 4.13809 18.7518 4.21778 18.9082C4.40951 19.2845 4.71555 19.5905 5.0918 19.7822C5.2482 19.8619 5.47272 19.9271 5.91113 19.9629C6.36117 19.9997 6.94342 20 7.79981 20H16.2002C17.0566 20 17.6388 19.9997 18.0889 19.9629C18.5273 19.9271 18.7518 19.8619 18.9082 19.7822C19.2845 19.5905 19.5905 19.2845 19.7822 18.9082C19.8619 18.7518 19.9271 18.5273 19.9629 18.0889C19.9997 17.6388 20 17.0566 20 16.2002V15C20 14.4477 20.4477 14 21 14C21.5523 14 22 14.4477 22 15V16.2002C22 17.0237 22.001 17.7016 21.9561 18.252C21.9101 18.814 21.8117 19.3311 21.5645 19.8164C21.181 20.5689 20.5689 21.181 19.8164 21.5645C19.3311 21.8117 18.814 21.9101 18.252 21.9561C17.7016 22.001 17.0237 22 16.2002 22H7.79981C6.97632 22 6.29843 22.001 5.74805 21.9561C5.18599 21.9101 4.6689 21.8117 4.1836 21.5645C3.43109 21.181 2.81902 20.5689 2.43555 19.8164C2.18827 19.3311 2.08988 18.814 2.04395 18.252C1.99898 17.7016 2 17.0237 2 16.2002ZM11 3C11 2.44772 11.4477 2 12 2C12.5523 2 13 2.44772 13 3V12.5859L16.293 9.29297C16.6835 8.90244 17.3165 8.90244 17.707 9.29297C18.0976 9.68349 18.0976 10.3165 17.707 10.707L12.707 15.707C12.3165 16.0976 11.6835 16.0976 11.293 15.707L6.29297 10.707C5.90245 10.3165 5.90245 9.68349 6.29297 9.29297C6.6835 8.90244 7.31651 8.90244 7.70703 9.29297L11 12.5859V3Z\" fill=\"#1A126E\"></path>\n</g>\n<defs>\n<clipPath id=\"clip0_11047_7388\">\n<rect width=\"24\" height=\"24\" fill=\"white\"></rect>\n</clipPath>\n</defs>\n</svg>\n</div><div class=\"cta-yellow-icon-v2 w-variant-927ae097-63d8-7236-ec7b-a65ed4a0b41b w-embed\"><svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M8 7.33333C8 7.70152 7.70152 8 7.33333 8C6.96514 8 6.66667 7.70152 6.66667 7.33333V2.27604L1.13802 7.80469C0.877671 8.06504 0.455662 8.06504 0.195312 7.80469C-0.065037 7.54434 -0.065037 7.12233 0.195312 6.86198L5.72396 1.33333H0.666667C0.298477 1.33333 0 1.03486 0 0.666667C0 0.298477 0.298477 0 0.666667 0H7.33333C7.70152 0 8 0.298477 8 0.666667V7.33333Z\" fill=\"#1A126E\"></path>\n</svg>\n</div></a></div><div class=\"info-new_image modify\"><img src=\"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a6907a37995be283ce13f41_dunedinpacedoc.png\" loading=\"lazy\" alt=\"\" class=\"info-new_img\" width=\"3\" height=\"3\"></div></div></div></div></section><section class=\"section_diagnostic blue\"><div class=\"padding-global-9 no-padd-top new\"><div class=\"container-large-4 medium\"><div class=\"diagnostic_wrapper light-blue\"><div class=\"diagnostic_image modify\"><img src=\"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a68c20a2850fda8b0d0c260_Image.png\" loading=\"lazy\" alt=\"\" class=\"diagnostic_img\" width=\"1\" height=\"1\"></div><div class=\"diagnostic_content modify\"><div class=\"diagnostic_title-wrap\"><h2 class=\"title-h2-new blue\">Is Your Lifestyle Slowing Your Aging Speed?</h2></div><div class=\"diagnostic_text\"><div class=\"text-regular blue\">The DunedinPACE report lets you see the real impact of your lifestyle choices on your aging process. Whether it’s diet, exercise, or sleep, our test provides concrete data on how these factors influence your pace of aging. Routine testing allows you to quickly measure the effects of your habits.</div></div><div class=\"diagnostic_links\"><a data-wf--global-cta-yellow--variant=\"modify\" href=\"https://shop.trudiagnostic.com/products/truage-complete-epigenetic-collection\" class=\"cta-yellow w-variant-927ae097-63d8-7236-ec7b-a65ed4a0b41b w-inline-block\"><div class=\"text-regular blue cta\">Purchase Test Kit</div><div class=\"cta-yellow-icon w-variant-927ae097-63d8-7236-ec7b-a65ed4a0b41b w-embed\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<g clip-path=\"url(#clip0_11047_7388)\">\n<path d=\"M2 16.2002V15C2 14.4477 2.44772 14 3 14C3.55229 14 4 14.4477 4 15V16.2002C4 17.0566 4.00035 17.6388 4.03711 18.0889C4.07293 18.5273 4.13809 18.7518 4.21778 18.9082C4.40951 19.2845 4.71555 19.5905 5.0918 19.7822C5.2482 19.8619 5.47272 19.9271 5.91113 19.9629C6.36117 19.9997 6.94342 20 7.79981 20H16.2002C17.0566 20 17.6388 19.9997 18.0889 19.9629C18.5273 19.9271 18.7518 19.8619 18.9082 19.7822C19.2845 19.5905 19.5905 19.2845 19.7822 18.9082C19.8619 18.7518 19.9271 18.5273 19.9629 18.0889C19.9997 17.6388 20 17.0566 20 16.2002V15C20 14.4477 20.4477 14 21 14C21.5523 14 22 14.4477 22 15V16.2002C22 17.0237 22.001 17.7016 21.9561 18.252C21.9101 18.814 21.8117 19.3311 21.5645 19.8164C21.181 20.5689 20.5689 21.181 19.8164 21.5645C19.3311 21.8117 18.814 21.9101 18.252 21.9561C17.7016 22.001 17.0237 22 16.2002 22H7.79981C6.97632 22 6.29843 22.001 5.74805 21.9561C5.18599 21.9101 4.6689 21.8117 4.1836 21.5645C3.43109 21.181 2.81902 20.5689 2.43555 19.8164C2.18827 19.3311 2.08988 18.814 2.04395 18.252C1.99898 17.7016 2 17.0237 2 16.2002ZM11 3C11 2.44772 11.4477 2 12 2C12.5523 2 13 2.44772 13 3V12.5859L16.293 9.29297C16.6835 8.90244 17.3165 8.90244 17.707 9.29297C18.0976 9.68349 18.0976 10.