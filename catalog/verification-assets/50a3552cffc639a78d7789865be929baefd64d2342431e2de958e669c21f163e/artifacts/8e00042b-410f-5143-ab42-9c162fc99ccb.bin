nt = item.querySelector('.item_faq-content');\n      const plusIcon = item.querySelector('.item_faq-plus');\n      const isActive = item.classList.contains('active');\n      item.classList.toggle('active');\n      if (plusIcon) plusIcon.classList.toggle('active');\n      if (!isActive) {\n        content.style.maxHeight = (content.scrollHeight + 25) + \"px\";\n      } else {\n        content.style.maxHeight = 0;\n      }\n    });\n  });\n\n  if (faqItems.length > 0) {\n    const firstItem = faqItems[0];\n    const firstContent = firstItem.querySelector('.item_faq-content');\n    const firstPlus = firstItem.querySelector('.item_faq-plus');\n    firstItem.classList.add('active');\n    if (firstPlus) firstPlus.classList.add('active');\n    firstContent.style.maxHeight = (firstContent.scrollHeight + 25) + \"px\";\n  }\n});\n</script>\n\n<script>\nconst testSlider = new Swiper('#testSlider', {\n  slidesPerView: 'auto',\n  spaceBetween: 12, \n});\n</script>\n\n\n\n<div style=\"position: fixed; outline: none; display: none;\" id=\"alia-root-324104\"></div></body></html>","metadata":{"og:description":"Measure how fast you're aging with DunedinPACE™. Track lifestyle impact on aging rate with scientifically validated epigenetic testing. See results fast.","twitter:description":"Measure how fast you're aging with DunedinPACE™. Track lifestyle impact on aging rate with scientifically validated epigenetic testing. See results fast.","ogTitle":"Dundein PACE™ | TruDiagnostic.com™","og:type":"website","viewport":"width=device-width, initial-scale=1","twitter:card":"summary_large_image","twitter:title":"Dundein PACE™ | TruDiagnostic.com™","google-site-verification":"S3Zn4wTV0DuLepYeVDpJ5Jmkj1Uh8nMePMamU92gIXw","title":"Dundein PACE™ | TruDiagnostic.com™","language":"en","og:title":"Dundein PACE™ | TruDiagnostic.com™","ogDescription":"Measure how fast you're aging with DunedinPACE™. Track lifestyle impact on aging rate with scientifically validated epigenetic testing. See results fas