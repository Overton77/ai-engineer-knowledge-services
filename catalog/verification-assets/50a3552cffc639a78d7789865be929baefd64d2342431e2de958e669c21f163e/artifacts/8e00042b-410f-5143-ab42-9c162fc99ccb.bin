path d=\"M24 0.5C36.9787 0.5 47.5 11.0213 47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.5 24C0.5 11.0213 11.0213 0.5 24 0.5Z\" stroke=\"#1A126E\"></path>\n<defs>\n<clipPath id=\"clip0_11045_1964\">\n<path d=\"M0 24C0 10.7452 10.7452 0 24 0C37.2548 0 48 10.7452 48 24C48 37.2548 37.2548 48 24 48C10.7452 48 0 37.2548 0 24Z\" fill=\"white\"></path>\n</clipPath>\n<clipPath id=\"clip1_11045_1964\">\n<rect width=\"20\" height=\"20\" fill=\"white\" transform=\"translate(14 14)\"></rect>\n</clipPath>\n</defs>\n</svg>\n</div></div><div id=\"aboutNext\" class=\"nav-btns-next\" tabindex=\"0\" role=\"button\" aria-label=\"Next slide\"><div class=\"nav-btns-icon w-embed\"><svg width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<g clip-path=\"url(#clip0_11045_1986)\">\n<g clip-path=\"url(#clip1_11045_1986)\">\n<path d=\"M20.9111 18.4108C21.2365 18.0854 21.764 18.0854 22.0895 18.4108L27.0895 23.4108C27.4149 23.7363 27.4149 24.2638 27.0895 24.5892L22.0895 29.5892C21.764 29.9146 21.2365 29.9146 20.9111 29.5892C20.5856 29.2638 20.5856 28.7363 20.9111 28.4108L25.3219 24L20.9111 19.5892C20.5856 19.2638 20.5856 18.7363 20.9111 18.4108Z\" fill=\"#1A126E\"></path>\n</g>\n</g>\n<path d=\"M24 0.5C36.9787 0.5 47.5 11.0213 47.5 24C47.5 36.9787 36.9787 47.5 24 47.5C11.0213 47.5 0.5 36.9787 0.5 24C0.5 11.0213 11.0213 0.5 24 0.5Z\" stroke=\"#1A126E\"></path>\n<defs>\n<clipPath id=\"clip0_11045_1986\">\n<path d=\"M0 24C0 10.7452 10.7452 0 24 0C37.2548 0 48 10.7452 48 24C48 37.2548 37.2548 48 24 48C10.7452 48 0 37.2548 0 24Z\" fill=\"white\"></path>\n</clipPath>\n<clipPath id=\"clip1_11045_1986\">\n<rect width=\"20\" height=\"20\" fill=\"white\" transform=\"translate(14 14)\"></rect>\n</clipPath>\n</defs>\n</svg>\n</div></div></div></div><div class=\"about_text-wrap\"><div class=\"text-regular blue\">Explore core diagnostics, reporting tools, and research platforms trusted by leading clinicians and scientists.</div></div><div id=\"aboutSlider\" class=\"about_slider swiper modify swiper-initialized swiper-horizontal swiper-backface-hidden\"><div class=\"about_slider-wrapper swiper-wrapper\" id=\"swiper-wrapper-1ccf357931066879e\" aria-live=\"polite\"><div class=\"about_item swiper-slide new swiper-slide-active\" role=\"group\" aria-label=\"1 / 4\" data-swiper-slide-index=\"0\" style=\"margin-right: 24px;\"><div class=\"about_item-icon\"><img src=\"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a1854d3119cab63a7340251_Icon.png\" loading=\"lazy\" alt=\"\" class=\"about_item-icon-img\"></div><h4 class=\"about_item-title\">Real-Time Feedback</h4><div class=\"about_item-content new\"><div class=\"text-small-medium blue\">Quickly see the results of your lifestyle changes.</div></div></div><div class=\"about_item swiper-slide new swiper-slide-next\" role=\"group\" aria-label=\"2 / 4\" data-swiper-slide-index=\"1\" style=\"margin-right: 24px;\"><div class=\"about_item-icon\"><img src=\"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a18548e3598132e63398e58_Icon.png\" loading=\"lazy\" alt=\"\" class=\"about_item-icon-img\"></div><h4 class=\"about_item-title\">Advanced Technology</h4><div class=\"about_item-content new\"><div class=\"text-small-medium blue\">The only third-generation biological clock aging algorithm available.</div></div></div><div class=\"about_item swiper-slide new\" role=\"group\" aria-label=\"3 / 4\" data-swiper-slide-index=\"2\" style=\"margin-right: 24px;\"><div class=\"about_item-icon\"><img src=\"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a1854a7e26efe4dccbed63f_Icon.png\" loading=\"lazy\" alt=\"\" class=\"about_item-icon-img\"></div><h4 class=\"about_item-title\">Accurate &amp; Sensitive</h4><div class=\"about_item-content new\"><div class=\"text-small-medium blue\">Detect subtle changes in your aging process.</div></div></div><div class=\"about_item swiper-slide new\" role=\"group\" aria-label=\"4 / 4\" data-swiper-slide-index=\"3\" style=\"margin-right: 24px;\"><div class=\"about_item-icon\"><img src=\"https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/6a1854bdd3521b59039b09af_Icon.png\" loading=\"lazy\" alt=\"\" class=\"about_item-icon-img\"></div><h4 class=\"about_item-title\">Comprehensive Reports</h4><div class=\"about_item-content new\"><div class=\"text-small-medium blue\">Get detailed insights into your biological responsiveness, lifestyle, and more.</div></div></div></div><span class=\"swiper-notification\" aria-live=\"assertive\" aria-atomic=\"true\"></span></div></div></div></div></section><section class=\"section_diagnostic blue\"><div class=\"padding-global-9 no-padd-top new\"><div class=\"container-large-4 medium\"><div class=\"diagnostic_wrapper light-blue\"><div class=\"diagnostic_content\"><div class=\"heading-xs-regular blue\">BERLIN AGING STUDY II</div><div class=\"diagnostic_title-wrap\"><h2 class=\"title-h2-new blue\">DunedinPACE is the strongest individual predictor of all-cause mortality.</h2></div><div class=\"diagnostic_text\"><div class=\"text-regular blue\">In a 7.4-year study of 1,083 older adults, our pace of aging clock outperformed 14 leading longevity biomarkers — including inflammation markers, grip strength, and cognitive tests.</div></div><div class=\"diagnostic_links\"><a data-wf--global-cta-yellow--variant=\"icon-2\" href=\"https://pubmed.ncbi.nlm.nih.gov/41792861/\" class=\"cta-yellow w-variant-b5009f81-40b3-a624-5f07-b1fbad456391 w-inline-block\"><div class=\"text-regular blue cta w-variant-b5009f81-40b3-a624-5f07-b1fbad456391\">Read the Research</div><div class=\"cta-yellow-icon w-embed\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<g clip-path=\"url(#clip0_11047_7388)\">\n<path d=\"M2 16.2002V15C2 14.4477 2.44772 14 3 14C3.55229 14 4 14.4477 4 15V16.2002C4 17.0566 4.00035 17.6388 4.03711 18.0889C4.07293 18.5273 4.13809 18.7518 4.21778 18.9082C4.40951 19.2845 4.71555 19.5905 5.