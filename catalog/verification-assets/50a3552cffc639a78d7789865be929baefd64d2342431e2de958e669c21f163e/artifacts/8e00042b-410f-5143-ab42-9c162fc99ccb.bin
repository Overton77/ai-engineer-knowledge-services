\n        a=t.getElementsByTagName(n)[0],a.parentNode.insertBefore(u,a));\n      }(window,document,'script');\n      window.twq && twq('config','os3sf');\n    }\n\n    // Finsweet CMS Slider (only if attribute exists)\n    if (!window.__fsSliderLoaded && document.querySelector('[fs-cmsslider-element=\"slider\"]')){\n      var fs = document.createElement('script');\n      fs.src = \"https://cdn.jsdelivr.net/npm/@finsweet/attributes-cmsslider@1/cmsslider.js\";\n      fs.async = true;\n      fs.onload = function(){ window.__fsSliderLoaded = true; };\n      document.head.appendChild(fs);\n    }\n\n    // SplitType + GSAP + ScrollTrigger (load missing only)\n    var needInit = 0;\n    function add(src, present){\n      if (present) return;\n      var s = document.createElement('script'); s.src = src; s.async = true; s.onload = done; needInit++;\n      document.head.appendChild(s);\n    }\n    function done(){ if(--needInit<=0) initTextSplit(); }\n\n    add(\"https://unpkg.com/split-type\", !!window.SplitType);\n    add(\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/gsap.min.js\", !!window.gsap);\n    add(\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/ScrollTrigger.min.js\", !!(window.gsap && window.ScrollTrigger));\n    if (needInit===0) initTextSplit();\n\n    function initTextSplit(){\n      if (!window.gsap || !window.ScrollTrigger || !window.SplitType || initTextSplit._done) return;\n      initTextSplit._done = true;\n      gsap.registerPlugin(ScrollTrigger);\n\n      var typeSplit = new SplitType(\"[text-split]\", { types:\"words, chars\", tagName:\"span\" });\n\n      function createScrollTrigger(el, tl){\n        ScrollTrigger.create({ trigger: el, start:\"top bottom\", onLeaveBack:function(){ tl.progress(0); tl.pause(); }});\n        ScrollTrigger.create({ trigger: el, start:\"top 60%\", onEnter:function(){ tl.play(); }});\n      }\n\n      document.querySelectorAll(\"[letters-fade-in]\").forEach(function(el){\n        var tl = gsap.timeline({ paused:true });\n        tl.from(el.querySelectorAll(\".char\"), { opacity:0, duration:.2, ease:\"power1.out\", stagger:{ amount:.8 } });\n        createScrollTrigger(el, tl);\n      });\n\n      document.querySelectorAll(\"[scrub-each-word]\").forEach(function(el){\n        gsap.timeline({ scrollTrigger:{ trigger:el, start:\"top 90%\", end:\"top center\", scrub:true } })\n            .from(el.querySelectorAll(\".word\"), { opacity:.2, duration:.2, ease:\"power1.out\", stagger:{ each:.4 }});\n      });\n\n      gsap.set(\"[text-split]\", { opacity:1 });\n    }\n\n    // Salesforce Embedded Messaging (lazy)\n    if (!window.__sfBoot){\n      var sf = document.createElement('script');\n      sf.src = 'https://trudiagnostic.my.site.com/ESWTruDiagnosticService1738072767419/assets/js/bootstrap.min.js';\n      sf.defer = true;\n      sf.onload = function(){ window.__sfBoot = true; if (typeof initEmbeddedMessaging === 'function') initEmbeddedMessaging(); };\n      document.head.appendChild(sf);\n    }\n  });\n\n  function schedule(){\n    if (document.hidden || netConstrained()){\n      clearTimeout(timer);\n      timer = setTimeout(schedule, 4000);\n      return;\n    }\n    setTimeout(load, delay);\n  }\n\n  // user signals\n  window.addEventListener('pointerdown', load, { once:true });\n  window.addEventListener('scroll', load, { once:true, passive:true });\n  document.addEventListener('visibilitychange', function(){ if (!document.hidden) schedule(); }, { once:true });\n\n  // time fallback\n  schedule();\n})();\n</script>\n<script src=\"https://backend.alia-prod.com/public/embed.js?shop=trudiagnostictest.myshopify.com\" async=\"\"></script>\n\n<script>\n  (function () {\n    var nav = document.querySelector('.navbar_component[role=\"banner\"]');\n    if (!nav) return;\n\n    // Замінюємо div на header зі збереженням всього вмісту\n    var header = document.createElement('header');\n\n    // Копіюємо всі атрибути\n    Array.from(nav.attributes).forEach(function (attr) {\n     