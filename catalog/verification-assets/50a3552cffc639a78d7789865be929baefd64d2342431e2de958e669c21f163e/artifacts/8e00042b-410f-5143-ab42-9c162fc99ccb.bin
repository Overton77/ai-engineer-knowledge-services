panelSessionLogic() {\n    try {\n      if (!window.mixpanel) return;\n\n      // rsid identity\n      var rsid = sessionStorage.getItem('rsid');\n      if (!rsid) {\n        rsid = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : (Date.now() + '-' + Math.random().toString(36).slice(2));\n        sessionStorage.setItem('rsid', rsid);\n      }\n      mixpanel.identify(rsid);\n      mixpanel.register({ rsid: rsid });\n\n      // UTM params -> register_once\n      var params = new URL(location.href).searchParams;\n      ['utm_source','utm_medium','utm_campaign','utm_term','utm_content'].forEach(function (k) {\n        var v = params.get(k); if (!v) return;\n        var o={}; o[k]=v; mixpanel.register_once(o);\n      });\n\n      // Session_Started (once per session)\n      if (!sessionStorage.getItem('sessionStarted')) {\n        mixpanel.track('Session_Started', { rsid: rsid, startTime: new Date().toISOString(), url: location.href, referrer: document.referrer });\n        sessionStorage.setItem('sessionStarted','true');\n      }\n\n      // First / returning\n      if (localStorage.getItem('returningVisitor')) {\n        var sc = parseInt(localStorage.getItem('sessionCount')||'1',10)+1;\n        localStorage.setItem('sessionCount', String(sc));\n        mixpanel.track('Visitor_Returned', { rsid: rsid, returningVisitor: true, sessionCount: sc });\n      } else {\n        localStorage.setItem('returningVisitor','true'); localStorage.setItem('sessionCount','1');\n        mixpanel.track('First_Time_Visitor', { rsid: rsid, returningVisitor: false, sessionCount: 1 });\n      }\n\n      // Page_Viewed\n      mixpanel.track('Page_Viewed', { rsid: rsid, pageURL: location.href, pageTitle: document.title, referrerURL: document.referrer });\n\n      // Traffic source (once per session)\n      if (!sessionStorage.getItem('trafficSourceDetected')) {\n        var src = params.get('utm_source') || (document.referrer ? new URL(document.referrer).hostname : 'Direct');\n        var med = params.get('utm_medium') || (document.referrer ? 'Referral' : 'Direct');\n        var camp = params.get('utm_campaign') || undefined;\n        mixpanel.track('Traffic_Source_Detected', { rsid: rsid, trafficSource: src, medium: med, campaign: camp });\n        sessionStorage.setItem('trafficSourceDetected','true');\n      }\n\n      // Exit\n      window.addEventListener('beforeunload', function () {\n        try { mixpanel.track('Page_Exited', { rsid: rsid, pageURL: location.href, exitTime: new Date().toISOString() }); } catch(e){}\n      });\n\n      // Targeted button clicks\n      var TRACK_SELECTORS = '.button, .section3_card-button, .card_button, .research_card-button';\n      document.addEventListener('click', function (e) {\n        var el = e.target.closest(TRACK_SELECTORS); if (!el) return;\n        var top = el.getBoundingClientRect().top, vh = window.innerHeight || 1;\n        var pos = top < vh/3 ? 'Top' : (top < 2*vh/3 ? 'Middle' : 'Bottom');\n        mixpanel.track('Button_Clicked', { rsid: rsid, pageURL: location.href, buttonText: (el.innerText||'').trim(), buttonID: el.className || '', clickPosition: pos });\n      }, true);\n\n      // Video play (if present)\n      var v = document.getElementById('video1');\n      if (v) v.addEventListener('play', function(){ mixpanel.track('Content_Interacted', { contentType:'Video', interactionType:'Play', contentURL: location.href }); });\n\n    } catch (err) {}\n  }\n\n  function start() {\n    if ('requestIdleCallback' in window) { requestIdleCallback(runMixpanelSessionLogic, { timeout: 2000 }); }\n    else { setTimeout(runMixpanelSessionLogic, 0); }\n  }\n\n  if (document.hidden) {\n    document.addEventListener('visibilitychange', function onv(){ if (!document.hidden){ document.removeEventListener('visibilitychange', onv); start(); }});\n  } else if (document.readyState === 'complete' || document.readyState === 'interactive') {\n    start();\n  } else {\n    document.addEventListener('DOMContentLoaded', start);\n  }\n})();\n</script>-->\n\n\n\n<!-- Card center hover logic (only on hover-capable devices) -->\n<script>\n(function(){\n  if (!window.matchMedia || !window.matchMedia('(hover: hover)').matches) return;\n  document.addEventListener('DOMContentLoaded', function(){\n    var cards = document.querySelectorAll('.card'), initial = document.querySelector('.card-center');\n    if (!cards.length || !initial) return;\n    cards.forEach(function(card){\n      card.addEventListener('mouseenter', function(){ cards.forEach(function(c){ c.classList.remove('card-center'); }); card.classList.add('card-center'); });\n      card.addEventListener('mouseleave', function(){\n        setTimeout(function(){\n          var anyHover = Array.prototype.some.call(cards, function(c){ return c.matches(':hover'); });\n          if (!anyHover) { cards.forEach(function(c){ c.classList.remove('card-center'); }); initial.classList.add('card-center'); }\n        }, 300);\n      });\n    });\n  });\n})();\n</script>\n\n<!-- Iframe height helper -->\n<script>\n(function(){\n  function sendHeightToParent(){\n    try{\n      var height = document.documentElement.scrollHeight;\n      if (window.self !== window.top) { window.parent.postMessage({ type:'iframe-height', height:height }, '*'); }\n    } catch(e){}\n  }\n  window.addEventListener('load', sendHeightToParent);\n})();\n</script>\n\n<!-- Salesforce chat init function (used by lazy loader) -->\n<script>\nfunction initEmbeddedMessaging(){\n  try{\n    embeddedservice_bootstrap.settings.language = 'en_US';\n    embeddedservice_bootstrap.init(\n      '00DHp00000HEg1d',\n      'TruDiagnostic_Service_Agent_Messaging_for_Website',\n      'https://trudiagnostic.my.site.com/ESWTruDiagnosticService1738072767419',\n      { scrt2URL: 'https://trudiagnostic.my.salesforce-scrt.com' }\n    );\n  }catch(err){ console.error('Error loading Embedded Messaging:', err); }\n}\n</script>\n\n<!-- ===========================\n     LAZY LOAD NON-CRITICAL JS