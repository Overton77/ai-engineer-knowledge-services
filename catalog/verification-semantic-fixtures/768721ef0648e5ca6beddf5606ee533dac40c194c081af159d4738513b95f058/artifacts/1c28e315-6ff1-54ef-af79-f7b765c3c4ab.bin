uated the resulting measure, named DunedinPACE, in five additional datasets.","qualifiers":[],"riskClass":"medium"}],"bundleId":"c034272c-4eac-45fd-ab5c-bf1a58ead9c4","captures":[{"canonicalProjectionArtifact":{"artifactId":"cb9b6f63-800e-5079-afd1-f82fc2a43b06","byteLength":517145,"createdAt":"2026-09-05T04:58:13.496Z","dataClassification":"restricted","digest":"sha256:87eee3598cf29dab59e1a8c7b70cef756b69a652c0c2787656d3fa02913d2af6","encryptionClass":"supabase-managed","mediaType":"application/vnd.aiengineer.verification-projection.html_dom+json","objectKey":"fbfa12cf-0cef-423d-858e-f7a3e213fa80/87/87eee3598cf29dab59e1a8c7b70cef756b69a652c0c2787656d3fa02913d2af6","parentArtifactIds":[],"producerActivityId":"verification-parser-admission","producerVersion":"verification-admission.v1","retentionClass":"verification-audit","tenantId":"fbfa12cf-0cef-423d-858e-f7a3e213fa80"},"captureId":"60f7dd92-6f3f-5205-a08a-cea2d0770489","captureMethod":"firecrawl-cli@1.23.1; maxAge=0","captureMethodVersion":"20260905","capturedAt":"2026-09-05T01:58:38.560Z","contentArtifact":{"artifactId":"7743a3f2-8230-500e-afc7-98e984ac8fb0","byteLength":414567,"createdAt":"2026-09-05T04:57:52.663Z","dataClassification":"restricted","digest":"sha256:e85f225d3307a5c520105d5059cda3351c7ce8cfe6c18e42d0ca63975ad26a04","encryptionClass":"supabase-managed","mediaType":"text/html","objectKey":"fbfa12cf-0cef-423d-858e-f7a3e213fa80/e8/e85f225d3307a5c520105d5059cda3351c7ce8cfe6c18e42d0ca63975ad26a04","parentArtifactIds":["aac04e09-16a8-5266-a251-c9259407aeae"],"producerActivityId":"diagnostics-frozen-source-import","producerVersion":"1","retentionClass":"restricted-source","tenantId":"fbfa12cf-0cef-423d-858e-f7a3e213fa80","transformationSignature":"sha256:d232771b9eeaaaed16e8e7e8105982d7b526c75ed29c36dad724b75e398d5418"},"sourceId":"cc72bb8c-1795-5e02-a212-405ea6e829c9"}],"lineage":[],"metricObservations":[],"policyVersion":"diagnostics-v1-semantic-policy-18a74b72-068c-446c-9315-423b993c5689","producer":{