  <script>
    // Auto-select "Subscribe" in Seal's recurring-invoice widget
    document.addEventListener('sealsubs:subscription_widget_created', function () {
      document.querySelectorAll('.sealsubs-target-element').forEach(function (widget) {
        // Look for a radio/option whose text contains "Subscribe" / "Subscription".
        // Adjust the regex if you changed translations (e.g., "Subscribe & Save").
        const opt = Array.from(widget.querySelectorAll('label, .sls-option, .sls-option-container, .seal-option--subscription'))
          .find(el => /subscribe|subscription/i.test(el.textContent || ''));
        if (!opt) return;
        const input = opt.querySelector('input[type="radio"], input[type="checkbox"]');
        if (input && !input.checked) {
          input.click();
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    });
  </script>

