.sg-spa-slider-icon-wrap.sg-spa-left-icon { left: 0px; transform: translateY(-50%) rotate(180deg); }

.sg-spa-slider-icon-wrap.sg-spa-right-icon { right: 0px; }

.sg-spa-slider-icon-wrap { height: 40px; width: 40px; max-width: 100%; max-height: 100%; }

