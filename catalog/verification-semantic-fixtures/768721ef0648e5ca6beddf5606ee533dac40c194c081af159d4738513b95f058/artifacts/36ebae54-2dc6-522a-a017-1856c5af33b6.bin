#layout-01 .spice-spa-addon-product-item, #layout-02 .spice-spa-addon-product-item { display: flex; flex-direction: column; align-items: center; overflow: hidden; min-width: 115px; max-width: 250px; width: calc(33.33% - 8px); margin-left: 4px; margin-right: 4px; margin-bottom: 8px; padding: 8px; border-radius: 4px; position: relative; }

