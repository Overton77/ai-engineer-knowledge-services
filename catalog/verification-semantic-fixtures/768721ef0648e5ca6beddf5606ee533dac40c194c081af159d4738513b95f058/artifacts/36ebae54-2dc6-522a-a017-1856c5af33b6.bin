#layout-01 .spice-spa-addon-product-image { border-radius: 50%; border: 1px solid rgb(170, 170, 170); margin: 0px auto; position: relative; overflow: hidden; }

#layout-01 .spice-spa-addon-product-quick-view, #layout-02 .spice-spa-addon-product-quick-view { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%; }

