.spice-spa-addon-product-item button.spice-spa-addon_event_init { width: 100%; min-width: 30px; max-width: 45px; height: 35px; min-height: 35px; max-height: 35px; line-height: 35px; outline: 0px; background: none rgb(245, 245, 245); color: var(--sg-addon-text-color); border: 1px solid rgb(204, 204, 204); cursor: pointer; padding: 0px; box-shadow: none; }

