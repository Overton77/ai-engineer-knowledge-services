.product-block { color: black; }

.sls-purchase-options-label { }

.spice-spa-addon-layouts { display: none; }

.site-navigation .site-nav__link, .megamenu__link-label { font-size: 1rem; margin: 0px 1.5rem; color: rgb(0, 0, 0); font-weight: 600 !important; }

.site-navigation .site-nav__link:hover { color: rgb(85, 85, 85) !important; }

.megamenu__promo-link { color: rgb(0, 0, 0) !important; }</style><style rel="stylesheet" type="text/css">@charset "utf-8";

.jdgm-rev__icon::after { content: ""; }

.jdgm-rev__icon::after, .jdgm-rev__buyer-badge { display: inline-block; color: rgb(255, 255, 255); background-color: rgb(251, 205, 10); }

.jdgm-rev__buyer-badge::before { content: "Verified"; }

.jdgm-rev-widg__title { visibility: unset; }

.jdgm-rev-widg__summary-text { visibility: unset; }

.jdgm-prev-badge__text { visibility: unset; }

.jdgm-quest__body::before { content: "Question:"; }

.jdgm-ans__body::before { content: "Answer:"; }

.jdgm-star { color: rgb(255, 205, 0); }

.jdgm-ask-question-btn, .jdgm-write-rev-link, .jdgm-all-reviews-rating-wrapper, .jdgm-carousel-wrapper a, .jdgm-rev__prod-link, .jdgm-all-reviews-text a, .jdgm-carousel-item__product, .jdgm-carousel-number-of-reviews, .jdgm-revs-tab__url { color: currentcolor; }

a.jdgm-write-rev-link { color: currentcolor; background-color: rgb(255, 255, 255); }

