#sg-checkbox input[type="checkbox"]:checked + .sg-label-text::before { content: ""; color: rgb(96, 125, 139); animation: 250ms ease-in 0s 1 normal none running effect; font-size: 24px; }

#sg-checkbox input[type="checkbox"]:disabled + .sg-label-text { color: rgb(170, 170, 170); }

