hildren":[{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-10 lg:gap-6"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-4 text-center lg:text-left"},"children":[{"tag":"h3","hidden":false,"attributes":{"class":"nk-heading-5 text-nk-beige-500 lg:nk-heading-4"},"children":[{"tag":"#text","text":"The Signal Everyone Else Is Missing."}]},{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-6"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"#text","text":"Conventional epigenetic clocks rely on methylation levels and statistical models to predict age. But levels alone capture only the average signal, not how that signal is regulated or how it changes over time."}]},{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"#text","text":"Aging is reflected not just in the level itself, but in increasing variability in methylation patterns, a sign of declining regulatory control. A healthy 30-year-old and a 70-year-old in decline can show the same methylation level at a CpG site, yet one is stable while the other becomes increasingly disordered. The level is the same. The underlying biology is not."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"flex w-full flex-col gap-4 border-t border-[rgba(147,128,112,0.35)] pt-4"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-center text-nk-cold-brown-400 lg:nk-text-lg lg:text-left"},"children":[{"tag":"#text","text":"References"}]},{"tag":"ul","hidden":false,"attributes":{"class":"list-inside list-disc text-center lg:list-outside lg:pl-5 lg:text-left"},"children":[{"tag":"li","hidden":false,"attributes":{"class":"text-nk-cold-brown-500 marker:text-nk-cold-brown-500"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://www.aging-us.com/article/205046","target":"_blank","rel":"noopener noreferrer","class":"nk-text-md font-medium leading-[1] text-nk-cold-brown-400 underline lg:nk-text-base lg:font-normal lg:leading-[1]"},"children":[{"tag":"#text","text":"Conboy et al., Aging, 2023 — Fail-tests of DNA methylation clocks and development of a noise barometer"}]}]},{"tag":"li","hidden":false,"attributes":{"class":"text-nk-cold-brown-500 marker:text-nk-cold-brown-500"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://www.nature.com/articles/s43587-024-00600-8","target":"_blank","rel":"noopener noreferrer","class":"nk-text-md font-medium leading-[1] text-nk-cold-brown-400 underline lg:nk-text-base lg:font-normal lg:leading-[1]"},"children":[{"tag":"#text","text":"Tong et al., Nature Aging, 2024 — Quantifying the stochastic component of epigenetic aging"}]}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-4 text-center lg:text-left"},"children":[{"tag":"h3","hidden":false,"attributes":{"class":"nk-heading-5 text-nk-beige-500 lg:nk-heading-4"},"children":[{"tag":"#text","text":"Conventional Clocks Estimate."},{"tag":"br","hidden":false},{"tag":"#text","text":"The SystemAge™ Test Measures."}]},{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-6"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"#text","text":"In a healthy body, the epigenetic machinery holds critical gene-regulatory sites within a narrow band: tight, stable, accurate. As biological aging progresses, that control breaks down."}]},{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"#text","text":"Methylation doesn't shift in one direction. It scatters. Variability increases. Regulatory precision declines. The body loses its grip on itself."}]},{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"#text","text":"This is BioNoise™: the measurable loss of epigenetic regulatory control, pioneered by Generation Lab CSO Dr. Irina Conboy and her laboratory with over 20 years of aging research."}]},{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"#text","text":"Where machine learning models assign arbitrary statistical weights to individual CpG sites, the SystemAge™ Test is built on curated biology, measuring the total variability across all 460 expert-selected biomarkers. A direct measurement of how well your biology is holding together."}]}]}]}]}]}]}]},{"tag":"section","hidden":false,"id":"biomarker-selection","attributes":{"aria-labelledby":"meaningful-biomarker-curation-heading","class":"w-full overflow-hidden bg-nk-warm-brown-700 py-[60px] lg:py-20"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"mx-auto flex w-full max-w-[1440px] flex-col items-center"},"children":[{"tag":"h2","hidden":false,"id":"meaningful-biomarker-curation-heading","attributes":{"class":"scroll-mt-24 px-4 text-center font-normal text-nk-beige-300 lg:scroll-mt-28 text-[30px] -tracking-[0.6px] lg:text-[44px] lg:-tracking-[0.88px]","style":"font-feature-settings:'salt' 1"},"children":[{"tag":"#text","text":"Not All Biomarkers Are Created Equal"}]},{"tag":"div","hidden":false,"attributes":{"class":"relative mt-8 h-[660px] w-[calc(100%-32px)] overflow-hidden rounded-[28px] min-[360px]:h-[740px] lg:mx-10 md:mt-[60px] lg:h-[640px] lg:w-[calc(100%-80px)] lg:max-w-[1360px] lg:rounded-[32px]"},"children":[{"tag":"img","hidden":false,"attributes":{"alt":"Microscope imagery behind epigenetic biomarker selection panels","loading":"lazy","decoding":"async","data-nimg":"fill","class":"object-cover","style":"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent","src":"https://www.generationlab.com/_next/image?url=%2Fscience%2Fbiomarker-curation-bg.jpg&w=3840&q=75","width":"1920","height":"99985"}},{"tag":"div","hidden":false,"attributes":{"class":"absolute