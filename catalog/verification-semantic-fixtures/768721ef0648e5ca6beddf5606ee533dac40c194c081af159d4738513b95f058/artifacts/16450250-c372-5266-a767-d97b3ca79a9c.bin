md:text-lg lg:text-[10px] xl:text-base","style":"width: clamp(72px, 8vw, 100px);"},"children":[{"tag":"#text","text":"PARK2"}]}]}]}]}]}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"pointer-events-none absolute left-1/2 top-[330px] z-20 flex h-8 w-8 -translate-x-1/2 items-center justify-center text-white min-[360px]:top-[334px] lg:top-1/2 lg:h-5 lg:w-[42px] lg:-translate-y-1/2"}}]},{"tag":"div","hidden":false,"attributes":{"class":"mt-[60px] flex w-full max-w-[680px] flex-col gap-[60px] px-4 md:px-8 lg:max-w-none lg:px-20"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"grid grid-cols-1 gap-[60px] lg:grid-cols-2 lg:gap-[60px] xl:gap-[120px]"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-10 lg:gap-6"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-[60px] lg:gap-6"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-4 text-center lg:text-left"},"children":[{"tag":"h3","hidden":false,"attributes":{"class":"nk-heading-5 text-nk-beige-500 lg:nk-heading-4"},"children":[{"tag":"#text","text":"460 Biomarkers. Each One Earned Its Place."}]},{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-6 nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The SystemAge™ Test analyzes 460 epigenetic biomarkers mapped across 21 body systems, selected not just for scale, but for biological relevance. Each biomarker was chosen to reflect meaningful changes in how aging unfolds across systems."}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-4 text-center lg:text-left"},"children":[{"tag":"h3","hidden":false,"attributes":{"class":"nk-heading-5 text-nk-beige-500 lg:nk-heading-4"},"children":[{"tag":"#text","text":"Most Tests Optimize for Prediction, Not Biology"}]},{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-6 nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Conventional epigenetic clocks rely on Elastic Net regression, selecting CpG sites based on how well they predict chronological age in a dataset. This approach prioritizes statistical fit, not biological significance."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"A 2025 study in GeroScience by Dr. Irina Conboy's lab demonstrated that Elastic Net regression systematically excludes biologically relevant CpG sites, including those critical to distinguishing healthy aging from accelerated decline. Because this method can remove overly correlated variables, meaningful signals can be downplayed, hiding the full picture of aging biology. Generation Lab's approach embraces that connection, because the goal is measurement, not model construction."}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"flex w-full flex-col gap-4 border-t border-[rgba(147,128,112,0.35)] pt-4"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-center text-nk-cold-brown-400 lg:nk-text-lg lg:text-left"},"children":[{"tag":"#text","text":"References"}]},{"tag":"ul","hidden":false,"attributes":{"class":"list-inside list-disc text-center lg:list-outside lg:pl-5 lg:text-left"},"children":[{"tag":"li","hidden":false,"attributes":{"class":"text-nk-cold-brown-500 marker:text-nk-cold-brown-500"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://link.springer.com/article/10.1007/s11357-024-01460-1","target":"_blank","rel":"noopener noreferrer","class":"nk-text-md font-medium leading-[1] text-nk-cold-brown-400 underline lg:nk-text-base lg:font-normal lg:leading-[1]"},"children":[{"tag":"#text","text":"Skinner, Conboy & Conboy, GeroScience, 2025 — DNA methylation clocks struggle to distinguish inflammaging from healthy aging"}]}]},{"tag":"li","hidden":false,"attributes":{"class":"text-nk-cold-brown-500 marker:text-nk-cold-brown-500"},"children":[{"tag":"a","hidden":false,"attributes":{"href":"https://www.aging-us.com/article/205046","target":"_blank","rel":"noopener noreferrer","class":"nk-text-md font-medium leading-[1] text-nk-cold-brown-400 underline lg:nk-text-base lg:font-normal lg:leading-[1]"},"children":[{"tag":"#text","text":"Conboy et al., Aging, 2023 — Fail-tests of DNA methylation clocks"}]}]}]}]},{"tag":"a","hidden":false,"attributes":{"class":"rounded-full py-2 px-6 text-sm font-medium text-white cursor-pointer backdrop-blur-lg relative z-10 primary-button border border-white/20 transition-all duration-200 box-border flex justify-center items-center h-[58px] w-full lg:hidden","href":"https://www.generationlab.com/biomarkers"},"children":[{"tag":"#text","text":"View our biomarkers →"}]}]},{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-6 text-center lg:text-left"},"children":[{"tag":"h3","hidden":false,"attributes":{"class":"nk-heading-5 text-nk-beige-500 lg:nk-heading-4"},"children":[{"tag":"#text","text":"The Algorithm That Understands Biological Aging"}]},{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-6 lg:hidden"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"#text","text":"The SystemAge™ Test starts with biology and validates with statistics. Each of the 460 biomarkers met three rigorous selection criteria:"}]},{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-3"},"children":[{"tag":"div","hidden":false,"children":[{"tag":"button","hidden":false,"attributes":{"type":"button","aria-expanded":"false","aria-controls":"biomarker-criterion-mobile-0","class":"w-full cursor-pointer border-b border-[rgba(147,128,112,0.35)] text-nk-beige-500 grid grid-cols-[20px_1fr_20px] items-center py-3"},"children":[{"tag":"span","hidden":true},{"tag":"span","hidden":false,"attributes":{"class":"font-bold text-center text-base tracking-[0.32px]"},"children":[{"tag":"#text","text":"Average Methylation Resilience"}]},{"tag":"span","hidden":true}]}]},{"tag":"div","hidden":false,"children":[{"tag":"button","hidden":false,"attributes":{"type":"button","aria-expanded":"false","aria-controls":"biomarker-criterion-mobile-1","class":"w-full cursor-pointer border-b border-[rgba(147,128,112,0.35)] text-nk-beige-500 grid grid-cols-[20px_1fr_20px] items-center py-3"},"children":[{"tag":"span","hidden":true},{"tag":"span","hidden":false,"attributes":{"class":"font-bold text-center text-base tracking-[0.32px]"},"children":[{"tag":"#text","text":"Cross-Dataset Consistency"}]},{"tag":"span","hidden":true}]}]},{"tag":"div","hidden":false,"children":[{"tag":"button","hidden":false,"attributes":{"type":"button","aria-expanded":"false","aria-controls":"biomarker-criterion-mobile-2","class":"w-full cursor-pointer border-b border-[rgba(147,128,112,0.35)] text-nk-beige-500 grid grid-cols-[20px_1fr_20px] items-center py-3"},"children":[{"tag":"span","hidden":true},{"tag":"span","hidden":false,"attributes":{"class":"font-bold text-center text-base tracking-[0.32px]"},"children":[{"tag":"#text","text":"Age-Related Variability"}]},{"tag":"span","hidden":true}]}]}]},{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"#text","text":"Every biomarker earned its place through both biological relevance and statistical rigor, not convenience."}]}]},{"tag":"div","hidden":false,"attributes":{"class":"hidden flex-col gap-8 lg:flex"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"nk-text-base text-nk-cold-brown-400"},"children":[{"tag":"#text","text":"The SystemAge™ Test starts with biology and validates with statistics. Each of the 460 biomarkers met three rigorous selection criteria:"}]},{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col gap-4"},"children":[{"tag":"div","hidden":false,"children":[{"tag":"button","hidden":false,"attributes":{"type":"button","aria-expanded":"true","aria-controls":"biomarke