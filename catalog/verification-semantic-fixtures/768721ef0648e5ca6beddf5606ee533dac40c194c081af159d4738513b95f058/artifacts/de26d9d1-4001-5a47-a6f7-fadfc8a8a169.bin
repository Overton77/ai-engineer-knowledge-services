{"assertionId":"d71f325a-c625-4e94-a9aa-df8eabc55a28","entityBindings":[],"fragments":[{"exactText":"Generation Lab does not practice medicine or provide medical advice. Nothing on the Platform — including the Report, any recommendations, provider matching, or communications — constitutes medical care, diagnosis, or treatment.","fragmentId":"sha256:be7d8deb0c9a8a640843d3addbd0c241cdf2f7beec1d3d8fad7b24a2445cd6ff"}],"proposition":"The platform's report constitutes medical diagnosis and treatment.","qualifiers":[],"rubricVersion":"evidence-only.v1"}