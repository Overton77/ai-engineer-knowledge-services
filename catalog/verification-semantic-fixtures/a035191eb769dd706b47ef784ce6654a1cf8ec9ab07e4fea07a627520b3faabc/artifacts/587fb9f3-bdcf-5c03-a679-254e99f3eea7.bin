ap-[120px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-4 text-center lg:text-left\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"nk-heading-5 text-nk-beige-500 lg:nk-heading-4\",\"children\":\"Aging Doesn’t Accelerate Gradually - It Surges.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6\",\"children\":[[\"$\",\"p\",\"Biological aging accelerates in non-linear waves, with critical acceleration points where molecular disregulation surges across multiple pathways.\",{\"className\":\"nk-text-base text-nk-cold-brown-400\",\"children\":\"Biological aging accelerates in non-linear waves, with critical acceleration points where molecular disregulation surges across multiple pathways.\"}],[\"$\",\"p\",\"Using BioNoise™ measurement, Dr. Conboy’s lab identified this pattern as the Aging Entropy Curve™, a model describing how epigenetic regulatory control degrades in accelerating phases rather than gradually.\",{\"className\":\"nk-text-base text-nk-cold-brown-400\",\"children\":\"Using BioNoise™ measurement, Dr. Conboy’s lab identified this pattern as the Aging Entropy Curve™, a model describing how epigenetic regulatory control degrades in accelerating phases rather than gradually.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-4 text-center lg:text-left\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"nk-heading-5 text-nk-beige-500 lg:nk-heading-4\",\"children\":\"Your Position On The Curve Matters\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6\",\"children\":[[\"$\",\"p\",\"The SystemAge™ Test maps each of your 21 systems against the Aging Entropy Curve™, showing where you are today and how close each system is to an acceleration point (the inflection point where decline compounds).\",{\"className\":\"nk-text-base text-nk-cold-brown-400\",\"children\":\"The SystemAge™ Test maps each of your 21 systems against the Aging Entropy Curve™, showing where you are today and how close each system is to an acceleration point (the inflection point where decline compounds).\"}],[\"$\",\"p\",\"This context provides earlier visibility into where aging-related biological change is likely to accelerate, enabling more proactive, system-specific intervention.\",{\"className\":\"nk-text-base text-nk-cold-brown-400\",\"children\":\"This context provides earlier visibility into where aging-related biological change is likely to accelerate, enabling more proactive, system-specific intervention.\"}]]}]]}]]}],\"$L26\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"14:[\"$\",\"section\",null,{\"id\":\"bionoise-measurement\",\"aria-labelledby\":\"bionoise-measurement-heading\",\"className\":\"w-full overflow-hidden bg-nk-warm-brown-700 py-[60px] lg:py-20\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto flex w-full max-w-[1440px] flex-col items-center\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"bionoise-measurement-heading\",\"className\":\"scroll-mt-24 px-4 text-center font-normal text-nk-beige-500 lg:scroll-mt-28 text-[28px] -tracking-[0.6px] min-[360px]:text-[30px] lg:text-[44px] lg:-tracking-[0.88px]\",\"style\":{\"fontFeatureSettings\":\"'salt' 1\"},\"children\":\"BioNoise™: A Novel Way to Measure Aging\"}],[\"$\",\"div\",null,{\"className\":\"relative mt-8 aspect-[361/413] w-[calc(100%-32px)] overflow-hidden rounded-[24px] lg:mx-10 md:mt-[60px] lg:aspect-[1360/580] lg:h-auto lg:w-[calc(100%-80px)] lg:max-w-[1360px] lg:rounded-[32px] lg:shadow-[0px_-8px_40px_1px_rgba(251,246,238,0.18)]\",\"children\":[[\"$\",\"$L7\",null,{\"src\":\"/science/bionoise-measurement-mobile.webp\",\"alt\":\"Microscope examining a sample slide for epigenetic analysis\",\"fill\":true,\"sizes\":\"(min-width: 1024px) 1360px, calc(100vw - 32px)\",\"className\":\"object-cover object-center lg:object-[50%_30%]\"}],[\"$\",\"div\",null,{\"className\":\"absolute inset-x-4 bottom-4 aspect-[329/206] overflow-hidden md:hidden\",\"children\":[\"$\",\"$L27\",null,{\"variant\":\"mobile\"}]}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-6 right-[clamp(24px,6.47vw,88px)] hidden aspect-[574/360] w-[clamp(420px,42.2vw,574px)] overflow-hidden md:block\",\"children\":[\"$\",\"$L27\",null,{\"variant\":\"desktop\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-[60px] flex w-full max-w-[680px] flex-col gap-[60px] px-4 md:px-8 lg:max-w-none lg:px-20\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 gap-[60px] lg:grid-cols-2 lg:gap-[60px] xl:gap-[120px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-10 lg:gap-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-4 text-center lg:text-left\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"nk-heading-5 text-nk-beige-500 lg:nk-heading-4\",\"children\":\"The Signal Everyone Else Is Missing.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6\",\"children\":[[\"$\",\"p\",\"Conventional epigenetic clocks rely on methylation levels and statistical models to predict age. But levels alone capture only the average signal, not how that signal is regulated or how it changes over time.\",{\"className\":\"nk-text-base text-nk-cold-brown-400\",\"children\":\"Conventional epigenetic clocks rely on methylation levels and statistical models to predict age. But levels alone capture only the average signal, not how that signal is regulated or how it changes over time.\"}],[\"$\",\"p\",\"Aging is reflected not just in the level itself, but in increasing variability in methylation patterns, a sign of declining regulatory control. A healthy 30-year-old and a 70-year-old in decline can show the same methylation level at a CpG site, yet one is stable while the other becomes increasingly disordered. The level is the same. The underlying biology is not.\",{\"className\":\"nk-text-base text-nk-cold-brown-400\",\"children\":\"Aging is reflected not just in the level itself, but in increasing variability in methylation patterns, a sign of declining regulatory control. A healthy 30-year-old and a 70-year-old in decline can show the same methylation level at a CpG site, yet one is stable while the other becomes increasingly disordered. The level is the same. The underlying biology is not.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"flex w-full flex-col gap-4 border-t border-[rgba(147,128,112,0.35)] pt-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"nk-text-base text-center text-nk-cold-brown-400 lg:nk-text-lg lg:text-left\",\"children\":\"References\"}],\"$L28\"]}]]}],\"$L29\"]}]}]]}]}]\n"])</script><script>self.__next_f.push([1,"15:[\"$\",\"section\",null,{\"id\":\"biomarker-selection\",\"aria-labelledby\":\"meaningful-biomarker-curation-heading\",\"className\":\"w-full overflow-hidden bg-nk-warm-brown-700 py-[60px] lg:py-20\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto flex w-full max-w-[1440px] flex-col items-center\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"meaningful-biomarker-curation-heading\",\"className\":\"scroll-mt-24 px-4 text-center font-normal text-nk-beige-300 lg:scroll-mt-28 text-[30px] -tracking-[0.6px] lg:text-[44px] lg:-tracking-[0.88px]\",\"style\":{\"fontFeatureSettings\":\"'salt' 1\"},\"children\":\"Not All Biomarkers Are Created Equal\"}],[\"$\",\"div\",null,{\"className\":\"relative mt-8 h-[660px] w-[calc(100%-32px)] overflow-hidden rounded-[28px] min-[360px]:h-[740px] lg:mx-10 md:mt-[60px] lg:h-[640px] lg:w-[calc(100%-80px)] lg:max-w-[1360px] lg:rounded-[32px]\",\"children\":[[\"$\",\"$L7\",null,{\"src\":\"/science/biomarker-curation-bg.jpg\",\"alt\":\"Microscope imagery behind epigenetic biomarker selection panels\",\"fill\":true,\"sizes\":\"(min-width: 1024px) 1360px, 100vw\",\"className\":\"object-cover\"}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-[#ba8f52] mix-blend-multiply\"}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-black/10\"}],[\"$\",\"div\",null,{\"className\":\"absolute inset-x-4 bottom-6 top-6 flex flex-col gap-6 min-[360px]:gap-8 lg:inset-y