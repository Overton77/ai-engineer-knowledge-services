        @keyframes pa-fa-pillBlue { 0%, 100% { transform: translate(0px, 0px); } 50%      { transform: translate(0px, -22px); } } @keyframes pa-fa-capsule { 0%, 100% { transform: translate(0px, 0px); } 50%      { transform: translate(0px, -22px); } } @keyframes pa-fa-pillPink { 0%, 100% { transform: translate(0px, 0px); } 50%      { transform: translate(0px, -20px); } } @keyframes pa-fa-yoga { 0%, 100% { transform: translate(0px, 0px); } 50%      { transform: translate(0px, -18px); } } @keyframes pa-fa-meditation { 0%, 100% { transform: translate(0px, 0px); } 50%      { transform: translate(0px, -16px); } }
        .pa-fa-bubble { will-change: transform; animation-fill-mode: both; }
        .pa-fa-pillBlue   { animation: pa-fa-pillBlue   5.5s ease-in-out 0s infinite; }
        .pa-fa-capsule    { animation: pa-fa-capsule    6s ease-in-out 1.2s infinite; }
        .pa-fa-pillPink   { animation: pa-fa-pillPink   6.5s ease-in-out 2.4s infinite; }
        .pa-fa-yoga       { animation: pa-fa-yoga       7s ease-in-out 0.6s infinite; }
