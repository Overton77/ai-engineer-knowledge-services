t-[40px] xl:mt-[27px] max-w-[1440px] px-4 xl:px-10 mx-auto absolute left-1/2 -translate-x-1/2 flex justify-end inspirational-video-banner" style="opacity: 1; pointer-events: auto;"><div class="w-full h-full flex flex-col lg:flex-row items-center justify-between py-3 px-3 lg:px-6 rounded-2xl lg:rounded-3xl gap-3 lg:gap-0" style="background: radial-gradient(113.73% 113.73% at 100% 50%, rgba(255, 222, 208, 0.8) 0%, rgba(252, 206, 186, 0.8) 22.17%, rgba(249, 249, 249, 0.8) 100%); backdrop-filter: blur(15px);"><p class="nk-text-md xl:nk-text-base text-nk-warm-brown-500 flex-1 pr-4">Introducing sex-specific results — trends and recommendations calibrated to your biology</p><div class="flex items-baseline lg:items-center justify-end gap-6 w-full lg:w-auto"><a class="nk-text-md lg:nk-text-base text-nk-warm-brown-500 hover:opacity-80 active:opacity-50 lg:text-[#4F4034] underline !font-bold lg:!font-normal whitespace-nowrap" href="https://www.generationlab.com/the-systemage-test#gl_get-sample-report">View Sample Report</a><button type="button" class="hover:opacity-60 active:opacity-50" aria-label="Dismiss banner"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" class="w-5 h-5 text-nk-warm-brown-500 cursor-pointer hidden lg:block"><path d="M18.75 5.25L5.25 18.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M18.75 18.75L5.25 5.25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="nk-text-md text-nk-warm-brown-500 underline lg:hidden">Dismiss</span></button></div></div></div></header><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://www.generationlab.com/#organization","name":"Generation Lab","alternateName":"GenLab","url":"https://www.generationlab.com","foundingDate":"2020","email":"support@generationlab.com","address":{"@type":"PostalAddress","streetAddress":"1701 Old Bayshore Highway","addressLocality":"Burlingame","addressRegion":"CA","postalCode":"94010","addressCountry":"US"},"sameAs":["https://www.facebook.com/generationlab.longevity.health","https://x.com/GenerationLab_","https://www.linkedin.com/company/generation-lab-longevity","https://www.instagram.com/generation_lab"],"logo":{"@type":"ImageObject","@id":"https://www.generationlab.com/#logo","url":"https://www.generationlab.com/assets/logo-tm.svg","width":200,"height":60,"caption":"Generation Lab"}},{"@type":"WebSite","@id":"https://www.generationlab.com/#website","url":"https://www.generationlab.com","name":"Generation Lab","publisher":{"@id":"https://www.generationlab.com/#organization"},"inLanguage":"en-US"},{"@type":"WebPage","@id":"https://www.generationlab.com/science","url":"https://www.generationlab.com/science","name":"The Science of Aging: Epigenetic Tests Explained","description":"Learn how biological age tests work, from DNA methylation, genetics to bionoise. Explore clinically relevant ways & evidence to reverse age & extend lifespan","publisher":{"@id":"https://www.generationlab.com/#organization"},"breadcrumb":{"@id":"https://www.generationlab.com/science#breadcrumb"},"mainEntity":{"@type":"AboutPage","description":"Learn how biological age tests work, from DNA methylation, genetics to bionoise. Explore clinically relevant ways & evidence to reverse age & extend lifespan"},"isPartOf":{"@id":"https://www.generationlab.com/#website"},"inLanguage":"en-US","primaryImageOfPage":{"@type":"ImageObject","url":"https://www.generationlab.com/og/science.webp","width":1200,"height":630}},{"@type":"BreadcrumbList","@id":"https://www.generationlab.com/science#breadcrumb","name":"Breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.generationlab.com"},{"@type":"ListItem","position":2,"name":"Science"}]}]}</script><section class="w-full top-0 h-svh flex flex-col justify-end sticky"><img alt="Hero Background" loading="eager" decoding="async" data-nimg="fill" class="object-cover w-full h-full absolute inset-0 hidden lg:block" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://www.generationlab.com/_next/image?url=%2Fscience%2Fhero-bg.webp&amp;w=3840&amp;q=75"><img alt="Hero Background" loading="eager" decoding="async" data-nimg="fill" class="object-cover w-full h-full absolute inset-0 block lg:hidden" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://www.generationlab.com/_next/image?url=%2Fscience%2Fhero-bg-mobile.webp&amp;w=3840&amp;q=75"><div class="w-full px-4 grid grid-cols-1 gap-6 pb-6 lg:grid-cols-12 lg:px-10 lg:gap-10 lg:pb-[60px] xl:max-w-[1440px] xl:mx-auto relative"><div class="flex flex-col gap-3 text-nk-white-500 items-start flex-1 md:gap-4 lg:col-span-5 lg:col-start-1 lg:col-end-7 xl:gap-6"><h1 class="nk-heading-3 md:nk-heading-1 lg:nk-heading-2 xl:nk-heading-1">The Cutting-Edge Science Behind SystemAge™</h1><p class="nk-text-md md:nk-text-base max-w-[440px]">SystemAge uses 20 years of research by Dr. Irina Conboy to measure aging at organ-level precision with AI powered Epigenetics.</p><div class="flex items-center w-full gap-1 lg:gap-2 xl:mt-6 md:max-w-[500px]"><a class="rounded-full cursor-pointer backdrop-blur-lg relative z-10 primary-button border border-white/20 transition-all duration-200 box-border h-[54px] flex-1 py-2 px-6 flex justify-center items-center text-sm font-medium text-nk-white-500" href="https://www.generationlab.com/the-systemage-test"><span class="md:hidden">Test Now →</span><span class="hidden md:flex">Test Your Biological Age Now →</span></a><a class="rounded-full py-2 font-medium text-sm flex justify-center items-center cursor-pointer box-border backdrop-blur-lg outline-button h-[58px] px-[30px]" href="https://www.generationlab.com/published-research">Research Papers →</a></div></div><div class="relative w-full overflow-hidden rounded-2xl border border-white/40 bg-nk-gray-500 md:backdrop-blur-[15px] aspect-[864/640] md:aspect-[1360/600] lg:aspect-[1360/850] lg:col-span-6 lg:col-start-7 lg:col-end-13"><div class="block h-full w-full md:hidden lg:block" role="img" aria-label="Animated Aging Entropy Curve chart comparing nonlinear BioNoise changes with traditional linear biological age clocks."></div><div class="hidden h-full w-full md:block lg:hidden" role="img" aria-label="Animated Aging Entropy Curve chart comparing nonlinear BioNoise changes with traditional linear biological age clocks."></div></div></div></section><main class="science-main relative z-10 bg-nk-warm-brown-700"><section class="w-full bg-nk-warm-brown-700"><div class=" mx-auto flex w-full max-w-[1200px] flex-col px-4 lg:px-0 text-center gap-[60px] py-[60px] lg:gap-[60px] lg:py-20 "><div class="flex gap-4 flex-col"><h2 class="nk-heading-3 text-nk-white-500 md:nk-heading-2 lg:nk-heading-1">The Gold Standard in Biological Age Testing</h2><p class="nk-text-base md:nk-text-lg mx-auto text-nk-cold-brown-400">SystemAge™ explicitly measures the patterns of aging in your DNA through changes in methylation—subtle signals that reflect how your biology evolves over time. By quantifying deviation from a healthy baseline, it delivers a more direct, data-driven measure of your biological age.</p></div><div class="hidden w-full justify-center lg:flex"><div class="relative h-[316px] w-[859px]"><img alt="Illustration of the testing process, showing a stylized DNA strand being analyzed and transformed into actionable insights, with a focus on the methylation patterns that reflect biological age." loading="lazy" width="859" height="316" decoding="async" data-nimg="1" class="h-full w-full" style="color:transparent" src="https://www.generationlab.com/assets/svg/science/testing-process-desktop.svg"><div class="pointer-events-none absolute" style="left:721px;top:205px;width:85px;height:40px" aria-hidden="true"><div class="h-full w-full" role="img" aria-label="Inconsistent and noisy methylation pattern animation"></div></div></div></div><div class="flex w-full justify-center lg:hidden"><div class="relative h-[643px] w-[254px]"><img alt="Illustration of the testing process, showing a stylized DNA strand being analyzed and transformed into actionable insights, with a focus on the methylation patterns that reflect biological age." loading="lazy" width="254" height="643" decoding="async" data-nimg="1" class="h-full w-full" style="color:transparent" src="https://www.generationlab.com/assets/svg/science/testing-process-mobile.svg"><div class="pointer-events-none absolute" style="left:156px;top:590.4px;width:85px;height:40px" aria-hidden="true"><div class="h-full w-full" role="img" aria-label="Inconsistent and noisy methylation pattern animation"></div></div></div></div></div></section><div><div class="relative w-full bg-[#624730] py-[40px] md:py-[60px] rounded-t-[32px] md:rounded-t-[80px] z-30"><nav aria-label="Science section navigation" class="transition-[top] duration-300 ease-out relative"><div class="scrollbar-hide overflow-x-auto px-4 md:px-8 lg:px-10"><div class="mx-0 flex w-max items-center gap-8 rounded-[99px] border border-white/30 md:backdrop-blur-[15px] bg-[rgba(157,157,157,0.2)] py-3 pl-4 pr-8 md:mx-auto md:rounded-[100px] md:bg-[rgba(88,55,32,0.7)] md:justify-center md:px-6 md:py-4"><button type="button" aria-pressed="true" class="flex h-[35px] shrink-0 appearance-none items-center justify-center whitespace-nowrap rounded-[60px] border-0 px-4 nk-heading-7 transition-colors md:h-11 md:rounded-[56px] md:px-6 bg-white/85 text-[#303030]/60">NONLINEAR AGING</button><button type="button" aria-pressed="false" class="flex h-[35px] shrink-0 appearance-none items-center justify-center whitespace-nowrap rounded-[60px] border-0 px-4 nk-heading-7 transition-colors md:h-11 md:rounded-[56px] md:px-6 bg-transparent text-nk-beige-300">BIONOISE MEASUREMENT</button><button type="button" aria-pressed="false" class="flex h-[35px] shrink-0 appearance-none items-center justify-center whitespace-nowrap rounded-[60px] border-0 px-4 nk-heading-7 transition-colors md:h-11 md:rounded-[56px] md:px-6 bg-transparent text-nk-beige-300">BIOMARKER SELECTION</button><button type="button" aria-pressed="false" class="flex h-[35px] shrink-0 appearance-none items-center justify-center whitespace-nowrap rounded-[60px] border-0 px-4 nk-heading-7 transition-colors md:h-11 md:rounded-[56px] md:px-6 bg-transparent text-nk-beige-300">21 SYSTEMS, 1 BODY</button><button type="button" aria-pressed="false" class="flex h-[35px] shrink-0 appearance-none items-center justify-center whitespace-nowrap rounded-[60px] border-0 px-4 nk-heading-7 transition-colors md:h-11 md:rounded-[56px] md:px-6 bg-transparent text-nk-beige-300">EFFICACY MEASUREMENT</button><button type="button" aria-pressed="false" class="flex h-[35px] shrink-0 appearance-none items-center justify-center whitespace-nowrap rounded-[60px] border-0 px-4 nk-heading-7 transition-colors md:h-11 md:rounded-[56px] md:px-6 bg-transparent text-nk-beige-300">PERSONALIZATION</button></div></div></nav></div></div><section id="non-linear-aging" aria-labelledby="aging-not-linear-heading" class="relative overflow-hidden bg-nk-warm-brown-700"><div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,#624730_0%,rgba(36,20,0,0.60)_26%,#241400_48%,#241400_100%)] lg:bg-[linear-gradient(180deg,#624730_0%,rgba(36,20,0,0.60)_34%,#241400_58%,#241400_100%)]"></div><div class="relative mx-auto flex w-full max-w-[1440px] flex-col items-center gap-[60px] py-[60px] lg:gap-[60px] lg:py-20"><div class="flex w-full flex-col items-center gap-8 lg:gap-[60px]"><h2 id="aging-not-linear-heading" class="nk-heading-3 px-4 text-center text-nk-beige-500 lg:nk-heading-2"><span class="block">Aging Is Not Linear:</span><span class="block">Introducing Aging Entropy Curve™</span></h2><div class="relative w-[calc(100%-32px)] overflow-hidden rounded-[32px] aspect-[361/252] bg-nk-warm-brown-500 shadow-[0px_0px_40px_2px_#351A07] md:w-[calc(100%-64px)] lg:w-[calc(100%-80px)] lg:max-w-[1360px] lg:aspect-[1360/580]"><div class="h-full w-full lg:hidden" role="img" aria-label="Animated Aging Entropy Curve chart comparing nonlinear BioNoise changes with traditional linear biological age clocks."></div><div class="hidden h-full w-full lg:block" role="img" aria-label="Animated Aging Entropy Curve chart comparing nonlinear BioNoise changes with traditional linear biological age clocks."></div></div></div><div class="flex w-full max-w-[680px] flex-col gap-10 px-4 md:gap-[60px] md:px-8 lg:max-w-none lg:px-20"><div class="grid grid-cols-1 gap-[60px] lg:grid-cols-2 lg:gap-[60px] xl:gap-[120px]"><div class="flex flex-col gap-4 text-center lg:text-left"><h3 class="nk-heading-5 text-nk-beige-500 lg:nk-heading-4">Aging Doesn’t Accelerate Gradually - It Surges.</h3><div class="flex flex-col gap-6"><p class="nk-text-base text-nk-cold-brown-400">Biological aging accelerates in non-linear waves, with critical acceleration points where molecular disregulation surges across multiple pathways.</p><p class="nk-text-base text-nk-cold-brown-400">Using BioNoise™ measurement, Dr. Conboy’s lab identified this pattern as the Aging Entropy Curve™, a model describing how epigenetic regulatory control degrades in accelerating phases rather than gradually.</p></div></div><div class="flex flex-col gap-4 text-center lg:text-left"><h3 class="nk-heading-5 text-nk-beige-500 lg:nk-heading-4">Your Position On The Curve Matters</h3><div class="flex flex-col gap-6"><p class="nk-text-base text-nk-cold-brown-400">The SystemAge™ Test maps each of your 21 systems against the Aging Entropy Curve™, showing where you are today and how close each system is to an acceleration point (the inflection point where decline compounds).</p><p class="nk-text-base text-nk-cold-brown-400">This context provides earlier visibility into where aging-related biological change is likely to accelerate, enabling more proactive, system-specific intervention.</p></div></div></div><div class="flex w-full flex-col gap-4 border-t border-[rgba(147,128,112,0.35)] pt-4"><p class="nk-text-base text-center text-nk-cold-brown-400 lg:text-left lg:nk-text-lg">References</p><ul class="list-inside list-disc text-center lg:list-outside lg:pl-5 lg:text-left"><li class="text-nk-cold-brown-500 marker:text-nk-cold-brown-500"><a href="https://www.nature.com/articles/s43587-024-00692-2" target="_blank" rel="noopener noreferrer" class="nk-text-md font-medium leading-[1] text-nk-cold-brown-400 underline lg:nk-text-base lg:font-normal lg:leading-[1]">Nonlinear dynamics of multi-omics profiles during human aging, Nature Aging, 2024</a></li><li class="text-nk-cold-brown-500 marker:text-nk-cold-brown-500"><a href="https://med.stanford.edu/news/all-news/2024/08/massive-biomolecular-shifts-occur-in-our-40s-and-60s--stanford-m.html" target="_blank" rel="noopener noreferrer" class="nk-text-md font-medium leading-[1] text-nk-cold-brown-400 underline lg:nk-text-base lg:font-normal lg:leading-[1]">Stanford Medicine: Massive biomolecular shifts in our 40s and 60s</a></li><li class="text-nk-cold-brown-500 marker:text-nk-cold-brown-500"><a href="https://link.springer.com/article/10.1007/s11357-024-01460-1" target="_blank" rel="noopener noreferrer" class="nk-text-md font-medium leading-[1] text-nk-cold-brown-400 underline lg:nk-text-base lg:font-normal lg:leading-[1]">Skinner, Conboy &amp; Conboy, GeroScience, 2025 — DNA methylation clocks struggle to distinguish inflammaging from healthy aging</a></li></ul></div></div></div></section><section id="bionoise-measurement" aria-labelledby="bionoise-measurement-heading" class="w-full overflow-hidden bg-nk-warm-brown-700 py-[60px] lg:py-20"><div class="mx-auto flex w-full max-w-[1440px] flex-col items-center"><h2 id="bionoise-measurement-heading" class="scroll-mt-24 px-4 text-center font-normal text-nk-beige-500 lg:scroll-mt-28 text-[28px] -tracking-[0.6px] min-[360px]:text-[30px] lg:text-[44px] lg:-tracking-[0.88px]" style="font-feature-settings:'salt' 1">BioNoise™: A Novel Way to Measure Aging</h2><div class="relative mt-8 aspect-[361/413] w-[calc(100%-32px)] overflow-hidden rounded-[24px] lg:mx-10 md:mt-[60px] lg:aspect-[1360/580] lg:h-auto lg:w-[calc(100%-80px)] lg:max-w-[1360px] lg:rounded-[32px] lg:shadow-[0px_-8px_40px_1px_rgba(251,246,238,0.18)]"><img alt="Microscope examining a sample slide for epigenetic analysis" loading="lazy" decoding="async" data-nimg="fill" class="object-cover object-center lg:object-[50%_30%]" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://www.generationlab.com/_next/image?url=%2Fscience%2Fbionoise-measurement-mobile.webp&amp;w=3840&amp;q=75" width="1920" height="99985"><div class="absolute inset-x-4 bottom-4 aspect-[329/206] overflow-hidden md:hidden"><div class="relative h-full w-full overflow-hidden rounded-[16px] border border-[rgba(255,255,255,0.3)] bg-[rgba(54,33,8,0.6)] md:backdrop-blur-[6px]"><img alt="" aria-hidden="true" loading="lazy" decoding="async" data-nimg="fill" class="pointer-events-none scale-110 object-cover opacity-75 blur-[8px] object-[50%_72%]" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://www.generationlab.com/_next/image?url=%2Fscience%2Fbionoise-measurement-mobile.webp&amp;w=3840&amp;q=75" width="1920" height="99985"><div class="absolute inset-0 bg-[rgba(54,33,8,0.48)]"></div><div class="relative z-10 h-full w-full" role="img" aria-label="Animated BioNoise card showing regulated methylation values for young and healthy people."></div></div></div><div class="absolute bottom-6 right-[clamp(24px,6.47vw,88px)] hidden aspect-[574/360] w-[clamp(420px,42.2vw,574px)] overflow-hidden md:block"><div class="relative h-full w-full overflow-hidden rounded-[16px] border border-[rgba(255,255,255,0.3)] bg-[rgba(54,33,8,0.6)] md:backdrop-blur-[6px]"><img alt="" aria-hidden="true" loading="lazy" decoding="async" data-nimg="fill" class="pointer-events-none scale-110 object-cover opacity-75 blur-[8px] object-[68%_66%]" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://www.generationlab.com/_next/image?url=%2Fscience%2Fbionoise-measurement-mobile.webp&amp;w=3840&amp;q=75" width="1920" height="99985"><div class="absolute inset-0 bg-[rgba(54,33,8,0.48)]"></div><div class="relative z-10 h-full w-full" role="img" aria-label="Animated BioNoise card showing regulated methylation values for young and healthy people."></div></div></div></div><div class="mt-[60px] flex w-full max-w-[680px] flex-col gap-[60px] px-4 md:px-8 lg:max-w-none lg:px-20"><div class="grid grid-cols-1 gap-[60px] lg:grid-cols-2 lg:gap-[60px] xl:gap-[120px]"><div class="flex flex-col gap-10 lg:gap-6"><div class="flex flex-col gap-4 text-center lg:text-left"><h3 class="nk-heading-5 text-nk-beige-500 lg:nk-heading-4">The Signal Everyone Else Is Missing.</h3><div class="flex flex-col gap-6"><p class="nk-text-base text-nk-cold-brown-400">Conventional epigenetic clocks rely on methylation levels and statistical models to predict age. But levels alone capture only the average signal, not how that signal is regulated or how it changes over time.</p><p class="nk-text-base text-nk-cold-brown-400">Aging is reflected not just in the level itself, but in increasing variability in methylation patterns, a sign of declining regulatory control. A healthy 30-year-old and a 70-year-old in decline can show the same methylation level at a CpG site, yet one is stable while the other becomes increasingly disordered. The level is the same. The underlying biology is not.</p></div></div><div class="flex w-full flex-col gap-4 border-t border-[rgba(147,128,112,0.35)] pt-4"><p class="nk-text-base text-center text-nk-cold-brown-400 lg:nk-text-lg lg:text-left">References</p><ul class="list-inside list-disc text-center lg:list-outside lg:pl-5 lg:text-left"><li class="text-nk-cold-brown-500 marker:text-nk-cold-brown-500"><a href="https://www.aging-us.com/article/205046" target="_blank" rel="noopener noreferrer" class="nk-text-md font-medium leading-[1] text-nk-cold-brown-400 underline lg:nk-text-base lg:font-normal lg:leading-[1]">Conboy et al., Aging, 2023 — Fail-tests of DNA methylation clocks and development of a noise barometer</a></li><li class="text-nk-cold-brown-500 marker:text-nk-cold-brown-500"><a href="https://www.nature.com/articles/s43587-024-00600-8" target="_blank" rel="noopener noreferrer" class="nk-text-md font-medium leading-[1] text-nk-cold-brown-400 underline lg:nk-text-base lg:font-normal lg:leading-[1]">Tong et al., Nature Aging, 2024 — Quantifying the stochastic component of epigenetic aging</a></li></ul></div></div><div class="flex flex-col gap-4 text-center lg:text-left"><h3 class="nk-heading-5 text-nk-beige-500 lg:nk-heading-4">Conventional Clocks Estimate.<br>The SystemAge™ Test Measures.</h3><div class="flex flex-col gap-6"><p class="nk-text-base text-nk-cold-brown-400">In a healthy body, the epigenetic machinery holds critical gene-regulatory sites within a narrow band: tight, stable, accurate. As biological aging progresses, that control breaks down.</p><p class="nk-text-base text-nk-cold-brown-400">Methylation doesn't shift in one direction. It scatters. Variability increases. Regulatory precision declines. The body loses its grip on itself.</p><p class="nk-text-base text-nk-cold-brown-400">This is BioNoise™: the measurable loss of epigenetic regulatory control, pioneered by Generation Lab CSO Dr. Irina Conboy and her laboratory with over 20 years of aging research.</p><p class="nk-text-base text-nk-cold-brown-400">Where machine learning models assign arbitrary statistical weights to individual CpG sites, the SystemAge™ Test is built on curated biology, measuring the total variability across all 460 expert-selected biomarkers. A direct measurement of how well your biology is holding together.</p></div></div></div></div></div></section><section id="biomarker-selection" aria-labelledby="meaningful-biomarker-curation-heading" class="w-full overflow-hidden bg-nk-warm-brown-700 py-[60px] lg:py-20"><div class="mx-auto flex w-full max-w-[1440px] flex-col items-center"><h2 id="meaningful-biomarker-curation-heading" class="scroll-mt-24 px-4 text-center font-normal text-nk-beige-300 lg:scroll-mt-28 text-[30px] -tracking-[0.6px] lg:text-[44px] lg:-tracking-[0.88px]" style="font-feature-settings:'salt' 1">Not All Biomarkers Are Created Equal</h2><div class="relative mt-8 h-[660px] w-[calc(100%-32px)] overflow-hidden rounded-[28px] min-[360px]:h-[740px] lg:mx-10 md:mt-[60px] lg:h-[640px] lg:w-[calc(100%-80px)] lg:max-w-[1360px] lg:rounded-[32px]"><img alt="Microscope imagery behind epigenetic biomarker selection panels" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://www.generationlab.com/_next/image?url=%2Fscience%2Fbiomarker-curation-bg.jpg&amp;w=3840&amp;q=75" width="1920" height="99985"><div class="absolute inset-0 bg-[#ba8f52] mix-blend-multiply"></div><div class="absolute inset-0 bg-black/10"></div><div class="absolute inset-x-4 bottom-6 top-6 flex flex-col gap-6 min-[360px]:gap-8 lg:inset-y-[35px] lg:left-9 lg:right-[35px] lg:grid lg:grid-cols-2 lg:gap-[67px]"><div class="relative overflow-hidden rounded-[24px] border border-white/30 bg-[rgba(157,157,157,0.2)] md:backdrop-blur-[10px] lg:rounded-[32px] h-[310px] lg:h-full"><div class="flex h-full w-full flex-col items-center"><div class="relative z-10 mt-[14px] rounded-[60px] border border-white/30 bg-[rgba(107,80,57,0.7)] px-3 py-1.5 text-center text-[14px] leading-none tracking-[0.28px] text-white md:backdrop-blur-[5px] lg:mt-[14px] lg:px-4 lg:py-2 lg:text-[22px] lg:tracking-[0.44px]">~1,000,000 CpG Sites Available</div><div class="relativ