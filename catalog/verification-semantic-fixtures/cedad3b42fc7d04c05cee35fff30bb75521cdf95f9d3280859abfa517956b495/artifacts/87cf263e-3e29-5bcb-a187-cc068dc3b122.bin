<circle cx="14" cy="14" r="13.25" stroke="#A8B0C2" stroke-width="1.5"></circle>
<path d="M9.5 9.5L18.5 18.5M18.5 9.5L9.5 18.5" stroke="#A8B0C2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
