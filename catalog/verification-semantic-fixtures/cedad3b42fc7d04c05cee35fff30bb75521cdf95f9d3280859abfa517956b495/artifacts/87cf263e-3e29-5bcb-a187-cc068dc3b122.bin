.card-left:hover ~ .card-center, .card-right:hover ~ .card-center { flex: 1 1 25%; }

.card-content { opacity: 0; transform: translateY(100%); transition: opacity 0.3s, transform 0.3s; }

.card:hover .card-content { opacity: 1; transform: translateY(0px); transition: opacity 0.3s 0.3s, transform 0.3s 0.3s; }

.card:not(:hover) .card-content { opacity: 0; transform: translateY(100%); transition: opacity 0.3s, transform 0.3s; }

.card-center:hover .card-content { opacity: 1; transform: translateY(0px); transition: opacity 0.3s 0.3s, transform 0.3s 0.3s; }

.card-center .card-content { opacity: 0; transform: translateY(100%); transition: opacity 0.3s, transform 0.3s; }

.card-center:not(:hover) .card-content { opacity: 1; transform: translateY(0px); transition: opacity 0.35s 0.3s, transform 0.35s 0.3s; }

