<!-- Mixpanel session logic (idle + visible) -->
<!--<script>
(function () {
  function runMixpanelSessionLogic() {
    try {
      if (!window.mixpanel) return;

      // rsid identity
      var rsid = sessionStorage.getItem('rsid');
      if (!rsid) {
        rsid = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : (Date.now() + '-' + Math.random().toString(36).slice(2));
        sessionStorage.setItem('rsid', rsid);
      }
      mixpanel.identify(rsid);
      mixpanel.register({ rsid: rsid });

      // UTM params -> register_once
      var params = new URL(location.href).searchParams;
      ['utm_source','utm_medium','utm_campaign','utm_term','utm_content'].forEach(function (k) {
        var v = params.get(k); if (!v) return;
        var o={}; o[k]=v; mixpanel.register_once(o);
      });

      // Session_Started (once per session)
      if (!sessionStorage.getItem('sessionStarted')) {
        mixpanel.track('Session_Started', { rsid: rsid, startTime: new Date().toISOString(), url: location.href, referrer: document.referrer });
        sessionStorage.setItem('sessionStarted','true');
      }

      // First / returning
      if (localStorage.getItem('returningVisitor')) {
        var sc = parseInt(localStorage.getItem('sessionCount')||'1',10)+1;
        localStorage.setItem('sessionCount', String(sc));
        mixpanel.track('Visitor_Returned', { rsid: rsid, returningVisitor: true, sessionCount: sc });
      } else {
        localStorage.setItem('returningVisitor','true'); localStorage.setItem('sessionCount','1');
        mixpanel.track('First_Time_Visitor', { rsid: rsid, returningVisitor: false, sessionCount: 1 });
      }

      // Page_Viewed
      mixpanel.track('Page_Viewed', { rsid: rsid, pageURL: location.href, pageTitle: document.title, referrerURL: document.referrer });

      // Traffic source (once per session)
      if (!sessionStorage.getItem('trafficSourceDetected')) {
        var src = params.get('utm_source') || (document.referrer ? new URL(document.referrer).hostname : 'Direct');
        var med = params.get('utm_medium') || (document.referrer ? 'Referral' : 'Direct');
        var camp = params.get('utm_campaign') || undefined;
        mixpanel.track('Traffic_Source_Detected', { rsid: rsid, trafficSource: src, medium: med, campaign: camp });
        sessionStorage.setItem('trafficSourceDetected','true');
      }

      // Exit
      window.addEventListener('beforeunload', function () {
        try { mixpanel.track('Page_Exited', { rsid: rsid, pageURL: location.href, exitTime: new Date().toISOString() }); } catch(e){}
      });

      // Targeted button clicks
      var TRACK_SELECTORS = '.button, .section3_card-button, .card_button, .research_card-button';
      document.addEventListener('click', function (e) {
        var el = e.target.closest(TRACK_SELECTORS); if (!el) return;
        var top = el.getBoundingClientRect().top, vh = window.innerHeight || 1;
        var pos = top < vh/3 ? 'Top' : (top < 2*vh/3 ? 'Middle' : 'Bottom');
        mixpanel.track('Button_Clicked', { rsid: rsid, pageURL: location.href, buttonText: (el.innerText||'').trim(), buttonID: el.className || '', clickPosition: pos });
      }, true);

      // Video play (if present)
      var v = document.getElementById('video1');
      if (v) v.addEventListener('play', function(){ mixpanel.track('Content_Interacted', { contentType:'Video', interactionType:'Play', contentURL: location.href }); });

    } catch (err) {}
  }

  function start() {
    if ('requestIdleCallback' in window) { requestIdleCallback(runMixpanelSessionLogic, { timeout: 2000 }); }
    else { setTimeout(runMixpanelSessionLogic, 0); }
  }

  if (document.hidden) {
    document.addEventListener('visibilitychange', function onv(){ if (!document.hidden){ document.removeEventListener('visibilitychange', onv); start(); }});
  } else if (document.readyState === 'complete' || document.readyState === 'interactive') {
    start();
  } else {
    document.addEventListener('DOMContentLoaded', start);
  }
})();
</script>-->



<!-- Card center hover logic (only on hover-capable devices) -->
<script>
(function(){
  if (!window.matchMedia || !window.matchMedia('(hover: hover)').matches) return;
  document.addEventListener('DOMContentLoaded', function(){
    var cards = document.querySelectorAll('.card'), initial = document.querySelector('.card-center');
    if (!cards.length || !initial) return;
    cards.forEach(function(card){
      card.addEventListener('mouseenter', function(){ cards.forEach(function(c){ c.classList.remove('card-center'); }); card.classList.add('card-center'); });
      card.addEventListener('mouseleave', function(){
        setTimeout(function(){
          var anyHover = Array.prototype.some.call(cards, function(c){ return c.matches(':hover'); });
          if (!anyHover) { cards.forEach(function(c){ c.classList.remove('card-center'); }); initial.classList.add('card-center'); }
        }, 300);
      });
    });
  });
})();
</script>

<!-- Iframe height helper -->
<script>
(function(){
  function sendHeightToParent(){
    try{
      var height = document.documentElement.scrollHeight;
      if (window.self !== window.top) { window.parent.postMessage({ type:'iframe-height', height:height }, '*'); }
    } catch(e){}
  }
  window.addEventListener('load', sendHeightToParent);
})();
</script>

