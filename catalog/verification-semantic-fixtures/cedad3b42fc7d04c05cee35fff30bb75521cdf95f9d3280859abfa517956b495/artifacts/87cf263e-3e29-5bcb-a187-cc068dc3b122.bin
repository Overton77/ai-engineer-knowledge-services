<script>
  document.addEventListener('DOMContentLoaded', function () {
    const accResults = document.querySelectorAll(".item-results-mobile-v2");

    function closeItem(item) {
      const panel = item.querySelector('.item-results-mobile-v2_panel');
      const head = item.querySelector('.item-results-mobile-v2_head');
      item.classList.remove("is-active");
      panel.classList.remove("is-active");
      head.classList.remove("is-active");
      head.setAttribute('aria-expanded', 'false');
      panel.style.maxHeight = null;
    }

    function openItem(item) {
      const panel = item.querySelector('.item-results-mobile-v2_panel');
      const head = item.querySelector('.item-results-mobile-v2_head');
      item.classList.add("is-active");
      panel.classList.add("is-active");
      head.classList.add("is-active");
      head.setAttribute('aria-expanded', 'true');
      panel.style.maxHeight = panel.scrollHeight + "px";
    }

    accResults.forEach((accItem, index) => {
      const head = accItem.querySelector('.item-results-mobile-v2_head');
      const panel = accItem.querySelector('.item-results-mobile-v2_panel');

      // Генеруємо унікальний id для кожної панелі
      const panelId = `faq-panel-${index}`;
      panel.setAttribute('id', panelId);

      // Початкові aria-атрибути
      head.setAttribute('aria-expanded', 'false');
      head.setAttribute('aria-controls', panelId);

      accItem.addEventListener("click", function () {
        const isCurrentlyActive = this.classList.contains("is-active");

        // Закриваємо всі пункти
        accResults.forEach(closeItem);

        // Якщо клікнутий пункт не був активним — відкриваємо його
        if (!isCurrentlyActive) {
          openItem(this);
        }
      });

      // Перший пункт відкритий за замовчуванням
      if (index === 0) {
        openItem(accItem);
      }
    });
  });
</script></div></section><section class="section_faq-with-image is-white"><div class="padding-global"><div class="container-large"><div class="faq-with-image_wrapper"><div class="faq-with-image_title-wrap"><h2 class="title-h2-new blue">How TruAge Benefits Your Clinic</h2></div><div class="faq-with-image_text-wrap"><div class="text-regular is-dark">TruAge is a precision longevity tool that analyzes more than 75 essential aging biomarkers to empower healthcare providers with personalized recommendations to help patients live longer, healthier lives.</div></div><div class="faq-with-image_layout"><div class="faq-with-image_content"><div class="faq-with-image_faq"><div class="item-faq-v2 is-full"><div class="item-faq-v2_head" aria-expanded="false" aria-controls="faq-panel-0"><div class="item-faq-v2_title">Establish a baseline</div><div class="item-faq-v2_icon"><div class="item-faq-v2_icon-vertical"></div><div class="item-faq-v2_icon-horizontal"></div></div></div><div class="item-faq-v2_panel" id="faq-panel-0"><p class="item-faq-v2_text">An initial test establishes where your patient stands biologically today, giving you the clinical anchor that turns every follow-up visit into a progress conversation.</p></div></div><div class="item-faq-v2 is-full"><div class="item-faq-v2_head" aria-expanded="false" aria-controls="faq-panel-1"><div class="item-faq-v2_title">Personalize a care plan</div><div class="item-faq-v2_icon"><div class="item-faq-v2_icon-vertical"></div><div class="item-faq-v2_icon-horizontal"></div></div></div><div class="item-faq-v2_panel" id="faq-panel-1"><p class="item-faq-v2_text">When your patient’s history and labs leave the picture incomplete, &nbsp;fill the gaps with the biological context you need to build a care plan that actually fits.</p></div></div><div class="item-faq-v2 is-full"><div class="item-faq-v2_head" aria-expanded="false" aria-controls="faq-panel-2"><div class="item-faq-v2_title">Monitor intervention response</div><div class="item-faq-v2_icon"><div class="item-faq-v2_icon-vertical"></div><div class="item-faq-v2_icon-horizontal"></div></div></div><div class="item-faq-v2_panel" id="faq-panel-2"><p class="item-faq-v2_text">Show whether the protocols you’re recommending are actually working at the biological level, giving your patients evidence &nbsp;that lifestyle changes are making a measurable difference.</p></div></div><div class="item-faq-v2 is-full"><div class="item-faq-v2_head" aria-expanded="false" aria-controls="faq-panel-3"><div class="item-faq-v2_title">Prioritize areas for follow-up</div><div class="item-faq-v2_icon"><div class="item-faq-v2_icon-vertical"></div><div class="item-faq-v2_icon-horizontal"></div></div></div><div class="item-faq-v2_panel" id="faq-panel-3"><p class="item-faq-v2_text">When a patient has multiple concerns, testing helps you see which biological systems need the most attention, turning a complex clinical picture into a clear set of priorities.</p></div></div></div><div class="faq-with-image_cta-wrap"><a data-wf--global-cta-yellow--variant="full-width-height" href="https://portal.trudiagnostic.com/sign-in" class="cta-yellow w-variant-5b9601e6-6a59-2b05-1b12-8de340a701eb w-inline-block"><div class="text-regular blue cta">Start Testing</div><div class="cta-yellow-icon w-embed"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
