<script>
  document.addEventListener('DOMContentLoaded', function () {
    const accHeader = document.querySelectorAll('.item-acc-mobile-menu');

    function closeItem(accItem) {
      const head = accItem.querySelector('.item-acc-mobile-menu_head');
      const panel = accItem.querySelector('.item-acc-mobile-menu_panel');

      accItem.classList.remove('active');
      panel.classList.remove('active');
      head.classList.remove('active');
      head.setAttribute('aria-expanded', 'false');
      panel.style.maxHeight = null;
    }

    function openItem(accItem) {
      const head = accItem.querySelector('.item-acc-mobile-menu_head');
      const panel = accItem.querySelector('.item-acc-mobile-menu_panel');

      accItem.classList.add('active');
      panel.classList.add('active');
      head.classList.add('active');
      head.setAttribute('aria-expanded', 'true');
      panel.style.maxHeight = panel.scrollHeight + 'px';
    }

    accHeader.forEach((accItem, index) => {
      const head = accItem.querySelector('.item-acc-mobile-menu_head');
      const panel = accItem.querySelector('.item-acc-mobile-menu_panel');

      // Генеруємо унікальний id для кожної панелі
      const panelId = `faq-panel-${index}`;
      panel.setAttribute('id', panelId);
      head.setAttribute('aria-controls', panelId);

      // Початковий стан: перший елемент відкритий, решта закриті
      if (index === 0) {
        head.setAttribute('aria-expanded', 'true');
      } else {
        head.setAttribute('aria-expanded', 'false');
      }

      accItem.addEventListener('click', function () {
        const isActive = this.classList.contains('active');

        // Закриваємо всі елементи
        accHeader.forEach(closeItem);

        // Якщо клікнутий елемент був закритий — відкриваємо його
        if (!isActive) {
          openItem(this);
        }
      });
    });

    // Відкриваємо перший елемент за замовчуванням
    if (accHeader.length > 0) {
      openItem(accHeader[0]);
    }
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const burger = document.querySelector('.header-v2_burger');
    const mobileMenu = document.querySelector('.header-v2_mobile-menu');
    const overlay = document.querySelector('.header-v2_mobile-overlay');
    const body = document.body;

    const mq = window.matchMedia('(max-width: 991px)');

    function openMenu() {
      burger.classList.add('is-active');
      mobileMenu.classList.add('is-visible');
      overlay.classList.add('is-visible');
      body.classList.add('no-scroll');
    }

    function closeMenu() {
      burger.classList.remove('is-active');
      mobileMenu.classList.remove('is-visible');
      overlay.classList.remove('is-visible');
      body.classList.remove('no-scroll');
    }

    function toggleMenu() {
      // діємо лише на пристроях менших за 991px
      if (!mq.matches) return;

      if (burger.classList.contains('is-active')) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    if (burger && mobileMenu && overlay) {
      burger.addEventListener('click', toggleMenu);

      // клік по оверлею закриває меню
      overlay.addEventListener('click', closeMenu);

      // закриваємо меню, якщо viewport став ширшим за 991px
      mq.addEventListener('change', function (e) {
        if (!e.matches) {
          closeMenu();
        }
      });

      // закриваємо меню при кліку на будь-яке посилання всередині мобільного меню
      mobileMenu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', closeMenu);
      });
    }
  });
</script></div></header></div></div><main id="main-content" class="main-wrapper above-fold-cta"><section class="section_hero-symphony"><div class="padding-global new"><div class="container-new"><div class="hero-symphony_wrapper is-v2"><div class="hero-symphony_content"><div class="hero-symphony_content-head"><div class="heading-xs-regular blue">TRUAGE™</div><h1 class="title-h2-new blue">The Most Trusted Biological Age Test</h1></div><div class="hero-symphony_content-bot"><div class="hero-symphony_content-bot-text"><div class="text-regular blue">TruAge combines 3 of the most advanced epigenetic age clocks to deliver a multi-dimensional view of how a patient's body is aging.</div></div><div class="hero-symphony_content-bot-links"><a data-wf--global-cta-yellow--variant="modify" href="https://cdn.prod.website-files.com/6690e254f4f07d1a469bb330/684b0280d60621d1be91641c_ExampleAdvancedTruAge.pdf" class="cta-yellow w-variant-927ae097-63d8-7236-ec7b-a65ed4a0b41b w-inline-block"><div class="text-regular blue cta">Download Sample Report</div><div class="cta-yellow-icon w-variant-927ae097-63d8-7236-ec7b-a65ed4a0b41b w-embed"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
