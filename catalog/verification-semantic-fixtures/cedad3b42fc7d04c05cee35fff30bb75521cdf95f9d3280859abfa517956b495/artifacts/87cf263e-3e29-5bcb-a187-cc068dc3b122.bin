<!-- ===========================
     LAZY LOAD NON-CRITICAL JS (smart, gesture/visible gated)
=========================== -->
<script>
(function lazyVendors(){
  var fired = false;
  var mobile = window.innerWidth <= 991;
  var delay = mobile ? 7000 : 3000;
  var timer;

  function netConstrained(){
    try{
      var c = navigator.connection;
      return c && (c.saveData || /(^|^slow-)?2g$/.test(c.effectiveType));
    }catch(e){ return false; }
  }

  function once(fn){ var ran=false; return function(){ if (ran) return; ran=true; fn(); }; }
  var load = once(function loadVendors(){
    if (fired) return; fired = true;
    
    // Wellput (Tune) — load late, then init/identify
    (function(){
      if (window.__tuneLoaded) return;
      var s = document.createElement('script');
      s.src = "https://js.go2sdk.com/v2/tune.js";
      s.async = true;
      s.onload = function(){
        window.__tuneLoaded = true;
        if (window.tdl && typeof tdl.init === 'function') {
          tdl.init("https://wellput.go2cloud.org");
          tdl.identify();
        }
      };
      document.head.appendChild(s);
    })();

    // Vibe
    if (!window.vbpx){
      (function(v,i,b,e,c,o){
        if(!v[c]){
          var s=v[c]=function(){ s.process ? s.process.apply(s,arguments) : s.queue.push(arguments); };
          s.queue=[]; s.b=1*new Date;
          var t=i.createElement(b); t.async=!0; t.src=e;
          var n=i.getElementsByTagName(b)[0]; n.parentNode.insertBefore(t,n);
        }
      })(window,document,"script","https://s.vibe.co/vbpx.js","vbpx");
      // init after script bootstraps
      window.vbpx && vbpx('init','BPg4n1'); 
      window.vbpx && vbpx('event','page_view');
    }

    // Twitter pixel
    if (!window.twq){
      !function(e,t,n,s,u,a){
        e.twq||(s=e.twq=function(){ s.exe ? s.exe.apply(s,arguments) : s.queue.push(arguments); },
        s.version='1.1',s.queue=[],u=t.createElement(n),u.async=!0,u.src='https://static.ads-twitter.com/uwt.js',
        a=t.getElementsByTagName(n)[0],a.parentNode.insertBefore(u,a));
      }(window,document,'script');
      window.twq && twq('config','os3sf');
    }

    // Finsweet CMS Slider (only if attribute exists)
    if (!window.__fsSliderLoaded && document.querySelector('[fs-cmsslider-element="slider"]')){
      var fs = document.createElement('script');
      fs.src = "https://cdn.jsdelivr.net/npm/@finsweet/attributes-cmsslider@1/cmsslider.js";
      fs.async = true;
      fs.onload = function(){ window.__fsSliderLoaded = true; };
      document.head.appendChild(fs);
    }

    // SplitType + GSAP + ScrollTrigger (load missing only)
    var needInit = 0;
    function add(src, present){
      if (present) return;
      var s = document.createElement('script'); s.src = src; s.async = true; s.onload = done; needInit++;
      document.head.appendChild(s);
    }
    function done(){ if(--needInit<=0) initTextSplit(); }

    add("https://unpkg.com/split-type", !!window.SplitType);
    add("https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/gsap.min.js", !!window.gsap);
    add("https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/ScrollTrigger.min.js", !!(window.gsap && window.ScrollTrigger));
    if (needInit===0) initTextSplit();

    function initTextSplit(){
      if (!window.gsap || !window.ScrollTrigger || !window.SplitType || initTextSplit._done) return;
      initTextSplit._done = true;
      gsap.registerPlugin(ScrollTrigger);

      var typeSplit = new SplitType("[text-split]", { types:"words, chars", tagName:"span" });

      function createScrollTrigger(el, tl){
        ScrollTrigger.create({ trigger: el, start:"top bottom", onLeaveBack:function(){ tl.progress(0); tl.pause(); }});
        ScrollTrigger.create({ trigger: el, start:"top 60%", onEnter:function(){ tl.play(); }});
      }

      document.querySelectorAll("[letters-fade-in]").forEach(function(el){
        var tl = gsap.timeline({ paused:true });
        tl.from(el.querySelectorAll(".char"), { opacity:0, duration:.2, ease:"power1.out", stagger:{ amount:.8 } });
        createScrollTrigger(el, tl);
      });

      document.querySelectorAll("[scrub-each-word]").forEach(function(el){
        gsap.timeline({ scrollTrigger:{ trigger:el, start:"top 90%", end:"top center", scrub:true } })
            .from(el.querySelectorAll(".word"), { opacity:.2, duration:.2, ease:"power1.out", stagger:{ each:.4 }});
      });

      gsap.set("[text-split]", { opacity:1 });
    }

    // Salesforce Embedded Messaging (lazy)
    if (!window.__sfBoot){
      var sf = document.createElement('script');
      sf.src = 'https://trudiagnostic.my.site.com/ESWTruDiagnosticService1738072767419/assets/js/bootstrap.min.js';
      sf.defer = true;
      sf.onload = function(){ window.__sfBoot = true; if (typeof initEmbeddedMessaging === 'function') initEmbeddedMessaging(); };
      document.head.appendChild(sf);
    }
  });

  function schedule(){
    if (document.hidden || netConstrained()){
      clearTimeout(timer);
      timer = setTimeout(schedule, 4000);
      return;
    }
    setTimeout(load, delay);
  }

  // user signals
  window.addEventListener('pointerdown', load, { once:true });
  window.addEventListener('scroll', load, { once:true, passive:true });
  document.addEventListener('visibilitychange', function(){ if (!document.hidden) schedule(); }, { once:true });

  // time fallback
  schedule();
})();
</script>
<script src="https://backend.alia-prod.com/public/embed.js?shop=trudiagnostictest.myshopify.com" async=""></script>

<script>
  (function () {
    var nav = document.querySelector('.navbar_component[role="banner"]');
    if (!nav) return;

    // Замінюємо div на header зі збереженням всього вмісту
    var header = document.createElement('header');

    // Копіюємо всі атрибути
    Array.from(nav.attributes).forEach(function (attr) {
      if (attr.name !== 'role') { // role="banner" не потрібен на <header>
        header.setAttribute(attr.name, attr.value);
      }
    });

    header.innerHTML = nav.innerHTML;
    nav.parentNode.replaceChild(header, nav);
  })();
</script>

