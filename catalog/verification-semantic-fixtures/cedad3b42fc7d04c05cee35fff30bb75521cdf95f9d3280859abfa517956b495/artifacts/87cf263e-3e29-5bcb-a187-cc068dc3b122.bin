<script>
  document.querySelectorAll('.different_slider').forEach((wrap) => {
    const clip = wrap.querySelector('.different_slider-slide:nth-child(2)');
    const divider = wrap.querySelector('.different_slider-divider');
    let drag = false;
    function setPos(x) {
      const r = wrap.getBoundingClientRect();
      const p = Math.min(100, Math.max(0, ((x - r.left) / r.width) * 100));
      clip.style.width = p + '%';
      divider.style.left = p + '%';
    }
    wrap.addEventListener('mousedown', (e) => {
      drag = true;
      e.preventDefault();
    });
    document.addEventListener('mouseup', () => (drag = false));
    document.addEventListener('mousemove', (e) => {
      if (drag) setPos(e.clientX);
    });
    wrap.addEventListener(
      'touchmove',
      (e) => {
        e.preventDefault();
        setPos(e.touches[0].clientX);
      },
      { passive: false },
    );
    wrap.addEventListener('touchstart', (e) => setPos(e.touches[0].clientX), { passive: true });
  });
</script>

