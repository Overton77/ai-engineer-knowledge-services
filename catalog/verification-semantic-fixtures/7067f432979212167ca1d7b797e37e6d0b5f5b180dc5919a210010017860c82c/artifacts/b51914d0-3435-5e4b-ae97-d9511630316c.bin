adient(113.73% 113.73% at 100% 50%, rgba(255, 222, 208, 0.8) 0%, rgba(252, 206, 186, 0.8) 22.17%, rgba(249, 249, 249, 0.8) 100%); backdrop-filter: blur(15px);"><p class="nk-text-md xl:nk-text-base text-nk-warm-brown-500 flex-1 pr-4">Introducing sex-specific results — trends and recommendations calibrated to your biology</p><div class="flex items-baseline lg:items-center justify-end gap-6 w-full lg:w-auto"><a class="nk-text-md lg:nk-text-base text-nk-warm-brown-500 hover:opacity-80 active:opacity-50 lg:text-[#4F4034] underline !font-bold lg:!font-normal whitespace-nowrap" href="https://www.generationlab.com/the-systemage-test#gl_get-sample-report">View Sample Report</a><button type="button" class="hover:opacity-60 active:opacity-50" aria-label="Dismiss banner"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" class="w-5 h-5 text-nk-warm-brown-500 cursor-pointer hidden lg:block"><path d="M18.75 5.25L5.25 18.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M18.75 18.75L5.25 5.25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="nk-text-md text-nk-warm-brown-500 underline lg:hidden">Dismiss</span></button></div></div></div></header><div class="tos-pp-page-wrapper leading-normal"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://www.generationlab.com/#organization","name":"Generation Lab","alternateName":"GenLab","url":"https://www.generationlab.com","foundingDate":"2020","email":"support@generationlab.com","address":{"@type":"PostalAddress","streetAddress":"1701 Old Bayshore Highway","addressLocality":"Burlingame","addressRegion":"CA","postalCode":"94010","addressCountry":"US"},"sameAs":["https://www.facebook.com/generationlab.longevity.health","https://x.com/GenerationLab_","https://www.linkedin.com/company/generation-lab-longevity","https://www.instagram.com/generation_lab"],"logo":{"@type":"ImageObject","@id":"https://www.generationlab.com/#logo","url":"https://www.generationlab.com/assets/logo-tm.svg","width":200,"height":60,"caption":"Generation Lab"}},{"@type":"WebSite","@id":"https://www.generationlab.com/#website","url":"https://www.generationlab.com","name":"Generation Lab","publisher":{"@id":"https://www.generationlab.com/#organization"},"inLanguage":"en-US"},{"@type":"WebPage","@id":"https://www.generationlab.com/terms-of-service","url":"https://www.generationlab.com/terms-of-service","name":"Generation Lab's Terms of Service","description":"Read the Terms of Service for Generation Lab.","publisher":{"@id":"https://www.generationlab.com/#organization"},"breadcrumb":{"@id":"https://www.generationlab.com/terms-of-service#breadcrumb"},"isPartOf":{"@id":"https://www.generationlab.com/#website"},"inLanguage":"en-US"},{"@type":"BreadcrumbList","@id":"https://www.generationlab.com/terms-of-service#breadcrumb","name":"Breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.generationlab.com"},{"@type":"ListItem","position":2,"name":"Terms of Service"}]}]}</script><section class="bg-neutral py-8 print:hidden"><div class="container mx-auto px-4"><div class="flex space-x-4 justify-center items-center"><a class="px-4 md:px-6 py-2 rounded-full transition-all duration-300 bg-gradient-to-r from-[#C3A06B] to-[#905E12] text-white font-medium" href="https://www.generationlab.com/terms-of-service">Terms of Service</a><a class="px-4 md:px-6 py-2 rounded-full transition-all duration-300 bg-white border border-[#C3A06B] text-[#C3A06B] hover:bg-[#F9F5F0]" href="https://www.generationlab.com/terms-of-service?type=provider">Provider Agreement</a></div></div></section><section class="md:p-20 px-3 py-10 w-full  undefined"><div class="container relative md:max-w-7xl max-w-lg m-auto h-full" style="opacity: 1; translate: none; rotate: none; scale: none; transform: translate(0px, 0px);"><h1 class="text-3xl md:text-5xl mb-2 text-center">Website and Platform Terms of Service</h1><p class="text-lg text-center">Last Revised: July 29, 2026</p><div class="flex justify-end mt-4 gap-2 container relative px-2 md:max-w-7xl max-w-lg m-auto h-full print:hidden"><button class="border border-[#C3A06B] text-[#C3A06B] px-4 py-2 rounded-full flex items-center gap-2 shadow-sm transition" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Print" role="img"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"></path><rect x="6" y="14" width="12" height="8" rx="1"></rect></svg>Print</button><a href="https://generation-lab-email-assets.s3.us-east-1.amazonaws.com/legal-documents/Generation%20Lab%20Terms%20of%20Service%20-%202026-07-29.pdf" target="_blank" rel="noopener noreferrer" class="border border-[#C3A06B] text-[#C3A06B] px-4 py-2 rounded-full flex items-center gap-2 shadow-sm transition cursor-pointer"><svg stroke="currentColor" fill="none" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>Download</a></div><h2 class="text-xl md:text-3xl mt-8 mb-5">1. Overview</h2><p>These Website and Platform Terms of Service (“Terms”) govern your access to and use of all digital services and properties provided by Generation Lab Inc. (“Generation Lab,” “we,” “us,” or “our”), including:</p><ul class="list-disc list-inside md:list-outside ml-4 md:ml-8 space-y-2"><li>Our website(s) and any content or functionality offered therein;</li><li>Our test kit registration and fulfillment interface;</li><li>The Generation Lab Report (the personalized epigenetic aging report produced following your test, “the Report”), whether delivered digitally, via the Portal, or independently;</li><li>The Generation Lab Portal, a digital platform through which you may store and access your Reports, book provider appointments, conduct telehealth consultations, and access other platform features as they become available (collectively, “the Portal”).</li></ul><p>These Terms apply to all users of the foregoing, including test-takers, visitors, and account holders. Together, the website, test kit interface, Report, and Portal are referred to as the “Platform.”</p><p>By accessing or using the Platform, you agree to be bound by these Terms and our<!-- --> <a class="underline" href="https://www.generationlab.com/privacy-policy">Privacy Policy</a>. If you do not agree, you must not use the Platform.</p><p>Testing logistics and fulfillment services are provided by Spot Health Inc. (“Spot Health”) as a contracted service provider to Generation Lab. As between Generation Lab and Spot Health, Generation Lab is the primary party responsible to you for the services described herein.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">2. Eligibility</h2><p>You must be at least 18 years old (or the age of majority in your jurisdiction) to use the Platform, unless you are a minor using the Platform with the informed consent of a parent or legal guardian. By using the Platform, you represent and warrant that you meet these eligibility requirements and that you are located in the United States or Canada.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">3. No Medical Advice</h2><p>Generation Lab does not practice medicine or provide medical advice. Nothing on the Platform — including the Report, any recommendations, provider matching, or communications — constitutes medical care, diagnosis, or treatment.</p><p>The Report contains personalized pre-clinical observations about biomarkers of aging and may surface common approaches associated with improving the health functions where you are showing signs of biological aging. These observations and approaches are informational and pre-clinical in nature. The Report clearly identifies these as pre-clinical recommendations that should not be acted upon without first consulting a qualified healthcare provider.</p><p>Always consult a licensed healthcare provider before making any medical decisions based on your Report or any other content on the Platform.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">4. The Report</h2><p>The Report is a personalized document generated from your test results. It is the output of Generation Lab’s SystemAge™ testing services. The Report may be delivered to you via the Portal, by email, or through other digital means.</p><p>The Report is for informational purposes only. Generation Lab makes no representations or warranties regarding the completeness, accuracy, or fitness for any particular purpose of the Report or its contents beyond those expressly stated in these Terms.</p><p>You are responsible for discussing your Report with a qualified healthcare provider. Generation Lab provides access to licensed providers through the Portal to facilitate this process, but such appointments are between you and your chosen provider.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">5. The Portal — Platform Features</h2><p>The Portal is Generation Lab’s digital platform and may include the following features, which may evolve over time:</p><ul class="list-disc list-inside md:list-outside ml-4 md:ml-8 space-y-2"><li><strong>Report Storage<!-- -->:</strong> <!-- -->Your Reports are stored in your account for your reference. You may access, download, or share them at your discretion.</li><li><strong>Provider Consultation Appointments<!-- -->:</strong> <!-- -->You may book appointments with licensed healthcare providers through the Portal. These appointments may be conducted via telehealth video or audio consultation on the Platform.</li><li><strong>Telehealth Consultations<!-- -->:</strong> <!-- -->Any consultation conducted through the Portal is a direct engagement between you and your chosen provider. Generation Lab provides the technology platform only and is not a party to the clinical encounter. Your provider has their own independent obligations to you, including those arising under applicable laws and their professional licensing requirements.</li><li><strong>Future Features<!-- -->:</strong> <!-- -->Generation Lab may add features to the Portal from time to time. Such features will be subject to these Terms and any additional terms presented at the time of introduction.</li></ul><p>Appointments or consultations conducted through the Portal may be subject to fees payable to the provider or to Generation Lab as a platform fee. Any fees will be disclosed prior to booking.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">6. Accounts and Registration</h2><p>You may be required to register an account to access certain features of the Platform. You agree to provide accurate, current, and complete information and to maintain the confidentiality of your account credentials. You are responsible for all activity that occurs under your account.</p><p><strong>Registration on your behalf.</strong> A kit may be registered by you directly, or by an authorized party such as a healthcare provider or clinic acting on your behalf. If a kit is registered on your behalf, that party represents and warrants that they have obtained your authorization to register the kit and to confirm your acceptance of the applicable consents, including that you have reviewed and accepted the Test Consent and have been given the opportunity to accept or decline the optional Research Consent. Consents confirmed at registration bind you as the test-taker regardless of who completes the registration.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">7. Additional Terms and Consents</h2><p>Your use of Generation Lab’s products or services is also subject to:</p><ul class="list-disc list-inside md:list-outside ml-4 md:ml-8 space-y-2"><li>Test Consent (required before using a test kit)</li><li>Research Consent (optional; participation in Generation Lab Research is voluntary and is not required to use a test kit)</li><li>Client Master Services Agreement (MSA), where applicable</li></ul><p>In the event of a conflict between these Terms and an applicable MSA, the MSA will control for clients.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">8. User Conduct</h2><p>You agree not to:</p><ul class="list-disc list-inside md:list-outside ml-4 md:ml-8 space-y-2"><li>Use the Platform for unlawful or fraudulent purposes</li><li>Submit false, misleading, or unauthorized information</li><li>Reverse engineer, decompile, or disassemble any part of the Platform</li><li>Copy, scrape, reproduce, or exploit any content without our written permission</li><li>Interfere with the Platform’s functionality or security</li></ul><p>We reserve the right to suspend or terminate your access if you violate these Terms.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">9. Intellectual Property</h2><p>All content on the Platform, including text, graphics, logos, interfaces, software, data, and the Report format and methodology, is owned by or licensed to Generation Lab and protected by applicable intellectual property laws. You may not use, modify, or distribute any content without our prior written consent.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">10. Data and Privacy</h2><p>All personal information collected through the Platform is subject to our Privacy Policy. Before a kit is registered, the test-taker must review and accept our Test Consent. Where a kit is registered by an authorized party, such as a healthcare provider, on the test-taker’s behalf, that party represents that they have the test-taker’s authorization and that the test-taker has reviewed and accepted the Test Consent. In both cases the test-taker will also be given the option to review and accept our Research Consent; participation in research is optional and is not required to register a kit.</p><p>You agree that Generation Lab may use de-identified or aggregated data derived from your use of the Platform or testing services to improve our services, conduct internal analytics, or support research, consistent with applicable laws and consents.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">11. Availability and Modifications</h2><p>We reserve the right to modify, suspend, or discontinue any aspect of the Platform at any time. We are not liable if all or part of the Platform is unavailable for any reason.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">12. Geographic and Legal Restrictions</h2><p>The Platform is intended for use only by individuals located in the United States or Canada. You agree not to access or use the Platform in jurisdictions where such use would be unlawful.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">13. Third-Party Services</h2><p>The Platform integrates or relies on certain third-party service providers for testing logistics and fulfillment. Generation Lab is not liable for the acts or omissions of third-party providers to the extent such acts or omissions are outside of Generation Lab’s reasonable control, provided that Generation Lab has contractually required such providers to meet appropriate service and data protection standards.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">14. Disclaimer of Warranties</h2><p>THE PLATFORM AND ALL CONTENT AND SERVICES ARE PROVIDED “AS IS” AND “AS AVAILABLE” WITHOUT WARRANTIES OF ANY KIND. TO THE MAXIMUM EXTENT PERMITTED BY LAW, GENERATION LAB DISCLAIMS ALL WARRANTIES, EXPRESS OR IMPLIED, INCLUDING MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, NON-INFRINGEMENT, AND ACCURACY OF INFORMATION. WHILE WE STRIVE TO PROVIDE A RELIABLE AND SECURE PLATFORM, WE DO NOT GUARANTEE THAT IT WILL BE ERROR-FREE, UNINTERRUPTED, OR COMPLETELY SECURE.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">15. Limitation of Liability</h2><p>TO THE FULLEST EXTENT PERMITTED BY LAW, GENERATION LAB AND ITS OFFICERS, DIRECTORS, EMPLOYEES, CONTRACTORS, AND AGENTS SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR EXEMPLARY DAMAGES ARISING FROM OR RELATED TO YOUR USE OF THE PLATFORM.</p><p>IN NO EVENT SHALL GENERATION LAB’S TOTAL LIABILITY EXCEED THE GREATER OF (A) ONE HUNDRED DOLLARS ($100), OR (B) THE AMOUNT YOU PAID TO GENERATION LAB IN THE TWELVE (12) MONTHS PRIOR TO THE CLAIM.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">16. Indemnification</h2><p>You agree to indemnify, defend, and hold harmless Generation Lab, its affiliates, and their respective officers, directors, employees, contractors, agents, and partners (including Spot Health Inc. and any third-party laboratories, physicians, and enterprise clients who offer Generation Lab services) from and against any and all claims, damages, obligations, losses, liabilities, costs, and expenses (including reasonable legal fees) arising from:</p><ul class="list-disc list-inside md:list-outside ml-4 md:ml-8 space-y-2"><li>your use or misuse of the Platform or services;</li><li>your violation of these Terms or any applicable law;</li><li>any content or information you submit through the Platform;</li><li>your use of any test result, Report, or interpretation outside of a clinical context or without consulting a qualified healthcare provider;</li><li>any claim arising from a telehealth consultation between you and a provider conducted through the Portal, to the extent such claim relates to your conduct or instructions;</li><li>or, if you are using the Platform as part of a program offered by an employer, insurer, healthcare provider, or another digital health company, any claim brought against such program sponsor relating to your use of Generation Lab’s services.</li></ul><h2 class="text-xl md:text-3xl mt-8 mb-5">17. Dispute Resolution and Arbitration</h2><p>Any dispute, claim, or controversy between you and Generation Lab arising out of or relating to these Terms or your use of the Platform shall be resolved exclusively through binding arbitration under the rules of the American Arbitration Association. The arbitration will take place in California, U.S.A., and will be conducted in English.</p><p>You agree to waive any right to a trial by jury or to participate in a class action.</p><p>This section shall not prevent Generation Lab from seeking injunctive or equitable relief in any court of competent jurisdiction.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">18. Governing Law</h2><p>These Terms are governed by and construed in accordance with the laws of the State of California and applicable U.S. federal law, without regard to conflict of law principles.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">19. Changes to Terms</h2><p>We may revise these Terms at any time. Material changes will be posted on the Platform and/or communicated to users. Your continued use of the Platform after such changes constitutes your acceptance of the revised Terms.</p><h2 class="text-xl md:text-3xl mt-8 mb-5">20. Contact Us</h2><p>If you have questions about these Terms, contact:</p><p>Generation Lab Inc.</p><p>Email:<!-- --> <a href="mailto:support@generationlab.com" class="underline">support@generationlab.com</a></p><p class="print-date">Date: <span></span></p></div></section></div><!--$--><!--/$--><footer class="relative z-20 bg-[#241400]"><div class="px-4 lg:px-10 py-10 text-white max-w-[1440px] mx-auto"><div class="mt-1 grid grid-cols-1 lg:grid-cols-3 gap-10 lg:pt-[100px]"><div class="flex flex-col justify-between"><div class="w-[330px]"><p class="text-white">Generation Lab</p><p class="text-white/60 mt-1">Slow your aging with the world's most accurate epigenetic test and personalized insights. 460 biomarkers, 21 organs and systems.</p><a class="rounded-full py-2 px-6 font-medium text-sm text-black cursor-pointer backdrop-blur-lg box-border secondary-button 