s test!!!"}],"hidden":false,"tag":"b"},{"tag":"#text","text":" "},{"attributes":{"class":"jdgm-rev__body"},"children":[{"children":[{"tag":"#text","text":"Love this test!!! I take it every 3 months to help track my aging and epigenetic biomarkers from home. No need to go get vials and vials of blood drawn for 10 biomarkers. This test analyzes over 100 with a tiny amount of blood which has been so awesome and reliably consistent in helping me track my health."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"div"},{"attributes":{"class":"jdgm-rev__custom-form"},"children":[{"tag":"#text","text":"  "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"   "},{"attributes":{"class":"jdgm-rev__transparency-badge-wrapper"},"children":[{"tag":"#text","text":"  "},{"attributes":{"class":"jdgm-rev__transparency-badge","data-badge-type":"review_collected_via_store_invitation","style":"display: inline-flex; align-items: center; padding: 4px 8px; margin-right: 2px; border-radius: 0px; border: 1px solid rgb(230, 230, 230); font-size: 12px; color: rgb(123, 123, 123);"},"children":[{"tag":"#text","text":"Review collected via store invitation"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"  "}],"hidden":false,"tag":"div"},{"tag":"#text","text":" "}],"hidden":false,"tag":"div"},{"tag":"#text","text":" "},{"attributes":{"class":"jdgm-rev__actions"},"children":[{"tag":"#text","text":" "},{"attributes":{"class":"jdgm-rev__social"},"hidden":false,"tag":"div"},{"tag":"#text","text":" "},{"attributes":{"class":"jdgm-rev__votes"},"hidden":false,"tag":"div"},{"tag":"#text","text":" "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"  "}],"hidden":false,"tag":"div"},{"attributes":{"class":"jdgm-rev jdgm-divider-top jdgm--done-setup","data-product-title":"TruAge™ Test","data-product-url":"/products/truage-complete-epigenetic-collection","data-review-id":"1c46d589-e3b4-4518-850d-bd1e2b85ca22","data-review-language":"","data-thumb-down-count":"0","data-thumb-up-count":"0","data-ve