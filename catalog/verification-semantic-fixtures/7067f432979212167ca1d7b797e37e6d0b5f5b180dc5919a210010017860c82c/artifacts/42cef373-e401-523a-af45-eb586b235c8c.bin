etails"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n  "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"section"},{"hidden":true,"tag":"script"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"shopify-section-template--27416866160925__compare_plans_table_YcbXQV","tag":"section"},{"attributes":{"class":"shopify-section"},"children":[{"attributes":{"href":"https://api.fontshare.com/v2/css?f[]=switzer@300,400,500&display=swap","media":"all","rel":"stylesheet"},"hidden":false,"tag":"link"},{"attributes":{"class":"faq-template--27416866160925__faq_accordion_Pj7mze","data-section-id":"template--27416866160925__faq_accordion_Pj7mze","data-section-type":"faq-accordion"},"children":[{"tag":"#text","text":"\n  "},{"attributes":{"class":"faq__inner"},"children":[{"tag":"#text","text":"\n    "},{"attributes":{"class":"faq__head"},"children":[{"attributes":{"class":"faq__eyebrow"},"children":[{"tag":"#text","text":"FAQ"}],"hidden":false,"tag":"p"},{"attributes":{"class":"faq__title"},"children":[{"tag":"#text","text":"Frequently asked questions"}],"hidden":false,"tag":"h2"},{"attributes":{"class":"faq__sub"},"children":[{"tag":"#text","text":"Everything you need to know before you order."}],"hidden":false,"tag":"p"},{"attributes":{"class":"faq__cta js-no-transition","href":"https://shop.trudiagnostic.com/products/truage-complete-epigenetic-collection#"},"children":[{"tag":"#text","text":"See full FAQ"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"header"},{"tag":"#text","text":"\n\n    "},{"attributes":{"class":"faq__list"},"children":[{"attributes":{"class":"faq__item"},"children":[{"tag":"#text","text":"\n            "},{"children":[{"tag":"#text","text":"What is the TruAge™ test, and how does it work?"}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n            "},{"attributes":{"class":"faq__answer"},"children":[{"children":[{"tag":"#text","text":"TruAge™ analyzes your epigenetics through DNA methylation — chemical changes to your DNA that shift predictably with age and lifestyle — the same medical-grade technology used in leading academic aging studies. From a single blood spot sample, it calculates your biological age, your aging speed, and the age of 11 individual organ systems using algorithms developed with Harvard, Yale, and Duke."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n          "}],"hidden":false,"tag":"details"},{"attributes":{"class":"faq__item"},"children":[{"tag":"#text","text":"\n            "},{"children":[{"tag":"#text","text":"What is included in my TruAge™ test results?"}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n            "},{"attributes":{"class":"faq__answer"},"children":[{"children":[{"tag":"#text","text":"TruAge™ shows you what your chronological age can't: how fast your body is actually aging, and where to focus. You'll see your overall biological age, your pace of aging, and organ-specific scores across 11 systems — plus personalized, science-backed recommendations you can act on. Retesting over time lets you see whether the changes you're making are actually working."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n          "}],"hidden":false,"tag":"details"},{"attributes":{"class":"faq__item"},"children":[{"tag":"#text","text":"\n            "},{"children":[{"tag":"#text","text":"Who should take TruAge™?"}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n            "},{"attributes":{"class":"faq__answer"},"children":[{"children":[{"tag":"#text","text":"TruAge™ is built for adults who want a clear, data-driven picture of how they're aging — whether you're optimizing an existing health routine, working with a longevity-focused provider, or just curious how your lifestyle is showing up at the cellular level. No prescription or diagnosis required to take it."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n          "}],"hidden":false,"tag":"details"},{"attributes":{"class":"faq__item"},"children":[{"tag":"#text","text":"\n            "},{"children":[{"tag":"#text","text":"How accurate is TruAge™?"}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n            "},{"attributes":{"class":"faq__answer"},"children":[{"children":[{"tag":"#text","text":"TruAge™ has a 98% test-retest reproducibility, meaning the same sample analyzed twice will return consistent results. The test is built on algorithms validated across more than 50 peer-reviewed publications, 80 academic collaborations, and over 100,000 processed samples."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n          "}],"hidden":false,"tag":"details"},{"attributes":{"class":"faq__item"},"children":[{"tag":"#text","text":"\n            "},{"children":[{"tag":"#text","text":"How often should I retest?"}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n            "},{"attributes":{"class":"faq__answer"},"children":[{"children":[{"tag":"#text","text":"Because biological age responds to lifestyle changes, many customers retest every 3–6 months to track progress — which is why we offer a 4-test annual subscription at a discount over one-time purchases."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n          "}],"hidden":false,"tag":"details"},{"attributes":{"class":"faq__item"},"children":[{"tag":"#text","text":"\n            "},{"children":[{"tag":"#text","text":"Is TruAge™ HSA/FSA eligible?"}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n            "},{"attributes":{"class":"faq__answer"},"children":[{"children":[{"tag":"#text","text":"Yes, TruAge™ qualifies for HSA/FSA reimbursement."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n          "}],"hidden":false,"tag":"details"},{"attributes":{"class":"faq__item"},"children":[{"tag":"#text","text":"\n            "},{"children":[{"tag":"#text","text":"How is my data protected?"}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n            "},{"attributes":{"class":"faq__answer"},"children":[{"children":[{"tag":"#text","text":"Your sample and results are processed in a CLIA-certified lab and stored with industry-standard encryption and strict access controls."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n          "}],"hidden":false,"tag":"details"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n  "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"section"},{"tag":"#text","text":"\n\n\n"}],"hidden":false,"id":"shopify-section-template--27416866160925__faq_accordion_Pj7mze","tag":"section"},{"attributes":{"class":"shopify-section"},"children":[{"attributes":{"class":"index-section"},"children":[{"attributes":{"class":"page-width"},"children":[{"attributes":{"class":"shopify-block shopify-app-block"},"children":[{"tag":"#text","text":"\n\n\n"},{"attributes":{"style":"clear:both"},"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"jdgm-widget jdgm-review-widget jdgm--done-setup-widget","data-block-id":"AVFRxMVdsdElDQjY2T__judge_me_reviews_review_widget_ULG9U4","data-cart-eligible-template":"false","data-customer-logged-in":"false","data-empty-state":"empty_widget","data-entry-key":"review-widget/main.js","data-entry-point":"review_widget.js","data-id":"6621245997110","data-impressions-tracked":"true","data-product-id":"6621245997110","data-product-title":"TruAge™ Test","data-shop-average-rating":"4.64","data-shop-review-count":"190","data-shop-reviews":"false","data-shop-reviews-count":"0","data-widget":"review","data-widget-name":"review_widget","style":"max-width: 1200px; margin: 0 auto;"},"children":[{"tag":"#text","text":"\n\n  \n    \n      "},{"attributes":{"class":"jdgm-legacy-widget-content","style":""},"children":[{"tag":"#text","text":"\n        "},{"attributes":{"class":"jdgm-rev-widg"