{"tag":"#text","text":"Amazing kit!"}],"hidden":false,"tag":"b"},{"tag":"#text","text":" "},{"attributes":{"class":"jdgm-rev__body"},"children":[{"children":[{"tag":"#text","text":"TruAge Test was very amazing to check my DNA and everything about my health state that an ordinary or usual test could not detect. It gives me a report of health risk which from that I'll be able to manage from an early stage. The kit was sealed, and the direction is very straight forward. It has a complete paraphernalia form cotton to bandage."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"div"},{"attributes":{"class":"jdgm-rev__custom-form"},"children":[{"tag":"#text","text":"  "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"   "},{"attributes":{"class":"jdgm-rev__transparency-badge-wrapper"},"children":[{"tag":"#text","text":"  "},{"attributes":{"class":"jdgm-rev__transparency-badge","data-badge-type":"review_collected_from_store_visitor","style":"display: inline-flex; align-items: center; padding: 4px 8px; margin-right: 2px; border-radius: 0px; border: 1px solid rgb(230, 230, 230); font-size: 12px; color: rgb(123, 123, 123);"},"children":[{"tag":"#text","text":"Review collected from a store visitor"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"  "}],"hidden":false,"tag":"div"},{"tag":"#text","text":" "}],"hidden":false,"tag":"div"},{"tag":"#text","text":" "},{"attributes":{"class":"jdgm-rev__actions"},"children":[{"tag":"#text","text":" "},{"attributes":{"class":"jdgm-rev__social"},"hidden":false,"tag":"div"},{"tag":"#text","text":" "},{"attributes":{"class":"jdgm-rev__votes"},"hidden":false,"tag":"div"},{"tag":"#text","text":" "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"  "}],"hidden":false,"tag":"div"},{"attributes":{"class":"jdgm-rev jdgm-divider-top jdgm--done-setup","data-product-title":"TruAge™ Test","data-product-url":"/products/truage-complete-epigenetic-collection","data-review-id":"55de7bac-2fcd-45e5-a543-7dfba6adff87","data-review-language":""