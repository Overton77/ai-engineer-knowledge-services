se,"tag":"link"},{"attributes":{"class":"dd-template--27416866160925__deeper_dive_accordion_ikAifa","data-section-id":"template--27416866160925__deeper_dive_accordion_ikAifa","data-section-type":"deeper-dive-accordion"},"children":[{"tag":"#text","text":"\n  "},{"attributes":{"class":"dd__inner"},"children":[{"attributes":{"class":"dd__layout"},"children":[{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__left"},"children":[{"attributes":{"class":"dd__eyebrow"},"children":[{"tag":"#text","text":"Deeper dive"}],"hidden":false,"tag":"p"},{"attributes":{"class":"dd__title"},"children":[{"tag":"#text","text":"Go deeper on the science"}],"hidden":false,"tag":"h2"},{"attributes":{"class":"dd__sub"},"children":[{"tag":"#text","text":"Every report inside your TruAge results, explained in detail."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n\n        "},{"attributes":{"class":"dd__right"},"children":[{"tag":"#text","text":"\n          "},{"attributes":{"class":"dd__list"},"children":[{"attributes":{"class":"dd__item"},"children":[{"tag":"#text","text":"\n    "},{"children":[{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__icon"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/hourglass-01.svg?v=1786611798"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__label"},"children":[{"tag":"#text","text":"OMICmAge™: Biological Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"hidden":true,"tag":"span"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n    "},{"attributes":{"class":"dd__body"},"children":[{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"Discover your biological age through the most advanced and predictive aging algorithm ever created; OMICmAge™, developed by TruDiagnostic™ in partnership with Harvard University."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"OMICmAge™ is exciting healthcare providers and patients alike because it provides novel insights into the reasons why someone is experiencing advanced aging. Older analysis was limited in the nature of only being able to determine if a patient's age and biological aging was accelerated or decelerated. Now we can not only tell you your biological age, but also what is most likely contributing to an age acceleration!"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"This report includes the following:"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"\n        "},{"children":[{"tag":"#text","text":"Your OMICm Biological Age"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n        "},{"children":[{"tag":"#text","text":"Your Methylation Risk Scores for Various Proteins"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n        "},{"children":[{"tag":"#text","text":"Your Methylation Risk Scores for Various Metabolites"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n        "},{"children":[{"tag":"#text","text":"Your Methylation Risk Scores for Clinical Biomarkers"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n      "}],"hidden":false,"tag":"ul"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"PLUS - Discover whether your methylation risk scores for various, multi-omic measurements are correlated with a higher or lower biological age. This report also calculates what your risk of death and disease would be if your biological age increases or decreases by one to several years."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n  "}],"hidden":false,"tag":"details"},{"tag":"#text","text":"\n  "},{"attributes":{"class":"dd__item"},"children":[{"tag":"#text","text":"\n    "},{"children":[{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__icon"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/speedometer-04.svg?v=1786611798"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__label"},"children":[{"tag":"#text","text":"DunedinPACE™: Aging Speed"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"hidden":true,"tag":"span"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n    "},{"attributes":{"class":"dd__body"},"children":[{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"Discover how fast or slow your body is currently aging! Results are reported in a fashion that compares your pace of aging to 1 standard calendar year. For example, if your results are '0.8', that means your body is currently aging 0.8 years for each year that passes."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"In our Pace of Aging report, we use the exclusively-licensed DunedinPACE™ algorithm to calculate your current speed of aging."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"This algorithm is the product of the on-going and renowned Dunedin Multidisciplinary Health and Development Study, where researchers have followed the lives and aging patterns of 1,037 people born between 1972, and 1973 at Queen Mary Maternity Hospital, in Dunedin, New Zealand."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"The study is now in its fifth decade and has produced a considerable amount of data that shapes what we know about the pace at which humans age, along with phenotypic expressions of aging; yielding the only 3rd generation aging technology currently available."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n  "}],"hidden":false,"tag":"details"},{"tag":"#text","text":"\n  "},{"attributes":{"class":"dd__item"},"children":[{"tag":"#text","text":"\n    "},{"children":[{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__icon"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/activity.svg?v=1786611798"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__label"},"children":[{"tag":"#text","text":"SYMPHONYAge™: Organ Systems"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"hidden":true,"tag":"span"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n    "},{"attributes":{"class":"dd__body"},"children":[{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"SYMPHONYAge™ is available exclusively through TruDiagnostic™. Access it by purchasing a new TruAge™ COMPLETE test or upgrading a previous COMPLETE analysis."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"Discover aging insights on eleven organ systems with SYMPHONYAge™, using Yale University's system-specific, epigenetic aging algorithms. TruDiagnostic™ exclusively offers the SYMPHONYAge™ clock series to deliver both individual and interconnected organ aging insights in our new SYMPHONYAge™ report."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"Upgrade your previous TruAge™ COMPLETE test(s) to gain digital access to the epigenetic age calculations in our SYMPHONYAge™ reports, including age for your SymphonyAge and 11 organ systems:"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__chips"},"children":[{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Left_Icon-9.svg?v=1786611891"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Brain Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Left_Icon-8.svg?v=1786611890"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Blood Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Left_Icon-7.svg?v=1786611891"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Heart Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Vector-1.svg?v=1786611891"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Lung Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Left_Icon-6.svg?v=1786611891"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Liver Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Left_Icon-5.svg?v=1786611891"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Hormone Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Left_Icon-4.svg?v=1786611891"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Metabolic Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Vector_bdb9cfd0-3448-48da-89da-ffab26574d38.svg?v=1786611891"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Kidney Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/immune.svg?v=1786611798"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Immunity Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Left_Icon-2.svg?v=1786611891"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Inflammation Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Left_Icon-1.svg?v=1786611891"},"hidden":false,"tag":"img"},{"tag":"#text","text":"Musculoskeletal Age"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n        "},{"attributes":{"class":"dd__chip"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Left_Icon_3ff4951e-833b-4050-9be6-466065aef0c4.svg?v=1786611891"},"hidden":false,"tag":"img"},{"tag":"#text","text":"SymphonyAge"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n  "}],"hidden":false,"tag":"details"},{"tag":"#text","text":"\n  "},{"attributes":{"class":"dd__item"},"children":[{"tag":"#text","text":"\n    "},{"children":[{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__icon"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/immune.svg?v=1786611798"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__label"},"children":[{"tag":"#text","text":"Immune Cell Deconvolution"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"hidden":true,"tag":"span"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n    "},{"attributes":{"class":"dd__body"},"children":[{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"The Immune Cell Deconvolution report breaks down the different types of immune cells present in a person's blood, giving insights into how the immune system is functioning."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"By analyzing the DNA methylation patterns, the report can estimate the proportion of various immune cells (like T-cells, B-cells, and macrophages) and track changes that may indicate immune system aging or dysfunction."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"This analysis helps in understanding how the immune system is involved in the aging process and its response to lifestyle or medical interventions."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n  "}],"hidden":false,"tag":"details"},{"tag":"#text","text":"\n  "},{"attributes":{"class":"dd__item"},"children":[{"tag":"#text","text":"\n    "},{"children":[{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__icon"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/Vector_7691313f-4914-4747-ac17-cb8e5eec65fd.svg?v=1786611797"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__label"},"children":[{"tag":"#text","text":"Telomere Length"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"hidden":true,"tag":"span"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n    "},{"attributes":{"class":"dd__body"},"children":[{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"Telomeres are an essential part of human cells that affect how our cells age. Telomere length has emerged as an important determinant of replicative senescence and cell fate - an important indicator of the aging process and a wide range of disease states, including cancers, cardiovascular disease, and age-related disorders."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n  "}],"hidden":false,"tag":"details"},{"tag":"#text","text":"\n  "},{"attributes":{"class":"dd__item"},"children":[{"tag":"#text","text":"\n    "},{"children":[{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__icon"},"children":[{"attributes":{"alt":"","loading":"lazy","src":"https://cdn.shopify.com/s/files/1/0269/3332/9974/files/alert-triangle.svg?v=1786611798"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"attributes":{"class":"dd__label"},"children":[{"tag":"#text","text":"Alcohol & Smoking Impact"}],"hidden":false,"tag":"span"},{"tag":"#text","text":"\n      "},{"hidden":true,"tag":"span"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"summary"},{"tag":"#text","text":"\n    "},{"attributes":{"class":"dd__body"},"children":[{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"Understand how drinking alcohol speeds up the aging processes of your skin, blood, and liver, as well as how it impacts your overall, biological aging processes."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"Learn how your lifetime alcohol consumption, as well as current drinking habits, affect your DNA expression. Our Alcohol Consumption report also breaks down the latest research on how long it would take an average person to reverse the damage of drinking, through abstinence."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"The Smoking Risk report analyzes DNA methylation patterns to assess the impact of smoking on your biological age and long-term health risks."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"By examining specific biomarkers in your DNA that are influenced by smoking, the report can reveal if smoking—whether current or in the past—has accelerated your biological aging process. This detailed analysis also highlights the potential long-term health consequences associated with smoking, such as increased risks for conditions like cardiovascular disease, lung disease, and cancer."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n      "},{"children":[{"tag":"#text","text":"The report provides actionable insights, helping you understand how smoking has affected your health and what lifestyle changes might help mitigate these risks."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n    "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n  "}],"hidden":false,"tag":"details"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n        "}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n      "}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"section"},{"tag":"#text","text":"\n\n\n"}],"hidden":false,"id":"shopify-section-template--27416866160925__deeper_dive_accordion_ikAifa","tag":"section"},{"attributes":{"class":"shopify-section"},"children":[{"attributes":{"href":"https: