"text":"View Sample Report"}]},{"tag":"button","hidden":false,"attributes":{"type":"button","class":"hover:opacity-60 active:opacity-50","aria-label":"Dismiss banner"},"children":[{"tag":"span","hidden":false,"attributes":{"class":"nk-text-md text-nk-warm-brown-500 underline lg:hidden"},"children":[{"tag":"#text","text":"Dismiss"}]}]}]}]}]}]},{"tag":"div","hidden":false,"attributes":{"class":"tos-pp-page-wrapper leading-normal"},"children":[{"tag":"script","hidden":true},{"tag":"section","hidden":false,"attributes":{"class":"bg-neutral py-8 print:hidden"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"container mx-auto px-4"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"flex space-x-4 justify-center items-center"},"children":[{"tag":"a","hidden":false,"attributes":{"class":"px-4 md:px-6 py-2 rounded-full transition-all duration-300 bg-gradient-to-r from-[#C3A06B] to-[#905E12] text-white font-medium","href":"https://www.generationlab.com/terms-of-service"},"children":[{"tag":"#text","text":"Terms of Service"}]},{"tag":"a","hidden":false,"attributes":{"class":"px-4 md:px-6 py-2 rounded-full transition-all duration-300 bg-white border border-[#C3A06B] text-[#C3A06B] hover:bg-[#F9F5F0]","href":"https://www.generationlab.com/terms-of-service?type=provider"},"children":[{"tag":"#text","text":"Provider Agreement"}]}]}]}]},{"tag":"section","hidden":false,"attributes":{"class":"md:p-20 px-3 py-10 w-full  undefined"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"container relative md:max-w-7xl max-w-lg m-auto h-full","style":"opacity: 1; translate: none; rotate: none; scale: none; transform: translate(0px, 0px);"},"children":[{"tag":"h1","hidden":false,"attributes":{"class":"text-3xl md:text-5xl mb-2 text-center"},"children":[{"tag":"#text","text":"Website and Platform Terms of Service"}]},{"tag":"p","hidden":false,"attributes":{"class":"text-lg text-center"},"children":[{"tag":"#text","text":"Last Revised: July 29, 2026"}]},{"tag":"div","hidden":false,"attributes":{"class":"flex justify-end mt-4 gap-2 container relative px-2 md:max-w-7xl max-w-lg m-auto h-full print:hidden"},"children":[{"tag":"button","hidden":false,"attributes":{"class":"border border-[#C3A06B] text-[#C3A06B] px-4 py-2 rounded-full flex items-center gap-2 shadow-sm transition","type":"button"},"children":[{"tag":"#text","text":"Print"}]},{"tag":"a","hidden":false,"attributes":{"href":"https://generation-lab-email-assets.s3.us-east-1.amazonaws.com/legal-documents/Generation%20Lab%20Terms%20of%20Service%20-%202026-07-29.pdf","target":"_blank","rel":"noopener noreferrer","class":"border border-[#C3A06B] text-[#C3A06B] px-4 py-2 rounded-full flex items-center gap-2 shadow-sm transition cursor-pointer"},"children":[{"tag":"#text","text":"Download"}]}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"1. Overview"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"These Website and Platform Terms of Service (“Terms”) govern your access to and use of all digital services and properties provided by Generation Lab Inc. (“Generation Lab,” “we,” “us,” or “our”), including:"}]},{"tag":"ul","hidden":false,"attributes":{"class":"list-disc list-inside md:list-outside ml-4 md:ml-8 space-y-2"},"children":[{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Our website(s) and any content or functionality offered therein;"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Our test kit registration and fulfillment interface;"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"The Generation Lab Report (the personalized epigenetic aging report produced following your test, “the Report”), whether delivered digitally, via the Portal, or independently;"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"The Generation Lab Portal, a digital platform through which you may store and access your Reports, book provider appointments, conduct telehealth consultations, and access other platform features as they become available (collectively, “the Portal”)."}]}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"These Terms apply to all users of the foregoing, including test-takers, visitors, and account holders. Together, the website, test kit interface, Report, and Portal are referred to as the “Platform.”"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"By accessing or using the Platform, you agree to be bound by these Terms and our"},{"tag":"#text","text":" "},{"tag":"a","hidden":false,"attributes":{"class":"underline","href":"https://www.generationlab.com/privacy-policy"},"children":[{"tag":"#text","text":"Privacy Policy"}]},{"tag":"#text","text":". If you do not agree, you must not use the Platform."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Testing logistics and fulfillment services are provided by Spot Health Inc. (“Spot Health”) as a contracted service provider to Generation Lab. As between Generation Lab and Spot Health, Generation Lab is the primary party responsible to you for the services described herein."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"2. Eligibility"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"You must be at least 18 years old (or the age of majority in your jurisdiction) to use the Platform, unless you are a minor using the Platform with the informed consent of a parent or legal guardian. By using the Platform, you represent and warrant that you meet these eligibility requirements and that you are located in the United States or Canada."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"3. No Medical Advice"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Generation Lab does not practice medicine or provide medical advice. Nothing on the Platform — including the Report, any recommendations, provider matching, or communications — constitutes medical care, diagnosis, or treatment."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The Report contains personalized pre-clinical observations about biomarkers of aging and may surface common approaches associated with improving the health functions where you are showing signs of biological aging. These observations and approaches are informational and pre-clinical in nature. The Report clearly identifies these as pre-clinical recommendations that should not be acted upon without first consulting a qualified healthcare provider."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Always consult a licensed healthcare provider before making any medical decisions based on your Report or any other content on the Platform."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"4. The Report"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The Report is a personalized document generated from your test results. It is the output of Generation Lab’s SystemAge™ testing services. The Report may be delivered to you via the Portal, by email, or through other digital means."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The Report is for informational purposes only. Generation Lab makes no representations or warranties regarding the completeness, accuracy, or fitness for any particular purpose of the Report or its contents beyond those expressly stated in these Terms."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"You are responsible for discussing your Report with a qualified healthcare provider. Generation Lab provides access to licensed providers through the Portal to facilitate this process, but such appointments are between you and your chosen provider."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"5. The Portal — Platform Features"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The Portal is Generation Lab’s digital platform and may include the following features, which may evolve over time:"}]},{"tag":"ul","hidden":false,"attributes":{"class":"list-disc list-inside md:list-outside ml-4 md:ml-8 space-y-2"},"children":[{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Report Storage"},{"tag":"#text","text":":"}]},{"tag":"#text","text":" "},{"tag":"#text","text":"Your Reports are stored in your account for your reference. You may access, download, or share them at your discretion."}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Provider Consultation Appointments"},{"tag":"#text","text":":"}]},{"tag":"#text","text":" "},{"tag":"#text","text":"You may book appointments with licensed healthcare providers through the Portal. These appointments may be conducted via telehealth video or audio consultation on the Platform."}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Telehealth Consultations"},{"tag":"#text","text":":"}]},{"tag":"#text","text":" "},{"tag":"#text","text":"Any consultation conducted through the Portal is a direct engagement between you and your chosen provider. Generation Lab provides the technology platform only and is not a party to the clinical encounter. Your provider has their own independent obligations to you, including those arising under applicable laws and their professional licensing requirements."}]},{"tag":"li","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Future Features"},{"tag":"#text","text":":"}]},{"tag":"#text","text":" "},{"tag":"#text","text":"Generation Lab may add features to the Portal from time to time. Such features will be subject to these Terms and any additional terms presented at the time of introduction."}]}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Appointments or consultations conducted through the Portal may be subject to fees payable to the provider or to Generation Lab as a platform fee. Any fees will be disclosed prior to booking."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"6. Accounts and Registration"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"You may be required to register an account to access certain features of the Platform. You agree to provide accurate, current, and complete information and to maintain the confidentiality of your account credentials. You are responsible for all activity that occurs under your account."}]},{"tag":"p","hidden":false,"children":[{"tag":"strong","hidden":false,"children":[{"tag":"#text","text":"Registration on your behalf."}]},{"tag":"#text","text":" A kit may be registered by you directly, or by an authorized party such as a healthcare provider or clinic acting on your behalf. If a kit is registered on your behalf, that party represents and warrants that they have obtained your authorization to register the kit and to confirm your acceptance of the applicable consents, including that you have reviewed and accepted the Test Consent and have been given the opportunity to accept or decline the optional Research Consent. Consents confirmed at registration bind you as the test-taker regardless of who completes the registration."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"7. Additional Terms and Consents"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Your use of Generation Lab’s products or services is also subject to:"}]},{"tag":"ul","hidden":false,"attributes":{"class":"list-disc list-inside md:list-outside ml-4 md:ml-8 space-y-2"},"children":[{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Test Consent (required before using a test kit)"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Research Consent (optional; participation in Generation Lab Research is voluntary and is not required to use a test kit)"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Client Master Services Agreement (MSA), where applicable"}]}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"In the event of a conflict between these Terms and an applicable MSA, the MSA will control for clients."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"8. User Conduct"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"You agree not to:"}]},{"tag":"ul","hidden":false,"attributes":{"class":"list-disc list-inside md:list-outside ml-4 md:ml-8 space-y-2"},"children":[{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Use the Platform for unlawful or fraudulent purposes"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Submit false, misleading, or unauthorized information"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Reverse engineer, decompile, or disassemble any part of the Platform"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Copy, scrape, reproduce, or exploit any content without our written permission"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"Interfere with the Platform’s functionality or security"}]}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"We reserve the right to suspend or terminate your access if you violate these Terms."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"9. Intellectual Property"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"All content on the Platform, including text, graphics, logos, interfaces, software, data, and the Report format and methodology, is owned by or licensed to Generation Lab and protected by applicable intellectual property laws. You may not use, modify, or distribute any content without our prior written consent."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"10. Data and Privacy"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"All personal information collected through the Platform is subject to our Privacy Policy. Before a kit is registered, the test-taker must review and accept our Test Consent. Where a kit is registered by an authorized party, such as a healthcare provider, on the test-taker’s behalf, that party represents that they have the test-taker’s authorization and that the test-taker has reviewed and accepted the Test Consent. In both cases the test-taker will also be given the option to review and accept our Research Consent; participation in research is optional and is not required to register a kit."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"You agree that Generation Lab may use de-identified or aggregated data derived from your use of the Platform or testing services to improve our services, conduct internal analytics, or support research, consistent with applicable laws and consents."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"11. Availability and Modifications"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"We reserve the right to modify, suspend, or discontinue any aspect of the Platform at any time. We are not liable if all or part of the Platform is unavailable for any reason."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"12. Geographic and Legal Restrictions"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The Platform is intended for use only by individuals located in the United States or Canada. You agree not to access or use the Platform in jurisdictions where such use would be unlawful."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"13. Third-Party Services"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"The Platform integrates or relies on certain third-party service providers for testing logistics and fulfillment. Generation Lab is not liable for the acts or omissions of third-party providers to the extent such acts or omissions are outside of Generation Lab’s reasonable control, provided that Generation Lab has contractually required such providers to meet appropriate service and data protection standards."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"14. Disclaimer of Warranties"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"THE PLATFORM AND ALL CONTENT AND SERVICES ARE PROVIDED “AS IS” AND “AS AVAILABLE” WITHOUT WARRANTIES OF ANY KIND. TO THE MAXIMUM EXTENT PERMITTED BY LAW, GENERATION LAB DISCLAIMS ALL WARRANTIES, EXPRESS OR IMPLIED, INCLUDING MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, NON-INFRINGEMENT, AND ACCURACY OF INFORMATION. WHILE WE STRIVE TO PROVIDE A RELIABLE AND SECURE PLATFORM, WE DO NOT GUARANTEE THAT IT WILL BE ERROR-FREE, UNINTERRUPTED, OR COMPLETELY SECURE."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"15. Limitation of Liability"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"TO THE FULLEST EXTENT PERMITTED BY LAW, GENERATION LAB AND ITS OFFICERS, DIRECTORS, EMPLOYEES, CONTRACTORS, AND AGENTS SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR EXEMPLARY DAMAGES ARISING FROM OR RELATED TO YOUR USE OF THE PLATFORM."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"IN NO EVENT SHALL GENERATION LAB’S TOTAL LIABILITY EXCEED THE GREATER OF (A) ONE HUNDRED DOLLARS ($100), OR (B) THE AMOUNT YOU PAID TO GENERATION LAB IN THE TWELVE (12) MONTHS PRIOR TO THE CLAIM."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"16. Indemnification"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"You agree to indemnify, defend, and hold harmless Generation Lab, its affiliates, and their respective officers, directors, employees, contractors, agents, and partners (including Spot Health Inc. and any third-party laboratories, physicians, and enterprise clients who offer Generation Lab services) from and against any and all claims, damages, obligations, losses, liabilities, costs, and expenses (including reasonable legal fees) arising from:"}]},{"tag":"ul","hidden":false,"attributes":{"class":"list-disc list-inside md:list-outside ml-4 md:ml-8 space-y-2"},"children":[{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"your use or misuse of the Platform or services;"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"your violation of these Terms or any applicable law;"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"any content or information you submit through the Platform;"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"your use of any test result, Report, or interpretation outside of a clinical context or without consulting a qualified healthcare provider;"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"any claim arising from a telehealth consultation between you and a provider conducted through the Portal, to the extent such claim relates to your conduct or instructions;"}]},{"tag":"li","hidden":false,"children":[{"tag":"#text","text":"or, if you are using the Platform as part of a program offered by an employer, insurer, healthcare provider, or another digital health company, any claim brought against such program sponsor relating to your use of Generation Lab’s services."}]}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"17. Dispute Resolution and Arbitration"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Any dispute, claim, or controversy between you and Generation Lab arising out of or relating to these Terms or your use of the Platform shall be resolved exclusively through binding arbitration under the rules of the American Arbitration Association. The arbitration will take place in California, U.S.A., and will be conducted in English."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"You agree to waive any right to a trial by jury or to participate in a class action."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"This section shall not prevent Generation Lab from seeking injunctive or equitable relief in any court of competent jurisdiction."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"18. Governing Law"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"These Terms are governed by and construed in accordance with the laws of the State of California and applicable U.S. federal law, without regard to conflict of law principles."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"19. Changes to Terms"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"We may revise these Terms at any time. Material changes will be posted on the Platform and/or communicated to users. Your continued use of the Platform after such changes constitutes your acceptance of the revised Terms."}]},{"tag":"h2","hidden":false,"attributes":{"class":"text-xl md:text-3xl mt-8 mb-5"},"children":[{"tag":"#text","text":"20. Contact Us"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"If you have questions about these Terms, contact:"}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Generation Lab Inc."}]},{"tag":"p","hidden":false,"children":[{"tag":"#text","text":"Email:"},{"tag":"#text","text":" "},{"tag":"a","hidden":false,"attributes":{"href":"mailto:support@generationlab.com","class":"underline"},"children":[{"tag":"#text","text":"support@generationlab.com"}]}]},{"tag":"p","hidden":false,"attributes":{"class":"print-date"},"children":[{"tag":"#text","text":"Date: "},{"tag":"span","hidden":false}]}]}]}]},{"tag":"footer","hidden":false,"attributes":{"class":"relative z-20 bg-[#241400]"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"px-4 lg:px-10 py-10 text-white max-w-[1440px] mx-auto"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"mt-1 grid grid-cols-1 lg:grid-cols-3 gap-10 lg:pt-[100px]"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"flex flex-col justify-between"},"children":[{"tag":"div","hidden":false,"attributes":{"class":"w-[330px]"},"children":[{"tag":"p","hidden":false,"attributes":{"class":"text-white"},"children":[{"tag":"#text","text":"Generation Lab"}]},{"tag":"p","hidden":false,"attributes":{"class":"text-white/60 mt-1"},"children":[{"tag":"#text","text":"Slow your aging with the world's most accurate epigenetic test and personalized insights. 460 biomarkers, 21 organs and systems."}]},{"tag":"a","hidden":false,"attributes":{"class":"rounded-full py-2 px-6 font-medium text-sm text-black cursor-pointer backdrop-blur-lg box-border secondary-button flex justify-center items-center h-11 mt-4 lg:mt-8 w-full lg:w-fit max-w-[310px]","href":"https://www.generationlab.com/the-systemage-test"},"children":[{"tag":"span","hidden":false,"children":[{"tag":"#text","text":"Order Now "}]},{"tag":"span","hidden":false,"attributes":{"class":"text-[#243DE0]"},"children":[{"tag":"#text","text":"→"}]}]},{"tag":"div","hidden":fals