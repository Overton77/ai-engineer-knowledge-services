d"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg07710266"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg12518535"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg14400541"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg14657277"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg20037507"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg20445245"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg24201362"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg25734842"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg27219748"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg27317439"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"*"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tbody"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"table"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/table/t1/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"tw-foot p"},"children":[{"attributes":{"class":"fn"},"children":[{"children":[{"tag":"#text","text":"* Not characterized."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"_fn_p36","tag":"div"}],"hidden":false,"tag":"div"}],"hidden":false,"id":"t1","tag":"section"},{"children":[{"tag":"#text","text":"Next, we examined if DNAme noise, which we define as the age-imposed increase in SD of beta values, would self-manifest when we select cytosines solely based on their nearly-same methylation through chronology. We identified all the cytosines with less than 0.1% difference in the Means of their beta values between the young (25-28years) and the old (67+ years) individuals, in the healthy controls’ datasets of the studies on Down Syndrome, Arthritis, Parkinson’s, Multiple Sclerosis, IBS, and Werner Syndrome. A healthy change in cytosine noise is biologically expected as the immune system matures ["},{"attributes":{"aria-describedby":"r43","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r43"},"children":[{"tag":"#text","text":"43"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"r44","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r44"},"children":[{"tag":"#text","text":"44"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"], thus our young range is 25-28 years. These cytosines that are well-regulated through age were also cross-checked by having Pearson’s (r) 0.02-0.05 of beta values over age, e.g., excluding the zeroes of experimental errors; this approach yielded 460 cytosines that had minimal change in their Mean methylation with age. Interestingly and in agreement with our hypothesis, every one of these cytosines, whose methylation on average was age-invariable, manifested an increase in SD – DNAme noise with age, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD2"},"children":[{"tag":"#text","text":"Supplementary Data Excel"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". This unadjusted primary data had a good fit with a polynomial curve of chronological ages v. summed SD (Left Y Axis); and the non-linearity of the pattern compressed certain biological ages, which were mapped onto the Right Y axis by entering the summed SDs into the polynomial equation, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Next, we narrowed down the 460-cytosine set of the noise detectors to those which are most regulated in the young cohort and those least regulated in the young cohort; once again, identifying the cytosines with these properties that are shared between all studied six healthy controls’ datasets. Out of 450K array data, only 460 cytosines had nearly the same Mean of beta values in young and old cohorts, and out of these only 8 had SD of >0.015 of the "},{"children":[{"tag":"#text","text":"absolute"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" Mean and only 5 had SD of >0.015 of a "},{"children":[{"tag":"#text","text":"relative"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" (set to 1) Mean of their beta values, e.g., they were the most regulated. Very interestingly, all the 8 and 4 out of the 5 were highly methylated (beta values ~1) and the remaining one cytosine had beta value near 0 – unmethylated; none were in-between or partially methylated, even though the samples analyzed for cytosine methylation were of a mixed population of peripheral blood cells, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5D"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"5F"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"It is possible that these cytosines reflect loci that should be always completely silenced (say, controlling a different cell fate) or open (say, for housekeeping genes), regardless of the cell types of the circulating cells. In contrast, the cytosines that were the least regulated in the young cohort, 17 cytosines with SD of <0.3 of the "},{"children":[{"tag":"#text","text":"absolute"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" Mean and 13 cytosines with SD of <0.3 of a "},{"children":[{"tag":"#text","text":"relative"}],"hidden":false,"tag":"em"},{"tag":"#text","text":"=1 Mean, had a large range of methylation (spanning the 0-1 range of beta values), "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5D"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"5F"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Other least regulated cytosines are shown in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 4B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Annotations for the 5, 8, 13 and 17 cytosines – noise detectors are in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD2"},"children":[{"tag":"#text","text":"Supplementary Data Excel"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Summing the 8, or the 5, or the 17, or the 13 Means of the SDs for each 3-year age interval between 25 and over 80 years, established that each set detected a natural pattern of human biological aging with a progression of epigenetic noise that is low in young, high in old, and has healthy, low noise plateaus, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5E"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"5G"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" (each dot is 49 individuals on average, black arrows point to the 3-year interval before the upward transitions in noise). Interestingly, both the least and most regulated cytosines, which were identified as such by the two approaches in the young samples, became noisier with age, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5E"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"5G"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". 64-67 years and 49-52 years demarcated the upward shifts in biological noise (black arrows) for the 8 most- and 17 least-regulated cytosines, respectively, (the SD of the "},{"children":[{"tag":"#text","text":"absolute"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" Mean of beta values), "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5E"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". 41-44 years and the very early 29-32 years transitions from low to high biological noise (black arrows) were detected for the 5 most- and 13 least-regulated cytosines, respectively (SD of the "},{"children":[{"tag":"#text","text":"relative"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" Mean of beta values), "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5G"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We think of this measurement of noise increase with age as a barometer, implying epigenetic pressure on homeostatic gene regulation."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The 460 cytosines that had constant Means with age and the 50 cytosines found on average invariant yet noisier with age by linear regressions, were independent of the first-gen, PhenoAge and PACE EN cytosine sets, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5H"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The young-to-adult focused PACE cytosine set was also expectedly different from the full age-range focused first generation and PhenoAge models."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Next, we examined differences between health and disease, using the combined DNAme array data from the six studies by different laboratories. As mentioned, all 460 cytosines of noise barometer self-manifested higher SD of beta values in the old as compared to young, and 293 of these cytosines had at least 20% increase in their SDs with age. Interestingly and consistently with the fundamental paradigm of DNAme noise as a biomarker of aging and disease, summing the SDs of 460, 293 or 5 cytosines yielded similar patterns of healthy biological aging and the disease-imposed shifts, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"Figure 6A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Moreover, this pattern of biological aging and difference between health and disease were also yielded by SD of a single noise barometer cytosine (one of the most regulated in young), "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"Figure 6A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The overlap between health and disease at certain ages is expected from the overall elevation of diseases with age (not just those studied), and from the possibility of "},{"children":[{"tag":"#text","text":"pathologically diminished"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" biological noise in some disease stages due to reduced complexity of blood cells (less lymphocytes and greater prevalence of inflammatory macrophages)."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 6."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=10522373_aging-15-205046-g006.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 6","class":"graphic zoom-in","height":"440","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/e604/10522373/9ad4fa000d27/aging-15-205046-g006.jpg","width":"786"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/figure/f6/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"children":[{"tag":"#text","text":"The fundamental paradigm of noise barometer; DNAme clocks do not rely on DNAme noise. "}],"hidden":false,"tag":"strong"},{"tag":"#text","text":"("},{"children":[{"tag":"#text","text":"A"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Shown are polynomial fit curves of the chronological age v. sums of 460-, 293-, 5 SDs, SD and the dot plot line-fit of a single cytosine from the most regulated in young group, and the sums of 143, 448 SDs of all heteroscedastic cytosines with 20% or larger SD in old than young; the unfiltered 450K summed SDs are the black dot scatter that is overlaid with the 143, 448 (143K) line graph. These data are on the six combined datasets of patients with various diseases (red lines) and their healthy controls (blue lines). All noise detectors, but not the unfiltered 450K DNAme cytosines, outline a similar progression of biological aging of the healthy subjects, clearly distinguishing it from the disease-influenced changes. Each dot is the age range. ("},{"children":[{"tag":"#text","text":"B"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Dashed blue line shows the Median of summed SDs of three DNAme array healthy controls datasets that have the most samples (Arthritis, MS, and PD); this Median line is overlayed with the dot plots of each of these individual datasets, color-coded. Each dot is the age range. ("},{"children":[{"tag":"#text","text":"C"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Venn Diagrams show the presence of the 143K cytosines in the 50 and 460 noise barometers and in the DNAme EN clocks, color-coding is the same, as in Figure 5. ("},{"children":[{"tag":"#text","text":"D"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Scatter plots of the coefficient of variation of the cytosines’ SD regressed on age are plotted against their rank/EN weights for the published 1st generation clock, PhenoAge and PACE, ["},{"attributes":{"aria-describedby":"r1","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r1"},"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r5","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r5"},"children":[{"tag":"#text","text":"5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"f6","tag":"figure"},{"children":[{"tag":"#text","text":"Confirming that selection of noise detecting cytosines is important, sums of SDs of all cytosines from these six combined 450K DNAme array healthy controls’ datasets showed a random scatter through chronological age, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"Figure 6A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", each black dot is an age range. At the same time, in agreement with the fundamental nature of the noise / SD approach, 1/4"},{"children":[{"tag":"#text","text":"th"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":" of 450K DNAme array cytosines (143,448 cytosines) was found to be significantly heteroscedastic and having 20% or more increase of the SDs of their beta values with age. Summing the 143,448 SDs yielded a similar pattern of biological aging and disease-imposed shifts, as when using 460, 293, 5, or 1 cytosine(s), "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"Figure 6A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Similar shapes of the healthy curves and good resolution between health and disease in the combined data from six independent studies by different laboratories suggested batch effect resilience of our noise barometer. This was confirmed and extrapolated by comparing the three most numerous healthy control datasets (from the studies of Arthritis, Parkinson’s, and Multiple Sclerosis) in their biological aging curves, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"Figure 6B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD2"},"children":[{"tag":"#text","text":"Supplementary Data Excel"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Low batch effect was seen for the three individual healthy datasets, except in the 49-64 years age range, which could be due to a natural increase in DNAme dynamics from cumulatively diverging environments, habits, and diseases (not just those specifically studied), "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"Figure 6B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Based on Venn Diagrams, 460 cytosine noise detectors have the highest overlap with the global 143 thousand subset, followed by the 50 cytosine noise detectors and various EN DNAme clocks, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"Figure 6C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD2"},"children":[{"tag":"#text","text":"Supplementary Data Excel"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The pattern of healthy biological aging based on the 460 and 5 cytosines was also similar to that yielded by the 50 cytosines, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figures 5B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"6A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". And the 50 cytosines noise barometer demonstrated different curve shapes for different diseases, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 5A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". At the single levels, the most regulated cytosines – noise detectors had different patterns of their age-specific noise increase, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 5B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"Figure 6A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The natural biological aging curves of the combined health vs. combined disease that include the HIV dataset, are shown in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 5C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Since SD is the main parameter in our noise barometer, we also tested if EN clocks might be based on selection of cytosines that have higher SD of their beta values with age and/or disease. The regression analysis demonstrated that this is not the case for either the 1"},{"children":[{"tag":"#text","text":"st"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":" generation EN clock that is trained on age or for PhenoAge or for PACE that are trained on health/disease parameters ["},{"attributes":{"aria-describedby":"r1","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r1"},"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r5","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r5"},"children":[{"tag":"#text","text":"5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. Namely, there was a lack of correlation between the ranking (weighting) of the clock’s cytosines by the ENs and the changes of the SDs of their beta values with age, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"Figure 6D"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"These results suggest that biological age can be measured in a batch effect resilient approach through quantification of the SD of the methylation of cytosines that should-be-invariable, yet are age deregulated. The natural curve of biological aging defined by this approach is not linear; it has healthy low-noise plateaus and upward shifts at specific ages. In this method, DNAme noise is the biomarker and a particular set of cytosines is the detector of such biomarker. This method is different from and moreover, orthogonal to, the linear predictors that are based on population statistics. Importantly, regardless of the selection of all the cytosines that should-be-invariable (50, 460) or their subsets most or least regulated in young (1, 5, 8, 13, 17), an increase of biological noise with age was always observed, and there was never a high in young to low in old progression for any cytosine of the noise barometer."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec6","tag":"section"}],"hidden":false,"id":"sec2","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"DISCUSSION"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"In this work, we fail-tested the key concepts of ML, EN DNAme clocks, and as such, our conclusions should be broadly applicable to most/all variants of these approaches. Our data confirms that the general phenomenon of change with age, e.g., the distinction between young, middle age and the old, is accurately determined by ML population statistics. With respect to overall implications and unmet need, changes in health are routinely quantified by Student’s t-test, etc. statistics, of well-controlled, independently analyzed from start to finish, epigenetic, proteomic and other molecular and cellular analyses of blood samples. These allow single cell resolution and are confirmed through redundancy of experimental methods, guarding against misinterpretation of random variability or typical dynamics for the changes in health."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Standard biomedical analyses giving Mean, SD, and p-values from several independent start-to-finish studies do not permit the erroneous assumption that a sample from each person is an experiment in itself when a population was studied by aligning all samples, once. Through such standard analyses, we illustrate how batch effects and dynamics of DNAme might reduce the reproducibility and accuracy of the clocks, making these, at times, below statistical significance. Of note, small, poorly reproducible changes might appear significant, and the healthy group cannot be reliably used as a standard for a disease group, when p-values are calculated to diminish from the sheer number of samples in an n=1 study."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Regarding fundamental conclusions, it is well known that a 75-year-old person with high levels of C-reactive protein, or diminished albumin, or with obesity, or high cholesterol, is unhealthy and has an increased risk of mortality. EN regression finds correlation, not causality, and as we show here, it does not rely on the changes of cytosine methylation or dysregulation with age or disease. Thus, even though DNA me array data is used, the biological meaning of predictions remains uncertain. And as we illustrate with the size of US population, non-biological changes can be successfully predicted by the DNAme array datasets. Summarily, any set of regularly changed numerical values can be linearly predicted through EN training on any large data, biological or not, physically connected to the measured axis or not. If anybody is interested, an expansion of the Universe could be predicted from evolutionary DNAme array data. And a person’s health and age could be predicted with relatively good accuracy from expanding distance between the Galaxies, or anything that changes progressively over time."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Since the physical meaning of the training parameters is lost in EN process, any assumption that specific health scores, C-reactive protein levels, etc., are being predicted, is ambiguous, because in the model training, a decline in health, reaching mortality and the increase in age all have linear progressions designated as a regular series of numbers."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"In these regards, high throughput sequencing is routine, yet clock models are typically built from less-accurate DNA hybridization data. For reliable scientific or consumer information from EN and other ML approaches, several key controls are important, such as, 1) performing independent start to finish experiments with the same or near-same-time samples, that are analyzed on independently run DNAme arrays, and compared with different samples of the same chronological span, by independently trained EN models; 2) sequencing-normalized bisulfite sequencing controls on whether a clock’s cytosines change in their methylation when a person is predicted to be age/disease accelerated or at 2-4 years age intervals; 3) confirming the chromatin change near clock cytosines by ATAC-Seq, for example; 4) testing whether genes of clock cytosines change their expression (mRNA and protein levels) when a shift in biological age is predicted for a person; 5) confirming that the levels of specific proteins (GrimAge) or health scale are statistically different in 4-2-years ranges, or at the point of age acceleration."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Through our investigation, we describe a new quantification of biological age from DNAme, based on the noise of the most-regulated, age invariable cytosines. This approach fits well with the importance of age-specific increase in biological noise ["},{"attributes":{"aria-describedby":"r45","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r45"},"children":[{"tag":"#text","text":"45"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"] and it is the quantification of primary data without numerical adjustments, which improves on ML predictions. The points of increased DNAme noise turned out to be 49-52 and 64-67 years of age, and it would be very interesting to probe global omics at these transitional ages. Our noise barometer distinguishes health from disease and can potentially distinguish one pathology from another completely different pathology. The different time-shapes of different diseases might enable epidemiology of a specific disease in a population, based on the curve of epigenetic noise. The biological significance of noise-detector cytosines is clear and the effects of their deregulation with time and disease are expected to be many and deleterious. Namely, the likely reason for the noise-detectors cytosines to be on average invariable in their methylation with age is that they are in the regulatory regions of genes that are vital at constant levels, such as coding for ribosomal proteins, core transcriptional factors, E3 ligases, regulators of cholesterol and glucose metabolism, MAPK signaling, beta-catenin, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#t1"},"children":[{"tag":"#text","text":"Table 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The less-characterized loci of noise detector cytosines, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#t1"},"children":[{"tag":"#text","text":"Table 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD2"},"children":[{"tag":"#text","text":"Supplementary Data Excel"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", would be interesting to study for their involvement in biological aging. The paradigm shift is that no specific cytosine or gene is biomarks biological age, but it is the noise and dysregulation, e.g., it is not the expression levels or beta values, but the SD that are the basis of quantifying biological age and risk of disease. Accordingly, summing SD of either 143 thousand or 460, or 5 cytosines. or even SD of one cytosine noise detector, yields overall the same non-linear curve of DNAme aging and distinguishes health from disease. The noticeable plateaus of the DNAme aging emphasize that biological age is progressing non-linearly, in contrast to the chronological age, making accurate linear predictions problematic for certain age ranges. Quantification of the deviation from the healthy range seems to be more relevant and it is enabled by the noise barometer."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Reasonably accurate predictability of chronological age from DNA samples positions EN models as potential forensics tools, to inform on the age-ranges of suspects, as was indeed suggested. DNA methylation arrays enable rapid high throughput analysis and generally agree with bisulfate sequencing when the big changes are assayed, such as differences between cancer vs. cancer-free cohorts ["},{"attributes":{"aria-describedby":"r46","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r46"},"children":[{"tag":"#text","text":"46"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r48","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r48"},"children":[{"tag":"#text","text":"48"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. Yet, for a law enforcement degree of accuracy, it might be prudent to also perform higher resolution bisulfite sequencing, controlled by non-bisulfite sequencing, for testing the precision of the age predictions."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Lastly, the assignments of human biological age are typically based on blood samples, and while some patterns might be shared in different organs (for example, fibrosis and inflammation generally increase with age, which is not healthy) the overall biological age is determined by the "},{"children":[{"tag":"#text","text":"integrated"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" dynamics of divergent cell-fate gene regulation in the organism, which varies between the tissues, collectively influencing organismal metabolism, proteostasis, organelles, fibrosis, regeneration, etc."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The above should not be confused with predicting ages of different tissues and species ["},{"attributes":{"aria-describedby":"r49","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r49"},"children":[{"tag":"#text","text":"49"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]; in a similar fashion, changes in human health, population, and temperature can be collectively predicted, or any set of regularly changed numbers, through training EN on DNAme array or any large data."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec7","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"MATERIALS AND METHODS"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Methods"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Code protocols are at "},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://github.com/jeblanchard/DNAme-clocks-fail-tests-and-development-of-noise-barometer?search=1","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://github.com/jeblanchard/DNAme-clocks-fail-tests-and-development-of-noise-barometer?search=1"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec9","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Datasets"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Small (27K) model datasets"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE41037","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE41037"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, Schizophrenia and health patients, "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE41037","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE41037"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE20067","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE20067"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, type 1 diabetes with nephropathy and type 1 diabetes without neproprathy,"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE20067","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE20067"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE20236","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE20236"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, healthy females,"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE20236","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE20236"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE19711","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE19711"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, postmenopausal women with ovarian cancer and healthy controls,"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE19711","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE19711"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Medium (450K) model datasets"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE40279","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE40279"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, no labeled diseased samples - can interpret this to be an average population,"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE40279","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE40279"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Out-of-sample (450K) datasets"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE57285","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE57285"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, BRCA1 set, cancer, healthy mutants, and healthy wild types,"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE57285","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE57285"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE53840","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE53840"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, HIV set, all HIV+ males,"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE53840","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE53840"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE42861","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE42861"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": PBL, Rheumatoid arthritis set, rheumatoid arthritis and healthy controls,"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE42861","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE42861"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE32148","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE32148"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": Peripheral blood; Crohns’ disease, ulcerative colitis, and normal controls;"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE32148","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE32148"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE52588","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE52588"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, Down syndrome and healthy relatives as controls,"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE52588","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE52588"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE106648","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE106648"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": PBL, Multiple sclerosis with healthy controls"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE106648","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE106648"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE87640","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE87640"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, and MACS isolated CD4+, CD8+, CD14+ leukocytes; WB data were used in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"Figure 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", the entire dataset was used in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figures 5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"6"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figures 4"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Irritable bowel disease with healthy controls"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE87640","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE87640"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE72774","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE72774"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, Parkinson’s disease with healthy controls"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE72774","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE72774"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE100825","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE100825"}],"hidden":false,"tag":"a"},{"tag":"#text","text":": WB, Werner Syndrome with healthy controls"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE100825","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE100825"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec10","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Elastic net regression"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"To construct the small and medium EN models, we first did a random 80/20 split to get a training and testing set respectively. To create our models we used the ElasticNetCV class from the sklearn.linear model library. After standardizing the array data using the sklearn preprocessing function StandardScaler, we used ElasticNetCV’s built-in cross-validation functionality to find optimal values for the regression parameters alpha and l1 ratio (used in Scikit-learn’s EN regression) for each set of data. We used these parameters to also fit the randomized versions of these clocks. We then tested the predictive ability of these models on the test dataset. After the models were trained and tested, we also tested their performance on out-of-sample datasets. We followed the same data preprocessing procedure on out-of-sample datasets."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec11","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"DNAme EN predictor of US population"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We built a model that was able to predict the growth of US population, using the same dataset, "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE40279","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE40279"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", as well as the same training techniques as for in the standard age predictor, but instead of correlating with known ages of the donors of blood samples, this EN model predicts the number of people living in US at the time of the donors’ birth. Although we’re able to accurately predict the US population from the birth year of a sample based on the sample’s methylation data, there of course is no direct connection between one’s methylation data and the US population from their birth year. In other words, the methylation profile of an individual does not determine the US population at their birth."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec12","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Models 0 and 1"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The data were imported from the GEO database using the GEOparse package in Python. For "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE40279","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE40279"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", kernel density estimation plots for each GSM were compared to identify potential outliers. None were found and all samples were used. The data were split 80/20 into training and test sets respectively. The training set was scaled using StandardScaler in the Scikit-learn library. ElasticNetCV, with 10-fold cross validation (cv=10), was used to train an elastic net regression model. The l1 ratio was set to 0.5 and the alpha hyperparameter was learned from a set of ten using cross validation (n alphas = 10). To check model accuracy the test data were transformed using the training set StandardScaler fit prior to predictions."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec13","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"UMAP"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We employed conventional unsupervised Machine Learning algorithm and Uniform Manifold Approximation and Projection (UMAP) method to reduce the dimension of 482421 Cytosines ("},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE4027","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE4027"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") in each individual and compare the closeness between individuals in terms of Cytosines beta value. Proximity in low-dimensional UMAP space identifies groups of individuals that correspond to their health condition or disease type."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec14","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Retraining an elastic net model after removing non-significant cytosines"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The significant Cytosines of the elastic net model were identified by their non-zero weights. A modified dataset was made by removing these significant Cytosines and a new model was trained and tested with this modified dataset. We first trained an Elastic Net model, using the ElasticNetCV function from the “sklearn” python library with a trained alpha value, a L1 value of 0.5, a tolerance of 0.001, and a maximum iteration of 5000, on the "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE40279","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE40279"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" dataset used by the DNAm Clock developed by Hannum et al. and found that this model relies on 849 Clock cytosine’s. We then randomly removed non-clock cytosine’s from our dataset and retrained Elastic Net with the same parameters on datasets with 1-10% of non-clock cytosine’s removed in 1% intervals and on datasets with 10-100% of non-clock cytosine’s removed in 10% intervals. These novel datasets are created by independently removing, by selecting random integers with the “random” python library, the desired percent of cytosine’s from the original list of non-clock cytosine’s. These newly trained Elastic Net models are then simply analyzed with the python libraries “Sklearn”, “matplotlib”, and “pandas” to create "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f3"},"children":[{"tag":"#text","text":"Figure 3"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 3"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec15","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Gene annotations for cytosines, gene functions and families"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The gene/genome location of the cytosines and their annotations were taken from the Illumina HumanMethylation450 manifest. The gene functions and families were determined from the GeneCards and Entrez databases ("},{"attributes":{"class":"usa-link usa-link--external","data-ga-action":"click_feat_suppl","href":"https://www.genecards.org/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.genecards.org/"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/Web/Search/entrezfs.html","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/Web/Search/entrezfs.html"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec16","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Noise barometer"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"In approach one, to identify cytosines which are on average age-invariant but are age-deregulated, we performed regression analysis and selected cytosines with an individual correlation with age of 0.02 < r < 0.05. This yielded 6,282 cytosines out of 480,000. The mean beta values for each of the 6,282 cytosine was calculated and the absolute difference from the mean (ADM) was calculated ("},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#eq6"},"children":[{"tag":"#text","text":"Equation 6"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#eq7"},"children":[{"tag":"#text","text":"7"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Then for each cytosine, age was regressed on the ADMs and Cytosines with r < 0.2 were discarded. This yielded a set of 50 cytosines. The ADMs (surrogate for noise) of the 50 cytosines were summed for the young samples, and a normalizing factor (ζ) was calculated by taking the average of these sums ("},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#eq8"},"children":[{"tag":"#text","text":"Equation 8"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). A final noise score σ for all samples was calculated by summing the ADMs for each sample and then normalizing by ζ ("},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#eq9"},"children":[{"tag":"#text","text":"Equation 9"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Y axis biological age numbers were calculated through the polynomial fit for the median value of normalized sum for each age in the healthy control dataset. We set the noise score to be Y and find root, or the X values, from the polynomial equation."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"In approach two, to identify cytosines which are on average age-invariant, we calculated the Means of beta values of all cytosines of the six independent 450K array datasets, in the healthy cohorts, and selected the cytosines that had nearly same (>0.1% difference) Means in the young (25-28 years) and the old (<67 years) groups. This selection was then cross-checked by having Pearson’s (r) 0.02-0.05 of beta values over age, e.g., excluding the zeroes of experimental errors; this yielded 460 cytosines out of 480,000 that had such near same Mean in all six studies with the 450K DNAme arrays, in healthy subjects. These 460 cytosines where then narrowed down to those in all six datasets, healthy subjects, with the SD of 0.015 of the absolute and relative (set to 1) Means in the young cohort (highly regulated 8 and 5 cytosines) and those with the SD of 0.3 of the absolute and relative (set to 1) Means in the young cohort (least regulated 17 and 13 cytosines)."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"In approach three: Two filters were used: 1. Unequal variance, e.g., the heteroskedasticity test (White’s test) for each cytosine, finding all with significant (p < 0.05) unequal variance between old and young (there were 372509 of such cytosines); 2. Old (67+ years of age) SD > Young (25-28 years of age) SD by at least 20%; after the first plus second filters, 143448 cytosines remained from the 480k cytosines, e.g., the typical number of probes of the 450K DNA me array. This approach was also compared with summing SD of all 480K cytosines, e.g., the entire 450K DNAme array data. When analyzing the 143448 cytosines in the six combined datasets, some samples of the DNAme array had missing values for a few cytosines in some datasets; to ensure data consistency, all data for such samples was removed from the analyses and the plots. Polynomial curves were fit to the values, using np.polyfit function."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec17","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Direct test of the batch effect"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Polynomial curve was fitted to the chronological age v. Median of the 293 summed SDs (the 293 cytosines of the 460 group have at least 20% higher SD in the old than young cohort). Healthy control datasets of arthritis, Multiple Sclerosis and Parkinson’s were used for generating the Median curve and overlaying it with the scatter plot of each individual dataset. The three datasets were chosen because they have the most samples out of all other studied here datasets."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec18","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Availability of data and materials"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"All data sets used in this study are publicly available on NCBI’s GEO database, found at "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"https://www.ncbi.nlm.nih.gov/geo/"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Equations"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"tw xbox font-sm"},"children":[{"attributes":{"class":"tbl-box p","tabindex":"0"},"children":[{"attributes":{"class":"content","frame":"box","rules":"all"},"children":[{"tag":"#text","text":"\n"},{"children":[{"attributes":{"span":"1","width":"90%"},"hidden":false,"tag":"col"},{"tag":"#text","text":"\n"},{"attributes":{"span":"1","width":"10%"},"hidden":false,"tag":"col"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"colgroup"},{"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"xmlns:mml":"http://www.w3.org/1998/Math/MathML"},"children":[{"tag":"#text","text":"\n"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"eq1","tag":"span"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"(1)"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"xmlns:mml":"http://www.w3.org/1998/Math/MathML"},"children":[{"tag":"#text","text":"\n"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"eq2","tag":"span"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"(2)"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"xmlns:mml":"http://www.w3.org/1998/Math/MathML"},"children":[{"tag":"#text","text":"\n"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"eq3","tag":"span"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"(3)"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"xmlns:mml":"http://www.w3.org/1998/Math/MathML"},"children":[{"tag":"#text","text":"\n"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"eq4","tag":"span"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"(4)"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"xmlns:mml":"http://www.w3.org/1998/Math/MathML"},"children":[{"tag":"#text","text":"\n"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"eq5","tag":"span"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"(5)"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"xmlns:mml":"http://www.w3.org/1998/Math/MathML"},"children":[{"tag":"#text","text":"\n"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"eq6","tag":"span"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"(6)"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"center","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"attributes":{"xmlns:mml":"http://www.w3.org/1998/Math/MathML