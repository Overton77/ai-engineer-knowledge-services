4B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f6"},"children":[{"tag":"#text","text":"6"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figures 4"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and participated in the manuscript writing. JB contributed to "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f1"},"children":[{"tag":"#text","text":"Figure 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and provided "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"Figure 2A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"2E"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"2H"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figures 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", and participated in the manuscript writing. CL provided "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f4"},"children":[{"tag":"#text","text":"Figure 4A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f4"},"children":[{"tag":"#text","text":"4C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 3"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and participated in manuscript writing. MJC provided concept development, contributed to "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f1"},"children":[{"tag":"#text","text":"Figure 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and co-wrote the manuscript. IC planned, directed, interpreted, and integrated the work, contributed to "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f1"},"children":[{"tag":"#text","text":"Figure 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and wrote the manuscript."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"fn2","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"children":[{"tag":"#text","text":"CONFLICTS OF INTEREST:"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" The authors declare that they have no conflicts of interest."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"fn3","tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fn p"},"children":[{"children":[{"children":[{"tag":"#text","text":"FUNDING:"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" This work was suppo