{"tag":"#text","text":"\n"}],"hidden":false,"id":"id4","tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"id5","class":"usa-link","href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Conboy%20IM%22[Author]"},"children":[{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Irina M Conboy"}],"hidden":false,"tag":"span"}],"hidden":false,"tag":"a"},{"children":[{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Irina M Conboy"}],"hidden":false,"tag":"span"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":"Department of Bioengineering and QB3, University of California, Berkeley, Berkeley, CA 94720, USA"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p"},"children":[{"tag":"#text","text":"Find articles by "},{"attributes":{"class":"usa-link","href":"https://pubmed.ncbi.nlm.nih.gov/?term=%22Conboy%20IM%22[Author]"},"children":[{"attributes":{"class":"name western"},"children":[{"tag":"#text","text":"Irina M Conboy"}],"hidden":false,"tag":"span"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"id":"id5","tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"1,"}],"hidden":false,"tag":"sup"},{"children":[{"tag":"#text","text":"✉"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"attributes":{"class":"d-buttons inline-list"},"children":[{"tag":"#text","text":"\n"},{"children":[{"attributes":{"aria-controls":"aip_a","aria-expanded":"false","class":"d-button"},"children":[{"tag":"#text","text":"Author information"}],"hidden":false,"tag":"button"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"aria-controls":"anp_a","aria-expanded":"false","class":"d-button"},"children":[{"tag":"#text","text":"Article notes"}],"hidden":false,"tag":"button"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"aria-controls":"clp_a","aria-expanded":"false","class":"d-button"},"children":[{"tag":"#text","text":"Copyright and License information"}],"hidden":false,"tag":"button"}],"hidden":false,"tag":"li"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"ul"},{"tag":"#text","text":"\n"},{"attributes":{"class":"d-panels font-secondary-light"},"children":[{"tag":"#text","text":"\n"},{"hidden":true,"id":"aip_a","tag":"div"},{"tag":"#text","text":"\n"},{"hidden":true,"id":"anp_a","tag":"div"},{"tag":"#text","text":"\n"},{"hidden":true,"id":"clp_a","tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"PMCID: PMC10522373  PMID: "},{"attributes":{"class":"usa-link","href":"https://pubmed.ncbi.nlm.nih.gov/37702598/"},"children":[{"tag":"#text","text":"37702598"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"div"}],"hidden":false,"tag":"section"}],"hidden":false,"tag":"section"},{"attributes":{"aria-label":"Article content"},"children":[{"attributes":{"class":"body main-article-body"},"children":[{"attributes":{"class":"abstract"},"children":[{"children":[{"tag":"#text","text":"Abstract"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"This study shows that Elastic Net (EN) DNA methylation (DNAme) clocks have low accuracy of predictions for individuals of the same age and a low resolution between healthy and disease cohorts; caveats inherent in applying linear model to non-linear processes. We found that change in methylation of cytosines with age is, interestingly, not the determinant for their selection into the clocks. Moreover, an EN clock’s selected cytosines change when non-clock cytosines are removed from the training data; as expected from optimization in a machine learning (ML) context, but inconsistently with the identification of health markers in a biological context. To address these limitations, we moved from predictions to measurement of biological age, focusing on the cytosines that on average remain invariable in their methylation through lifespan, postulated to be homeostatically vital. We established that dysregulation of such cytosines, measured as the sums of standard deviations of their methylation values, quantifies biological noise, which in our hypothesis is a biomarker of aging and disease. We term this approach a “noise barometer” - the pressure of aging and disease on an organism. These noise-detecting cytosines are particularly important as sums of SD on the entire 450K DNAme array data yield a random pattern through chronology. Testing how many cytosines of the 450K arrays become noisier with age, we found that the paradigm of DNAme noise as a biomarker of aging and disease remarkably manifests in ~1/4 of the total. In that large set even the cytosines that have on average constant methylation through age show increased SDs and can be used as noise detectors of the barometer."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"kwd-group"},"children":[{"children":[{"children":[{"tag":"#text","text":"Keywords:"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" DNA methylation, epigenetics, aging, clocks’ fail-tests, biological noise"}],"hidden":false,"tag":"p"}],"hidden":false,"id":"kwd-group1","tag":"section"}],"hidden":false,"id":"abstract1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"INTRODUCTION"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Elastic Net (EN) is the most used machine learning (ML) approach in constructing DNAme clocks ["},{"attributes":{"aria-describedby":"r1","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r1"},"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r5","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r5"},"children":[{"tag":"#text","text":"5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. The main principle of EN is to use regularization on datasets where the number of features far exceeds the number of samples and perform feature selection toward an absolute shrinkage of feature weights, allowing for the fit of a linear model to a relationship between the response variable and the predictors ["},{"attributes":{"aria-describedby":"r6","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r6"},"children":[{"tag":"#text","text":"6"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. The EN model is trained using stochastic gradient descent to minimize a cost function ("},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#eq1"},"children":[{"tag":"#text","text":"Equation 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") and returns a sparse set of feature weights, w^ ("},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#eq2"},"children":[{"tag":"#text","text":"Equation 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). Prediction is given by taking a linear combination of the learned weights and a sample’s surrogate measure of methylation, e.g., the beta values ("},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#eq3"},"children":[{"tag":"#text","text":"Equation 3"}],"hidden":false,"tag":"a"},{"tag":"#text","text":") ["},{"attributes":{"aria-describedby":"r7","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r7"},"children":[{"tag":"#text","text":"7"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. It must be noted that a least-error linear relationship is found regardless of whether the relationship is in fact linear. It is also notably different from typical biological experiments, that after most of the data are filtered out the remaining values are multiplied by weights that may be biologically arbitrary, as long as they mathematically enforce the hypothesis of linear change, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f1"},"children":[{"tag":"#text","text":"Figure 1A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 1."}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=10522373_aging-15-205046-g001.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 1","class":"graphic zoom-in","height":"420","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/e604/10522373/6b189127a780/aging-15-205046-g001.jpg","width":"786"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/figure/f1/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"children":[{"tag":"#text","text":"Basic principles of the 1"},{"children":[{"tag":"#text","text":"st"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":" and next gen DNAme EN clocks."}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" ("},{"children":[{"tag":"#text","text":"A"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") A schematic of the fundamental processing of DNAme arrays data into relative beta values and using these as input for the 1"},{"children":[{"tag":"#text","text":"st"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":" gen and next gen EN DNAme clocks. A large data set with some underlying pattern suffices for forming the least erroneous linear correlation with a measured parameter. ("},{"children":[{"tag":"#text","text":"B"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":", "},{"children":[{"tag":"#text","text":"C"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Comparison between the epigenetic analysis of gene expression in typical biological studies ("},{"children":[{"tag":"#text","text":"B"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") and the cytosines picked by EN DNAme clocks ("},{"children":[{"tag":"#text","text":"C"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":"). ("},{"children":[{"tag":"#text","text":"D"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":", "},{"children":[{"tag":"#text","text":"E"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") comparison between typical biomedical studies that yield significant differences between cohorts in select parameters ("},{"children":[{"tag":"#text","text":"D"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") and EN DNAme clock predictions ("},{"children":[{"tag":"#text","text":"E"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":"). Of note, high throughput sequencing is broadly available, yet clock models are typically built from less-accurate DNA hybridization data, and parallel bisulfite sequencing controls are lacking for the putative changes in DNAme of the individuals who are predicted by the clocks to be biologically older or younger."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"f1","tag":"figure"},{"children":[{"tag":"#text","text":"DNAme clocks do not reflect the overall epigenetic state of a cell or a tissue and do not predict the process of epigenetic regulation of gene expression by CpG islands. Instead, the clocks are based on a small subset of cytosines that tend to be isolated and scattered sparsely through the genome, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f1"},"children":[{"tag":"#text","text":"Figure 1B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f1"},"children":[{"tag":"#text","text":"1C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Such disconnect of the clocks from the current understanding of gene regulation and purely correlative nature of predictions questions the relationship to the underlying biology. The DNAme array data are not derived from exact and well-controlled sequencing of methylated vs. unmethylated DNA. They are estimates of hybridization strength of 480-900K probes, read as optical signals of different intensity, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f1"},"children":[{"tag":"#text","text":"Figure 1A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Probe hybridizations are largely based on the methylation status of a single end-of-probe cytosine. All signals are normalized and represented as beta values from 0 (unmethylated) to 1 (methylated), based on the maximum and minimum fluorescent intensities of a given cytosine read assay or Illumina run. Random differences in the hybridization efficiency of a probe and in the maximum and minimum fluorescent intensities of an assay or run are expected, and this influences the beta values and hence the predictions. After training on measured parameters, for example age or health scores, an EN model returns weights by which the beta values are multiplied before being summed; the sums are the correlate - predictor. There is no biological reason for weighting these beta values, but since the task is to correlate the measured axis linearly, EN returns the data-adjustment weights for a mathematical solution to the least-squares linear fit, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f1"},"children":[{"tag":"#text","text":"Figure 1A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" ["},{"attributes":{"aria-describedby":"r1","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r1"},"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r5","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r5"},"children":[{"tag":"#text","text":"5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The measured and then predicted axes are conceptually always a regular set of numbers (1, 2, 3… 10) be these inputted as chronological age (first generation clocks), levels of a few proteins followed by years-to-death (GrimAge), a composite of clinical parameters associated with age (PhenoAge), a health scale for people in ~26-50 age range (PACE), or any measurable parameter. In EN, no physical meaning is implied to these numbers."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"As expected, EN regression can confirm well-known, robust differences of age, disease, ectopic epigenetic determinants such as Yamanaka factors, trisomy, etc., cases where DNAme arrays and bisulfate sequencing yield similar data ["},{"attributes":{"aria-describedby":"r8","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r8"},"children":[{"tag":"#text","text":"8"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r12","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r12"},"children":[{"tag":"#text","text":"12"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. However, artifacts of non-specific probe hybridizations are expected to increase with age and disease due to DNA damage and mutations (C to T and others), skewing the data distribution in the outputs of DNAme arrays ["},{"attributes":{"aria-describedby":"r13","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r13"},"children":[{"tag":"#text","text":"13"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"r14","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r14"},"children":[{"tag":"#text","text":"14"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. Aging and disease also involve lymphoid to myeloid, fibrotic, inflammatory, senescent, and other shifts; these may be accurately determined by Flow cytometry, single cell RNA Seq, ATAC-Seq, and "},{"children":[{"tag":"#text","text":"in situ"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" omics, but are unresolvable in bulk DNAme arrays ["},{"attributes":{"aria-describedby":"r15","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r15"},"children":[{"tag":"#text","text":"15"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r17","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r17"},"children":[{"tag":"#text","text":"17"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"In typical biomedical research, a statistically robust number of samples is studied independently from start to finish, however, the metrics of clock performance (e.g., mean squared error, median absolute error, p-value) are often correlations based on an experimental n=1, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f1"},"children":[{"tag":"#text","text":"Figure 1D"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f1"},"children":[{"tag":"#text","text":"1E"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Low p-values mean that the best-fit line could not have been generated by chance in this one experiment, but do not signify accuracy from one experiment (dataset) to another. The natural dynamics of DNAme and experimental differences in instruments, reagents stocks, researcher introduced, etc. ["},{"attributes":{"aria-describedby":"r18","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r18"},"children":[{"tag":"#text","text":"18"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r21","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r21"},"children":[{"tag":"#text","text":"21"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"] are inherent and largely uncontrolled for, meaning that after a successful DNAme array assay, no input/output of EN is known to be more or less accurate than another, and none normalizes for the other. The dataset (split into a training and test subsets) is a subject to above-mentioned batch effects, and thus, the possibility of misinterpreting random experimental variation for biologically relevant changes. The reliance of clocks solely on hybridization arrays also contrasts with typical molecular biology approaches that study each parameter through several redundant assays ["},{"attributes":{"aria-describedby":"r22","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r22"},"children":[{"tag":"#text","text":"22"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The idea of a biological age clock has been explored over the past decades through studies of the Hayflick number, telomere length, DNAme and proteomics, all under the hypotheses that each of these methods reflects a life-long linear change of a biomedically important parameter. Clock’s cytosines have been profiled as biomarkers but such bioinformatics seems to be currently de-emphasized ["},{"attributes":{"aria-describedby":"r3","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r3"},"children":[{"tag":"#text","text":"3"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"r23","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r23"},"children":[{"tag":"#text","text":"23"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. With respect to the notion of linearity, many studies demonstrate a healthy young-adult plateau with stably controlled epigenetics, gene expression and protein levels ["},{"attributes":{"aria-describedby":"r24","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r24"},"children":[{"tag":"#text","text":"24"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r27","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r27"},"children":[{"tag":"#text","text":"27"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. And not all patterns of aging are determinants, for example, hair greying, or loss might be age and health-linked and can be used in EN-based predictions, but hair restoration does not yield health or youth and hair is not a determinant of mortality ["},{"attributes":{"aria-describedby":"r28","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r28"},"children":[{"tag":"#text","text":"28"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"r29","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r29"},"children":[{"tag":"#text","text":"29"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Diseases contribute to health decline and shorten life span; the diseases of age can be detected by many well controlled analyses, including genetics, epigenetics, and clinical tests without clocks that, in some cases, differ from clock predictions ["},{"attributes":{"aria-describedby":"r30","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r30"},"children":[{"tag":"#text","text":"30"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r33","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r33"},"children":[{"tag":"#text","text":"33"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. The question is not whether epigenetics can be used to detect changes in health or if health declines with age, compounded by diseases (both are given), but whether ML clocks predict these changes with high resolution or as early as other methods."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Here, we reveal the capacities and limitations of DNAme clocks of all generations, by expanding the n=1 experimental to a more systematic examination of clock performance on many different DNAme array datasets of healthy controls and patients with various diseases. Additionally, we show that even though EN regression models linearly predict age and risk of mortality from DNAme array data, the clocks are not based on any specific changes in DNA methylation with age, or dysregulation of such methylation, e.g., a change in SD of beta values. Lastly, we describe a conceptually different measurement (not a prediction) of persons’ biological age, which we term a noise barometer, reflecting the concept of "},{"children":[{"tag":"#text","text":"pressure"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" of aging and disease."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec1","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"RESULTS"}],"hidden":false,"tag":"h2"},{"tag":"#text","text":"\n"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"The robustness of linear correlations varies over the age ranges"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"We found that while EN-trained DNAme models yield high linear correlation (r > 0.9) between age and DNAme over the complete age range, weaker linear correlations manifest in tests on binned age ranges ("},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), from 0.16 ≤ r ≤ 0.8. Specifically, bins of 18-30yr (during the maturation of the immune system) and 80-100yr have the highest correlation of r=0.8, with the rest of the age ranges are more moderately correlated (0.16 ≤ r ≤ 0.5). The uneven correlations of different age bins to DNAme changes are consistent with the notion of non-linear changes in biological age over the lifespan, e.g., the healthy plateaus and steeper health decline after combinatorial tissue disrepair ["},{"attributes":{"aria-describedby":"r24","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r24"},"children":[{"tag":"#text","text":"24"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r27","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r27"},"children":[{"tag":"#text","text":"27"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"A non-linearity of epigenetic changes through the lifespan should be expected, due to genetic and environmental variability between people, compounded by the high dynamics of epigenetics that is influenced by such parameters as sense of well-being, financial status, circadian rhythm, etc. ["},{"attributes":{"aria-describedby":"r34","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r34"},"children":[{"tag":"#text","text":"34"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"r35","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r35"},"children":[{"tag":"#text","text":"35"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The non-linearity of biological age, the high variation of the assay and, hence, of the data, which is used for EN training, might result in diminished accuracy of correlations, particularly for some age groups. On the other hand, the overall estimates of being young, middle-aged, or old are reliably well predicted by the EN DNAme clock."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec3","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"Tests of accuracy and biological relevance of predictions"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Two claims are made by studies of EN-based predictors, first that the errors in prediction by DNAme clocks are attributed to age acceleration in particular individuals. In support for this attribution, a similar acceleration was seen for some diseases, albeit only for some age groups ["},{"attributes":{"aria-describedby":"r1","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r1"},"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r5","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r5"},"children":[{"tag":"#text","text":"5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"r36","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r36"},"children":[{"tag":"#text","text":"36"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. A second claim is that because clocks trained on one sample set can work on out-of-sample set data, this indicates some biological relevance of EN predictions and of cytosine selection."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"To examine these claims, we performed systematic fail-tests of DNAme clocks with large DNAme datasets from nine independent studies. First, we reconstructed EN regression models that replicate the published first-generation clocks, and tested them with the original and out-of-sample DNAme array datasets, in which healthy subjects were compared to those with disease: Rheumatoid arthritis, Down syndrome, BRCA-1 cancer, Werner syndrome, Multiple Sclerosis, Crohn’s Disease, Ulcerative Colitis, Irritable Bowel Disease, and an HIV dataset that did not have a parallel healthy control, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"Figure 2A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Model performance was assessed by correlation coefficient (Pearson’s r) between the predicted and actual ages and median absolute error (MAE) ("},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#eq4"},"children":[{"tag":"#text","text":"Equations 4"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#eq5"},"children":[{"tag":"#text","text":"5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 2."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=10522373_aging-15-205046-g002.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 2","class":"graphic zoom-in","height":"422","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/e604/10522373/05946bdfe2fe/aging-15-205046-g002.jpg","width":"786"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/figure/f2/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"children":[{"tag":"#text","text":"Fail-tests of EN models that are trained on biological v. non-biological parameters."}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" ("},{"children":[{"tag":"#text","text":"A"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Standard first generation EN model was trained on 450K DNAme arrays dataset; tests with the original and new datasets, as indicated, are shown (blue – healthy, red – disease). BRCA-1 studies were done on 27K dataset, thus, after training on 27K dataset. EN was tested on BRCA-1 data. EN models were testable with the original and new datasets, except for the BRCA-1, where only the subjects with BRCA1 mutation and cancer but not healthy controls received fairly accurate age predictions. All EN models overlapped predictions for healthy subjects and patients (see "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" for the tests of EN models on additional disease v. healthy datasets). ("},{"children":[{"tag":"#text","text":"B"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") PhenoAge scatter plots overlay for the patients with the studied datasets (red dots-Combined Disease, blue dots-Combined Healthy). ("},{"children":[{"tag":"#text","text":"C"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") PhenoAge tests on the six 450K datasets are represented as the bar graphs on Mean and SDs of predicted age minus actual age (left) and as the comparison in absolute residuals (right); patients – red bars n=806, healthy controls – blue bars; n=754, p-values are shown, NS- non-significant. ("},{"children":[{"tag":"#text","text":"D"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") PhenoAge predictions of DNAme age for the indicated age-intervals are shown as bar graphs of Means with SDs for the patients with Down Syndrome and Parkinson’s Disease (red bars), and their healthy controls (blue bars). DS, n=26, Control, n=58; PD, n=289, Control, n=219; p-values are shown. ("},{"children":[{"tag":"#text","text":"E"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") EN model was trained on the US population numbers, at subjects’ birth years, using the same 450K DNAme array, as in A. The test shows excellent linearity and low MAE in predicting the numbers of people living in US from DNAme array, through 151 clock cytosines. ("},{"children":[{"tag":"#text","text":"F"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") The US population EN model was then trained to predict persons’ age with successful tests (near perfect linearity and MAE of 2.6 years) by 149 clock cytosines. ("},{"children":[{"tag":"#text","text":"G"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") This US population clock was also testable as an age predictor on the out-of-sample 450K datasets of indicated diseases (red dots) and their healthy controls (blue dots); health and disease predictions overlapped. ("},{"children":[{"tag":"#text","text":"H"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") The age predictions made by the US population clock are shown as scatter plots overlay for Combined Disease (arthritis, Down Syndrome, HIV and Chron’s – red dots) and their healthy controls (Combined Healthy, blue dots). All GSEs are in Methods."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"f2","tag":"figure"},{"children":[{"tag":"#text","text":"The models fairly accurately predicted the age of samples, but with an error of age acceleration throughout chronology (shifted above the line) and with overlap in age predictions for the patients and healthy subjects, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"Figure 2A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". This is biologically inconsistent, as arthritis significantly increases PBMC inflammaging, ["},{"attributes":{"aria-describedby":"r37","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r37"},"children":[{"tag":"#text","text":"37"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"r38","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r38"},"children":[{"tag":"#text","text":"38"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"], Werner Syndrome is a disease of premature aging (caused by a mutation of DNA helicase) ["},{"attributes":{"aria-describedby":"r39","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r39"},"children":[{"tag":"#text","text":"39"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"aria-describedby":"r40","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r40"},"children":[{"tag":"#text","text":"40"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"], and Down syndrome has a pathological juvenile blood phenotype with a prevalence of childhood leukemias and less mature circulating PBMCs ["},{"attributes":{"aria-describedby":"r41","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r41"},"children":[{"tag":"#text","text":"41"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. In tests on BRCA-1 studies, the EN model had very high MAE and poor correlation with the age of the healthy subjects but produced fairly accurate predictions for the people with the BRCA-1 mutation, and cancer, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"Figure 2A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The 27K EN model that was from the combination of disease and healthy samples surprisingly reported age acceleration when tested on the 450K dataset that was from relatively healthy individuals, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". 27K dataset cytosine probes are present in the 450K dataset. Lastly, we found that a simple ordinary least squares regression (OLS) on the set of clock’s cytosines also yielded linear correlations, and these were somewhat more accurate in predicting age (lesser age acceleration through chronology) than the EN model, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 2"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"In testing PhenoAge, thought to be biologically more relevant, we expanded the approach to multiple independent studies with 450K DNAme arrays on Arthritis, Multiple Sclerosis, Down Syndrome, Parkinson’s, IBS, Werner Syndrome. We analyzed whether predicted age is on average higher for disease samples as compared to their healthy controls. Additionally, instead of MAE on one 450K correlation, which is the Median from an experimental n=1, we quantified the errors as the arithmetic Means of predicted minus actual age, with Standard Deviation (SD) and p-values, in these six large data studies, experimental n=6. In other words, we applied the typical data analysis that is used in biomedical research, when testing for a relevant change."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"When applied to the DNAme clock, these analyses demonstrated that PhenoAge generally predicted that both healthy subjects and patients with various diseases were younger than their chronological age (shifted below the line) and these predictions had on average 12-17 years of error, which for some age groups grew to over 20 years, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"Figure 2B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"2C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The accuracy of PhenoAge was below statistical significance when it was analyzed with n=6, based on the errors for the same age and when comparing health v. disease. This agrees with batch effects causing a lack of reproducibility, and/or with the normally high variation in the underlying biology of epigenetics. PhenoAge predicted Down Syndrome patients to be biologically older than controls, even though their blood cells are reported to be pathologically juvenile ["},{"attributes":{"aria-describedby":"r41","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r41"},"children":[{"tag":"#text","text":"41"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]. Parkinson’s disease patients surprisingly had a prediction trend of being younger than their healthy controls at 30–40-year range and not statistically different from their healthy controls at all age intervals after 51years, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"Figure 2D"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The second-generation clocks are trained on, and can thus successfully predict, various biological and health parameters and also age, in both test and out-of-sample datasets. As mentioned above, this property of EN does not in itself require a biological meaning or even a physical connection between the correlated and the measured parameter. To demonstrate this point, we constructed a EN clock that accurately predicted the numbers of people living in US from DNAme array data, and like PhenoAge and PACE, it also predicted people’s age on both the original and out-of-sample datasets, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"Figure 2E"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"2G"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". In fact, the US population clock needed only 149 cytosines for predicting age with 2.6-year MAE and Pearson’s r of 0.97, e.g., outperforming many conventional DNAme clocks, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"Figure 2E"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The DNAme predictor of the size of US population also illustrated that the ML EN process tends to overlap age predictions for health and disease, regardless of the training variable, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"Figure 2G"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f2"},"children":[{"tag":"#text","text":"2H"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The increase in US population over time is a proxy for chronology, but this is also true for all DNAme clocks, be they trained on age, levels of inflammatory cytokines, packs of cigarettes smoked, composite health scores, or any metric which tends to have a progressive change with time. The meaning of the values that are composed together to create a latent variable are not preserved in EN training. EN regression only requires that there are some features which have at least some moderate correlations with time progression."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"As expected from the body of published literature, inflammaging, trisomy and diseases are robustly different from health, and this can be detected with much higher resolution than EN by analyzing the primary, un-adjusted, non-linearized data of the DNAme array. For example, Uniform Manifold Approximation and Projection (UMAP), which preserves the topological structure of the data (with all 450k+ cytosines) while embedding it in multi-dimensional computational space, robustly distinguishes between health and disease in the studied here 450K array datasets, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f3"},"children":[{"tag":"#text","text":"Figure 3"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" ["},{"attributes":{"aria-describedby":"r42","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r42"},"children":[{"tag":"#text","text":"42"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"]."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 3."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=10522373_aging-15-205046-g003.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 3","class":"graphic zoom-in","height":"219","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/e604/10522373/8b1ef28fba20/aging-15-205046-g003.jpg","width":"786"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/figure/f3/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"children":[{"tag":"#text","text":"Robust epigenetic differences between health and disease are clear in the 450K datasets."}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" Distinct clustering of DNAme of healthy vs. disease cohorts. UMAP on the 450Kcytosinedataset for Arthritis, Down Syndrome, Parkinson’s Disease and BRCA1 studies (see Methods for dataset identifiers). Each point represents an individual. The clustering of healthy, cancer, and BRCA1 mutation yet no cancer cohorts is distinct for each dataset."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"f3","tag":"figure"},{"children":[{"tag":"#text","text":"Thus, the input DNAme data accurately reflects the expected significant epigenetic differences between healthy and disease populations. However, under the training of a least erroneous linear correlation EN is expected to minimize the weights of cytosines-beta values, which vary among individuals of the same age (or its proxy) due to a disease. Even when a combination of health parameters is used for training, as with the next generation EN clocks, the disease-imposed DNAme differences that vary between age groups, might be overlooked in search for the best linear predictors of age or age-related outcomes for the whole population."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Summarily, if chronology or its proxy is the response variable, and finding the best linear correlation is the task, the relevance of ML predictors is not obvious. Additionally, random experimental variation of the arrays and/or EN training might be misinterpreted as biologically meaningful change in all generations of clock models."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec4","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"EN predictors are not based on change in DNA methylation with age"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"To explore a possible mechanism by which clock features predict age or health scores we studied the assigned weights of cytosine beta values of several published DNAme clock models. The weight assigned by a model to a predictor is a surrogate measure of its importance in the model, as the predictions returned by a model are most sensitive to changes in predictors with the highest weights. Interestingly, we found that EN does not necessarily select cytosines whose methylation either change or correlate strongly with age, and hence are biologically meaningful in such a way, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f4"},"children":[{"tag":"#text","text":"Figure 4A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 4."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=10522373_aging-15-205046-g004.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 4","class":"graphic zoom-in","height":"476","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/e604/10522373/3e1c7939a7cd/aging-15-205046-g004.jpg","width":"786"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/figure/f4/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"children":[{"tag":"#text","text":"Cytosine ranking by EN is not based on the changes in methylation with age."}],"hidden":false,"tag":"strong"},{"tag":"#text","text":" ("},{"children":[{"tag":"#text","text":"A"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") DNAme clock was constructed with EN regression on a 450K array dataset ("},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE40279","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE40279"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", N=656), and the test set prediction performance is shown (Model 0). The selected clock cytosines were removed, the model was retrained, and model performance on the test set is shown (Model 1). Scatter plot of the coefficient of variation for each clock cytosine individually regressed on age plotted against their rank by their absolute weights. The mean coefficient of variation of the clock cytosines are shown as red dashed lines. The cytosines of Model 1, e.g., those which were minimized to zero in Model 0, have a higher mean R"},{"children":[{"tag":"#text","text":"2"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":", despite being slightly less accurate. ("},{"children":[{"tag":"#text","text":"B"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Scatter plots of the coefficient of variation for the cytosines regressed on age are plotted against their rank/EN weights of the published 1"},{"children":[{"tag":"#text","text":"st"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":" generation Hannum clock, PhenoAge and PACE. ("},{"children":[{"tag":"#text","text":"C"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") An EN clock was trained with a 450K dataset ("},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE40279","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE40279"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"), then non-clock cytosines were randomly removed: independently in a stepwise fashion. After each iteration of removal, a new EN model was trained and the selected set of cytosines was compared to the set of original clock cytosines. Non-clock cytosines were removed in one percent increments from 0-10% (left panel) and 10% increments from 10-100% (right panel). At 2% of removal of the non-clock cytosines, the cytosine set selected by EN began significantly changing. The percentage of unused original cytosines plateau at 17% in both gradual (1% at a time) and rapid (10% at a time) removal of the non-clock cytosines."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"f4","tag":"figure"},{"children":[{"tag":"#text","text":"In fact, the ranking of cytosines as per their methylation change with age became "},{"children":[{"tag":"#text","text":"better"}],"hidden":false,"tag":"em"},{"tag":"#text","text":", yet MAE became slightly worse, after all the original clock picked cytosines were removed from the dataset, and as expected, EN selected the next weighted best fit linear predictor set, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f4"},"children":[{"tag":"#text","text":"Figure 4A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". The redundancy of cytosine sets is known, e.g., EN is “resilient” to specific cytosines, or their combination, and it is the EN process on large data that gives the linear correlation. In support of these finding, the changes of DNAme with age were not the determinant of the ranking of cytosines by the published 1"},{"children":[{"tag":"#text","text":"st"}],"hidden":false,"tag":"sup"},{"tag":"#text","text":" generation clock trained on age or PhenoAge, and PACE trained on health/disease parameters ["},{"attributes":{"aria-describedby":"r1","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r1"},"children":[{"tag":"#text","text":"1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"aria-describedby":"r5","class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#r5"},"children":[{"tag":"#text","text":"5"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"], ("},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f4"},"children":[{"tag":"#text","text":"Figure 4B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"). The red dashed lines are the mean coefficient of variation and that the line remains flat with age signifies the irrelevance of age-specific changes in DNAme for the ranking of clock’s cytosines."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Exploring the mechanisms of cytosines selection further, we next removed not the clock picked cytosines, but the cytosines that were excluded from the model by EN, and then retrained EN on the remaining set, and we did this repeatedly, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f4"},"children":[{"tag":"#text","text":"Figure 4B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Removal of unpicked cytosines significantly changed the picked cytosines from the original training, plateauing at 17-20% of the unused original set after removal of 3-4% of irrelevant cytosines. DeepmAge, PhenoAge and Hannum’s 71 clock cytosines were similarly deselected upon the non-clock cytosine removal, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 3A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"–"},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"3C"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Such behavior does not agree with a hypothesis that biomarkers should not change when non-biomarkers are deleted from a dataset and supports the null hypothesis that picked cytosines are not biomarkers. ML methods that rely on stochastic gradient descent for optimization appear to suffer from the pitfall that removal or absence of certain features changes the hyper surface of the feature space which influences the local optima (i.e., feature sets, weights and hyperparameter values) that the gradient descent can converge upon. This point was experimentally supported by studying the effects of removing the non-significant cytosines on the energy landscape of EN, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 3D"}],"hidden":false,"tag":"a"},{"tag":"#text","text":"."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Summarily, the biomedical significance of clock cytosines is not clear, and DNAme clocks are not directly based on the changes in DNA methylation with age or disease."}],"hidden":false,"tag":"p"}],"hidden":false,"id":"sec5","tag":"section"},{"children":[{"attributes":{"class":"pmc_sec_title"},"children":[{"tag":"#text","text":"It is not absolute beta values, but the noise (SD) of certain cytosines that biomarks biological age"}],"hidden":false,"tag":"h3"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"In the final part of our study, we quantify biological age from the DNAme arrays data, using six independent studies with 450K DNAme arrays that were performed on 1806 samples. We postulated that homeostatically vital cytosines would serve well as the detectors of biological noise, which in our hypothesis is a biomarker of aging and disease. Furthermore, we postulated that such noise detecting cytosines can be characterized and thus identified by a nearly equivalent Mean of their beta values between young and old, but a higher SD about the Mean with age. Our goal was to measure this indicator of biological age, not to predict it."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"The age-imposed increase in the DNAme noise is visible when looking at a scatter plot of the beta values of individual cytosines that are on average invariable in their methylation across the lifespan, as exemplified in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" (each dot is an individual). To capture this biological phenomenon from the DNAme array data, we first specifically identified the cytosines that remain on average invariable in their methylation through age (Pearson’s (r) 0.02-0.05 of beta values over age) and become deregulated or “noisy” with age (change in absolute distance of their beta values from the Mean, ADM); this yielded 50 cytosines out of the 450K DNAme array, "},{"attributes":{"class":"usa-link","data-ga-action":"click_feat_suppl","href":"https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE42861","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"GSE42861"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" dataset, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":". Consistent with the hypothesis of biological relevance, all these cytosines turned out to be in vital genes known to be homeostatically regulated, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#t1"},"children":[{"tag":"#text","text":"Table 1"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" and "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD2"},"children":[{"tag":"#text","text":"Supplementary Data Excel"}],"hidden":false,"tag":"a"},{"tag":"#text","text":", which shows genome loci annotations of the 50 noise detector cytosines. The biological age (Right Y axis) was then quantified based on the Median of the normalized by the young age sums of SDs of these 50 cytosines (Left Y axis). This unadjusted primary data had a good fit with polynomial curve, it displayed age-imposed increase in biological noise with a plateau at ~35-45 years of age, in healthy subjects, and a clear increase in the noise for the young and middle-aged patients with arthritis, "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#f5"},"children":[{"tag":"#text","text":"Figure 5B"}],"hidden":false,"tag":"a"},{"tag":"#text","text":" (each dot represents the indicated age; the raw data with dots representing individuals per each age is shown in "},{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/#SD1"},"children":[{"tag":"#text","text":"Supplementary Figure 4A"}],"hidden":false,"tag":"a"},{"tag":"#text","text":")."}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"fig xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Figure 5."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"attributes":{"class":"img-box line-height-none margin-x-neg-2 tablet:margin-x-0 text-center"},"children":[{"attributes":{"class":"tileshop","href":"https://www.ncbi.nlm.nih.gov/core/lw/2.0/html/tileshop_pmc/tileshop_pmc_inline.html?title=Click%20on%20image%20to%20zoom&p=PMC3&id=10522373_aging-15-205046-g005.jpg","target":"_blank"},"children":[{"attributes":{"alt":"Figure 5","class":"graphic zoom-in","height":"446","loading":"lazy","src":"https://cdn.ncbi.nlm.nih.gov/pmc/blobs/e604/10522373/04e3d7a27f43/aging-15-205046-g005.jpg","width":"786"},"hidden":false,"tag":"img"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"p"},{"tag":"#text","text":"\n"},{"attributes":{"class":"p text-right font-secondary"},"children":[{"attributes":{"class":"usa-link","href":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10522373/figure/f5/","rel":"noopener noreferrer","target":"_blank"},"children":[{"tag":"#text","text":"Open in a new tab"}],"hidden":false,"tag":"a"}],"hidden":false,"tag":"div"},{"tag":"#text","text":"\n"},{"children":[{"children":[{"children":[{"tag":"#text","text":"Direct quantification of biological age from DNAme array data through noise barometer. "}],"hidden":false,"tag":"strong"},{"tag":"#text","text":"("},{"children":[{"tag":"#text","text":"A"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Representative cytosine that is on average invariable in its methylation throughout lifespan but becomes visibly noisier, showing higher absolute deviation from the mean in older individuals. Each dot is an individual. ("},{"children":[{"tag":"#text","text":"B"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Polynomial curve was fitted to the dot-plot of Median of normalized by healthy young sums of SDs of the 50 cytosines for healthy individuals, left; the same polynomial curve is overlayed with the dot plot of the Median of normalized by healthy young sums of SDs of the 50 cytosines for arthritis patients, right. Biological ages were mapped onto the right Y axis, as described in Methods. Each dot is age range: blue – healthy, red, arthritis. ("},{"children":[{"tag":"#text","text":"C"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Polynomial curve was fitted to the 460 Summed SDs (of the 460 cytosines) v. chronological age ranges, using the six combined 450K DNAme datasets of healthy controls. Right Y axis shows mapping of the summed SDs into biological ages and the compression of specific age ranges. ("},{"children":[{"tag":"#text","text":"D"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Scatter plots on the changes in beta values over age for representative cytosines that are least regulated in young, with SD=0.3 of absolute Mean of beta values, and all 8 most regulated in young cytosines with SD=0.015 of absolute Mean of beta values. Each dot is a sample. ("},{"children":[{"tag":"#text","text":"E"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Dot plots of the summed SDs of the 17 cytosines and of the 8 cytosines. Each dot is 49 samples on average. Black arrows indicate transitions from low to high noise. ("},{"children":[{"tag":"#text","text":"F"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Same as ("},{"children":[{"tag":"#text","text":"D"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":"), but for cytosines that have SD=0.3 and 0.015 of the "},{"children":[{"tag":"#text","text":"relative "}],"hidden":false,"tag":"em"},{"tag":"#text","text":"Mean of beta values. ("},{"children":[{"tag":"#text","text":"G"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Same as ("},{"children":[{"tag":"#text","text":"E"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":"), but for the summed cytosines with SD=0.3 and 0.015 of the "},{"children":[{"tag":"#text","text":"relative"}],"hidden":false,"tag":"em"},{"tag":"#text","text":" Mean of beta values. ("},{"children":[{"tag":"#text","text":"H"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":") Venn diagrams of the cytosines of the published clocks and the 460, 50 and 5, 8 – most regulated, 13, 17 least regulated cytosines of the noise barometer that quantifies biological age; the text is color-coded per each cytosine set."}],"hidden":false,"tag":"p"}],"hidden":false,"tag":"figcaption"}],"hidden":false,"id":"f5","tag":"figure"},{"attributes":{"class":"tw xbox font-sm"},"children":[{"attributes":{"class":"obj_head"},"children":[{"tag":"#text","text":"Table 1. Families and functions of the genes annotated to the 50 cytosines noise biomarkers."}],"hidden":false,"tag":"h4"},{"tag":"#text","text":"\n"},{"attributes":{"class":"tbl-box p","tabindex":"0"},"children":[{"attributes":{"class":"content","frame":"hsides","rules":"groups"},"children":[{"tag":"#text","text":"\n"},{"children":[{"attributes":{"span":"1","width":"12%"},"hidden":false,"tag":"col"},{"tag":"#text","text":"\n"},{"attributes":{"span":"1","width":"12%"},"hidden":false,"tag":"col"},{"tag":"#text","text":"\n"},{"attributes":{"span":"1","width":"36%"},"hidden":false,"tag":"col"},{"tag":"#text","text":"\n"},{"attributes":{"span":"1","width":"40%"},"hidden":false,"tag":"col"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"colgroup"},{"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","style":"border-top: solid 1pt; border-bottom: solid 1pt;","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Probe"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","style":"border-top: solid 1pt; border-bottom: solid 1pt;","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Gene"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","style":"border-top: solid 1pt; border-bottom: solid 1pt;","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Family"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","style":"border-top: solid 1pt; border-bottom: solid 1pt;","valign":"middle"},"children":[{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"Effects"}],"hidden":false,"tag":"strong"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg00868523"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"PRKCG"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Protein Kinase C"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Pleiotropic"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg01767885"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"C1QTNF8"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"C1q/TNF-Related"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Cell motility - vital"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg01869186"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"EPHB4"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Ephrin receptor/RTK"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Vascular repair - vital"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg01900413"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"ETS-1"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"TF"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Pleiotropic"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg02247160"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"CTNNB1"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Beta-catenin"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Pleiotropic"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg04153991"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"PHLDB2"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Regulators of cadherin"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Cell adhesion and cytoskeleton - vital"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg04495670"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"FGF3"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"FGF, MAPK signaling"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Pleiotropic"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg06362282"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"B3GALT4"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Membrane-bound Galactosyltransferase"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"Pleiotropic"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"}],"hidden":false,"tag":"tr"},{"tag":"#text","text":"\n"},{"children":[{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"cg06494091"}],"hidden":false,"tag":"td"},{"tag":"#text","text":"\n"},{"attributes":{"align":"left","colspan":"1","rowspan":"1","valign":"middle"},"children":[{"tag":"#text","text":"GNAQ"}],"hidden":false,"tag":"td"},{"tag":"#