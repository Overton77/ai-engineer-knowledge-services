{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
      "packages/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
      "services/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
      "scripts/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
      "tools/**/*.{ts,tsx,mts,cts,js,mjs,cjs}",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!**/fixtures",
      "!**/__fixtures__",
      "!**/testdata",
      "!**/skills",
      "!**/*.generated.*",
      "!packages/persistence/src/promotion-selection.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "auto"
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "json": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "assist": { "enabled": false }
}
