NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=source-captures
MAXIMUM_ARTIFACT_BYTES=
CANONICAL_LOCAL_ONLY=
POSTGRES_URL=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1/scrape
FIRECRAWL_API_KEY=
UNSTRUCTURED_API_URL=https://platform.unstructuredapp.io/api/v1
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_TEMPLATE_ID=
AI_GATEWAY_API_KEY=
DOCLING_BASE_URL=http://127.0.0.1:5001
DOCLING_API_KEY=
DOCLING_MAXIMUM_RESULT_BYTES=67108864
DOCLING_REQUEST_TIMEOUT_MS=300000
KNOWLEDGE_API_URL=http://127.0.0.1:4100
# JSON array of local static identities. Every token is bound to one actor and
# explicit per-tenant roles/scopes; unlisted tenants/actions are denied.
# KNOWLEDGE_API_IDENTITIES=[{"token":"replace-with-a-long-random-token","actor":{"kind":"service","id":"00000000-0000-4000-8000-000000000001","serviceIdentity":"mission_control_client"},"grants":[{"tenantId":"00000000-0000-4000-8000-000000000002","roles":["knowledge_operator"],"scopes":[]}]}]
KNOWLEDGE_API_IDENTITIES=
KNOWLEDGE_API_TOKEN=
# Verification API ownership grants bind an authenticated actor to a canonical
# tenant, mission and agent deployment; routing IDs are checked against Postgres.
VERIFICATION_SERVICE_OWNERSHIP_GRANTS_JSON=
# Worker-only immutable source/profile grants. Empty leaves verification disabled.
VERIFICATION_SERVICE_CATALOG_JSON=
# API admission requires authenticated mission ownership grants; worker requires
# immutable metric profile grants and the parser configuration below.
VERIFICATION_METRIC_ENABLED=0
VERIFICATION_METRIC_PROFILE_GRANTS_JSON=
VERIFICATION_PARSER_IMAGE_DIGEST=
VERIFICATION_PARSER_COMMAND=docker
VERIFICATION_STORAGE_BUCKET=ai-engineer-cloud-bucket
# MCP and A2A use a bearer from KNOWLEDGE_API_IDENTITIES and send accepted-operation
# status links to KNOWLEDGE_API_URL; it has no separate shared bearer token.
# JSON array of tenant-scoped HMAC secrets resolved only at the callback edge.
# KNOWLEDGE_CALLBACK_SIGNING_KEYS=[{"tenantId":"00000000-0000-4000-8000-000000000002","signingKeyReference":"secret://eve/callback-signing","secret":"replace-with-at-least-32-random-bytes"}]
KNOWLEDGE_CALLBACK_SIGNING_KEYS=
KNOWLEDGE_PERSISTENCE_MODE=postgres
WORKER_TENANT_ID=
WORKER_ID=
WORKER_POLL_MS=1000
WORKER_LEASE_MS=30000
ACQUISITION_ALLOWED_HOSTS=
ACQUISITION_TIMEOUT_MS=30000
ACQUISITION_MAXIMUM_REDIRECTS=5
ACQUISITION_MAXIMUM_DECOMPRESSION_RATIO=20
ALLOW_INSECURE_HTTP_ACQUISITION=0

# Enable bounded reads of canonically registered, sealed verification runs.
# Requires POSTGRES_URL, SUPABASE_URL and SUPABASE_SECRET_KEY.
VERIFICATION_READS_ENABLED=0

# Metric worker sealing: trusted tenant/version -> registered policy artifact grants.
# Set only after registering the exact immutable policy artifact. Empty keeps the
# existing mechanical-only operation mode; it does not claim a sealed audit run.
VERIFICATION_SEAL_POLICY_GRANTS_JSON=
VERIFICATION_CODE_GIT_SHA=
# Explicit 0/1 required when sealing is configured.
VERIFICATION_CODE_DIRTY=
VERIFICATION_RUNTIME_PLATFORM=
VERIFICATION_RUNTIME_DEPLOYMENT_ID=

# --- Verification: static / legacy operation hints (optional) ---
VERIFICATION_SERVICE_ATTEMPT_ID=
VERIFICATION_SERVICE_WORK_ITEM_ID=
VERIFICATION_SERVICE_MISSION_ID=
VERIFICATION_SERVICE_CAUSATION_ID=
VERIFICATION_SERVICE_EXTERNAL_RUNTIME=
VERIFICATION_SERVICE_EXTERNAL_RUN_ID=
VERIFICATION_SERVICE_EXTERNAL_ROOT_RUN_ID=
VERIFICATION_SERVICE_EXTERNAL_SESSION_ID=
VERIFICATION_SERVICE_EXTERNAL_TURN_ID=
VERIFICATION_SERVICE_EXTERNAL_TOOL_CALL_ID=
VERIFICATION_SERVICE_CAPABILITY_VERSION=

# --- Verification: Eve runtime attestation (API public keys JSON) ---
VERIFICATION_EVE_RUNTIME_ATTESTATION_KEYS_JSON=

# --- Verification: capture / parse (flags default 0) ---
VERIFICATION_CAPTURE_ACQUIRE_ENABLED=0
VERIFICATION_SOURCE_ACQUISITION_GRANTS_JSON=
VERIFICATION_PARSE_ARTIFACT_ENABLED=0
VERIFICATION_CAPTURE_READS_ENABLED=0

# --- Verification: claims / report / semantic (flags default 0; grants JSON arrays) ---
VERIFICATION_CLAIMS_ENABLED=0
VERIFICATION_CLAIMS_PROJECTION_GRANTS_JSON=
VERIFICATION_CLAIMS_REPORT_READ_PUBLIC_KEYS_JSON=
VERIFICATION_SEMANTIC_RUNTIME_JSON=
VERIFICATION_SEMANTIC_PROFILE_GRANTS_JSON=

# --- Verification: audit inspection (flags default 0; PEM on worker) ---
VERIFICATION_AUDIT_INSPECTION_ENABLED=0
VERIFICATION_AUDIT_INSPECTION_GRANTS_JSON=
VERIFICATION_AUDIT_INSPECTION_PUBLIC_KEYS_JSON=
VERIFICATION_AUDIT_INSPECTION_READS_ENABLED=0
VERIFICATION_AUDIT_INSPECTION_TIMEOUT_MS=
VERIFICATION_AUDIT_SIGNING_KEY_ID=
VERIFICATION_AUDIT_SIGNING_PRIVATE_KEY_PEM=

# --- Verification: adjudication trio + decisions (flags default 0) ---
VERIFICATION_ADJUDICATION_GRANTS_JSON=
VERIFICATION_ADJUDICATION_REVIEW_REQUIREMENTS_JSON=
VERIFICATION_ADJUDICATION_PUBLIC_KEYS_JSON=
VERIFICATION_ADJUDICATION_TIMEOUT_MS=
VERIFICATION_ADJUDICATION_DECISIONS_ENABLED=0
VERIFICATION_ADJUDICATION_SYNTHETIC_REVIEWER_GRANTS_JSON=

# --- Verification: benchmark + comparison (PEM on worker) ---
VERIFICATION_BENCHMARK_CONFIG_JSON=
VERIFICATION_BENCHMARK_SIGNING_KEY_ID=
VERIFICATION_BENCHMARK_SIGNING_PRIVATE_KEY_PEM=
VERIFICATION_BENCHMARK_COMPARISON_CONFIG_JSON=
VERIFICATION_BENCHMARK_COMPARISON_SIGNING_KEY_ID=
VERIFICATION_BENCHMARK_COMPARISON_SIGNING_PRIVATE_KEY_PEM=
VERIFICATION_BENCHMARK_CAPTURE_PROFILES_JSON=
VERIFICATION_BENCHMARK_READ_PUBLIC_KEYS_JSON=
VERIFICATION_BENCHMARK_COMPARISON_READ_PUBLIC_KEYS_JSON=

# --- Verification: structured extraction + provider reconciliation ---
VERIFICATION_STRUCTURED_EXTRACTION_CONFIG_JSON=
VERIFICATION_STRUCTURED_EXTRACTION_SIGNING_KEY_ID=
VERIFICATION_STRUCTURED_EXTRACTION_SIGNING_PRIVATE_KEY_PEM=
VERIFICATION_STRUCTURED_EXTRACTION_READ_PUBLIC_KEYS_JSON=
VERIFICATION_PROVIDER_RECONCILIATION_GRANTS_JSON=
VERIFICATION_SEMANTIC_PROVIDER_RECONCILIATION_GRANTS_JSON=
VERIFICATION_PROVIDER_RECONCILIATION_PUBLIC_KEYS_JSON=

# --- Verification: internal drift (flag default 0) ---
VERIFICATION_DRIFT_REVALIDATION_ENABLED=0
VERIFICATION_DRIFT_CONSUMER_SERVICE_IDENTITIES_JSON=
VERIFICATION_COMPONENT_DRIFT_MONITORS_JSON=
VERIFICATION_COMPONENT_DRIFT_PUBLIC_KEYS_JSON=
